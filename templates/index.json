      "type": "join-revolution",
      "settings": {
        "bg_color": "#fdfaf0",
        "title": "Join the <strong>Satvik Snacking</strong> Revolution",
        "content": "<p>Wellness begins with what you eat. Swarna Raisins isn't just a premium snack — it's a movement towards clean, mindful, Indian-origin nourishment. Choose purity, support 200+ farmers, and make wellness your daily ritual.</p>",
        "btn1_text": "Join the Movement",
        "btn1_link": "/collections/all",
        "btn2_text": "Follow @SwarnaRaisins",
        "btn2_link": "https://instagram.com/swarnaraisins",
