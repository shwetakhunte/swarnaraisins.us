    "we_care_section": {
      "type": "we-care",
      "settings": {
        "bg_color": "#fdfaf0",
        "title": "We Care For",
        "content": "<p>Other brands make raisins a commodity. We make them a promise — nourishment, purity and energy in every bite. In every batch we fuse ancient Ayurvedic wisdom with scientific safety checks, so your snack is both sacred and safe.</p>",
        "badge_1_text": "FSSAI Certified",
        "badge_2_text": "APEDA Certified",
        "badge_3_text": "ISO 9001:2015 Certified",
        "badge_4_text": "U.S. FDA Approved",
        "padding_top": 80,
        "padding_bottom": 80
      }
    },
    "what_we_stand_for_section": {
      "type": "what-we-stand-for",
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "icon_bg": "#4a0080",
            "title": "Our Farmers",
            "intro": "<p>We honour the hands that grow your food.</p>",
            "list_items": "<ul><li>Fair pricing & guaranteed offtake</li><li>Support during difficult seasons</li><li>Skill training for better livelihoods</li><li>Education support for their children</li></ul>",
            "footer_text": "<p>When farmers grow with dignity, you get food with integrity.</p>"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "icon_bg": "#2e7d32",
            "title": "You — Our Consumers",
            "intro": "<p>Your health and trust come first.</p>",
            "list_items": "<ul><li>Zero sulfur, zero shortcuts</li><li>Sun-dried purity</li><li>FSSAI & NABL certified</li><li>Transparent sourcing</li><li>Nutrition-focused processing</li></ul>",
            "footer_text": "<p>Food that strengthens you — not concerns you.</p>"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "icon_bg": "#4a0080",
            "title": "The Environment",
            "intro": "<p>We grow responsibly to protect tomorrow.</p>",
            "list_items": "<ul><li>Renewable energy</li><li>Plastic neutrality</li><li>Water-efficient farming</li><li>Soil-first practices</li><li>Reduced carbon footprint</li></ul>",
            "footer_text": "<p>Because the land that feeds us deserves respect.</p>"
          }
        },
        "card_4": {
          "type": "card",
          "settings": {
            "icon_bg": "#2e7d32",
            "title": "Our Responsibility",
            "intro": "<p>Swarna Raisins is built on ethics, not trends.</p>",
            "list_items": "<ul><li>Better incomes for farmers</li><li>Educated families</li><li>Healthier consumers</li><li>Cleaner farming</li><li>A sustainable India</li></ul>",
            "footer_text": "<p>When you choose us, you support impact that lasts.</p>"
          }
        }
      },
      "block_order": [
