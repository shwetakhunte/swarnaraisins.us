    "our_story_section": {
      "type": "our-story",
      "settings": {
        "title": "Our Story - A Legacy Of Decades",
        "subtitle": "Born in the Vineyards. Perfected by Passion",
        "content": "<p>We founded <b>Swarna Raisins</b> with a simple yet powerful vision — to bring <b>India's finest, naturally sweet raisins</b> directly from our farms to homes across the world.<br><br>For decades, our family has been growing raisins in the fertile lands of <b>Karnataka</b>, closely working with farmers across <b>Maharashtra</b> — regions celebrated for producing some of the most flavourful grapes in India. Over the years, we witnessed a recurring challenge: while farmers worked tirelessly to grow premium-quality grapes, the real value of their effort was often lost in long supply chains and multiple intermediaries.</p>",
        "btn_text": "Read our Story",
        "btn_link": "/pages/about-us",
        "bg_color": "#ffffff",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
