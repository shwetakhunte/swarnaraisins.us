{%- liquid
  assign sid = section.id
  assign section_blocks = section.blocks
  assign arr_img = section_blocks | where: 'type', 'img'
  assign layout_des = section.settings.layout_des
  assign border = section.settings.border
  assign sett_equal = section.settings.use_eq_height
  assign image_ratio = section.settings.image_ratio
  if sett_equal
    case image_ratio
      when 'ratio2_1'
        assign aspect_ratio = 2.0
      when 'ratio3_2'
        assign aspect_ratio = 1.5
      when 'ratio4_3'
        assign aspect_ratio = 1.333
      when 'ratio1_1'
        assign aspect_ratio = 1.0
      when 'ratio3_4'
        assign aspect_ratio = 0.75
      when 'ratio2_3'
        assign aspect_ratio = 0.66667
      when 'ratio1_2'
        assign aspect_ratio = 0.5
    endcase
  endif
-%}
{{ 'media-grid.css' | asset_url | stylesheet_tag }}
<section id="laber_{{sid}}" class="wow animate--slide-in">
  <div class="{%if layout_des%}full-width{% else %}container{%endif%}" style="--alo-container-width:{{ section.settings.container }}px;">
      {% if section.settings.title != blank %}
          <div class="wrap_title w_{{ section.settings.h_position }} {{ section.settings.text_size }} mb-30 sm:mb-20">
          <div
             class="h3 section-title text-transform {% if section.settings.cl_underline != 'rgba(0,0,0,0)' %}title-hr{% endif %}"
                style="
                  --cl-text:{{ section.settings.cl_title |default:"#333333" }};
                  --text-transform:{{ section.settings.text_transform }};
                --cl-underline:{{ section.settings.cl_underline }};
                "
            >
              <span>{{ section.settings.title }}</span>
            </div>
            {% if section.settings.content %}
              <div class="content">{{ section.settings.content }}</div>
            {% endif %}
          </div>
        {% endif %}

        <media-grid class="media-grid" style="--media-grid-column:{{ section.settings.column }};--alo-gap:{{ section.settings.gap }}px;">
          {%- if arr_img.size > 0 -%}
            {% assign offset = 0 -%}
            {%- for bl in arr_img -%}
              {% assign offset = offset | plus: 1 %}
              {% assign image = bl.settings.image -%}
              <article id="media-grid-{{ bl.id }}" class="media-item w-full h-full" style="--media-grid-column-span: {{ bl.settings.media-grid-column-span }}; --media-grid-row-span: {{ bl.settings.media-grid-row-span }};"> 
              <lookbook-pin class="w-full h-full" {{ bl.shopify_attributes }} style="--rounded:{{ border }}px;">
                <div class="pin__maker pr w-full h-full">
                  <div class="lookbock-image w-full h-full">
                    {% if image != blank %}
                      {% render 'responsive-image',
                        image: image,
                        aspect_ratio: aspect_ratio,
                        image_class: 'w-full h-full'
                      %}
                    {% else %}
                      {% if aspect_ratio != blank %}
                        {%- assign ratio = 1 | divided_by: aspect_ratio | times: 100 -%}
                      {% else %}
                        {%- assign ratio = 100 -%}
                      {% endif %}
                      <div
                        class="image-card__img overflow-hidden alo-border-radius ratio"
                        style="--ratio-percent: {{ ratio }}%;"
                      >
                        {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                        {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                      </div>
                    {% endif %}

                    {%- if section_blocks.size > 0 -%}
                      {%- for block in section_blocks offset: offset -%}
                        {%- if block.type == 'img' %}{% break %}{% endif -%}
                        {% assign offset = offset | plus: 1 -%}
                        {%- if block.type == 'pr' -%}
                          {%- if block.settings.product == blank %}{% continue %}{% endif -%}
                          <div
                            {{ block.shopify_attributes }}
                            class="pin__type pin__type_{{block.id}}  pin__type_pr pin__size--{{block.settings.pos_size}} pin_ic_{{block.settings.type}}"
                            style="--cl-text:{{ block.settings.cl_text }};--cl-border:{{ block.settings.cl_border }};"
                          >
                            <span class="zoompin"></span>
                          
                              <span class="pin_tt pin_tt_js dn db_mb">
                                {%- if block.settings.type != '2' -%}<i class="icon-plus"></i>{%- else -%}<span class="truncate">{{ block.settings.shorttxt }}</span>{%- endif -%}
                              </span>
                              <span
                                data-opennt="#pin_mfp_{{block.id}}"
                                data-ani="none"
                                data-class="mfp__pin"
                                class="pin_tt mfp_js dn_md"
                                >{%- if block.settings.type != '2' -%}<i class="icon-plus"></i>{%- else -%}<span class="truncate">{{ block.settings.shorttxt }}</span>{%- endif -%}
                              </span>
                           
                            <div id="pin_mfp_{{block.id}}">
                              {% # theme-check-disable %}
                              <div class="pin_lazy_js pin__popup--{{block.settings.pos_pin}} pin__popup--{{block.settings.effect}} lazyload" data-include="/products/{{block.settings.product}}/?view=lookbook"></div>
                              {% # theme-check-enable %}
                            </div>
                          </div>
                        {%- elsif block.type == 'txt' -%}
                          <div
                            {{ block.shopify_attributes }}
                            data-i="{{bl.id}}"
                            id="pin_{{block.id}}"
                            class="pin__type pin__type_{{block.id}}   pin__type_txt pin__size--{{block.settings.pos_size}}"
                            style="--cl-text:{{ block.settings.cl_text }};--cl-border:{{ block.settings.cl_border }};"
                          >
                            <span class="zoompin"></span>
                    
                              <span class="pin_tt pin_tt_js dn db_mb">
                                {%- if block.settings.type != '2' -%}<i class="icon-plus"></i>{%- else -%}<span class="truncate">{{ block.settings.shorttxt }}</span>{%- endif -%}
                              </span>
                               <span
                                data-opennt="#pin_mfp_{{block.id}}"
                                data-ani="none"
                                data-class="mfp__pin"
                                class="pin_tt mfp_js dn_md"
                                >{%- if block.settings.type != '2' -%}<i class="icon-plus"></i>{%- else -%}<span class="truncate">{{ block.settings.shorttxt }}</span>{%- endif -%}</span>
                           
                            <div id="pin_mfp_{{block.id}}">
                              <div class="pin__popup pin__popup--{{block.settings.pos_pin}} pin__popup--{{block.settings.effect}} ">
                                <div class="popup__title">{{ block.settings.heading }}</div>
                                <div class="popup__content">{{ block.settings.text }}</div>
                              </div>
                            </div>
                          </div>
                        {%- else -%}
                          <div
                            {{ block.shopify_attributes }}
                            data-i="{{bl.id}}"
                            id="pin_{{block.id}}"
                            class="pin__type pin__type_{{block.id}}  pin__type_url pin__size--{{block.settings.pos_size}}"
                            style="--cl-text:{{ block.settings.cl_text }};--cl-border:{{ block.settings.cl_border }};"
                          >
                            <span class="zoompin"></span>

                              <a
                                href="{{block.settings.url}}"
                                target="{{block.settings.open_link}}"
                                class="pin_tt cw"
                                >{%- if block.settings.type != '2' -%}<i class="icon-plus"></i>{%- else -%}<span class="truncate">{{ block.settings.shorttxt }}</span>{%- endif -%}</a>

                          </div>
                        {%- endif -%}

                        {%- style -%}
                          .pin__type_{{block.id}} {transform: translate(-{{block.settings.pos_l}}%, -{{block.settings.pos_t}}%);top:{{block.settings.pos_t}}%;left:{{block.settings.pos_l}}%}.pin__type_{{block.id}} .pin_tt{background-color: {{block.settings.bg_cl}}}.pin__type_{{block.id}} .zoompin{background-color: {{block.settings.bg_cl_br}};opacity:{{block.settings.bg_cl_br_opacity}};}
                        {%- endstyle -%}
                      {%- endfor -%}
                    {%- endif -%}
                  </div>
                </div>
              </lookbook-pin>
              </article>
            {%- endfor -%}
          {%- endif -%}
        </media-grid >
  </div>
</section>
<style>
    #laber_{{ sid}} {
    --media-grid-row-height: {{ section.settings.mobile_row_height }}px;
    }
    @media screen and (min-width: 1200px) {
      #laber_{{ sid }} {
        --media-grid-row-height: {{ section.settings.desktop_row_height }}px;
      }
    }
    @media only screen and (min-width: 768px) and (max-width: 1199px) {
      #laber_{{ sid }} {
        --media-grid-row-height: {{ section.settings.tablet_row_height }}px;
      }
    }
</style>
{{ 'lookbook.css' | asset_url | stylesheet_tag }}
{%- render 'section_style' -%}
