{% liquid
  assign sid = section.id
%}
{{ 'custom-section.css' | asset_url | stylesheet_tag }}
  <section id="laber_{{sid}}">
    <div class="container {% if section.settings.layout == "full-width"%}{{section.settings.layout}}{% endif %}">
      <div class="section_content ">
        <div class="part">
          <div class="row flex-wrap v_{{section.settings.v_position}}">
            {% render 'custom-section' %}
          </div>
        </div>
      </div>
    </div>
  </section>
{%- render 'section_style' -%}
