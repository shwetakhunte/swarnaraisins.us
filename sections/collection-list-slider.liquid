{% liquid
  assign sid = section.id 
  assign layout = section.settings.layout
  assign num_p_qty =  section.settings.num_p_qty
  assign se_blocks = section.blocks
  assign se_size = se_blocks.size
  assign space_between = section.settings.space-Between
  assign navigation = section.settings.navigation
  assign pagination = section.settings.pagination
  assign sett_equal = section.settings.use_eq_height
  assign image_ratio = section.settings.image_ratio
  if sett_equal
    case image_ratio
      when 'ratio2_1'
        assign aspect_ratio = 2.0
      when 'ratio3_2'
        assign aspect_ratio = 1.5
      when 'ratio4_3'
        assign aspect_ratio = 1.333
      when 'ratio1_1'
        assign aspect_ratio = 1.0
      when 'ratio3_4'
        assign aspect_ratio = 0.75
      when 'ratio2_3'
        assign aspect_ratio = 0.66667
      when 'ratio1_2'
        assign aspect_ratio = 0.5
      when 'custom'
        assign custom_ratio = section.settings.custom_ratio | split: '/'
        assign width = custom_ratio[0]
        assign height = custom_ratio[1] | times: 1.0
        assign aspect_ratio = width | divided_by: height
    endcase
  endif

  if section.settings['use-slider']
    assign use_slider = true
  else
    assign use_slider = false
  endif
%}
{{ 'section-collection.css' | asset_url | stylesheet_tag }}
<section id="laber_{{sid}}" class="wow animate--slide-in" style="--cl-border:{{ section.settings.cl_border }};">
  <div class="{% if layout %}full-width{% else %}container{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
    <div class="collection_featured  {% if section.settings.cl_bg_content != 'rgba(0,0,0,0)' %}alo-background-color alo-border-radius pd-20 py-20 sm:pd-10 sm:py-10 {% endif %}" style="{% if section.settings.cl_bg_content != 'rgba(0,0,0,0)' %}--bg-color:{{ section.settings.cl_bg_content  }}; {% endif %}">
      {% if section.settings.title != blank %}
        <div class="wrap_title sm:mb-10 w_{{ section.settings.h_position }} text_{{section.settings.txt_align}} mb-30 {{ section.settings.text_size }} ">
          {% if section.settings.subtitle != blank %}
            <div class="section-subtitle" style="--cl-text:{{ section.settings.cl_subtitle }};" bis_skin_checked="1">{{ section.settings.subtitle }}</div>
          {% endif %}
          <div class="h3 section-title " style="--cl-text:{{ section.settings.cl_title }};">{{section.settings.title}}</div>  
          {% if section.settings.content != blank %}
            <div class="content">{{section.settings.content}}</div>
          {% endif %}
        </div>
      {% endif %}
    <div class="collection_list_slider">
      {% # theme-check-disable %}
    {% include 'grid-slider', settings:section.settings %} 
    <grid-slider class="grid-slider {%if sett_equal%}{{image_ratio}} {%endif%}" {{gridSlider}} >
        <div class="swiper iSwiper" 
            {%- render 'skeleton', settings: section.settings -%} 
          style="--perload-gap: {{ space_between}}px" >
          <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
            {% assign index = 1 %} 
            {%- for block in section.blocks -%}
            <div class="swiper-slide" style="--animation-order:{{ index }}; --cl-border:{{ block.settings.cl_b }};--cl-bg:{{ block.settings.cl_bg }};--cl-border-h:{{ block.settings.cl_b_h }};--cl-bg-h:{{ block.settings.cl_bg_h }};"> 	
              {%- render 'cat-grid-item',block:block,num_p_qty:num_p_qty,aspect_ratio:aspect_ratio,for_i:se_size -%}
            </div> 
            {% assign index = index | plus: 1 %}
            {%- endfor -%}
          </div>
            {% if use_slider == true %}
            {% if navigation %}
              <div class="swiper-button">
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
              </div>
            {% endif %}
            {% if pagination %}
              <div class="swiper-pagination"></div>
            {% endif %}
          {% endif %}
          
        </div>
    </grid-slider>
      {% # theme-check-enable %}
    </div>     
  </div>
  </div>
</section>
{%- render 'section_style' -%} 
{% if use_slider == false %}
  {% style %}#laber_{{sid}} .swiper-slide{padding-bottom:{{space_between}}px; }{% endstyle %}
{% endif %}


