<style>
  .meticulous-section {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
    background-color: {{ section.settings.bg_color }};
  }
  .meticulous-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 50px;
  }
  .meticulous-left {
    flex: 1 1 50%;
    max-width: 50%;
    position: relative;
  }
  .meticulous-image-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .meticulous-image-wrapper img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  
  .meticulous-right {
    flex: 1 1 40%;
    max-width: 40%;
  }
  
  .meticulous-title {
    font-size: 56px;
    font-weight: 800;
    color: #6a0dad; /* Purple */
    margin-bottom: 20px;
    line-height: 1.1;
  }
  
  .meticulous-subtitle {
    font-size: 22px;
    color: #111;
    font-weight: 600;
    margin-bottom: 40px;
    line-height: 1.4;
  }
  
  .meticulous-divider {
    width: 100%;
    height: 3px;
    background-color: #2e7d32; /* Green */
    margin-bottom: 40px;
  }
  
  .meticulous-heading-2 {
    font-size: 32px;
    font-weight: 700;
    color: #6a0dad; /* Purple */
    margin-bottom: 20px;
    line-height: 1.2;
  }
  
  .meticulous-content {
    font-size: 18px;
    color: #111;
    line-height: 1.6;
  }
  .meticulous-content strong {
    font-weight: 700;
  }

  @media (max-width: 992px) {
    .meticulous-container {
      flex-direction: column;
    }
    .meticulous-left, .meticulous-right {
      flex: 1 1 100%;
      max-width: 100%;
    }
    .meticulous-title {
      font-size: 40px;
    }
    .meticulous-subtitle {
      font-size: 18px;
    }
    .meticulous-heading-2 {
      font-size: 26px;
    }
    .meticulous-content {
      font-size: 16px;
    }
  }
</style>

<div class="meticulous-section">
  <div class="meticulous-container">
    <div class="meticulous-left">
      <div class="meticulous-image-wrapper">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | img_url: 'master' }}" alt="{{ section.settings.title | escape }}">
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>
    
    <div class="meticulous-right">
      {% if section.settings.title != blank %}
        <h2 class="meticulous-title">{{ section.settings.title }}</h2>
      {% endif %}
      
      {% if section.settings.subtitle != blank %}
        <div class="meticulous-subtitle">{{ section.settings.subtitle }}</div>
      {% endif %}
      
      <div class="meticulous-divider"></div>
      
      {% if section.settings.heading_2 != blank %}
        <h3 class="meticulous-heading-2">{{ section.settings.heading_2 }}</h3>
      {% endif %}
      
      {% if section.settings.content != blank %}
        <div class="meticulous-content">
          {{ section.settings.content }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Meticulous Processing",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdfaf0"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Graphic Image (Left side)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Meticulous Processing"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "At Swarna Raisins, we turn grapes into golden delights."
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Secondary Heading",
      "default": "Real Raisins made by Real Farmers"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>From Our Farm, Straight to Your Soul – Natural Raisins, every raisin is a promise: <strong>natural, pure, and Ayurvedic-friendly.</strong></p>"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Meticulous Processing",
      "category": "Custom"
    }
  ]
}
{% endschema %}
