{%- liquid
  assign blog = blogs[section.settings.blog]
  assign sid = section.id 
  assign layout =section.settings.layout 
  assign space_between = section.settings.space-Between
  assign navigation = section.settings.navigation
  assign pagination = section.settings.pagination
  if section.settings['use-slider']
    assign use_slider = true
  else
    assign use_slider = false
  endif
  assign sett_equal = section.settings.use_eq_height
  assign image_ratio = section.settings.image_ratio
  if sett_equal
    case image_ratio
      when 'ratio2_1'
        assign aspect_ratio = 2.0
      when 'ratio3_2'
        assign aspect_ratio = 1.5
      when 'ratio4_3'
        assign aspect_ratio = 1.333
      when 'ratio5_6'
        assign aspect_ratio = 0.8333
      when 'ratio1_1'
        assign aspect_ratio = 1.0
      when 'ratio6_5'
        assign aspect_ratio = 1.2
      when 'ratio3_4'
        assign aspect_ratio = 0.75
      when 'ratio2_3'
        assign aspect_ratio = 0.66667
      when 'ratio1_2'
        assign aspect_ratio = 0.5
      when 'custom'
        assign custom_ratio = settings.custom_ratio | split: '/'
        assign width = custom_ratio[0]
        assign height = custom_ratio[1] | times: 1.0
        assign aspect_ratio = width | divided_by: height
    endcase
  endif
-%} 
{{ 'blog.css' | asset_url | stylesheet_tag }}
<section id="laber_{{sid}}" data-aos-duration="500" data-aos="fade-up">
    <div class="container {% if layout %}full-width{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
    <div class="alo-wrap-content {% if section.settings.cl_bg_content != 'rgba(0,0,0,0)' %}alo-background-color alo-border-radius pd-20 py-20 sm:pd-10 sm:py-10 {% endif %}" style="{% if section.settings.cl_bg_content != 'rgba(0,0,0,0)' %}--bg-color:{{ section.settings.cl_bg_content  }}; {% endif %}">   
  {% if section.settings.title != blank %}
      <div class="wrap_title w_{{ section.settings.h_position }} text_{{section.settings.txt_align}} {{ section.settings.text_size }} mb-30 sm:mb-20">
        {% if section.settings.subtitle != blank %}
            <div class="section-subtitle" style="--cl-text:{{ section.settings.cl_subtitle }};" bis_skin_checked="1">{{ section.settings.subtitle }}</div>
          {% endif %}
        <div
          class="h3 section-title alo-text-transform"
            style="
              --cl-text:{{ section.settings.cl_title }};
              --alo-text-transform:{{ section.settings.text_transform }};
            ">
          {{ section.settings.title }}
        </div>
        {% if section.settings.content %}
          <div class="content">
            {{ section.settings.content }}
          </div>
        {% endif %}
      </div>
    {% endif %}
    {% # theme-check-disable %}
    {% include 'grid-slider', settings:section.settings %} 
    <grid-slider class="grid-slider blog-slider" {{gridSlider}} style="--rounded:{{ section.settings.border }}px;">
        <div class="swiper iSwiper"
          {%- render 'skeleton', settings: section.settings -%}
          style="--perload-gap: {{ space_between}}px"
          >
          <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
            {%- if blog != blank -%}
                {%- for article in blog.articles -%}
                      {% assign image = article.image %}
                      {% assign url = article.url %}
                      <article class="swiper-slide post-item post_laber_loop">  
                        <div class="item">
                        {% if image != blank %} 
                        <div  class="images-card  w-full h-full overflow-hidden" >
                            {% render 'responsive-image', image: image ,aspect_ratio:aspect_ratio, image_class: 'w-full h-full alo-border-radius',url: url %}
                        </div>
                        {% endif %} 
                        <div class="post-info pt-20">
                             {%if section.settings.show-cate-blog%} <div class="blog"><a href="{{blog.url}}">{{blog.title}}</a></div>{% endif %}  
                             {%if section.settings.show-name-blog%}
                            <div class="head head-article">
                             
                              <div class="title_blog">
                                <h3>
                                  <a href="{{url}}" class="post-title">{{ article.title }}</a>
                                </h3>  
                              </div>
                            </div>
                            {%endif%}
                              <div class="meta-post">
                                {% if section.settings.show-date %}
                                <div class="item-meta inner-date">
                                  {% render 'icon-data' %}
                                  <p>
                                  <span class="day">{{ article.created_at | date: "%d" }}</span>
                                  <span class="month">{{ article.created_at | date: "%b" }}</span>
                                  </p>
                                </div>
                                {% endif %}
                                {% if section.settings.show-author %}<div class="item-meta author">{% render 'icon-login' %} <p><span>{{article.author}}</span></p></div>{% endif %}
                                {% if section.settings.show-comments %}<div class="item-meta comments">{% render 'icon-comment' %} <p><span>{{article.comments_count}} {{'blogs.article.comments' | t}} </span></p></div>{% endif %}
                              </div>
                            {%if section.settings.show-description%}
                            <div class="main-info-post">
                                {% if article.excerpt.size > 0 %}
                                {{ article.excerpt | strip_html | truncatewords: 25}}         
                                {% else %}
                                <div class="des"><p>{{ article.content | strip_html | truncatewords: 25}}</p></div>
                                {% endif %}   
                            </div>
                             
                            {%endif%}
                            {%if section.settings.show-read_more%}
                            <div class="read_more">
                              <a href="{{ article.url }}" title="{{ article.title }}">
                                {{'blogs.article.read_more' | t}}
                              </a>
                              
                            </div>
                            {%endif%}
                          </div>
                        </div>
                      </article>	
            	{%- endfor -%}
              {%- else -%}
                 {%- for i in (1..5) -%}
                   <article class="swiper-slide post-item post_laber_loop">
                     <div class="item">
                        {% if aspect_ratio != blank %}
                                 {%- assign ratio =  1 | divided_by: aspect_ratio | times: 100 -%}
                              {% else %}
                                  {%- assign ratio = 100 -%}
                              {% endif %}
                              <div class="image-card__img alo-border-radius image-blog img-demo overflow-hidden ratio" style="--ratio-percent: {{ ratio }}%;">
                                {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                                {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                                
                              </div>
                       <div class="post-info head head-article pt-20">
                         
                           {%if section.settings.show-cate-blog%} <div class="blog"><a href="#">Blog category </a></div>{% endif %} 
                         {%if section.settings.show-name-blog%}
                           <div class="title_blog">
                             <h3>
                               <a href="{{ routes.root_url }}" class="post-title">Avocado Grilled Salmon, Rich In Nutrients For The Body</a>
                             </h3>  
                           </div>
                           {% endif %} 
                         
                           <div class="meta-post">
                             {% if section.settings.show-date %}
                             <div class= "item-meta inner-date">
                                  {% render 'icon-data' %}
                                  <p>
                                 <span class="day">05</span>
                                 <span class="year">Feb</span>
                                  </p>
                               </div>
                             {% endif %}  
                             {%if section.settings.show-author%}<div class="item-meta author">{% render 'icon-login' %} <p><span>Alothemes</span></p></div>{% endif %}  
                            {%if section.settings.show-comments%} <div class="item-meta comments">{% render 'icon-comment' %} <p><span>10 {{'blogs.article.comments' | t}} </span></p></div>{% endif %}  
                           </div>
                        {%if section.settings.show-description%}
                           <div class="main-info-post">
                               <div class="des">These are the people who make your life easier. Egestas is tristique vestibulum...</div>                         
                           </div>
                        {% endif %}  
                       {%if section.settings.show-read_more%}
                         <div class="read_more">
                           <a href="#" title="read more">
                             Read more
                           </a>
                         </div>
                        {% endif %}
                       </div>
                     </div>
                   </article>
                 {%- endfor -%}
              {%- endif -%}
            </div>
            {% if use_slider == true %}
            {% if navigation %}
              <div class="swiper-button-next"></div>
              <div class="swiper-button-prev"></div>
            {% endif %}
            {% if pagination %}
              <div class="swiper-pagination"></div>
            {% endif %}
          {% endif %}
          </div>
        </grid-slider>
        {% # theme-check-enable %}  
        {% if section.settings.all_blogs %}
          <div class="bn_button viewall text-center pt-60">
            <a class="btn" href="{{blog.url | default :"#"}}">{{'blogs.article.view_all' | t}} </a>
          </div>
      {% endif %}
      </div>
    </div>
</section>

{%- render 'section_style' -%} 

