{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="customer account section-{{ section.id }}-padding">
<div class="main-content shop-page-account">
  <div class="container">
    <div class="container block-page-login">
      <div id="primary">
        <div class="row">
          <div class="col-lg-auto col-xs-12 col-sm-4 col-md-3 col-lg-3 ">
            <div class="wrapper_tabcontent customer sticky-sidebar">
              <h3>{{ 'customer.account.dashboard' | t }}</h3>

              <a href="{{routes.root_url}}checkout" class="btn btn--full checkout">
                {{- 'cart.general.checkout' | t -}}
              </a>
              <a class="btn btn--full view-address" href="{{routes.account_addresses_url }}">
                {{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})
              </a>
            

              <a class="btn btn--full view-address" href="{{routes.root_url}}pages/wishlist">
                <mini-wishlist>
                {{ 'general.wishlist.view' | t }}
                (<span class="header__counter count">0</span>)
                  </mini-wishlist>
              </a>
              <a href="{{routes.account_logout_url }}" class="btn  btn-link">
                {{ 'customer.login.sign_out' | t }}
              </a>
            </div>
          </div>
          <div class="account-content col ">
            <p class="title-customer">
              {{ 'customer.login.welcome' | t }}
              <span>{{ customer.name }}</span>
              ( {{ 'customer.logout.not' | t }}
              <span>{{ customer.name }} ?</span>
              <a href="{{routes.account_logout_url }}">{{ 'customer.logout.title' | t }}</a> )
            </p>
            <div class="order-history">
              <h3>{{ 'customer.orders.title' | t }}</h3>

              {% paginate customer.orders by 20 %}
                {%- if customer.orders.size > 0 -%}
                  <table role="table">
                    <thead role="rowgroup">
                      <tr role="row">
                        <th id="ColumnOrder" scope="col" role="columnheader">
                          {{ 'customer.orders.order_number' | t }}
                        </th>
                        <th id="ColumnDate" scope="col" role="columnheader">{{ 'customer.orders.date' | t }}</th>
                        <th id="ColumnPayment" scope="col" role="columnheader">
                          {{ 'customer.orders.payment_status' | t }}
                        </th>
                        <th id="ColumnFulfillment" scope="col" role="columnheader">
                          {{ 'customer.orders.fulfillment_status' | t }}
                        </th>
                        <th id="ColumnTotal" scope="col" role="columnheader">{{ 'customer.orders.total' | t }}</th>
                      </tr>
                    </thead>
                    <tbody role="rowgroup">
                      {%- for order in customer.orders -%}
                        <tr role="row">
                          <td
                            class="ColumnOrder"
                            id="RowOrder"
                            role="cell"
                            headers="ColumnOrder"
                            data-label="{{ 'customer.orders.order_number' | t }}"
                          >
                            <a
                              href="{{ order.customer_url }}"
                              aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}"
                            >
                              {{ order.name }}
                            </a>
                          </td>
                          <td
                            class="ColumnDate"
                            headers="RowOrder ColumnDate"
                            role="cell"
                            data-label="{{ 'customer.orders.date' | t }}"
                          >
                            {{ order.created_at | time_tag: format: 'date' }}
                          </td>
                          <td
                            class="ColumnPayment"
                            headers="RowOrder ColumnPayment"
                            role="cell"
                            data-label="{{ 'customer.orders.payment_status' | t }}"
                          >
                            {{ order.financial_status_label }}
                          </td>
                          <td
                            class="ColumnFulfillment"
                            headers="RowOrder ColumnFulfillment"
                            role="cell"
                            data-label="{{ 'customer.orders.fulfillment_status' | t }}"
                          >
                            {{ order.fulfillment_status_label }}
                          </td>
                          <td
                            class="ColumnTotal"
                            headers="RowOrder ColumnTotal"
                            role="cell"
                            data-label="{{ 'customer.orders.total' | t }}"
                          >
                            {{ order.total_price | money_with_currency }}
                          </td>
                        </tr>
                      {%- endfor -%}
                    </tbody>
                  </table>
                {%- else -%}
                  <p class="none">
                    <a href="{{routes.root_url}}collections/all">
                      <i class="icon-check"></i>
                      {{ 'customer.account.collections_all' | t }}
                    </a>
                    {{ 'customer.orders.none' | t }}
                  </p>
                {%- endif -%}

                {%- if paginate.pages > 1 -%}
                  {%- if paginate.parts.size > 0 -%}
                    <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
                      <ul role="list">
                        {%- if paginate.previous -%}
                          <li>
                            <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
                              <svg aria-hidden="true" focusable="false" viewBox="0 0 10 6">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                              </svg>
                            </a>
                          </li>
                        {%- endif -%}

                        {%- for part in paginate.parts -%}
                          <li>
                            {%- if part.is_link -%}
                              <a
                                href="{{ part.url }}"
                                aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                              >
                                {{- part.title -}}
                              </a>
                            {%- else -%}
                              {%- if part.title == paginate.current_page -%}
                                <span
                                  aria-current="page"
                                  aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                                >
                                  {{- part.title -}}
                                </span>
                              {%- else -%}
                                <span>{{ part.title }}</span>
                              {%- endif -%}
                            {%- endif -%}
                          </li>
                        {%- endfor -%}

                        {%- if paginate.next -%}
                          <li>
                            <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
                              <svg aria-hidden="true" focusable="false" viewBox="0 0 10 6">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                              </svg>
                            </a>
                          </li>
                        {%- endif -%}
                      </ul>
                    </nav>
                  {%- endif -%}
                {%- endif -%}
              {% endpaginate %}
            </div>
            <div class="account_details">
              <h3>{{ 'customer.account.account_details' | t }}</h3>
              <div class="row">
                {% for address in customer.addresses %}
                  <div class="table-res col-xs-12 col-sm-12 col-md-12 col-lg-12">
                    <table class="table">
                      <tbody>
                        <tr>
                          <td>
                            <span class="h3">{{ 'customer.account.name' | t }}</span>
                          </td>
                          <td>{{ address.name }}</td>
                        </tr>
                        <tr>
                          <td>
                            <span class="h3">{{ 'customer.account.country' | t }}</span>
                          </td>
                          <td>{{ address.country }}</td>
                        </tr>
                        <tr>
                          <td>
                            <span class="h3">{{ 'customer.account.email' | t }}</span>
                          </td>
                          <td>{{ customer.email }}</td>
                        </tr>
                        <tr>
                          <td>
                            <span class="h3">{{ 'customer.account.phone' | t }}</span>
                          </td>
                          <td>{{ address.phone }}</td>
                        </tr>
                        <tr>
                          <td>
                            <span class="h3">{{ 'customer.account.city' | t }}</span>
                          </td>
                          <td>{{ address.city }}</td>
                        </tr>
                        <tr>
                          <td>
                            <span class="h3">{{ 'customer.account.zip' | t }}</span>
                          </td>
                          <td>{{ address.zip }}</td>
                        </tr>

                        <tr>
                          <td>
                            <span class="h3">{{ 'customer.account.address' | t }}</span>
                          </td>
                          <td>{{ address.address1 }}</td>
                        </tr>
                        <tr>
                          <td>
                            <span class="h3">{{ 'customer.account.address2' | t }}</span>
                          </td>
                          <td>{{ address.address2 }}</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</div>

{% schema %}
{
  "name": "t:sections.main-account.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
