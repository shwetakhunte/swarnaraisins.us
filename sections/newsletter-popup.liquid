{{ 'newsletter-popup.css' | asset_url | stylesheet_tag }}
    {% assign max_width = section.settings.max_width %}
    {% assign bg_color = section.settings.bg_color %}
    <newsletter-popup
      id="{{ section.id }}"
      style="
      --max-width:{{ max_width }}px;
      --item-width:{{ max_width | divided_by: 2 }}px;
      --bg-color:{{- bg_color -}}; 
      --rounded:{{ section.settings.border }}px;"
    >
      <dialog-modal>
        <template>
          <dialog
            class="newsletter-popup"
            modal-mode="mega"
            data-match-media="(min-width: 768px)"
            data-autoplay="{{section.settings.timeout | times: 1000}}"
            data-cookie="newsletter-popup"
            data-expires="{{section.settings.day_next}} "
            data-destroy="true"
          >
            <dialog-content>
            <div class="popup_content">
              <div class="row">
                {% assign image = section.settings.bg_newsletter %}
                <div class=" images-newslette col-xs-12 col-sm-12  col-md-6 col-lg-6">
                  {% if image != blank %}
                    {% render 'image', image: image, width: 1024, class: 'w-full h-full' %}
                  {% else %}
                    <div
                      class="image-card__img overflow-hidden alo-border-radius ratio"
                      style="--ratio-percent: {{ 100 }}%;"
                    >
                      {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                      {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                    </div>
                  {% endif %}
                </div>

                <div class=" content col-xs-12 col-sm-12  col-md-6 col-lg-6">
                  <div class="wrap-newslette-popup">
                    <div class="title_newslette">
                      <h3>
                        {{ section.settings.title_newslette }}
                      </h3>
                    </div>
                    <div class="desc">
                      {{ section.settings.description }}
                    </div>
                    <form
                      method="post"
                      action="{{settings.newsletter_form_action}}"
                      class="newsletter-form-footer"
                      autocomplete="on"
                    >
                      <div class="signup-newsletter-form">
                        <div class="col_email">
                          <input
                            type="email"
                            name="EMAIL"
                            placeholder="{{section.settings.placeholder_newsletter}}"
                            value="{% if customer %}{{ customer.email }}{% endif %}"
                            class="input-text"
                            required="required"
                          >
                        </div>
                        <div class="col-auto">
                          <button type="submit" class="btn btn-theme">{{ section.settings.button_newsletter }}</button>
                        </div>
                      </div>
                    </form>
                    <div class="do-not-show-again checkbox clearfix">
                      <input id="do-not-show" name="do-not-show" type="checkbox">
                      <label for="do-not-show">{{ section.settings.no_show_popup_again }}</label>
                    </div>
                  </div>
                </div>
              </div>
            </div>
              </dialog-content>
          </dialog>
        </template>
      </dialog-modal>
    </newsletter-popup>
{%- schema -%}
{
  "name": "Newsletter popup",
  "settings": [
 {
      "type": "paragraph",
      "content": "Only visible on desktop."
    },
    {
      "type": "header",
      "content": "== Newsletter Settings"
    },
    {
    "type": "image_picker",
    "id": "bg_newsletter",
    "label":"background image"
    },
    {
    "type": "color",
    "id": "bg_color",
    "label": "Background color",
    "default": "#ffffff"
    },
    {
    "type": "text",
    "id": "title_newslette",
    "label": "Title newslette",
    "default":"Subcribe To Our Newsletter"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
    "default": "<p>Sign up for our newsletter to be updated on the latest  designs, exclusive offers, inspiration and tip!</p>"
    },
    {
      "type": "text",
      "id": "placeholder_newsletter",
      "label": "Placeholder of newsletter",
"default":"Your email address"
    },
 {
      "type": "text",
      "id": "button_newsletter",
      "label": "Button of newsletter",
"default":"Subscribe"
    },
 {
      "type": "text",
      "id": "no_show_popup_again",
      "label": "Don't show this popup again",
"default":"Don't show this popup again"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 500,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Max width",
      "default": 860
    },
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "range",
      "id": "border",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Border",
      "default": 0
    },
    {
      "type": "range",
      "id": "timeout",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "sec",
      "label": "Delay time (second)",
      "default": 15
    },
    {
      "type": "header",
      "content": "Show popup after Settings"
    },
    {
      "type": "range",
      "id": "day_next",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "Day",
      "label": "Day next show (n)",
      "info": "if customer close the popup, next show will be after 'n' Day",
      "default": 1
    }
  ]
}
{%- endschema -%}
