{% liquid
  assign sid = section.id 
  assign layout = section.settings.layout
  assign products_count = section.settings.products_count
  

  assign space_between = section.settings.space-Between
  assign navigation = section.settings.navigation
  assign pagination = section.settings.pagination

  if section.settings['use-slider']
    assign use_slider = true
  else
    assign use_slider = false
  endif
  
%}
{{ 'section-link.css' | asset_url | stylesheet_tag }}
<section id="laber_{{sid}}" class="alo-section-link" style="--cl-border:{{ section.settings.cl_border }};">
  <div class=" {% if layout %}full-width{% else %}container{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
    <div class="menu_featured ">
      {% if section.settings.title != blank %}
        <div class="wrap_title w_{{ section.settings.h_position }} text_{{section.settings.txt_align}} {{ section.settings.text_size }} mb-30 sm:mb-20 ">
            <div
              class="h3 section-title text-transform"
                style="
                  --cl-text:{{ section.settings.cl_title |default:"#333333" }};
                  --text-transform:{{ section.settings.text_transform }}
                "
            >
            {{ section.settings.title }}
          </div>
          {% if section.settings.content != blank %}
            <div class="content">{{ section.settings.content }}</div>
          {% endif %}
        </div>
      {% endif %}

          <div class="menu-list-featured">
            {% # theme-check-disable %}

    {% include 'grid-slider', settings:section.settings %} 
    <grid-slider class="grid-slider {%if sett_equal%}{{image_ratio}} {%endif%}" {{gridSlider}} >
        <div class="swiper iSwiper" 
            {%- render 'skeleton', settings: section.settings -%} 
          style="--perload-gap: {{ space_between}}px" >
          <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
          {%- for block in section.blocks -%}
      		<article class="swiper-slide item-menu"> 	
            {%- render 'item-menu',block:block ,products_count:products_count-%}
            </article> 
          {%- endfor -%}
          </div>
            {% if use_slider == true %}
            {% if navigation %}
              <div class="swiper-button">
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
              </div>
            {% endif %}
            {% if pagination %}
              <div class="swiper-pagination"></div>
            {% endif %}
          {% endif %}
          
        </div>
    </grid-slider>
  {% # theme-check-enable %}
    </div>
      
  </div>
  </div>  
</section>
{%- render 'section_style' -%} 
{%- schema -%}
