        },
        {
            "type": "number",
            "id": "qty_items",
            "label": "Minimum quantity of items",
            "default": 2
        },
        {
          "type": "select",
          "id": "value",
          "default": "1",
          "options": [
            {
              "value": "1",
              "label": "Percentage"
           },
           {
              "value": "2",
              "label": "Fixed amount"
           }
          ],
          "label": "Value"
        },
        {
          "type": "text",
          "id": "percent",
          "label": "Percentage"
        },
        {
          "type": "text",
          "id": "amount",
          "label": "Fixed amount"
        }
      ]
    }
  ],
  "settings": [
    {
    "type": "text",
    "id": "title",
    "label": "Heading",
    "default": "Frequently Bought Together"
  },
    {
   "type": "color",
   "id": "cl_title",
   "label": "Color title",
   "default": "#333"
   },
   {
    "type": "select",
    "id": "text_size",
    "default": "medium",
    "options": [
      {
        "value": "small",
        "label": "small"
     },
     {
        "value": "medium",
        "label": "Medium"
     },
     {
        "value": "large",
        "label": "Large"
      }
    ],
    "label": "Text size"
  },
  {
          "type": "select",
          "id": "text_transform",
          "default": "none",
          "options": [
           {
              "value": "none",
              "label": "None"
           },
           {
              "value": "capitalize",
              "label": "Capitalize"
           },
           {
              "value": "lowercase",
              "label": "Lowercase"
           },
           {
              "value": "uppercase",
              "label": "Uppercase"
            }
          ],
          "label": "Text transform:"
        },
{
    "type": "checkbox",
    "id": "product-main-require",
    "label": "Product main require?",
    "default": true
},

    {
