{{ 'product-bought-together.css' | asset_url | stylesheet_tag }}
{% liquid
  assign sid = section.id
  assign space_between = section.settings['space-Between']
  assign navigation = section.settings.navigation
  assign pagination = section.settings.pagination

  if section.settings['use-slider']
    assign use_slider = true
  else
    assign use_slider = false
  endif

  assign bought_together = product.metafields.custom.bought_together
  assign product_bogether = bought_together.value
%}
{% if product_bogether != blank %}
  <section id="laber_{{sid}}" style="--rounded:{{ section.settings.border }}px; --alo-gap:{{ space_between }}px;">
    <bought-together data-product-main-require="true">
      {% if section.settings.title != blank %}
        <div
          class="wrap_title mb-30 sm:mb-20 {{ section.settings.text_size }}"
        >
          <h3
            class="section-title alo-text-transform"
            style="
              --cl-text:{{ section.settings.cl_title |default:"#333333" }};
              --alo-text-transform:{{ section.settings.text_transform }}
            "
          >
            {{ section.settings.title }}
          </h3>
        </div>
      {% endif %}
      <div class="bought-together">
        <div class="product-bought-together">
          <div class="products-arrivals ">
            <div class="section-content">
              {% # theme-check-disable %}
              <script class="data-json-discounts" type="application/json">
                {{ discounts | json }}
              </script>
              {% include 'grid-slider', settings: section.settings %}
              <grid-slider class="grid-slider" {{ gridSlider }}>
                <div
                  class="swiper iSwiper"
                  {%- render 'skeleton', settings: section.settings -%}
                  style="--perload-gap: {{ space_between}}px"
                >
                  <div class="swiper-wrapper {% if use_slider== false %}flex-wrap{% endif %}">
                    {% render 'product-bought-together',
                      section: section,
                      product: product,
                      classes: 'bought-together-main'
                    %}
                    {% liquid
                      assign total_price = product.price
                      assign total_compare_price = product.compare_at_price | default: product.price
                      for item in product_bogether
                        assign total_price = item.price | plus: total_price
                        assign total_compare_price = item.compare_at_price | default: item.price | plus: total_compare_price
                        render 'product-bought-together', product: item
                      endfor
                    %}
                  </div>
                  {% if use_slider == true %}
                    {% if navigation %}
                      <div class="swiper-button-next"></div>
                      <div class="swiper-button-prev"></div>
                    {% endif %}
                    {% if pagination %}
                      <div class="swiper-pagination"></div>
                    {% endif %}
                  {% endif %}
                </div>
              </grid-slider>
              {% # theme-check-enable %}
            </div>
          </div>
        </div>
        <div class="info-bought-together {% if total_compare_price <= total_price %}hidden-save{% endif %}">
          {% if section.blocks.size > 0 %}
            {% assign items = product_bogether.count | plus: 1 %}
            <div class="alo-discount-announcement discount-items-{{ items }}">
              {%- for block in section.blocks -%}
                {% assign qty_item = block.settings.qty_items %}
                {% assign value = block.settings.value | plus: 0 %}
                {% if value == 1 %}
                  {% assign discount = block.settings.percent %}
                {% else %}
                  {% assign discount = block.settings.amount | money %}
                {% endif %}
                <div class="alo-discount qty_item_{{ qty_item }}  {% if items != qty_item%}hidden{%endif%}">
                  <div class="discount_announcement">
                    <p>
                      {% render 'icon-discount' %}
                      {{
                        'sections.products-bought-together.discount_announcement_html'
                        | t: qty_item: qty_item, value: discount
                      }}
                    </p>
                    <p>{{ 'sections.products-bought-together.announcement' | t }}</p>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {% endif %}

          <div class="total-price">{{ 'sections.products-bought-together.total' | t }}</div>
          <div class="total-product-price">
            <div class="price price-regular">
              <span class="compare-price">{{ total_compare_price | money }}</span>
            </div>
            <div class="price price-special">
              <span class="special-price">{{ total_price | money }}</span>
            </div>
          </div>
          <button class="add-bought-together btn">
            <span class="label">{{ 'sections.products-bought-together.Add_selected_item' | t }}</span>
          </button>
          <div class="save-cost">
            <span class="label">{{ 'sections.products-bought-together.You_are_saving' | t }}</span>
            <span class="save-price">{{ total_compare_price | minus: total_price | money }}</span>
          </div>
        </div>
      </div>
    </bought-together>
  </section>
  {%- render 'section_style' -%}
{% endif %}
{%- schema -%}
{
  "name": "Products Bought Together",
  "class": "alo-bought-together",
    	"blocks": [
    {
      "type": "discount",
      "name": "Discount announcement",
      "settings": [
