{{ 'testimonials.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign sid = section.id
  assign layout = section.settings.layout
  assign space_between = section.settings.space-Between
  assign navigation = section.settings.navigation
  assign pagination = section.settings.pagination

  if section.settings['use-slider']
    assign use_slider = true
  else
    assign use_slider = false
  endif
  
 %}
{%- for i in (1..1) -%}    
<section id="laber_{{sid}}" data-aos-duration="500" data-aos="fade-up">
  <div class=" {% if layout %}full-width{% else %}container{% endif %}" style="--rounded:{{ section.settings.border }}px;--alo-container-width:{{ section.settings.container }}px;">
    <div class="testimonial-wrapper {% if section.settings.cl_bg_content != 'rgba(0,0,0,0)' %}alo-background-color alo-border-radius pd-20 py-20 sm:pd-10 sm:py-10 {% endif %}" style="{% if section.settings.cl_bg_content != 'rgba(0,0,0,0)' %}--bg-color:{{ section.settings.cl_bg_content  }}; {% endif %}">
      {% if section.settings.title != blank %}
        <div class="wrap_title w_{{ section.settings.h_position }} text_{{section.settings.txt_align}} {{ section.settings.text_size }} mb-30 sm:mb-20 ">
            <div
              class="h3 section-title text-transform"
                style="
                  --cl-text:{{ section.settings.cl_title |default:"#333333" }};
                  --text-transform:{{ section.settings.text_transform }}
                "
            >
            {{ section.settings.title }}
          </div>
          {% if section.settings.content != blank %}
            <div class="content">{{ section.settings.content }}</div>
          {% endif %}
        </div>
      {% endif %}
        <div  class="quotes_wrapper ">
          {%- if section.blocks.size > 0 -%}         
            {% # theme-check-disable %}

          {% include 'grid-slider', settings:section.settings %} 
          <grid-slider class="grid-slider show-tooltip blog-slider {%if sett_equal%}{{image_ratio}} {%endif%}" {{gridSlider}} >
            <div class="swiper iSwiper"
            {%- render 'skeleton', settings: section.settings -%}
            style="--perload-gap: {{ space_between}}px"
            >
              <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                  {% assign index = 1 %} 
                  {%- for block in section.blocks -%}
                	{%- case block.type -%}
                	{%- when 'quote' -%}	
                    <div class="quote_slide swiper-slide scroll-trigger" style="--animation-order:{{ index }};">
                      <div class="quote_content" style="--alo-background:{{ block.settings.cl_bg }};">
                         
                            <div class="testimonial_{{index}} testimonial_avatar">	
                          <div  class="quote_avatar alo-border-radius overflow-hidden {% if forloop.first%} active {% endif %} mb-10" style="--rounded:100%;" >    
                          {%assign image = block.settings.image %}
                          {% if image != blank %}
                          {% render 'responsive-image',
                            image: image,
                            image_class: 'w-full h-full '
                          %}
                         {% else %}
                          <div class="image-card__img overflow-hidden ratio" style="--ratio-percent: 100%;">
                            {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                            {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                          </div>
                        {% endif %}
                        </div>
                        <div class="cms_content_quote mb-20">
                          {{block.settings.content}}
                          </div>
                         {%- if block.settings.rating >= 1 -%}
                          {%- case block.settings.rating -%}
                          {%- when 1 -%}{% assign class = ', _outline,_outline,_outline,_outline,dn' %}
                          {%- when 1.5 -%}{% assign class = ',_half pr,_outline,_outline,_outline,_outline' %}
                          {%- when 2 -%}{% assign class = ',, _outline,_outline,_outline,dn' %}
                          {%- when 2.5 -%}{% assign class = ',,_half pr,_outline,_outline,_outline' %}
                          {%- when 3 -%}{% assign class = ',,, _outline,_outline,dn' %}
                          {%- when 3.5 -%}{% assign class = ',,,_half pr,_outline,_outline' %}
                          {%- when 4 -%}{% assign class = ',,,, _outline,dn' %}
                          {%- when 4.5 -%}{% assign class = ',,,,_half pr,_outline' %}
                          {%- else -%}{% assign class = ',,,,,dn' %}
                          {%- endcase -%}
                          {% assign arr = class | split:',' %}
                          <div class="quote_rating mb-20 cra rating_{{block.settings.rating}}">
                              <i class="icon-star{{arr[0]}}"></i>
                              <i class="icon-star{{arr[1]}}"></i>
                              <i class="icon-star{{arr[2]}}"></i>
                              <i class="icon-star{{arr[3]}}"></i>
                              <i class="icon-star{{arr[4]}}"></i>
                          </div>
                        {%- endif -%}      
                        <div>
                          <div class="quote_author mb-10">{{block.settings.title}}</div>
                          <div class="quote_address">{{block.settings.address}}</div>
                        </div>
                        </div>
                      </div>
                    </div>
                	{%endcase%}
                    {% assign index = index | plus: 1 %}
                  {%- endfor -%} 
                </div>
                {% if use_slider == true %}
                {% if navigation %}
                  <div class="swiper-button-next"></div>
                  <div class="swiper-button-prev"></div>
                {% endif %}
                {% if pagination %}
                  <div class="swiper-pagination"></div>
                {% endif %}
              {% endif %} 
            </div>
          	</grid-slider>
            {% # theme-check-enable %}
          {%- endif -%}
        </div>
       {% if section.settings.show_text_bottom %} <div class="text_bottom ">{{ section.settings.text_bottom }}</div>{% endif %}
      </div>
  </div>
    </section>
{%- endfor -%}
{%style%}

	
{%endstyle%}
{%- render 'section_style' -%}
{%- schema -%}
  {
    "name": "Testimonials",
    "class": "type_testimonials type_carousel",
    "max_blocks": 30,
    "settings": [
