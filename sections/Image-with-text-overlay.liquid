{% liquid
  assign sid = section.id 
  assign layout = section.settings.layout
  assign section_blocks = section.blocks
  assign arr_blocks_img = section_blocks | where: "type", 'banner_img'
  assign img_size = arr_blocks_img.size | plus:0
  assign index = 1
%}
<section id="laber_{{sid}}" class="wow animate--slide-in">
  <div class="{% if layout %}full-width{% else %}container{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
    	{% if img_size > 0 %} 
            {%- for block in arr_blocks_img -%}
                {% if block.type == 'banner_img' %}
                    {% assign image = block.settings.image_sl %}
                    {% assign image_mobile = block.settings.image_sl_mobile | default: block.settings.image_sl %}
                    {% assign url = block.settings.link_img %}
                    {% assign open_link = block.settings.open_link %} 
                    <div id="laber_{{block.id}}" class="banner-card laber_banner">
                        <div class="content-item relative alo-border-radius overflow-hidden" style="--rounded:{{ section.settings.b_image }}px;">
                          <div  class="images-card w-full h-full " style="--alo-height-pc:{{ section.settings.h_des }}px; --alo-height-tb:{{ section.settings.h_tb }}px;--alo-height-mb:{{ section.settings.h_mb }}px" {{ block.shopify_attributes }}>
                          
                          {% if image != blank %} 
                            {% render 'banner-image', image: image, image_class: 'w-full h-full sm:d-none',url: url,open_link:open_link %}
                            {% if image_mobile != blank %}
                              {% render 'banner-image', image: image_mobile, image_class: 'w-full h-full d-none sm:d-block',url: url,open_link:open_link %}
                            {% endif %}  
                          {% else %}
                            <div class="image-card__img absolute  inset-0 w-full h-full ">
                                {{ 'image' | placeholder_svg_tag: 'placeholder-svg w-full h-full object-cover ' }}
                            </div>
                          {% endif %}
                          
                            <div class="w-full h-full events-none banner_content banner_text_{{block.id}}" {%if block.settings.hidden_content %}style="display:none;"{%endif%}>
                            <div class="w-full h-full flex relative banner_text h_{{block.settings.h_position}} v_{{block.settings.v_position}} text_{{block.settings.txt_align}}"> 
                            <div class="content_banner" style="--alo-width-content:{{ block.settings.w_content }}%;--alo-background:{{ block.settings.bg_content }};">
                                  {% for block in section_blocks offset:index %}
                                  {% assign index = index|plus:1 %}                          		
                                  {%- case block.type -%}
                                      {% when 'hd' %}
                                        <h3 id="b_{{block.id}}" class="banner_title_h3 {% if block.settings.hide %} d-none{% endif %}" {{ block.shopify_attributes }}>                             
                                          {% assign somearray = block.settings.title | split: ' ' %} 
                                          {% assign pos = block.settings.custom_mark %}
                                          {% assign index_mark  = 0 %}
                                          {% for item in somearray %}
                                          {% assign index_mark  = index_mark | plus: 1 %} 
                                          <span  class="{% if block.settings.first_mark and forloop.first %}first {% endif %}{% if pos contains index_mark %}marked{% endif %}{% if block.settings.last_mark and forloop.last %}last {% endif %}" > 
                                            {{item}}
                                            </span>
                                          {% endfor %}                             
                                        </h3>
                                      {% when 'subhd' %}
                                        <h5 id="b_{{block.id}}" class="banner_title_h5 {% if block.settings.hide %} d-none{% endif %}" {{ block.shopify_attributes }}>
                                          {% assign somearray = block.settings.title | split: ' ' %}                             
                                          {% assign pos = block.settings.custom_mark %}
                                          {% assign index_mark  = 0 %}
                                          {% for item in somearray %}
                                          {% assign index_mark  = index_mark | plus: 1 %} 
                                          <span  class="{% if block.settings.first_mark and forloop.first %}first {% endif %}{% if pos contains index_mark %}marked{% endif %}{% if block.settings.last_mark and forloop.last %}last {% endif %}" > 
                                              {{item}} 
                                          </span>
                                          {% endfor %}   
                                        </h5>
                                      {% when 'txt' %}
                                          <div id="b_{{block.id}}" class="slide_item_p {% if block.settings.hide %} d-none{% endif %}">
                                              <p  {{ block.shopify_attributes }}>{{block.settings.title}}</p> 
                                          </div>
                                    {% when 'btn' %}
                                      {% if block.settings.button_label != blank %}
                                          <div id="b_{{block.id}}" class="btn-image events-auto alo-btn mb-{{ block.settings.mg_bottom }} sm:mb-{{ block.settings.mobile_mg_bottom }}">
                                            <a class="btn alo-letter-spacing text-transform {{ block.settings.button_style }} {{ block.settings.button_size }}" href="{{ url | default:'#' }}" title="{{ block.settings.button_label }}" 
                                              style="
                                                --rounded-btn:{{ block.settings.border }}px;
                                                --alo-letter-spacing{{ block.settings.ls_text }};
                                                --text-transform:{{ block.settings.text_transform }};
                                                --cl-btn-text:{{ block.settings.cl-btn }};
                                                --cl-btn-text-h:{{ block.settings.cl-btn-h }};
                                                --bg-btn:{{ block.settings.bg-btn }};
                                                --cl-b-btn:{{ block.settings.bg-btn }};
                                                --bg-btn-h:{{ block.settings.bg-btn-h }};
                                                --cl-b-btn-h:{{ block.settings.bg-btn-h }}
                                              ">
                                              {{- block.settings.button_label -}}
                                            </a>
                                          </div>
                                        {% endif %}
                              
                                  {% else %} 
                                  {%- break -%}
                                  {%- endcase -%}
                                  {%- endfor -%}
                            </div>
                            </div>
                          </div>
                          </div>
                      </div>
                    </div>

                {%endif%}
            {%endfor%}
    	{%endif%}
    	
  </div>
</section>
{%- render 'section_style' -%}
{%- capture banner_style -%}
	{%- if section_blocks.size > 0 %}
      {%- for block in section_blocks -%}
        {%- assign id = block.id -%}
        {%- assign type = block.type -%}
        {%- case type -%} 
			{% when 'hd' %}
			.type_banner .laber_banner .banner_text h3#b_{{id}}{
				margin-bottom:{{block.settings.mg_bottom}}px;
                text-transform:{{block.settings.text_transform}}; 
                letter-spacing:{{block.settings.ls_text}}; 
                {% if block.settings.lh_text >0 %}line-height:{{block.settings.lh_text}}px; {% endif %} 
                font-size:{{block.settings.fs_text}}px; 
                color:{{block.settings.color}}; 
                font-weight:{{block.settings.fw_text}};
				
			}
            .type_banner .laber_banner .banner_text h3#b_{{id}} span.first ,
            .type_banner .laber_banner .banner_text h3#b_{{id}} span.marked,
            .type_banner .laber_banner .banner_text h3#b_{{id}} span.last {
              color:{{block.settings.color_mark}}; 
            }
            @media (max-width: 1024px) {
				.type_banner .laber_banner .banner_text h3#b_{{id}}{
					font-size:{{block.settings.mobile_font_text}}px;
					margin-bottom:{{block.settings.mobile_mg_bottom}}px;
				}
          	}

            {% when 'txt' %}
              .type_banner .laber_banner .banner_text div#b_{{id}} p{
                  margin-bottom:{{block.settings.mg_bottom}}px; 
                  letter-spacing:{{block.settings.ls_text}}; 
				  text-transform:{{block.settings.text_transform}}; 
                  {% if block.settings.lh_text >0 %}line-height:{{block.settings.lh_text}}px; {% endif %} 
                  font-size:{{block.settings.fs_text}}px; 
                  color:{{block.settings.color}}; 
                  font-weight:{{block.settings.fw_text}};
              }
              @media (max-width: 1024px) {
                  .type_banner .laber_banner .banner_text div#b_{{id}} p{
                      font-size:{{block.settings.mobile_font_text}}px;
                      margin-bottom:{{block.settings.mobile_mg_bottom}}px;
                  }
              }	
        {%endcase%}
      {%- endfor -%}
	{%- endif -%}
{%- endcapture -%}

{% style%}
{{ banner_style | strip_newlines | remove:"  "}}
{% endstyle%}

