{%- liquid
  assign section_blocks = section.blocks
  assign sid = section.id 
  assign layout =section.settings.layout 
  assign sett_equal = section.settings.use_eq_height
  assign image_ratio = section.settings.image_ratio
  if sett_equal
    case image_ratio
      when 'ratio2_1'
        assign aspect_ratio = 2.0
      when 'ratio3_2'
        assign aspect_ratio = 1.5
      when 'ratio4_3'
        assign aspect_ratio = 1.333
      when 'ratio5_6'
        assign aspect_ratio = 0.8333
      when 'ratio1_1'
        assign aspect_ratio = 1.0
      when 'ratio6_5'
        assign aspect_ratio = 1.2
      when 'ratio3_4'
        assign aspect_ratio = 0.75
      when 'ratio2_3'
        assign aspect_ratio = 0.66667
      when 'ratio1_2'
        assign aspect_ratio = 0.5
      when 'custom'
        assign custom_ratio = settings.custom_ratio | split: '/'
        assign width = custom_ratio[0]
        assign height = custom_ratio[1] | times: 1.0
        assign aspect_ratio = width | divided_by: height
    endcase
  endif
-%} 
{{ 'blog.css' | asset_url | stylesheet_tag }}
<section class="wow animate--slide-in">
    <div class="container {% if layout %}full-width{% endif %}" style="--rounded:{{ section.settings.border }}px;--alo-container-width:{{ section.settings.container }}px;">
      {% if section.settings.title != blank %}
        <div class="wrap_title w_{{ section.settings.h_position }} text_{{section.settings.txt_align}} {{ section.settings.text_size }} mb-30 sm:mb-20">
          <div
            class="h3 section-title alo-text-transform {% if section.settings.cl_underline != 'rgba(0,0,0,0)' %}title-hr{% endif %}"
              style="
                --cl-text:{{ section.settings.cl_title }};
                --alo-text-transform:{{ section.settings.text_transform }};
                --cl-underline:{{ section.settings.cl_underline }}
              "
          >
            <span>{{ section.settings.title }}</span>
          </div>
          <div class="content">
            {{ section.settings.content }}
          </div>
          {% if section.settings.use-all-blog %}
            <div class="bn_button viewall text-center">
              <a href="{{blog.url | default :"#"}}">{{'blogs.article.view_all' | t}} </a>
            </div>
        {% endif %}
        </div>
      {% endif %}
    </div>
<div id="laber_{{sid}}">
    <div class="container {% if layout %}full-width{% endif %}" style="--rounded:{{ section.settings.border }}px;--alo-container-width:{{ section.settings.container }}px;">
    <div class="alo-wrap-content">   
    <home-article class="blog-slider">
            {%- if section_blocks != blank -%}
                {%- for block in section_blocks -%}
                    {% assign blog = blogs[block.settings.blog] %}
                     {% assign article = block.settings.article %}
                      {% if article != blank %}
                      <article  class="swiper-slide post-item mb-60 sm:mb-30">  
                        <div id="bk_{{ block.id }}">
                        <div class="item">
                        {% if article.image != blank %} 
                        <div  class="images-card image-blog alo-border-radius w-full h-full overflow-hidden" >
                            {% render 'responsive-image', image: article.image ,aspect_ratio:aspect_ratio, image_class: 'w-full h-full',url: article.url %}
                        </div>
                        {% endif %} 
                        <div class="post-info">
                            <div class="blog"><a href="{{blog.url}}">{{blog.title}}</a></div>
                            <div class="head head-article">
                              
                              <div class="title_blog">
                                <h3>
                                  <a href="{{article.url}}" class="post-title">{{ article.title }}</a>
                                </h3>  
                              </div>
                            </div>
                            <div class="meta-post">
                                {% if section.settings.show-date %}
                                <div class="item-meta inner-date">
                                  <p>
                                  <span class="day">{{ article.created_at | date: "%d" }}</span>
                                  <span class="month">{{ article.created_at | date: "%b" }}</span>
                                  </p>
                                </div>
                                {% endif %}
                                {% if section.settings.show-author %}<div class="item-meta author"> <p><span>{{article.author}}</span></p></div>{% endif %}
                                {% if section.settings.show-comments %}<div class="item-meta comments"> <p><span>{{article.comments_count}} {{'blogs.article.comments' | t}} </span></p></div>{% endif %}
                                <div class="read_more">
                                  <a href="{{ article.url }}" title="{{ article.title }}">
                                    {{'blogs.article.read_more' | t}}
                                  </a>
                                </div>
                              </div>
                          </div>
                        </div>
                        </div>
                      </article>	
                        {% else %}
                         <article class="swiper-slide post-item mb-60 sm:mb-30">
                           <div id="bk_{{ block.id }}">
                           <div class="item">
                              {% if aspect_ratio != blank %}
                                       {%- assign ratio =  1 | divided_by: aspect_ratio | times: 100 -%}
                                    {% else %}
                                        {%- assign ratio = 100 -%}
                                    {% endif %}
                                    <div class="image-card__img alo-border-radius image-blog img-demo overflow-hidden ratio" style="--ratio-percent: {{ ratio }}%;">
                                      {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                                      {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                                      
                                    </div>
                                   <div class="post-info head head-article">
                                       <div class="blog"><a href="#">Blog category </a></div>
                                       <div class="title_blog">
                                         <h3>
                                           <a href="{{ routes.root_url }}" class="post-title">Avocado Grilled Salmon, Rich In Nutrients For The Body</a>
                                         </h3>  
                                       </div>
                                       <div class="meta-post">
                                       {% if section.settings.show-date %}
                                       <div class= "item-meta inner-date">
                                            <p>
                                           <span class="day">05</span>
                                           <span class="year">Feb</span>
                                            </p>
                                         </div>
                                       {% endif %}  
                                       {%if section.settings.show-author%}<div class="item-meta author"> <p><span>Alothemes</span></p></div>{% endif %}  
                                      {%if section.settings.show-comments%} <div class="item-meta comments"> <p><span>10 {{'blogs.article.comments' | t}} </span></p></div>{% endif %} 
                                       <div class="read_more">
                                         <a href="#" title="read more">
                                           Read more
                                         </a>
                                       </div>  
                                     </div>
                                   </div>
                                 </div>
                              </div>
                          </article>
                      {% endif %}
            	{%- endfor -%}
              {%- endif -%}
        </home-article>
      </div>
    </div>
</div>
</section>

{%- render 'section_style' -%} 

{%- schema -%}
  {
    "name": "Home article",
    "class": "blog-style2 type_carousel zoom_img",
