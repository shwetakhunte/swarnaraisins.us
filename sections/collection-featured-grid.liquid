{% liquid
  assign sid = section.id 
  assign layout = section.settings.layout
  assign se_blocks = section.blocks
  assign se_size = se_blocks.size
  assign num_p_qty =  section.settings.num_p_qty
  assign border = section.settings.border
%}
{{ 'media-grid.css' | asset_url | stylesheet_tag }}
{{ 'collection-featured.css' | asset_url | stylesheet_tag }}
<section id="laber_{{sid}}" class="wow animate--slide-in cat_size_{{se_size}} pad-{{ section.settings.pad }}">
  <div class="container {% if layout %}full-width{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
    {% if section.settings.title != blank %}
      <div class="wrap_title mb-30 sm:mb-20 {{ section.settings.text_size }} w_{{ section.settings.d_position }}">
        <div class="section-title alo-text-transform" style="--alo-text-transform:{{ section.settings.text_transform }}">{{section.settings.title}}</div>  
        {% if section.settings.content!= blank %}
          <div class="content">{{section.settings.content}}</div>
        {% endif %}
      </div>
    {% endif %}
    <media-grid class="media-grid {{ section.settings.style }}" style="--media-grid-column:{{ section.settings.column }}">
        {%- for block in section.blocks -%}
            <article id="media-grid-{{ block.id }}" class="media-item w-full h-full" style="--media-grid-column-span: {{ block.settings.media-grid-column-span }}; --media-grid-row-span: {{ block.settings.media-grid-row-span }};"> 
              {%- render 'collection-featured-grid',block:block,num_p_qty:num_p_qty,border:border,for_i:se_size -%}
            </article>
          {%- endfor -%}
    </media-grid>
  </div>
</section>
{%- render 'section_style' -%}
<style>
  #laber_{{ section.id }} {
    --media-grid-row-height: {{ section.settings.mobile_row_height }}px;
  }
  @media screen and (min-width: 700px) {
    #laber_{{ section.id }} {
      --media-grid-row-height: {{ section.settings.desktop_row_height }}px;
    }
  }
</style>

{%- schema -%}
  {
