      "min": 150,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 290
    },
    {
      "type": "range",
      "id": "mobile_row_height",
      "label": "Mobile row height",
      "min": 120,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 150
    },
      {
        "type": "header",
        "content": "== Design Options"
