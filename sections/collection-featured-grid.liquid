            } 
          },
          { 
            "type": "collection" ,
            "settings": {
            "media-grid-column-span": 1,
            "media-grid-row-span": 1
            }
          }, 
          { 
            "type": "collection" ,
            "settings": {
            "media-grid-column-span": 2,
            "media-grid-row-span": 1
            }
          }
          
        ]
      }
    ]
  }
{% endschema %}
