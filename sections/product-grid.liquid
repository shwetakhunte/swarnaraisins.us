{% liquid
  assign sid = section.id
  assign layout = section.settings.layout
%}
{{ 'product-grid.css' | asset_url | stylesheet_tag }}
<section
  id="laber_{{sid}}"
  class="wow animate--slide-in {% if section.settings.use_border_for_product %}alo-border-product{% endif%}"
>
  <div
    class="container {% if layout %}full-width{% endif %}"
    style="--alo-container-width:{{ section.settings.container }}px;"
  >
    {% if section.settings.title != blank %}
      <div class="wrap_title {{ section.settings.text_size }} w_{{ section.settings.d_position }}">
        <div
          class="h3 section-title alo-text-transform"
          style="--alo-text-transform:{{ section.settings.text_transform }}"
        >
          {{ section.settings.title }}
        </div>
        {% if section.settings.content != blank %}
          <div class="content">{{ section.settings.content }}</div>
        {% endif %}
        {% if section.settings['use-all-product'] %}
          <div class="bn_button viewall text-center">
            <a href="{{ collections[collection].url | default:'/admin/collections' }}">
              {{- 'collections.general.view_more' | t }}
              <i class="icon-arrow-right"></i
            ></a>
          </div>
        {% endif %}
      </div>
    {% endif %}
    {% # theme-check-disable %}
    <product-grid class="product-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks limit: section.settings.max_count -%}
          {%- case block.type -%}
            {%- when 'product' -%}
              {%- assign product = all_products[block.settings.product] %}
              {% if product != blank %}
                {% assign index = 1 %}
                {%- if settings.productlazyload == true -%}
                  <div
                    class="swiper-slide lazyload scroll-trigger"
                    style="--animation-order:{{ index }};"
                    data-include="{{url_cat}}/products/{{product.handle}}/?view=pr_lazy_load"
                  ></div>
                {% else %}
                  <div
                    class="swiper-slide scroll-trigger "
                    style="--animation-order:{{ index }};"
                  >
                    {% include 'product_style' %}
                  </div>
                {%- endif -%}
              {%- else -%}
                <div class="pr_grid_item">
                  {% render 'product_demo' %}
                </div>
              {%- endif -%}
            {%- when 'product_special' -%}
              {% assign sett_equal_product = block.settings.use_eq_height_product %}
              {% assign image_ratio_product = block.settings.image_ratio_product %}
              {% assign custom_ratio_product = block.settings.custom_ratio %}
              {%- assign product = all_products[block.settings.product] %}
              {% if product != blank %}
                {% assign pr_hd = product.handle %}
                <div
                  class="pr_grid_item big_product"
                  style="--animation-order:{{ index }};"
                >
                  {% include 'product_style' %}
                </div>
              {%- else -%}
                <div class="pr_grid_item big_product">
                  {% render 'product_demo' %}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      {%- endif -%}
    </product-grid>
    {% # theme-check-enable %}
  </div>
  {% if section.settings.show_border %}
    <div
      class="sm:d-none pt-100 sm:pt-50 container {% if layout %}full-width{% endif %}"
      style="--alo-container-width:{{ section.settings.container }}px;"
    >
      <div class="line alo-background-color" style="--alo-background-color:{{ section.settings.cl_line }};"></div>
    </div>
  {% endif %}
</section>
{%- render 'section_style' -%}
{%- schema -%}
