{% assign sid = section.id %}
{% assign layout = section.settings.layout %}
{% liquid
  assign space_between = section.settings['space-Between']
  assign navigation = section.settings.navigation
  assign pagination = section.settings.pagination
  if section.settings['use-slider']
    assign use_slider = true
  else
    assign use_slider = false
  endif
%}
{% case section.settings.col %}
    {% when '16%' %}
        {%- assign block_width = 'col-lg-2 col-md-2 col-12' -%}
    {% when '25%' %}
        {%- assign block_width = 'col-lg-3 col-md-3 col-12' -%}
    {% when '33%' %}
        {%- assign block_width = 'col-lg-4 col-md-4 col-12' -%}
    {% when '42%' %}
        {%- assign block_width = 'col-lg-5 col-md-5 col-12' -%}
    {% when '50%' %}
        {%- assign block_width = 'col-lg-6 col-md-6 col-12' -%}
    {% when '58%' %}
        {%- assign block_width = 'col-lg-7 col-md-7 col-12' -%}
    {% when '66%' %}
        {%- assign block_width = 'col-lg-8 col-md-8 col-12' -%}
    {% when '75%' %}
        {%- assign block_width = 'col-lg-9 col-md-9 col-12' -%}
    {% when '100%' %}
        {%- assign block_width = 'col-12' -%}
{% endcase %}
{% liquid
  assign show_stock_bar = section.settings.show_stock_bar
  assign show_countdown = false | default: section.settings.show_countdown
  assign year_count_down = section.settings.year_count_down
  assign month_count_down = section.settings.month_count_down
  assign day_count_down = section.settings.day_count_down
  
-%}
{%- capture countdown_ii -%}
{%- if show_countdown -%}
<div class="countdown-wrap countdown-header" style="--cl-number-countdown:{{section.settings.cl_number_countdown}};--bg-countdown:{{ section.settings.bg_countdown }};" >
  {% if section.settings.title_countdown != blank %}<h3>{{ section.settings.title_countdown }}</h3>{% endif %}
  <count-down class="cms-countdown" data-y="{{year_count_down}}" data-m="{{month_count_down}}" data-d="{{day_count_down}}" data-h="00" data-i="00" data-s="00">
  </count-down>
</div>	
{%- endif -%}
{%- endcapture -%}
{{ 'countdown-header.css' | asset_url | stylesheet_tag }}
{% if show_stock_bar %}{{ 'stock-bar.css' | asset_url | stylesheet_tag }}{% endif %}
  <section id="laber_{{sid}}" >
     <div class="{% if layout %}full-width{% else %}container{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;" >
       <div class="wrap-countdown  {% if section.settings.cl_bg_content != 'rgba(0,0,0,0)' %}alo-background-color alo-border-radius pd-20 py-20 sm:pd-10 sm:py-10 {% endif %}" style="{% if section.settings.cl_bg_content != 'rgba(0,0,0,0)' %}--bg-color:{{ section.settings.cl_bg_content  }}; {% endif %}">
          {% if section.settings.title != blank %}
          <div class="wrap_title w_{{ section.settings.h_position }} {{ section.settings.text_size }} mb-30 sm:mb-20">
          <div
             class="h3 section-title text-transform {% if section.settings.cl_underline != 'rgba(0,0,0,0)' %}title-hr{% endif %}"
                style="
                  --cl-text:{{ section.settings.cl_title |default:"#333333" }};
                  --text-transform:{{ section.settings.text_transform }};
                --cl-underline:{{ section.settings.cl_underline }};
                "
            >
              <span>{{ section.settings.title }}</span>
              {{ countdown_ii | strip_newlines | remove: '  ' }}
            </div>
            {% if section.settings.content %}
              <div class="content">{{ section.settings.content }}</div>
            {% endif %}
          </div>
        {% endif %}

        <div  class="laber-section row">

        <div
          class="content-section {{ block_width }}">
          <div class="products-arrivals products-list-countdown {% if show_countdown %}d-none-countdown-product{% endif%}">
            {% # theme-check-disable %}
            {% include 'grid-slider', settings: section.settings %}
            <grid-slider
              class="grid-slider"
              {{ gridSlider }}
            >
              <div
                class="swiper iSwiper"
                {%- render 'skeleton', settings: section.settings -%}
                style="--perload-gap: {{ space_between}}px"
              >
                <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                  {%- if section.blocks.size > 0 -%}
                    {%- for block in section.blocks -%}
                      {% liquid
                        assign show_stock_bar = section.settings.show_stock_bar
                        assign total = block.settings.total
                        assign available = block.settings.available
                      -%}
                  {%- capture stock_bar -%}	
                  {%- if show_stock_bar -%}
                  	{%- assign sold = total | minus: available | times: 100 | divided_by: total | ceil -%}
                    <div class="loop-product-stock" style="--h-stock-bar:{{section.settings.h_stock_bar }}px;">
                      <div class="product-stock">
                      <div class="status-bar"  style="--bg-status:{{section.settings.status_bg}}; ">
                        <div class="sold-bar" style="--bg-sold:{{section.settings.sold_bg}};  width: {{sold}}%;"></div>
                      </div>	
                      <div class="product-stock-status flex wrap">
                        <div class="sold">
                          <span>{{'products.grid_items.sold' | t  }} <b>{{total | minus: available}}</b></span> <span>{{'products.grid_items.available' | t  }} <b>{{available}}</b></span>
                        </div>
                      </div>
                      </div>
                    </div>
                  {%- endif -%}	
                  {%- endcapture -%}
                      {%- case block.type -%}
                        {%- when 'product' -%}
                          {%- assign product = all_products[block.settings.product] %}
                          {% if product != blank %}
                            <div class="swiper-slide">
                              {% include 'product_countdown', product: product, stock_bar: stock_bar %}
                            </div>
                          {%- else -%}
                            <div class="pr_grid_item swiper-slide">
                              {% render 'product_demo' %}
                            </div>
                          {%- endif -%}
                      {%- endcase -%}
                    {%- endfor -%}

                  {%- else -%}
                    {%- for i in (1..10) -%}
                      <div class="pr_grid_item swiper-slide">
                        {% render 'product_demo' %}
                      </div>
                    {%- endfor -%}
                  {%- endif -%}
                </div>
                {% if use_slider == true %}
                  {% if navigation %}
                    <div class="swiper-button-next"></div>
                    <div class="swiper-button-prev"></div>
                  {% endif %}
                  {% if pagination %}
                    <div class="swiper-pagination"></div>
                  {% endif %}
                {% endif %}
              </div>
            </grid-slider>
            {% # theme-check-enable %}
          </div>
          {% if section.settings.show_view_all %}
          <div class="view-all flex h_center pt-30">
            <a class="btn" href="{{ section.settings.url_view_all | default:"#"  }}">{{ 'sections.products_countdown.view_all' | t }}</a>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
     </div>
  </section>
  {%- render 'section_style' -%}
{%- schema -%}
