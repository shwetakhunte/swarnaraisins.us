{% liquid
  assign sid = section.id
  assign layout = section.settings.layout
%}
<section
  id="laber_{{sid}}"
  class="{% if section.settings.use_border_for_product %}alo-border-product{% endif%}"
  data-aos-duration="500" data-aos="fade-up"
>
  <div
    class="{% if layout %}full-width{% else %}container{% endif %}"
    style="--alo-container-width:{{ section.settings.container }}px;"
  >
  <div class="product-content {% if section.settings.cl_bg_content != 'rgba(0,0,0,0)' %}alo-background-color alo-border-radius pd-20 py-20 sm:pd-10 sm:py-10 {% endif %}" style="{% if section.settings.cl_bg_content != 'rgba(0,0,0,0)' %}--bg-color:{{ section.settings.cl_bg_content  }}; {% endif %}">  
    {% if section.settings.title != blank %}
        <div class="wrap_title w_{{ section.settings.h_position }} text_{{section.settings.txt_align}} mb-30 {{ section.settings.text_size }}">
            {% if section.settings.subtitle != blank %}
                <div class="section-subtitle" style="--cl-text:{{ section.settings.cl_subtitle }};" bis_skin_checked="1">{{ section.settings.subtitle }}</div>
              {% endif %}
            <div class="section-title h3 text-transform {% if section.settings.cl_underline != 'rgba(0,0,0,0)' %}title-hr{% endif %}" 
              style="
              --cl-text:{{ section.settings.cl_title |default:"#333333" }};
              --text-transform:{{ section.settings.text_transform }};
            --cl-underline:{{ section.settings.cl_underline }};
              ">
              <span>{{section.settings.title}}</span>
            </div>
            {% if section.settings.content %}
              <div class="content">
                {{ section.settings.content }}
              </div>
            {% endif %}
        </div>
      {% endif %}
    <div class="content-section alo-{{ section.settings.full_banner }}">
    {%- if section.blocks.size > 0 -%}
      <div class="row">
      {%- for block in section.blocks  -%}
        {% liquid
          assign limit = block.settings.max_count
          assign mb = block.settings.mb
          assign mb_mobile = block.settings.mb-mobile
          assign space_between = block.settings.space-Between
          assign navigation = block.settings.navigation
          assign pagination = block.settings.pagination
          assign use_slider = block.settings.use-slider
        %}
        {% case block.settings.col %}
            {% when '16%' %}
                {%- assign block_width = 'col-lg-2 col-md-2 col-12' -%}
            {% when '25%' %}
                {%- assign block_width = 'col-lg-3 col-md-3 col-12' -%}
            {% when '33%' %}
                {%- assign block_width = 'col-lg-4 col-md-4 col-12' -%}
            {% when '42%' %}
                {%- assign block_width = 'col-lg-5 col-md-5 col-12' -%}
            {% when '50%' %}
                {%- assign block_width = 'col-lg-6 col-md-6 col-12' -%}
            {% when '58%' %}
                {%- assign block_width = 'col-lg-7 col-md-7 col-12' -%}
            {% when '66%' %}
                {%- assign block_width = 'col-lg-8 col-md-8 col-12' -%}
            {% when '75%' %}
                {%- assign block_width = 'col-lg-9 col-md-9 col-12' -%}
            {% when '100%' %}
                {%- assign block_width = 'col-12' -%}
        {% endcase %}
        {%- case block.type -%}
        {%- when 'product_countdown' -%}
          {%- assign products = block.settings.product_list -%}
          {% assign show_stock_bar = block.settings.show_stock_bar %}
          {% if show_stock_bar %}{{ 'stock-bar.css' | asset_url | stylesheet_tag }}{% endif %}
          {{ 'product_countdown.css' | asset_url | stylesheet_tag }}
          <product-list id="b_{{block.id}}" class="{{ block_width }} mb-{{ mb }} sm:mb-{{ mb_mobile }} {% if block.settings.s_product == 'horizontal' %}products-column{% endif %}" style="display:block;">
         <div class="products-list-countdown" style="
            --cl-border:{{ block.settings.cl_border }};
            --bg-color: {{ block.settings.cl_bg }};
           ">
           <div class="alo-swiper-button">
            {% if block.settings.title != blank %}
            <div class="wrap_title  mb-30 {{ block.settings.text_size }}">
                <div class="block-title h3 text-transform {% if block.settings.bg_header != 'rgba(0,0,0,0)' %}bg-header{% endif %}" style="--text-transform:{{ block.settings.text_transform }};--cl-text:{{ block.settings.cl_title }};{% if block.settings.bg_header != 'rgba(0,0,0,0)' %}--bg-header:{{ block.settings.bg_header }}; {% endif %}">
                  <span>{{block.settings.title}}</span>
                  {% if block.settings.btn_text != blank %}
                    <a class="btn alo_btn-link" href="{{ block.settings.btn_url | default:'#' }}" >
                      {{ block.settings.btn_text }}
                    </a>
                {% endif %}
                </div>
            </div>
          {% endif %}
         {% # theme-check-disable %}    
          {% include 'grid-slider', settings: block.settings %}
          <grid-slider class="grid-slider" {{ gridSlider }}>
            <div
              class="swiper iSwiper"
              {%- render 'skeleton', settings: block.settings -%}
              style="--perload-gap: {{ space_between}}px"
            >
              <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                {% if products != blank %}
                  {%- for product in products limit: limit -%}
                    {% liquid
                        assign total = block.settings.total
                        assign available = product.variants.first.inventory_quantity
                      -%}
                  {%- capture stock_bar -%}	
                  {%- if show_stock_bar -%}
                    
                  	{%- assign sold = total | minus: available | times: 100 | divided_by: total | ceil -%}
                    <div class="loop-product-stock">
                      <div class="product-stock">
                      <div class="status-bar"  style="--bg-status:{{block.settings.status_bg}}; ">
                        <div class="sold-bar" style="--bg-sold:{{block.settings.sold_bg}};  width: {{sold}}%;"></div>
                      </div>	
                      <div class="product-stock-status flex wrap">
                        <div class="sold">
                          <span>{{'products.grid_items.sold' | t  }} <b>{{total | minus: available}}</b></span> <span>{{'products.grid_items.available' | t  }} <b>{{available}}</b></span>
                        </div>
                      </div>
                      </div>
                    </div>
                  {%- endif -%}	
                  {%- endcapture -%}
                    <div class="swiper-slide {{ quantity }}">
                      {% include 'product_countdown_4', product: product, stock_bar: stock_bar %}
                    </div>
                  {%- endfor -%}
                {% else %}
                  {%- for i in (1..limit) -%}
                    <div class="swiper-slide pr_grid_item">
                      {% render 'product_demo' %}
                    </div>
                  {%- endfor -%}
                {% endif %}
              </div>
              {% if use_slider == true %}
                {% if navigation %}
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                {% endif %}
                {% if pagination %}
                  <div class="swiper-pagination"></div>
                {% endif %}
              {% endif %}
            </div>
          </grid-slider>
             {% # theme-check-enable %}
             </div>
            </div>
          </product-list>
          {%- when 'product_list' -%}
          
          {%- assign products = block.settings.product_list -%}
          <div class="{{ block_width }}">
          <product-list id="b_{{block.id}}" class="alo-swiper-button  mb-{{ mb }} sm:mb-{{ mb_mobile }} {% if block.settings.s_product == 'horizontal' %}products-column{% endif %}" style="display:block;">
          {% if block.settings.title != blank %}
            <div class="wrap_title w_{{ block.settings.h_position }} text_{{block.settings.txt_align}} mb-30 {{ block.settings.text_size }}">
                <div class="block-title h3 text-transform {% if block.settings.cl_underline != 'rgba(0,0,0,0)' %}title-hr{% endif %}" 
                  style="
                  --cl-text:{{ section.settings.cl_title |default:"#333333" }};
                  --text-transform:{{ section.settings.text_transform }};
                --cl-underline:{{ block.settings.cl_underline }};
                  ">
                  <span>{{block.settings.title}}</span>
                </div>
                {% if block.settings.content %}
                  <div class="content">
                    {{ block.settings.content }}
                  </div>
                {% endif %}
            </div>
          {% endif %}
           {% # theme-check-disable %} 
          {% include 'grid-slider', settings: block.settings %}
          <grid-slider class="grid-slider" {{ gridSlider }}>
            <div
              class="swiper iSwiper"
              {%- render 'skeleton', settings: block.settings -%}
              style="--perload-gap: {{ space_between}}px"
            >
              <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                {% if products != blank %}
                  {%- for product in products limit: limit -%}
                    {% if block.settings.s_product == 'vertical' %}
                    <div
                        class="swiper-slide lazyload scroll-trigger"
                        style="--animation-order:{{ index }};"
                        data-include="/products/{{product.handle}}/?view=pr_lazy_load"
                      >{% include 'product_style' %} </div>
                      {% else %}
                        <div class="swiper-slide">
                          {% include 'product-column' %} 
                        </div>
                      {% endif %}
                  {%- endfor -%}
                {% else %}
      
                  {%- for i in (1..limit) -%}
                    {% if block.settings.s_product == 'vertical' %}
                    <div class="swiper-slide pr_grid_item">
                      {% render 'product_demo' %}
                    </div>
                      {% else %}
                         <div class="pr_grid_item swiper-slide">
                          {% render 'product_demo_column' %} 
                        </div>
                      {% endif %}
                  {%- endfor -%}
                {% endif %}
              </div>
              {% if use_slider == true %}
                {% if navigation %}
                
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
               
                {% endif %}
                {% if pagination %}
                  <div class="swiper-pagination"></div>
                {% endif %}
              {% endif %}
            </div>
          </grid-slider>
          {% # theme-check-enable %}  
          </product-list>
          </div>
          {%- when 'product_slider' -%}
          {{ 'product-slider.css' | asset_url | stylesheet_tag }}
          {%- assign products = block.settings.product_list -%}
          <product-slider id="b_{{block.id}}" class="col-12  mb-{{ mb }} sm:mb-{{ mb_mobile }}" style="display:block;">
           {% # theme-check-disable %} 
          {% include 'grid-slider', settings: block.settings %}
          <grid-slider class="grid-slider" {{ gridSlider }}>
            <div
              class="swiper iSwiper"
              {%- render 'skeleton', settings: block.settings -%}
              style="--perload-gap: {{ space_between}}px"
            >
              <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                
                
                {% if products != blank %}
                  {%- for product in products limit: limit -%}
                        <div class="swiper-slide">
                          {% include 'product_slider' %} 
                        </div>
                  {%- endfor -%}
                {% else %}
      
                  {%- for i in (1..limit) -%}
                    <div class="swiper-slide pr_grid_item">
                      {% render 'product_demo' %}
                    </div>
                  {%- endfor -%}
                {% endif %}
              </div>
              {% if use_slider == true %}
                {% if navigation %}
                  <div class="swiper-button-next"></div>
                  <div class="swiper-button-prev"></div>
                {% endif %}
                {% if pagination %}
                  <div class="swiper-pagination"></div>
                {% endif %}
              {% endif %}
            </div>
          </grid-slider>
          {% # theme-check-enable %}  
          </product-slider>
          {%- when 'collection' -%}
          {% assign collection = block.settings.collection %}
          <collection-product id="b_{{block.id}}" class="{{ block_width }} mb-{{ mb }} sm:mb-{{ mb_mobile }}" style="display:block;">
            {% if block.settings.title != blank %}
            <div class="wrap_title w_{{ block.settings.h_position }} text_{{block.settings.txt_align}} mb-30 {{ block.settings.text_size }}">
                {% if block.settings.subtitle != blank %}
                <div class="section-subtitle" style="--cl-text:{{ block.settings.cl_subtitle }};" bis_skin_checked="1">{{ block.settings.subtitle }}</div>
              {% endif %}
                <div class="block-title h3 text-transform {% if block.settings.cl_underline != 'rgba(0,0,0,0)' %}title-hr{% endif %}" style="--text-transform:{{ block.settings.text_transform }};--cl-text:{{ block.settings.cl_title }};--cl-underline:{{ block.settings.cl_underline }}">
                  <span>{{block.settings.title}}</span>
                </div>
                {% if block.settings.content %}
                  <div class="content">
                    {{ block.settings.content }}
                  </div>
                {% endif %}
            </div>
          {% endif %} 
            {% # theme-check-disable %}
           {% include 'grid-slider', settings: block.settings %}
          <grid-slider class="grid-slider" {{ gridSlider }} >
            <div
              class="swiper iSwiper"
              {%- render 'skeleton', settings: block.settings -%}
              style="--perload-gap: {{ space_between}}px"
            >
              <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                  {%- if collection != blank -%}
                    {%- assign products = collections[collection].products -%}
                    {%- capture url_cat -%}{%- if routes.root_url != '/' -%}{{routes.root_url}}{%- endif -%}{% if collection %}/collections/{{collection.handle}}{% endif %}{%- endcapture -%}
                    {% assign index = 1 %}
                    {%- for product in products limit: limit -%}
                      <div class="swiper-slide">
                        <div
                          class=" lazyload scroll-trigger"
                          data-include="{{url_cat}}/products/{{product.handle}}/?view=pr_lazy_load"
                        ></div>
                      </div>
                      {% assign index = index | plus: 1 %}
                    {%- endfor -%}
                  {%- else -%}
                    {%- for i in (1..limit) -%}
                      <div class="swiper-slide pr_grid_item">
                        {% render 'product_demo' %}
                      </div>
                    {%- endfor -%}
                  {%- endif -%}
     
              </div>
              {% if use_slider == true %}
                {% if navigation %}
                  <div class="swiper-button-next"></div>
                  <div class="swiper-button-prev"></div>
                {% endif %}
                {% if pagination %}
                  <div class="swiper-pagination"></div>
                {% endif %}
              {% endif %}
            </div>
          </grid-slider>
            {% # theme-check-enable %}
            {% if block.settings.show_view_all %}
              <div class="view_all pt-60">
              {{ 'collections.general.text' | t }} 
              <a href="/collections/all">{{ 'collections.general.view_all' | t }} {{- 'chevron.svg' | inline_asset_content -}}</a>
              </div>  
            {% endif %}
          </collection-product>
          {%- when 'banner' -%}
          {{ 'banner-image.css' | asset_url | stylesheet_tag }}
          {% # theme-check-disable %}
          {% include 'aspect-ratio', sett_equal: block.settings.use_eq_height, image_ratio: block.settings.image_ratio %}
          <banner-image id="b_{{block.id}}" class="{{ block_width }} mb-{{ mb }} sm:mb-{{ mb_mobile }}" style="display:block;">
            <div class="block-banner alo-border-radius w-full h-full {% if block.settings.hidden_mobile %}sm:d-none{% endif %}" >
              <div class="image_static image_card relative w-full h-full" style="--rounded:{{ block.settings.b_image }}px;">
                {% assign image = block.settings.image %}
                {% assign url = block.settings.link %}
                {% if image != blank %}
                  {% render 'responsive-image', image: image, aspect_ratio:aspect_ratio, url: url, image_class: 'w-full h-full alo-border-radius' %}
                {% else %}
                  {% if aspect_ratio != blank %}
                       {%- assign ratio =  1 | divided_by: aspect_ratio | times: 100 -%}
                    {% else %}
                        {%- assign ratio = 100 -%}
                    {% endif %}
                  <div class="image-card__img overflow-hidden alo-border-radius ratio w-full h-full" style="--rounded:{{ block.settings.b_image }}px;--ratio-percent: {{ ratio }}%;">
                    {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                    {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                  </div>
                {% endif %}
                {% if block.settings.c_image != blank %}
                  <content-image class="flex absolute inset-0 h_{{block.settings.h_position}} v_{{block.settings.v_position}} text_{{block.settings.txt_align}}">
                  <div class="content ">
                    {{ block.settings.c_image }}
                    {% if block.settings.n_btn_image %}
                      <div class="{{ block.settings.ct_color }}">
                      <a
                        class="btn events-auto {{ block.settings.button_style }}"
                        href="{{ url }}"
                        title="{{ block.settings.n_btn_image }}"
                      >
                        {{ block.settings.n_btn_image }}
                      </a>
                      </div>
                    {% endif %}
                    </div>
                  </content-image>
                {% endif %}
              </div>
            </div>
          </banner-image>
          {% # theme-check-enable %}
          {%- when 'banner_text' -%}
          {{ 'banner-image.css' | asset_url | stylesheet_tag }}
          {% # theme-check-disable %}
          {% include 'aspect-ratio', sett_equal: block.settings.use_eq_height, image_ratio: block.settings.image_ratio %}
          <banner-image id="b_{{block.id}}" class="{{ block_width }} mb-{{ mb }} sm:mb-{{ mb_mobile }}" style="display:block;">
            <div class="block-banner alo-border-radius w-full h-full {% if block.settings.hidden_mobile %}sm:d-none{% endif %}" >
              <div class="row">
              <div class="col-lg-6 col-md-6 col-12 image_static image_card relative w-full h-full {% if block.settings.change_position %}order_1{% endif %}" style="--rounded:{{ block.settings.b_image }}px;">
                {% assign image = block.settings.image %}
                {% assign url = block.settings.link %}
                {% if image != blank %}
                  {% render 'responsive-image', image: image, aspect_ratio:aspect_ratio, url: url, image_class: 'w-full h-full alo-border-radius' %}
                {% else %}
                  {% if aspect_ratio != blank %}
                       {%- assign ratio =  1 | divided_by: aspect_ratio | times: 100 -%}
                    {% else %}
                        {%- assign ratio = 100 -%}
                    {% endif %}
                  <div class="image-card__img overflow-hidden alo-border-radius ratio w-full h-full" style="--rounded:{{ block.settings.b_image }}px;--ratio-percent: {{ ratio }}%;">
                    {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                    {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                  </div>
                {% endif %}
                
              </div>
              {% if block.settings.c_image != blank %}
                  <content-image class="col-lg-6 col-md-6 col-12 flex h_{{block.settings.h_position}} v_{{block.settings.v_position}} text_{{block.settings.txt_align}}">
                  <div class="content ">
                    {{ block.settings.c_image }}
                    {% if block.settings.n_btn_image != blank %}
                      <div class="{{ block.settings.ct_color }}">
                      <a
                        class="btn events-auto {{ block.settings.button_style }}"
                        href="{{ url }}"
                        title="{{ block.settings.n_btn_image }}"
                      >
                        {{ block.settings.n_btn_image }}
                      </a>
                      </div>
                    {% endif %}
                    </div>
                  </content-image>
                {% endif %}
              </div>
            </div>
          </banner-image>
          {% # theme-check-enable %}
        {% endcase %}
      {% endfor %}
      </div>
    {% endif %}
    </div>
  </div>
  </div>
  {% if section.settings.show_border %}
    <div class="sm:d-none pt-100 sm:pt-50 container {% if layout %}full-width{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;" >
      <div class="line alo-background-color" style="--alo-background-color:{{ section.settings.cl_line }};"></div>
    </div>
  {% endif %}
</section>
{%- render 'section_style' -%}
{%- schema -%}
{
  "name": "Carousel Products",
  "class": "shopify-section cms_section type_carousel product_section collection_carousel_product",
  	"blocks": [
      {
        "type": "product_countdown",
        "name": "Product Countdown",
        "settings": [
          {
          "type": "text",
          "id": "title",
          "label": "Heading"
        },
    {
       "type": "color",
       "id": "cl_title",
       "label": "Color Heading",
       "default": "#fff"
       },
     {
       "type": "color",
       "id": "bg_header",
       "label": "Background Heading",
       "default":"rgba(0,0,0,0)"
     },     
    {
      "type": "select",
      "id": "text_size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "small"
       },
       {
          "value": "medium",
          "label": "Medium"
       },
       {
          "value": "large",
          "label": "Large"
        }
      ],
      "label": "Text size"
    },
    {
        "type": "select",
        "id": "text_transform",
        "default": "none",
        "options": [
         {
            "value": "none",
            "label": "None"
         },
         {
            "value": "capitalize",
            "label": "Capitalize"
         },
         {
            "value": "lowercase",
            "label": "Lowercase"
         },
         {
            "value": "uppercase",
            "label": "Uppercase"
          }
        ],
        "label": "Text transform:"
      },
          {
            "type": "select",
            "id": "col",
            "default": "42%",
            "options": [
            {
            "value": "16%",
            "label": "16%"
            },  
            {
            "value": "25%",
            "label": "25%"
            },
            {
            "value": "33%",
            "label": "33%"
            },
             {
            "value": "42%",
            "label": "42%"
            }, 
            {
            "value": "50%",
            "label": "50%"
            },
            {
            "value": "58%",
            "label": "58%"
            }, 
            {
            "value": "66%",
            "label": "66%"
            },
            {
            "value": "75%",
            "label": "75%"
            },
            {
            "value": "100%",
            "label": "100%"
            }
            ],
            "label": "Container width:"
          },
          {
            "type": "product_list",
            "id": "product_list",
            "label": "Product list"
          },
          {
            "type": "range",
            "id": "max_count",
            "min": 4,
            "max": 24,
            "step": 1,
            "unit": "pds",
            "label": "Max product",
            "default": 8
          },
          
          {
           "type": "checkbox",
           "id": "show_stock_bar",
           "label": "Show stock bar",
           "default": true
           },
            {
             "type": "range",
             "id": "total",
             "min": 1,
             "max": 100,
             "step": 1,
             "label": "Total Stock:",
             "unit": "qty",
             "default": 100
           },
           {
           "type": "color",
           "id": "status_bg",
           "label": "Background color 1",
           "default": "#f5f5f5",
           "info":"Background color status bar"
           },
           {
           "type": "color",
           "id": "sold_bg",
           "label": "Background color 2",
           "default": "#777777",
           "info":"Background color sold bar"
           },
          {
        "type": "header",
        "content": "---- Collection Product Slider ----",
        "info": "Refer to the attribute values [here](https://swiperjs.com/swiper-api)"
    },
    {
        "type": "checkbox",
        "id": "use-slider",
        "label": "Use slider?",
        "default": true
    },
    {
       "type": "range",
       "id": "visible",
       "label": "Columns in Visible",
    "info": "Item(s) in screen ( Size >= 1920 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 5
    },
    {
       "type": "range",
       "id": "widescreen",
       "label": "Columns in Widescreen",
    "info": "Item(s) in screen ( 1366 <= Size < 1920 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 1
    },
    {
       "type": "range",
       "id": "desktop",
       "label": "Columns in Desktop",
    "info":  "Item(s) in screen ( 1200 <= Size < 1480 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 1
    },
    {
       "type": "range",
       "id": "laptop",
       "label": "Columns in Laptop",
    "info": "Item(s) in screen ( 992 <= Size < 1200 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 4
    },
    {
       "type": "range",
