{% comment %} Swarna Raisins — Nutritional Goodness / What's Inside {% endcomment %}

<style>
.sr-nutrition-section {
  padding: 72px 24px;
  background: #ffffff;
  font-family: 'Poppins', sans-serif;
}
.sr-nutrition-inner {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}
@media (max-width: 768px) {
  .sr-nutrition-inner {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .sr-nutrition-section { padding: 48px 16px; }
}
/* Left: image / visual */
.sr-nutrition-visual {
  position: relative;
}
.sr-nutrition-img-wrap {
  border-radius: 20px;
  overflow: hidden;
  background: linear-gradient(135deg, #e8f5e9 0%, #f1f8e9 100%);
  aspect-ratio: 4/5;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sr-nutrition-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 24px;
}
.sr-nutrition-img-placeholder {
  text-align: center;
  padding: 40px;
}
.sr-nutrition-img-placeholder svg {
  width: 120px;
  height: 120px;
  opacity: 0.3;
  margin-bottom: 16px;
}
.sr-nutrition-img-placeholder p {
  color: #888;
  font-size: 14px;
}
/* Floating badge */
.sr-nutrition-badge {
  position: absolute;
  bottom: -16px;
  right: -16px;
  background: #2e7d32;
  color: #fff;
  border-radius: 50%;
  width: 96px;
  height: 96px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(46,125,50,0.3);
  font-size: 11px;
  font-weight: 600;
  text-align: center;
  line-height: 1.3;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.sr-nutrition-badge strong {
  font-size: 22px;
  font-weight: 800;
  display: block;
  line-height: 1;
}
/* Right: content */
.sr-nutrition-eyebrow {
  display: block;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #2e7d32;
  margin-bottom: 10px;
}
.sr-nutrition-heading {
  font-size: clamp(26px, 3.5vw, 38px);
  font-weight: 800;
  color: #1b1b1b;
  margin: 0 0 10px;
  line-height: 1.2;
}
.sr-nutrition-sub {
  font-size: 15px;
  color: #666;
  line-height: 1.7;
  margin: 0 0 32px;
}
/* Nutrition list */
.sr-nutrition-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid #eaeaea;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 28px;
}
.sr-nutrition-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 20px;
  border-bottom: 1px solid #f0f0f0;
  transition: background 0.2s;
}
.sr-nutrition-row:last-child { border-bottom: none; }
.sr-nutrition-row:hover { background: #f9f9f9; }
.sr-nutrition-row.header-row {
  background: #2e7d32;
  color: #fff;
  font-weight: 700;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.sr-nutrition-label {
  font-weight: 600;
  font-size: 14px;
  color: #1b1b1b;
  display: flex;
  align-items: center;
  gap: 10px;
}
.sr-nutrition-label::before {
  content: '';
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #2e7d32;
  flex-shrink: 0;
}
.sr-nutrition-amount {
  font-size: 14px;
  font-weight: 700;
  color: #2e7d32;
}
/* Cert badges row */
.sr-cert-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}
.sr-cert-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: #f1f8e9;
  border: 1px solid #c8e6c9;
  border-radius: 40px;
  padding: 8px 16px;
  font-size: 12px;
  font-weight: 600;
  color: #2e7d32;
}
.sr-cert-badge svg {
  width: 16px; height: 16px; stroke: #2e7d32;
}
</style>

<section class="sr-nutrition-section">
  <div class="sr-nutrition-inner">
    <!-- Visual -->
    <div class="sr-nutrition-visual">
      <div class="sr-nutrition-img-wrap">
        {% if section.settings.main_image %}
          <img src="{{ section.settings.main_image | image_url: width: 600 }}"
               alt="{{ section.settings.heading | default: 'Swarna Raisins Nutrition' }}">
        {% else %}
          <div class="sr-nutrition-img-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="#2e7d32" stroke-width="1.5">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
              <circle cx="12" cy="9" r="2.5"/>
            </svg>
            <p>Upload a product / ingredient image</p>
          </div>
        {% endif %}
      </div>
      <div class="sr-nutrition-badge">
        <strong>100%</strong>
        Natural
      </div>
    </div>

    <!-- Content -->
    <div class="sr-nutrition-content">
      <span class="sr-nutrition-eyebrow">{{ section.settings.eyebrow | default: '— Nutrition Facts —' }}</span>
      <h2 class="sr-nutrition-heading">{{ section.settings.heading | default: "What's Inside Every Bite?" }}</h2>
      <p class="sr-nutrition-sub">{{ section.settings.subheading | default: 'Sun-dried to perfection, Swarna Raisins are a powerhouse of natural nutrients — no additives, no preservatives, just pure goodness in every pack.' }}</p>

      <div class="sr-nutrition-list">
        <div class="sr-nutrition-row header-row">
          <span>Nutrient (per 100g)</span>
          <span>Amount</span>
        </div>
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <div class="sr-nutrition-row" {{ block.shopify_attributes }}>
              <span class="sr-nutrition-label">{{ block.settings.title }}</span>
              <span class="sr-nutrition-amount">{{ block.settings.amount }}</span>
            </div>
          {% endfor %}
        {% else %}
          {%- assign default_nutrients = "Energy|299 kcal|Carbohydrates|79 g|Natural Sugars|59 g|Dietary Fibre|3.7 g|Protein|3.1 g|Iron|1.9 mg|Potassium|749 mg|Calcium|50 mg|Vitamin C|3.2 mg|Antioxidants (Polyphenols)|High" | split: "|" -%}
          {% for i in (0..9) %}
            {%- assign l_idx = forloop.index0 | times: 2 -%}
            {%- assign v_idx = l_idx | plus: 1 -%}
            {%- assign label = default_nutrients[l_idx] -%}
            {%- assign value = default_nutrients[v_idx] -%}
            <div class="sr-nutrition-row">
              <span class="sr-nutrition-label">{{ label }}</span>
              <span class="sr-nutrition-amount">{{ value }}</span>
            </div>
          {% endfor %}
        {% endif %}
      </div>

      <div class="sr-cert-row">
        <span class="sr-cert-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          FSSAI Certified
        </span>
        <span class="sr-cert-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          NABL Tested
        </span>
        <span class="sr-cert-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Zero Sulphur
        </span>
        <span class="sr-cert-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          No Preservatives
        </span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Swarna Nutrition Facts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Label", "default": "— Nutrition Facts —" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's Inside Every Bite?" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Sun-dried to perfection, Swarna Raisins are a powerhouse of natural nutrients — no additives, no preservatives, just pure goodness in every pack." },
    { "type": "image_picker", "id": "main_image", "label": "Product / Nutrition Image" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Nutrient Row",
      "settings": [
        { "type": "text", "id": "title", "label": "Nutrient Name", "default": "Energy" },
        { "type": "text", "id": "amount", "label": "Amount", "default": "299 kcal" }
      ]
    }
  ],
  "presets": [
    { "name": "Swarna Nutrition Facts" }
  ]
}
{% endschema %}
