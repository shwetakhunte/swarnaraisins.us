       },
       {
         "type": "textarea",
         "id": "alphabet",
         "label": "Alphabet",
         "default":"a, b, c, d, e, f, g, h ,i ,k , l, m, n, o, p, q, r, s, t, u, v, w, x, y, z.",
         "info": "Note: Separate letters with a comma \",\""
       },
       {
       "type": "header",
