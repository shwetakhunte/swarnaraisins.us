{{ 'main-brand.css' | asset_url | stylesheet_tag }}
{% liquid
  assign sid = section.id
  assign list_alphabet = section.settings.alphabet | remove: ' ' | split: ','
%}
<section id="laber_{{sid}}">
  <div class="page-brands">
    <div class="container">
      {% if section.settings.show_page %}
        <h1 class="main-page-title">
          {{ page.title | escape }}
        </h1>
      {% endif %}
      {% comment %}
        <ul id="brandsCode" class="brands-list-code">
          <li data-code="all" class="all-brands brand-filter active"><a href="#" role="button">Show All</a></li>
          {% for alphabet in list_alphabet %}
              <li class="brand-filter " data-code="{{ alphabet }}"><a href="#brand-{{ alphabet }}" data-href="a" role="button">{{ alphabet }}</a></li>
          {% endfor %}
        </ul>
      {% endcomment %}
      <filter-search class="brandsWrap" data-show-empty="false">
        <div class="search-brand">
          <div class="title">{{ 'sections.main_brand.search_brand' | t }}</div>
          <input type="text" class="search" name="search" placeholder="{{'sections.main_brand.enter_item_name' |t}}">
        </div>
        {% for alphabet in list_alphabet %}
          {% assign brandhtml = '' %}
          {% for product_vendor in shop.vendors %}
            {% assign f_letter = product_vendor | slice: 0 | handleize %}
            {% assign alp = alphabet | handleize %}
            {% if alp == f_letter %}
              {% capture brandhtml %}{{brandhtml}}<li class="brand item">{{ product_vendor | link_to_vendor }}</li>{% endcapture %}
            {% endif %}
          {% endfor %}
          {% if brandhtml != '' %}
            <div id="brands-code-{{ alphabet }}" class="brands-group group" data-code="{{ alphabet }}">
              <h3 class="brands-group-title">{{ alphabet }}</h3>
              <ul class="brands-group-list">
                {{ brandhtml }}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      </filter-search>
    </div>
  </div>
</section>
{%- render 'section_style' -%}
{% schema %}
 {
   "name": "Main Brands",
   "settings": [
       {
       "type": "checkbox",
       "id": "show_page",
       "label": "show Name page",
