{% comment %}
  Top Sellers Section — Dynamic version
  Each product card is a block, letting merchants swap products in the Shopify Theme Editor.
  UI is kept identical to the original hardcoded version.
{% endcomment %}

<div class="top-sellers-section">
  <div class="container">
    <h2 class="top-sellers-title">{{ section.settings.title }}</h2>

    <div class="top-sellers-grid">
      {% for block in section.blocks %}
        {% assign product = all_products[block.settings.product] %}
        {% if product != blank %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          <div class="top-seller-card" {{ block.shopify_attributes }}>

            <div class="card-header">
              <h3 class="product-tag-title">{{ product.title }}</h3>
              {% if block.settings.ribbon_text != blank %}
                <div class="ribbon-banner {{ block.settings.ribbon_color }}">
                  {{ block.settings.ribbon_text }}
                </div>
              {% endif %}
            </div>

            <div class="product-image-wrap">
              {% if product.featured_image %}
                <a href="{{ product.url }}">
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    class="product-image"
                    loading="lazy"
                    width="600"
                  >
                </a>
              {% endif %}
            </div>

            <div class="card-footer">
              <div class="reviews-wrap">
                <span class="stars">★★★★★</span>
                {% if block.settings.review_count != blank %}
                  <span class="reviews-count">{{ block.settings.review_count }} reviews</span>
                {% endif %}
              </div>

              {% if block.settings.product_desc != blank %}
                <p class="product-desc">{{ block.settings.product_desc }}</p>
              {% elsif product.metafields.custom.short_description != blank %}
                <p class="product-desc">{{ product.metafields.custom.short_description }}</p>
              {% else %}
                <p class="product-desc">{{ product.description | strip_html | truncate: 100 }}</p>
              {% endif %}

              {%- comment -%} Price block — sale + compare-at {%- endcomment -%}
              <div class="ts-price-wrap">
                {% if product.compare_at_price > product.price %}
                  <span class="ts-sale-price">{{ product.price | money }}</span>
                  <span class="ts-compare-price">{{ product.compare_at_price | money }}</span>
                {% else %}
                  <span class="ts-regular-price">{{ product.price | money }}</span>
                {% endif %}
              </div>

              {%- comment -%} Add to Cart button — same structure as carousel cards {%- endcomment -%}
              <div class="ts-btn-wrap">
                {% if product.available %}
                  {% if product.variants.size == 1 %}
                    <form method="post" action="/cart/add" class="product-item">
                      <input type="hidden" name="id" value="{{ current_variant.id }}">
                      <button
                        type="submit"
                        class="ts-add-to-cart alo_tooltip add-to-cart js_add_to_cart_button"
                        data-pid="{{ current_variant.id }}"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="9" cy="21" r="1"></circle>
                          <circle cx="20" cy="21" r="1"></circle>
                          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                        <span class="text alo_tooltip-content">
                          {{ 'products.product.add_to_cart' | t }}
                        </span>
                      </button>
                    </form>
                  {% else %}
                    <a
                      href="{{ product.url }}"
                      class="ts-add-to-cart alo_tooltip js_select_options select_options"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                      </svg>
                      <span class="text alo_tooltip-content">{{ 'products.grid_items.select_options' | t }}</span>
                    </a>
                  {% endif %}
                {% else %}
                  <a href="{{ product.url }}" class="ts-add-to-cart ts-sold-out">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="9" cy="21" r="1"></circle>
                      <circle cx="20" cy="21" r="1"></circle>
                      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <span class="text">{{ 'products.product.sold_out' | t }}</span>
                  </a>
                {% endif %}
              </div>

            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_shop_all %}
      <div class="shop-all-wrap">
        <a href="{{ section.settings.shop_all_url | default: '/collections/all' }}" class="shop-all-link">
          {{ section.settings.shop_all_label | default: 'Shop All' }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Top Sellers",
  "tag": "section",
  "class": "top-sellers-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Meet our Top Sellers"
    },
    {
      "type": "checkbox",
      "id": "show_shop_all",
      "label": "Show Shop All link",
      "default": true
    },
    {
      "type": "url",
      "id": "shop_all_url",
      "label": "Shop All URL"
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Shop All Label",
      "default": "Shop All"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "ribbon_text",
          "label": "Ribbon Label",
          "info": "e.g. Clinically Tested, Best Seller"
        },
        {
          "type": "select",
          "id": "ribbon_color",
          "label": "Ribbon Color",
          "options": [
            { "value": "teal-ribbon",  "label": "Teal (dark green)" },
            { "value": "pink-ribbon",  "label": "Pink" }
          ],
          "default": "teal-ribbon"
        },
        {
          "type": "text",
          "id": "review_count",
          "label": "Review Count",
          "info": "e.g. 262"
        },
        {
          "type": "textarea",
          "id": "product_desc",
          "label": "Short Description",
          "info": "Leave blank to use the product description automatically."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Top Sellers",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
