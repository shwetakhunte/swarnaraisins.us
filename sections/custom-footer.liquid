<style>
  .custom-footer {
    background-color: #ffffff;
    padding-top: 60px;
    font-family: inherit;
  }
  .cf-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .cf-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 50px;
  }
  
  .cf-logo-col {
    flex: 1 1 30%;
    margin-bottom: 30px;
  }
  .cf-logo-col img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .cf-logo-col svg {
    display: block;
    max-width: 200px;
    height: auto;
    fill: #000;
  }
  
  .cf-menus-wrap {
    flex: 1 1 65%;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  
  .cf-menu-col {
    flex: 1 1 30%;
    margin-bottom: 30px;
  }
  .cf-menu-heading {
    font-size: 16px;
    font-weight: 800;
    color: #000;
    margin-bottom: 25px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .cf-menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cf-menu-list li {
    margin-bottom: 15px;
  }
  .cf-menu-list a {
    font-size: 15px;
    color: #222;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .cf-menu-list a:hover {
    color: #6a0dad;
  }

  .cf-bottom {
    border-top: 1px solid #e5e5e5;
    padding: 25px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
  }
  
  .cf-copyright {
    font-size: 14px;
    color: #222;
    font-weight: 500;
  }
  
  .cf-social {
    display: flex;
    gap: 15px;
  }
  .cf-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background-color: #222;
    color: #fff;
    border-radius: 50%;
    text-decoration: none;
    transition: background-color 0.3s ease;
  }
  .cf-social a:hover {
    background-color: #6a0dad;
  }
  .cf-social svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  @media (max-width: 992px) {
    .cf-top {
      flex-direction: column;
    }
    .cf-logo-col {
      flex: 1 1 100%;
      margin-bottom: 40px;
    }
    .cf-menus-wrap {
      flex: 1 1 100%;
    }
  }
  @media (max-width: 768px) {
    .cf-menus-wrap {
      flex-direction: column;
    }
    .cf-menu-col {
      flex: 1 1 100%;
      margin-bottom: 30px;
    }
    .cf-bottom {
      flex-direction: column;
      text-align: center;
      gap: 20px;
    }
  }

  /* Info Text after logo */
  .cf-logo-info {
    margin-top: 20px;
    font-size: 14px;
    line-height: 1.6;
    color: #444;
    text-align: left;
  }
  .cf-info-title {
    font-weight: 700;
    color: #2e7d32;
    margin-bottom: 8px;
    font-size: 15px;
    font-family: 'Poppins', sans-serif;
  }
  .cf-info-text {
    margin-bottom: 12px;
    color: #555;
    font-family: 'Poppins', sans-serif;
  }
  .cf-info-emails {
    font-size: 13px;
    font-weight: 600;
    color: #2e7d32;
    font-family: 'Poppins', sans-serif;
  }
  .cf-info-emails a {
    color: #2e7d32;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .cf-info-emails a:hover {
    opacity: 0.8;
  }

  /* Social Icons under info */
  .cf-logo-socials {
    display: flex;
    gap: 12px;
    margin-top: 20px;
    justify-content: flex-start;
  }
  .cf-logo-socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background-color: #2e7d32;
    color: #fff;
    border-radius: 50%;
    text-decoration: none;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }
  .cf-logo-socials a:hover {
    background-color: #e5a919;
    transform: translateY(-2px);
  }
  .cf-logo-socials svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* Newsletter Column styling */
  .cf-newsletter-col {
    flex: 1 1 35% !important;
  }
  .cf-newsletter-desc {
    font-size: 14px;
    color: #555;
    margin-bottom: 15px;
    line-height: 1.5;
    font-family: 'Poppins', sans-serif;
  }
  .cf-input-group {
    display: flex;
    align-items: stretch;
    margin-bottom: 12px;
    width: 100%;
  }
  .cf-newsletter-input {
    flex: 1;
    height: 46px;
    padding: 0 16px;
    border: 1px solid #cccccc;
    border-right: none;
    border-radius: 4px 0 0 4px;
    font-size: 14px;
    color: #333;
    outline: none;
    background-color: #fff;
  }
  .cf-newsletter-btn {
    height: 46px;
    padding: 0 20px;
    background-color: #e5a919;
    color: #ffffff;
    border: none;
    border-radius: 0 4px 4px 0;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .cf-newsletter-btn:hover {
    background-color: #d49714;
  }
  .cf-newsletter-disclaimer {
    font-size: 12px;
    color: #666666;
    line-height: 1.5;
    margin: 0;
    text-align: left;
    font-family: 'Poppins', sans-serif;
  }

  @media (max-width: 992px) {
    .cf-newsletter-col {
      flex: 1 1 100% !important;
    }
  }
</style>

<footer class="custom-footer">
  <div class="cf-container">
    <div class="cf-top">
      <div class="cf-logo-col">
        <a href="{{ routes.root_url }}">
          {% if section.settings.logo != blank %}
            <img src="{{ section.settings.logo | img_url: 'master' }}" alt="{{ shop.name }}" style="max-width: {{ section.settings.logo_max_width }}px;">
          {% else %}
            <span style="font-size: 24px; font-weight: bold; color: #1b5e20;">Swarna Raisins</span>
          {% endif %}
        </a>
        
        <div class="cf-logo-info">
          <p class="cf-info-title">Grown, Processed & Marketed by Farmers</p>
          <p class="cf-info-text">At Swarna Raisins, we are committed to delivering India’s finest premium raisins — residual-free golden, rich black seedless, and vibrant yellow varieties — crafted with purity, safety, and farm-fresh integrity.</p>
          <p class="cf-info-emails">
            <a href="mailto:support@swarnaraisins.com">support@swarnaraisins.com</a> | 
            <a href="mailto:product@swarnaraisins.com">product@swarnaraisins.com</a> | 
            <a href="mailto:careers@swarnaraisins.com">careers@swarnaraisins.com</a>
          </p>
        </div>
        
        <div class="cf-logo-socials">
          <a href="https://facebook.com" target="_blank" aria-label="Facebook">
            <svg viewBox="0 0 24 24"><path d="M22.675 0h-21.35C.597 0 0 .597 0 1.325v21.351C0 23.403.597 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116c.73 0 1.323-.597 1.323-1.325V1.325C24 .597 23.403 0 22.675 0z"/></svg>
          </a>
          <a href="https://instagram.com" target="_blank" aria-label="Instagram">
            <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        </div>
      </div>
      
      <div class="cf-menus-wrap">
        {% for block in section.blocks %}
          {% if block.type == 'link_list' %}
            <div class="cf-menu-col" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <div class="cf-menu-heading">{{ block.settings.heading }}</div>
              {% endif %}
              
              {% if block.settings.menu != blank %}
                <ul class="cf-menu-list">
                  {% for link in linklists[block.settings.menu].links %}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% endfor %}
                </ul>
              {% else %}
                <ul class="cf-menu-list">
                  <li><a href="#">Link 1</a></li>
                  <li><a href="#">Link 2</a></li>
                  <li><a href="#">Link 3</a></li>
                </ul>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
        
        <div class="cf-menu-col cf-newsletter-col">
          <div class="cf-menu-heading">Our Newsletter</div>
          <p class="cf-newsletter-desc">Get instant updates about our new products and special promos!</p>
          
          <div class="cf-newsletter-form-wrap">
            {% form 'customer', class: 'cf-newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="cf-input-group">
                <input type="email" name="contact[email]" placeholder="Enter your email here" required class="cf-newsletter-input">
                <button type="submit" class="cf-newsletter-btn">SUBSCRIBE</button>
              </div>
            {% endform %}
          </div>
          
          <p class="cf-newsletter-disclaimer">By entering the e-mail you accept the terms and conditions and the privacy policy.</p>
        </div>
      </div>
    </div>
    
    <div class="cf-bottom">
      <div class="cf-copyright">
        {{ section.settings.copyright_text | replace: '[year]', 'now' | date: "%Y" }}
      </div>

{% schema %}
{
  "name": "Custom Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Logo Max Width",
      "default": 180
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Copyright [year] © Swarna Raisins. All rights reserved"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Media Icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu Column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Footer",
      "category": "Footer"
    }
  ]
}
{% endschema %}
