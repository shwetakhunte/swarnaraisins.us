{%- if section.settings.hidden %}{% break %}{% endif -%}
{% liquid
  assign sid = section.id
%}
{{ 'text-runs-popup.css' | asset_url | stylesheet_tag }}
<section
  id="laber_{{sid}}"
  class="display_{{ section.settings.location }} {% if section.settings.hidden_mobile %}sm:d-none{% endif %}"
  style="--alo-healing-speed:{{ section.settings.healing_speed }}s;--rounded:{{ section.settings.border }}px;--alo-width:{{ section.settings.width }}px;--bg-color:{{ section.settings.cl_bg }};--cl-text:{{ section.settings.cl_text }};"
>
  <campaign-bar id="open-store" data-container="" data-slow-appear="2000" class="show">
    <div class="text-horizontal-running {{ section.settings.slider_direction }}">
      {%- if section.blocks.size > 0 -%}
        <div class="wrap-text">
          {%- for block in section.blocks -%}
              {% if block.settings.text != blank -%}
                <div class="flex">{{ block.settings.text }}</div>
              {%- endif %}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <button class="close-button close-rotate close-x icon-x">
      <span style="display:none">X</span>
    </button>
  </campaign-bar>
</section>
{%- schema -%}
 {
   "name": "Text runs popup",
   "class": "type_text_runs_popup",
"max_blocks": 30,
   "settings": [
     {
       "type": "header",
       "content": "== Design Options"
     },
     {
       "type": "select",
       "id": "location",
       "label": "Display location",
       "default": "bottom",
       "options": [
         {
           "value": "top",
           "label": "Top"
         },
         {
           "value": "bottom",
           "label": "Bottom"
         }
       ]
     },
     {
       "type": "checkbox",
       "id": "hidden",
       "label": "Hidden Section?",
       "default": false
     },
     {
       "type": "checkbox",
       "id": "hidden_mobile",
       "label": "Hidden Mobile",
       "default": false
     },
     {
       "type": "range",
       "id": "width",
       "label": "Width",
       "min": 400,
       "max": 1200,
       "step": 10,
       "unit": "px",
       "default": 630
     },
     {
       "type": "range",
       "id": "border",
       "label": "Border",
       "min": 0,
       "max": 50,
       "step": 1,
       "unit": "px",
       "default": 0
     },
     {
       "type": "select",
       "id": "slider_direction",
       "label": "Slider Direction",
       "default": "slide-left",
       "options": [
         {
           "value": "slide-left",
           "label": "Left"
         },
         {
           "value": "slide-right",
           "label": "Right"
         }
       ]
     },
     {
       "type": "range",
       "id": "healing_speed",
       "label": "Healing speed",
       "min": 10,
       "max": 30,
       "step": 1,
       "unit": "s",
       "default": 10
     },
     {
       "type": "color",
       "id": "cl_bg",
       "label": "Background color",
       "default": "#B3E359"
     },
     {
       "type": "color",
       "id": "cl_text",
       "label": "Color text",
       "default": "#212529"
     }
   ],
"blocks": [
   {
   "type": "text",
   "name": "Text",
   "settings": [
       {
         "type": "richtext",
         "id": "text",
         "label": "Text",
         "default": "<p>😍 &nbsp; Special offer: enjoy 3 months of shopify for $1/month</p>"
       }
     ]
   }],
   "presets": [
     {
       "name": "Text runs popup",
       "category": "Text",
	"blocks": [
         { "type": "text" },
         { "type": "text" },
         { "type": "text" },
         { "type": "text" },
         { "type": "text" },
         { "type": "text" },
         { "type": "text" },
         { "type": "text" },
         { "type": "text" },
         { "type": "text" },
         { "type": "text" },
         { "type": "text" }
       ]
     }
   ]
 }
{%- endschema -%}
