{% liquid
  assign sid = section.id 
  assign layout = section.settings.layout
  assign se_blocks = section.blocks
  assign se_size = se_blocks.size
  assign space_between = section.settings['space-Between']
  assign navigation = section.settings.navigation
  assign pagination = section.settings.pagination
  if section.settings['use-slider']
    assign use_slider = true
  else
    assign use_slider = false
  endif
  assign sett_equal = section.settings.use_eq_height
  assign image_ratio = section.settings.image_ratio
  if sett_equal
    case image_ratio
      when 'ratio2_1'
        assign aspect_ratio = 2.0
      when 'ratio3_2'
        assign aspect_ratio = 1.5
      when 'ratio4_3'
        assign aspect_ratio = 1.333
      when 'ratio1_1'
        assign aspect_ratio = 1.0
      when 'ratio3_4'
        assign aspect_ratio = 0.75
      when 'ratio2_3'
        assign aspect_ratio = 0.66667
      when 'ratio1_2'
        assign aspect_ratio = 0.5
      when 'custom'
        assign custom_ratio = section.settings.custom_ratio | split: '/'
        assign width = custom_ratio[0]
        assign height = custom_ratio[1] | times: 1.0
        assign aspect_ratio = width | divided_by: height
    endcase
  endif
%}
{{ 'section-collection.css' | asset_url | stylesheet_tag }}
<section id="laber_{{sid}}" class="wow animate--slide-in" style="--alo-container-width:{{ section.settings.custom_width }}px;">
  <div class="container {%if layout %}full-width{%endif%}" >   
    <div class="sub-collection-featured ">
        {% if section.settings.title != blank %}
          <div class="wrap_title {{ section.settings.text_size }} w_{{ section.settings.d_position }} mb-30 sm:mb-20">
            <h3
              class="section-title text-transform"
                style="
                  --cl-text:{{ section.settings.cl_title |default:"#333333" }};
                  --text-transform:{{ section.settings.text_transform }}">
              {{ section.settings.title }}
            </h3>
          </div>
        {% endif %}
    <div class="sub-collection">
    <div class="content_section slick-carousel">
    {% # theme-check-disable %}
   {% include 'grid-slider', settings: section.settings %}
        <grid-slider class="grid-slider" {{ gridSlider }}>
          <div class="swiper iSwiper" {%- render 'skeleton', settings: section.settings -%} style="--perload-gap: {{ space_between}}px">
            <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
            {% assign index = 1 %} 
            {%- for block in section.blocks -%}
        		<article class="swiper-slide alo-loop scroll-trigger" style="--animation-order:{{ index }};"> 	
                {%- include 'sub-collection',block:block,aspect_ratio:aspect_ratio,for_i:se_size -%}
              </article> 
            {% assign index = index | plus: 1 %}
            {%- endfor -%}
          </div>
        {% if use_slider == true %}
          {% if navigation %}
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
          {% endif %}
          {% if pagination %}
            <div class="swiper-pagination"></div>
          {% endif %}
        {% endif %}
      </div>
    </grid-slider>
      {% # theme-check-enable %}  
  </div>
    </div>
  </div>
  </div>  
</section>
{%- render 'section_style' -%} 
