{{ 'product_sidebar.css' | asset_url | stylesheet_tag }} 
{% liquid
	assign sid = section.id
    assign blocks = section.blocks
%}
<section id="laber_{{sid}}" class="product-sidebar">     
{%- if blocks.size > 0 -%}
  {%- for block in blocks -%}
{% liquid
    assign sett_equal = block.settings.use_eq_height
    assign image_ratio = block.settings.image_ratio
    if sett_equal 
    case image_ratio
      when 'ratio2_1'
          assign aspect_ratio = 2.0
      when 'ratio3_2'
          assign aspect_ratio = 1.5
      when 'ratio4_3'
          assign aspect_ratio = 1.333
      when 'ratio1_1'
          assign aspect_ratio = 1.0
      when 'ratio3_4'
          assign aspect_ratio = 0.75
      when 'ratio2_3'
          assign aspect_ratio = 0.66667
      when 'ratio1_2'
          assign aspect_ratio = 0.5
    endcase 
    endif
  %}
  {%- case block.type -%}
  {% when 'menu' %}
  <div class="menu_categories mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb_mobile }}" style="--font-size:{{ block.settings.font-size }}px;--font-weight:{{ block.settings.font-weight }};">
    {% if block.settings.title_categories != blank %}
      <h3 class="b-title mb-10 sm:mb-10">
        {{ block.settings.title_categories }}
      </h3>
    {% endif %}
    {% if block.settings.menu %}
      {% render 'magic-accordion', menu: block.settings.menu, use_thumb: block.settings.use_thumb %}
    {% endif %}
  </div>  
  {%- when 'benefit' -%}
    <div class="laber_benefit mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb_mobile }}" style="--cl-icon:{{ block.settings.cl_icon }};--cl-text:{{ block.settings.cl_heading }};--cl-content:{{ block.settings.cl_text }};">
      {% if block.settings.show_benefit_1 %}
      <div class="item-benefit">
        {%- if block.settings.source == '1' -%}
          <div class="icon">
            <i class="{{block.settings.icon}}"></i>
          </div>
        {%- elsif block.settings.source == '2' -%}
        <div class=" icon img">
          {% assign image = block.settings.icon_img %}
          {% if image != blank %} 
              {% render 'responsive-image', image: image, image_class: 'w-full h-full' %}
            {% else %}
                  {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                  {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
            {% endif %}
        </div>
        {%- else -%}
        <div class="icon svg">
          {{block.settings.code_svg_1}}
        </div>
        {%- endif -%}
        <div class="content">
          <p class="title">{{block.settings.title}}</p>
          <div class="c_benefit">{{block.settings.c_benefit}}</div>
        </div>
      </div>
      {%endif%}
      
      
      {% if block.settings.show_benefit_2 %}
      <div class="item-benefit">
        {%- if block.settings.source == '1' -%}
        <div class="icon">
          <i class="{{block.settings.icon2}}"></i>
        </div>
        {%- elsif block.settings.source == '2' -%}
        <div class=" icon img">
         {% assign image = block.settings.icon_img2 %}
          {% if image != blank %} 
              {% render 'responsive-image', image: image, image_class: 'w-full h-full' %}
            {% else %}
                  {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                  {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
            {% endif %}
        </div>
        {%- else -%}
        <div class="icon svg">
          {{block.settings.code_svg_2}}
        </div>
        {%- endif -%}
        <div class="content">
          <p class="title">{{block.settings.title2}}</p>
          <div class="c_benefit">{{block.settings.c_benefit2}}</div>
        </div>
      </div>
      {%endif%}
      
      
      {% if block.settings.show_benefit_3 %}
      <div class="item-benefit">
        {%- if block.settings.source == '1' -%}
        <div class="icon">
          <i class="{{block.settings.icon3}}"></i>
        </div>
        {%- elsif block.settings.source == '2' -%}
        <div class=" icon img">
          {% assign image = block.settings.icon_img3 %}
          {% if image != blank %} 
              {% render 'responsive-image', image: image, image_class: 'w-full h-full' %}
            {% else %}
                  {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                  {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
            {% endif %}
        </div>
        {%- else -%}
        <div class="icon svg">
          {{block.settings.code_svg_3}}
        </div>
        {%- endif -%}
        <div class="content">
          <p class="title">{{block.settings.title3}}</p>
          <div class="c_benefit">{{block.settings.c_benefit3}}</div>
        </div>
      </div>
      {%endif%}

      {% if block.settings.show_benefit_4 %}
      <div class="item-benefit">
        {%- if block.settings.source == '1' -%}
        <div class="icon">
          <i class="{{block.settings.icon4}}"></i>
        </div>
        {%- elsif block.settings.source == '2' -%}
        <div class=" icon img">
          {% assign image = block.settings.icon_img4 %}
          {% if image != blank %} 
              {% render 'responsive-image', image: image, image_class: 'w-full h-full' %}
            {% else %}
                  {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                  {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
            {% endif %}
        </div>
        {%- else -%}
        <div class="icon svg">
          {{block.settings.code_svg_4}}
        </div>
        {%- endif -%}
        <div class="content">
          <p class="title">{{block.settings.title4}}</p>
          <div class="c_benefit">{{block.settings.c_benefit4}}</div>
        </div>
      </div>
      {%endif%}
    </div>
    {%- when 'promobox' -%}
    
    <div class="laber_promobox mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb_mobile }}">
      <div class="promobox">
        {% assign image = block.settings.image_promobox %}
        {% assign url = block.settings.url %}
        {% assign border = block.settings.border %}
        {% if image != blank %}
            {% render 'responsive-image',
              image: image,
              border: border,
              aspect_ratio:aspect_ratio,
              url: url,
              image_class: 'w-full h-full'
            %}
          {% else %}
            {% if aspect_ratio != blank %}
               {%- assign ratio =  1 | divided_by: aspect_ratio | times: 100 -%}
            {% else %}
                {%- assign ratio = 100 -%}
            {% endif %}
            <div class="image-card__img overflow-hidden alo-border-radius ratio" style="--alo-border-radius:{{ border }}px;--ratio-percent: {{ ratio }}%;">
              {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
              {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
            </div>
          {% endif %}
        {% if block.settings.title != blank %}
        <div class="promobox-content">
          <div class="title">{{block.settings.title}}</div>
          <div class="h3 sub_title">{{block.settings.sub_title}}</div>
          <div class="content">{{block.settings.content}}</div>
        </div>
        {%endif%}
      </div>
    </div>
    {%- when 'product_slider' -%} 
           {%- assign products = block.settings.product_list -%}   
            {%-assign limit = block.settings.max_count-%}   
            {%-assign space_between = block.settings.space-Between-%}   
            {%-assign navigation = block.settings.navigation-%}   
            {%-assign pagination = block.settings.pagination-%}   
            {%-assign use_slider = block.settings.use-slider   -%}          
            <div id="bl_{{block.id}}" class="alo-product-slider mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb_mobile }}" style="--font-size:{{ block.settings.font-size }}px;--font-weight:{{ block.settings.font-weight }};">
              {% if block.settings.title != blank %}
                <h3 class="b-title mb-20 sm:mb-20">{{ block.settings.title }}</h3>
              {% endif %}
              <div class="products-slider">
                  {% # theme-check-disable %}
                  {% include 'grid-slider', settings: block.settings %}
                  <grid-slider class="grid-slider" {{ gridSlider }}>
                    <div
                      class="swiper iSwiper"
                      {%- render 'skeleton', settings: block.settings -%}
                      style="--perload-gap: {{ space_between}}px"
                    >
                      <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                        {% if products != blank %}
                          {%- for product in products limit: limit -%}
                            {% if block.settings.s_product == 'vertical' %}
                            <div
                                class="swiper-slide lazyload scroll-trigger"
                                style="--animation-order:{{ index }};"
                                data-include="/products/{{product.handle}}/?view=pr_lazy_load"
                              >{% include 'product_style' %} </div>
                              {% else %}
                                <div class="swiper-slide">
                                  {% include 'product-column' %} 
                                </div>
                              {% endif %}
                          {%- endfor -%}
                        {% else %}
              
                          {%- for i in (1..limit) -%}
                            {% if block.settings.s_product == 'vertical' %}
                            <div class="swiper-slide pr_grid_item">
                              {% render 'product_demo' %}
                            </div>
                              {% else %}
                                 <div class="pr_grid_item swiper-slide">
                                  {% render 'product_demo_column' %} 
                                </div>
                              {% endif %}
                          {%- endfor -%}
                        {% endif %}
                      </div>
                      {% if use_slider == true %}
                        {% if navigation %}
                          <div class="swiper-button">
                            <div class="swiper-button-next"></div>
                            <div class="swiper-button-prev"></div>
                          </div>
                        {% endif %}
                        {% if pagination %}
                          <div class="swiper-pagination"></div>
                        {% endif %}
                      {% endif %}
                    </div>
                  </grid-slider>
                {% # theme-check-enable %}
              </div>
            </div>          	
        {%- when 'products' -%}
			<div id="bl_{{block.id}}" class="laber-product mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb_mobile }}" style="--font-size:{{ block.settings.font-size }}px;--font-weight:{{ block.settings.font-weight }};">
              {%if block.settings.title != blank%}	
              	<div class="title mb-10 sm:mb-10" >
                  <span>{{block.settings.title}}</span>
                </div>
              {%endif%}
              <div class="products-column" style="--perload-gap:20px;">
                <div class="list-product">
                   {%- assign products = block.settings.product_list -%} 
                  {%- for product in products -%}
                    {% # theme-check-disable %}
                      {% include 'product-column', product: product %}
                    {% # theme-check-enable %}
                  {%- endfor -%}  
                </div>
              </div>
  			</div>
  			{%style%}
  				
                  #bl_{{block.id}}{
                      {%if block.settings.pd != blank%}padding:{{block.settings.pd}};{%endif%}
  				      {%if block.settings.cl_bg != blank%}background-color: {{block.settings.cl_bg}};{%endif%}
                  }
  				
  			{%endstyle%}
  
  {%- endcase -%}
  {%- endfor -%}
{%- endif -%} 
</section>
{%- render 'section_style' -%}
