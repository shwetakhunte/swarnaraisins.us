{% schema %}
{
  "name": "S6 Premium Product",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Product Subtitle",
      "default": "Daily nutrition to support modern diets"
    },
    {
      "type": "text",
      "id": "description_text",
      "label": "Description Text",
      "default": "Fill everyday nutrient and gut-health needs with essential vitamins, minerals, probiotics, and prebiotics from whole foods."
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promo Banner Text",
      "default": "Avail extra 15% off using code GLAD15"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Badge Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Badge Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "S6 Premium Product Main",
      "category": "Product"
    }
  ]
}
{% endschema %}

{{ 'supplysix-style.css' | asset_url | stylesheet_tag }}

<div class="s6-pdp-wrapper-v2">
  <div class="s6-pdp-grid-v2">
    
    <!-- INFO COLUMN (LEFT) -->
    <div class="s6-info-col-v2">
      <h1 class="s6-title-v2">{{ product.title }}</h1>
      
      {% if section.settings.subtitle != blank %}
        <p class="s6-subtitle-v2">{{ section.settings.subtitle }}</p>
      {% endif %}

      <div class="s6-reviews-row-v2">
        <div class="s6-stars-v2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#f6a429"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#f6a429"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#f6a429"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#f6a429"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#f6a429"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <span class="s6-review-text-v2">263 reviews</span>
        </div>
        <div class="s6-loved-badge-v2">Loved by 2L+ Customers</div>
      </div>

      <p class="s6-desc-v2">{{ section.settings.description_text }}</p>

      <div class="s6-feature-grid-v2">
        <div class="s6-feature-item-v2">
          <span class="s6-feature-icon-v2">🌾</span> Supports Digestive Health
        </div>
        <div class="s6-feature-item-v2">
          <span class="s6-feature-icon-v2">⚡</span> Natural Energy
        </div>
        <div class="s6-feature-item-v2">
          <span class="s6-feature-icon-v2">🛡️</span> Rich in Antioxidants
        </div>
        <div class="s6-feature-item-v2">
          <span class="s6-feature-icon-v2">❤️</span> Supports Heart Health
        </div>
        <div class="s6-feature-item-v2">
          <span class="s6-feature-icon-v2">🦴</span> Supports Bone Health
        </div>
        <div class="s6-feature-item-v2">
          <span class="s6-feature-icon-v2">🩸</span> Iron for Everyday Vitality
        </div>
      </div>

      <div class="s6-secondary-buttons-v2">
        <button class="s6-sec-btn-v2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            <a class="text-white" href="https://swarnaraisins.us/pages/swarna-safety-shield">Nutritional Research</a>
        </button>
        <button class="s6-sec-btn-v2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
          <a class="text-white" href="https://swarnaraisins.us/pages/swarna-safety-shield">Lab Test Reports</a> 
        </button>
      </div>

      {% if section.settings.promo_text != blank %}
      <div class="s6-promo-banner-v2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="15" x2="15.01" y2="15"></line></svg>
        {{ section.settings.promo_text }}
      </div>
      {% endif %}

      <form action="/cart/add" method="post" id="s6-form-v2">
        <div class="s6-variant-boxes-v2">
          {% if product.has_only_default_variant == false %}
            {% for variant in product.variants %}
              
              <!-- Map Index to Display Styles -->
              {% assign is_highlighted = false %}
              {% if forloop.index == 2 %}
                {% assign is_highlighted = true %}
              {% endif %}

              <label class="s6-vbox {% if is_highlighted %}highlighted{% endif %} {% if forloop.first and is_highlighted == false %}selected{% elsif is_highlighted %}selected{% endif %}" onclick="s6SelectVarBox(this, '{{ variant.id }}')">
                <input type="radio" name="id" value="{{ variant.id }}" class="hidden-radio" {% if is_highlighted %}checked{% endif %}>
                
                {% if is_highlighted %}
                  <div class="s6-vbox-ribbon">Best Results</div>
                {% endif %}

                <div class="s6-vbox-top">
                  <div class="s6-vbox-title">
                    {% if forloop.index == 1 %}15 Days{% elsif forloop.index == 2 %}30 Days{% else %}60 Days{% endif %}
                  </div>
                  {% if variant.compare_at_price > variant.price %}
                    <div class="s6-vbox-compare">{{ variant.compare_at_price | money }}</div>
                  {% endif %}
                  <div class="s6-vbox-price">{{ variant.price | money }}</div>
                </div>

                <div class="s6-vbox-bottom">
                  <div class="s6-vbox-serving">
                    {% if forloop.index == 1 %}₹ 72/serving{% elsif forloop.index == 2 %}₹ 68/serving{% else %}₹ 65/serving{% endif %}
                  </div>
                  {% if variant.compare_at_price > variant.price %}
                    {% assign savings = variant.compare_at_price | minus: variant.price %}
                    <div class="s6-vbox-save">Save {{ savings | money }}</div>
                  {% endif %}
                  {% if is_highlighted %}
                    <div class="s6-vbox-mrp">MRP (Incl. of all taxes)</div>
                  {% endif %}
                </div>
              </label>
            {% endfor %}
          {% else %}
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          {% endif %}
        </div>

        <button type="submit" class="s6-atc-btn-v2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          ADD TO CART
        </button>
      </form>

    </div>

    <!-- MEDIA COLUMN (RIGHT) -->
    <div class="s6-media-col-v2">
      <div class="s6-image-container-v2">
        <div class="s6-clinically-bar-v2">Food Safety Tested</div>
        <div class="s6-image-inner-v2">
          <div class="s6-arrow-v2 s6-arrow-left" id="s6-prev-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </div>
          <div class="s6-arrow-v2 s6-arrow-right" id="s6-next-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </div>
          <img id="s6-main-product-image" src="{{ product.featured_image | img_url: '1000x' }}" alt="{{ product.title }}">
          <div class="s6-zoom-icon-v2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- ZOOM MODAL LIGHTBOX -->
<div id="s6-zoom-modal" class="s6-zoom-modal" style="display: none;">
  <span class="s6-modal-close">&times;</span>
  <div class="s6-modal-arrow s6-modal-arrow-left" id="s6-modal-prev">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
  </div>
  <div class="s6-modal-content-container" id="s6-modal-container">
    <img id="s6-modal-image" src="" alt="Zoomed product image">
  </div>
  <div class="s6-modal-arrow s6-modal-arrow-right" id="s6-modal-next">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
  </div>
</div>

<style>
.s6-zoom-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(10, 10, 10, 0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 100000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}
.s6-zoom-modal.active {
  opacity: 1;
  pointer-events: auto;
}
.s6-modal-close {
  position: absolute;
  top: 25px;
  right: 35px;
  color: rgba(255, 255, 255, 0.8);
  font-size: 44px;
  font-weight: 200;
  cursor: pointer;
  transition: color 0.2s, transform 0.2s;
  z-index: 100002;
  line-height: 1;
}
.s6-modal-close:hover {
  color: #fff;
  transform: scale(1.1);
}
.s6-modal-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  color: rgba(255, 255, 255, 0.8);
  cursor: pointer;
  z-index: 100002;
  padding: 15px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s, color 0.2s, transform 0.2s;
}
.s6-modal-arrow:hover {
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  transform: translateY(-50%) scale(1.05);
}
.s6-modal-arrow-left {
  left: 40px;
}
.s6-modal-arrow-right {
  right: 40px;
}
.s6-modal-content-container {
  max-width: 80%;
  max-height: 80%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  cursor: zoom-in;
  border-radius: 8px;
}
.s6-modal-content-container.zoomed {
  cursor: zoom-out;
}
.s6-modal-content-container img {
  max-width: 100%;
  max-height: 80vh;
  object-fit: contain;
  transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), transform-origin 0.1s ease;
  user-select: none;
  -webkit-user-drag: none;
}
@media (max-width: 768px) {
  .s6-modal-arrow-left { left: 15px; }
  .s6-modal-arrow-right { right: 15px; }
  .s6-modal-arrow { padding: 10px; }
  .s6-modal-close { top: 15px; right: 20px; font-size: 36px; }
}
</style>

<script>
  function s6SelectVarBox(el, variantId) {
    document.querySelectorAll('.s6-vbox').forEach(b => b.classList.remove('selected'));
    el.classList.add('selected');
    el.querySelector('input[type="radio"]').checked = true;
  }

  // Product Gallery Images Array
  const productImages = [
    {% for image in product.images %}
      "{{ image | img_url: '1000x' }}"{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  const productImageAlts = [
    {% for image in product.images %}
      "{{ image.alt | escape }}"{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  let currentImageIndex = 0;

  // Find the index of the current featured image in productImages array
  const initialSrc = "{{ product.featured_image | img_url: '1000x' }}";
  const matchedIndex = productImages.findIndex(src => src.includes(initialSrc.split('?')[0].split('_1000x')[0]));
  if (matchedIndex !== -1) {
    currentImageIndex = matchedIndex;
  }

  const mainImage = document.getElementById('s6-main-product-image');
  const prevBtn = document.getElementById('s6-prev-btn');
  const nextBtn = document.getElementById('s6-next-btn');
  const zoomIcon = document.querySelector('.s6-zoom-icon-v2');

  function updateMainImage(index) {
    if (index >= 0 && index < productImages.length) {
      currentImageIndex = index;
      mainImage.src = productImages[currentImageIndex];
      mainImage.alt = productImageAlts[currentImageIndex] || "{{ product.title }}";
    }
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      let index = currentImageIndex - 1;
      if (index < 0) index = productImages.length - 1;
      updateMainImage(index);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      let index = currentImageIndex + 1;
      if (index >= productImages.length) index = 0;
      updateMainImage(index);
    });
  }

  // Lightbox Modal Functionality
  const zoomModal = document.getElementById('s6-zoom-modal');
  const modalClose = document.querySelector('.s6-modal-close');
  const modalImage = document.getElementById('s6-modal-image');
  const modalContainer = document.getElementById('s6-modal-container');
  const modalPrev = document.getElementById('s6-modal-prev');
  const modalNext = document.getElementById('s6-modal-next');
  let modalZoomed = false;

  function openLightbox() {
    modalImage.src = productImages[currentImageIndex];
    modalImage.alt = productImageAlts[currentImageIndex] || "{{ product.title }}";
    zoomModal.style.display = 'flex';
    // Force reflow
    zoomModal.offsetHeight;
    zoomModal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    zoomModal.classList.remove('active');
    setTimeout(() => {
      zoomModal.style.display = 'none';
      modalImage.src = '';
      resetZoom();
    }, 300);
    document.body.style.overflow = '';
  }

  function resetZoom() {
    modalZoomed = false;
    modalContainer.classList.remove('zoomed');
    modalImage.style.transform = 'scale(1)';
  }

  function updateModalImage(index) {
    if (index >= 0 && index < productImages.length) {
      currentImageIndex = index;
      resetZoom();
      modalImage.src = productImages[currentImageIndex];
      modalImage.alt = productImageAlts[currentImageIndex] || "{{ product.title }}";
      // Sync main image on page as well
      updateMainImage(currentImageIndex);
    }
  }

  // Bind trigger elements
  if (mainImage) {
    mainImage.style.cursor = 'zoom-in';
    mainImage.addEventListener('click', openLightbox);
  }
  if (zoomIcon) {
    zoomIcon.addEventListener('click', openLightbox);
  }

  // Close triggers
  modalClose.addEventListener('click', closeLightbox);
  zoomModal.addEventListener('click', (e) => {
    if (e.target === zoomModal) {
      closeLightbox();
    }
  });

  // Modal Arrows
  modalPrev.addEventListener('click', (e) => {
    e.stopPropagation();
    let index = currentImageIndex - 1;
    if (index < 0) index = productImages.length - 1;
    updateModalImage(index);
  });
  modalNext.addEventListener('click', (e) => {
    e.stopPropagation();
    let index = currentImageIndex + 1;
    if (index >= productImages.length) index = 0;
    updateModalImage(index);
  });

  // Zoom implementation inside modal
  modalContainer.addEventListener('click', (e) => {
    if (e.target === modalPrev || e.target === modalNext || e.target.closest('.s6-modal-arrow')) return;
    
    modalZoomed = !modalZoomed;
    if (modalZoomed) {
      modalContainer.classList.add('zoomed');
      zoomAt(e);
    } else {
      resetZoom();
    }
  });

  modalContainer.addEventListener('mousemove', (e) => {
    if (modalZoomed) {
      zoomAt(e);
    }
  });

  function zoomAt(e) {
    const rect = modalContainer.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    const xPercent = (x / rect.width) * 100;
    const yPercent = (y / rect.height) * 100;
    modalImage.style.transformOrigin = `${xPercent}% ${yPercent}%`;
    modalImage.style.transform = 'scale(2.2)';
  }

  // Keyboard navigation
  window.addEventListener('keydown', (e) => {
    if (!zoomModal.classList.contains('active')) return;
    
    if (e.key === 'Escape') {
      closeLightbox();
    } else if (e.key === 'ArrowLeft') {
      let index = currentImageIndex - 1;
      if (index < 0) index = productImages.length - 1;
      updateModalImage(index);
    } else if (e.key === 'ArrowRight') {
      let index = currentImageIndex + 1;
      if (index >= productImages.length) index = 0;
      updateModalImage(index);
    }
  });
</script>

