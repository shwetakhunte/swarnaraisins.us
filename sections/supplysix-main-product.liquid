{% schema %}
{
  "name": "SupplySix Product Main",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Product Subtitle",
      "default": "Fill everyday nutrient and gut-health needs."
    },
    {
      "type": "text",
      "id": "loved_badge_text",
      "label": "Badge Text",
      "default": "Loved by Customers"
    },
    {
      "type": "text",
      "id": "subscription_discount",
      "label": "Subscription Discount Text",
      "default": "Save 15%"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Badge Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Badge Title",
          "default": "Zero Sugar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SupplySix Product Main",
      "category": "Product"
    }
  ]
}
{% endschema %}

{{ 'supplysix-style.css' | asset_url | stylesheet_tag }}

<div class="ss-pdp-wrapper">
  <!-- Mobile Title & Reviews (visible on mobile only) -->
  <div class="ss-pdp-header-mobile">
    <div class="ss-stars-mobile">★★★★★ <span class="ss-review-count">4.73 (263 reviews)</span></div>
    <h1 class="ss-title-mobile">{{ product.title }}</h1>
    {% if section.settings.subtitle != blank %}
      <p class="ss-subtitle-mobile">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>

  <div class="ss-pdp-container">
    <!-- Media Column -->
    <div class="ss-pdp-media">
      <div class="ss-media-main">
        <img id="ss-main-image" src="{{ product.featured_image | img_url: '1000x' }}" alt="{{ product.title }}">
      </div>
      {% if product.images.size > 1 %}
        <div class="ss-media-thumbnails">
          {% for image in product.images %}
            <div class="ss-thumb-item {% if forloop.first %}active{% endif %}" onclick="changeMainImage('{{ image | img_url: '1000x' }}', this)">
              <img src="{{ image | img_url: '150x' }}" alt="{{ product.title }}">
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Info Column -->
    <div class="ss-pdp-info">
      <!-- Desktop Title & Reviews -->
      <div class="ss-pdp-header-desktop">
        <h1 class="ss-title">{{ product.title }}</h1>
        {% if section.settings.subtitle != blank %}
          <p class="ss-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
        <div class="ss-reviews">
          <span class="ss-stars">★★★★★</span> <span class="ss-review-count">4.73 (263)</span>
        </div>
      </div>

      <!-- Form -->
      <form action="/cart/add" method="post" enctype="multipart/form-data" id="ss-add-to-cart-form">
        
        <!-- Variant Selection -->
        {% if product.has_only_default_variant == false %}
          <div class="ss-variants-grid">
            {% for variant in product.variants %}
              <label class="ss-variant-card {% if forloop.first %}selected{% endif %}" onclick="selectVariant(this, '{{ variant.id }}', {{ variant.price }}, {{ variant.compare_at_price | default: variant.price }})">
                <input type="radio" name="id" value="{{ variant.id }}" class="hidden-radio" {% if forloop.first %}checked{% endif %}>
                <div class="ss-var-name">{{ variant.title }}</div>
                <div class="ss-var-price-group">
                  {% if variant.compare_at_price > variant.price %}
                    <span class="ss-var-compare">{{ variant.compare_at_price | money }}</span>
                  {% endif %}
                  <span class="ss-var-price">{{ variant.price | money }}</span>
                </div>
              </label>
            {% endfor %}
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          <div class="ss-price-single" data-price="{{ product.price }}">
             {{ product.price | money }}
          </div>
        {% endif %}

        <!-- Subscription Toggle -->
        <div class="ss-subscription-box">
          <label class="ss-sub-option selected" onclick="toggleSubscription('subscribe')">
            <input type="radio" name="purchase_type" value="subscribe" class="hidden-radio" checked>
            <div class="ss-sub-radio"><div class="ss-dot"></div></div>
            <div class="ss-sub-content">
              <span class="ss-sub-title">Subscribe & Save {{ section.settings.subscription_discount }}</span>
              <span class="ss-sub-desc">Delivered every 30 days. Cancel anytime.</span>
            </div>
          </label>
          
          <label class="ss-sub-option" onclick="toggleSubscription('onetime')">
            <input type="radio" name="purchase_type" value="onetime" class="hidden-radio">
            <div class="ss-sub-radio"><div class="ss-dot"></div></div>
            <div class="ss-sub-content">
              <span class="ss-sub-title">One-time purchase</span>
            </div>
          </label>
        </div>
        
        <!-- Hidden selling plan input if needed by app -->
        <input type="hidden" name="selling_plan" value="12345" id="ss-selling-plan">

        <!-- Add to Cart Button -->
        <button type="submit" class="ss-btn-add-cart" id="ss-add-button">
          <span class="ss-btn-text">Add to cart</span>
          <span class="ss-btn-price" id="ss-btn-price-display">{{ product.price | money }}</span>
        </button>

        <!-- Trust Badges -->
        <div class="ss-trust-badges">
          {% for block in section.blocks %}
            <div class="ss-badge-item">
              {% if block.settings.icon %}
                <img src="{{ block.settings.icon | img_url: '100x' }}" alt="{{ block.settings.title }}">
              {% else %}
                <div class="ss-badge-placeholder"></div>
              {% endif %}
              <span>{{ block.settings.title }}</span>
            </div>
          {% endfor %}
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Sticky Add to Cart (Mobile) -->
<div class="ss-sticky-cart">
  <button type="button" class="ss-sticky-btn" onclick="document.getElementById('ss-add-button').click()">
    Add to cart - <span id="ss-sticky-price">{{ product.price | money }}</span>
  </button>
</div>

<script>
  let currentPrice = {{ product.price }};
  let isSubscribed = true;

  function changeMainImage(url, el) {
    document.getElementById('ss-main-image').src = url;
    document.querySelectorAll('.ss-thumb-item').forEach(i => i.classList.remove('active'));
    el.classList.add('active');
  }

  function selectVariant(el, id, price, comparePrice) {
    document.querySelectorAll('.ss-variant-card').forEach(i => i.classList.remove('selected'));
    el.classList.add('selected');
    currentPrice = price;
    updatePrices();
  }

  function toggleSubscription(type) {
    document.querySelectorAll('.ss-sub-option').forEach(i => i.classList.remove('selected'));
    isSubscribed = (type === 'subscribe');
    
    event.currentTarget.classList.add('selected');
    if (isSubscribed) {
      document.getElementById('ss-selling-plan').value = "12345";
    } else {
      document.getElementById('ss-selling-plan').value = "";
    }
    updatePrices();
  }

  function updatePrices() {
    // Assuming 15% discount for subscribe
    let finalPrice = isSubscribed ? (currentPrice * 0.85) : currentPrice;
    
    // Format money (basic formatter for demo)
    let formattedPrice = '₹' + (finalPrice / 100).toFixed(2);
    
    document.getElementById('ss-btn-price-display').innerText = formattedPrice;
    document.getElementById('ss-sticky-price').innerText = formattedPrice;
  }

  // Sticky header visibility on scroll
  window.addEventListener('scroll', function() {
    let addBtn = document.getElementById('ss-add-button');
    let sticky = document.querySelector('.ss-sticky-cart');
    
    if (window.scrollY > (addBtn.offsetTop + addBtn.offsetHeight)) {
      sticky.classList.add('visible');
    } else {
      sticky.classList.remove('visible');
    }
  });
</script>
