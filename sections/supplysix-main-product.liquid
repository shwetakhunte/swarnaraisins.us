{% schema %}
{
  "name": "SupplySix Product Page",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Product Subtitle",
      "default": "Daily nutrition to support modern diets"
    },
    {
      "type": "text",
      "id": "loved_badge_text",
      "label": "Badge Text",
      "default": "Loved by Customers"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Badge Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Badge Title",
          "default": "Zero Sugar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SupplySix Product Page",
      "category": "Product"
    }
  ]
}
{% endschema %}

{{ 'supplysix-style.css' | asset_url | stylesheet_tag }}

<div class="ss-product-template">
  <!-- Top Hero Section -->
  <div class="ss-product-top-bg">
    <div class="ss-product-container">
      <div class="ss-product-columns">
        
        <!-- Left Column: Product Info -->
        <div class="ss-product-info-col">
          <h1 class="ss-prod-title">{{ product.title }}</h1>
          
          {% if section.settings.subtitle != blank %}
            <p class="ss-prod-subtitle">{{ section.settings.subtitle }}</p>
          {% endif %}
          
          <div class="ss-prod-reviews">
            <span class="ss-stars">★★★★★</span> 
            <span class="ss-review-count">263 reviews</span>
            {% if section.settings.loved_badge_text != blank %}
              <span class="ss-loved-badge">{{ section.settings.loved_badge_text }}</span>
            {% endif %}
          </div>

          <div class="ss-prod-description">
            {{ product.description }}
          </div>

          <!-- Add to Cart Form with Custom Variant Pack Selectors -->
          <form action="/cart/add" method="post" enctype="multipart/form-data" id="AddToCartForm-{{ section.id }}">
            
            {% if product.has_only_default_variant == false %}
              <div class="ss-variant-boxes">
                {% for variant in product.variants %}
                  <label class="ss-variant-box {% if forloop.first %}selected{% endif %}" for="variant-{{ variant.id }}">
                    <input type="radio" name="id" value="{{ variant.id }}" id="variant-{{ variant.id }}" {% if forloop.first %}checked{% endif %} class="hidden-radio" onchange="updateVariantSelection(this)">
                    
                    {% if forloop.index == 2 %}
                      <div class="ss-var-badge">Best Results</div>
                    {% endif %}
                    
                    <div class="ss-var-title">{{ variant.title }}</div>
                    
                    <div class="ss-var-prices">
                      {% if variant.compare_at_price > variant.price %}
                         <div class="ss-var-compare struck">{{ variant.compare_at_price | money }}</div>
                      {% endif %}
                      <div class="ss-var-price">{{ variant.price | money }}</div>
                    </div>
                    
                    <div class="ss-var-savings">
                      {% if variant.compare_at_price > variant.price %}
                        Save {{ variant.compare_at_price | minus: variant.price | money }}
                      {% else %}
                        Select
                      {% endif %}
                    </div>
                  </label>
                {% endfor %}
              </div>
            {% else %}
              <input type="hidden" name="id" value="{{ product.variants.first.id }}">
              <div class="ss-single-price-wrapper">
                {% if product.compare_at_price > product.price %}
                  <span class="ss-single-sale">{{ product.price | money }}</span>
                  <span class="ss-single-regular struck">{{ product.compare_at_price | money }}</span>
                {% else %}
                  <span class="ss-single-price">{{ product.price | money }}</span>
                {% endif %}
              </div>
            {% endif %}

            <!-- Quantity (hidden or optional, SupplySix usually forces 1 for packs) -->
            <input type="hidden" name="quantity" value="1" min="1">

            <button type="submit" class="ss-prod-add-to-cart" id="AddToCart-{{ section.id }}" {% unless product.available %}disabled{% endunless %}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span id="AddToCartText-{{ section.id }}">
                {% if product.available %}ADD TO CART{% else %}SOLD OUT{% endif %}
              </span>
            </button>
          </form>
        </div>

        <!-- Right Column: Product Images -->
        <div class="ss-product-image-col">
          <div class="ss-image-badge-wrapper">
            <div class="ss-clinically-tested-bar">Clinically Tested</div>
            <div class="ss-main-image">
              <img id="ss-featured-image" src="{{ product.featured_image | img_url: '1000x' }}" alt="{{ product.title }}">
            </div>
          </div>
          
          {% if product.images.size > 1 %}
            <div class="ss-thumbnails">
              {% for image in product.images %}
                <img src="{{ image | img_url: '150x' }}" class="ss-thumb {% if forloop.first %}active{% endif %}" alt="{{ product.title }}" onclick="changeMainImage('{{ image | img_url: '1000x' }}', this)">
              {% endfor %}
            </div>
          {% endif %}
        </div>

      </div>
    </div>
  </div>
  
  <!-- Trust Badges Strip -->
  <div class="ss-trust-badges-strip">
    <div class="ss-product-container">
      <div class="ss-trust-badges-flex">
        {% for block in section.blocks %}
          {% if block.type == 'trust_badge' %}
            <div class="ss-trust-badge">
              {% if block.settings.icon != blank %}
                <img src="{{ block.settings.icon | img_url: '100x' }}" alt="{{ block.settings.title }}">
              {% else %}
                <!-- Placeholder SVG if no image uploaded -->
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--brand-green)" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              {% endif %}
              <span>{{ block.settings.title }}</span>
            </div>
          {% endif %}
        {% endfor %}
        <!-- Default badges if no blocks are added -->
        {% if section.blocks.size == 0 %}
            <div class="ss-trust-badge">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--brand-green)" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>Zero Sugar</span>
            </div>
            <div class="ss-trust-badge">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--brand-green)" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>No Preservatives</span>
            </div>
            <div class="ss-trust-badge">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--brand-green)" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>Plant Based</span>
            </div>
            <div class="ss-trust-badge">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--brand-green)" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>Non-GMO</span>
            </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<script>
  function changeMainImage(url, element) {
    document.getElementById('ss-featured-image').src = url;
    document.querySelectorAll('.ss-thumb').forEach(thumb => thumb.classList.remove('active'));
    element.classList.add('active');
  }

  function updateVariantSelection(radio) {
    document.querySelectorAll('.ss-variant-box').forEach(box => box.classList.remove('selected'));
    radio.parentElement.classList.add('selected');
  }
</script>
