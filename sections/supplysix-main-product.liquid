{% schema %}
{
  "name": "S6 Premium Product",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Product Subtitle",
      "default": "Daily nutrition to support modern diets"
    },
    {
      "type": "text",
      "id": "description_text",
      "label": "Description Text",
      "default": "Fill everyday nutrient and gut-health needs with essential vitamins, minerals, probiotics, and prebiotics from whole foods."
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promo Banner Text",
      "default": "Avail extra 15% off using code GLAD15"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Badge Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Badge Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "S6 Premium Product Main",
      "category": "Product"
    }
  ]
}
{% endschema %}

{{ 'supplysix-style.css' | asset_url | stylesheet_tag }}

<div class="s6-pdp-wrapper-v2">
  <div class="s6-pdp-grid-v2">
    
    <!-- INFO COLUMN (LEFT) -->
    <div class="s6-info-col-v2">
      <h1 class="s6-title-v2">{{ product.title }}</h1>
      
      {% if section.settings.subtitle != blank %}
        <p class="s6-subtitle-v2">{{ section.settings.subtitle }}</p>
      {% endif %}

      <div class="s6-reviews-row-v2">
        <div class="s6-stars-v2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#f6a429"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#f6a429"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#f6a429"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#f6a429"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#f6a429"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <span class="s6-review-text-v2">263 reviews</span>
        </div>
        <div class="s6-loved-badge-v2">Loved by 2L+ Customers</div>
      </div>

      <p class="s6-desc-v2">{{ section.settings.description_text }}</p>

      <div class="s6-feature-grid-v2">
        <div class="s6-feature-item-v2">
          <span class="s6-feature-icon-v2">🌾</span> Supports Digestive Health
        </div>
        <div class="s6-feature-item-v2">
          <span class="s6-feature-icon-v2">⚡</span> Natural Energy
        </div>
        <div class="s6-feature-item-v2">
          <span class="s6-feature-icon-v2">🛡️</span> Rich in Antioxidants
        </div>
        <div class="s6-feature-item-v2">
          <span class="s6-feature-icon-v2">❤️</span> Supports Heart Health
        </div>
        <div class="s6-feature-item-v2">
          <span class="s6-feature-icon-v2">🦴</span> Supports Bone Health
        </div>
        <div class="s6-feature-item-v2">
          <span class="s6-feature-icon-v2">🩸</span> Iron for Everyday Vitality
        </div>
      </div>

      <div class="s6-secondary-buttons-v2">
        <button class="s6-sec-btn-v2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            <a href="https://swarnaraisins.us/pages/swarna-safety-shield">Nutritional Research</a>
        </button>
        <button class="s6-sec-btn-v2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
          <a href="https://swarnaraisins.us/pages/swarna-safety-shield">Lab Test Reports</a> 
        </button>
      </div>

      {% if section.settings.promo_text != blank %}
      <div class="s6-promo-banner-v2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="15" x2="15.01" y2="15"></line></svg>
        {{ section.settings.promo_text }}
      </div>
      {% endif %}

      <form action="/cart/add" method="post" id="s6-form-v2">
        <div class="s6-variant-boxes-v2">
          {% if product.has_only_default_variant == false %}
            {% for variant in product.variants %}
              
              <!-- Map Index to Display Styles -->
              {% assign is_highlighted = false %}
              {% if forloop.index == 2 %}
                {% assign is_highlighted = true %}
              {% endif %}

              <label class="s6-vbox {% if is_highlighted %}highlighted{% endif %} {% if forloop.first and is_highlighted == false %}selected{% elsif is_highlighted %}selected{% endif %}" onclick="s6SelectVarBox(this, '{{ variant.id }}')">
                <input type="radio" name="id" value="{{ variant.id }}" class="hidden-radio" {% if is_highlighted %}checked{% endif %}>
                
                {% if is_highlighted %}
                  <div class="s6-vbox-ribbon">Best Results</div>
                {% endif %}

                <div class="s6-vbox-top">
                  <div class="s6-vbox-title">
                    {% if forloop.index == 1 %}15 Days{% elsif forloop.index == 2 %}30 Days{% else %}60 Days{% endif %}
                  </div>
                  {% if variant.compare_at_price > variant.price %}
                    <div class="s6-vbox-compare">{{ variant.compare_at_price | money }}</div>
                  {% endif %}
                  <div class="s6-vbox-price">{{ variant.price | money }}</div>
                </div>

                <div class="s6-vbox-bottom">
                  <div class="s6-vbox-serving">
                    {% if forloop.index == 1 %}₹ 72/serving{% elsif forloop.index == 2 %}₹ 68/serving{% else %}₹ 65/serving{% endif %}
                  </div>
                  {% if variant.compare_at_price > variant.price %}
                    {% assign savings = variant.compare_at_price | minus: variant.price %}
                    <div class="s6-vbox-save">Save {{ savings | money }}</div>
                  {% endif %}
                  {% if is_highlighted %}
                    <div class="s6-vbox-mrp">MRP (Incl. of all taxes)</div>
                  {% endif %}
                </div>
              </label>
            {% endfor %}
          {% else %}
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          {% endif %}
        </div>

        <button type="submit" class="s6-atc-btn-v2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          ADD TO CART
        </button>
      </form>

    </div>

    <!-- MEDIA COLUMN (RIGHT) -->
    <div class="s6-media-col-v2">
      <div class="s6-image-container-v2">
        <div class="s6-clinically-bar-v2">Clinically Tested</div>
        <div class="s6-image-inner-v2">
          <div class="s6-arrow-v2 s6-arrow-left">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </div>
          <div class="s6-arrow-v2 s6-arrow-right">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </div>
          <img src="{{ product.featured_image | img_url: '1000x' }}" alt="{{ product.title }}">
          <div class="s6-zoom-icon-v2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  function s6SelectVarBox(el, variantId) {
    document.querySelectorAll('.s6-vbox').forEach(b => b.classList.remove('selected'));
    el.classList.add('selected');
    el.querySelector('input[type="radio"]').checked = true;
  }
</script>
