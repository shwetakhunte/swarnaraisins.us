{{ 'blog.css' | asset_url | stylesheet_tag }}
{% assign id = section.id  %}
{%assign sett_equal = section.settings.use_eq_height %}
{%assign image_ratio = section.settings.image_ratio%}
{% assign layout = section.settings.layout_blog | plus:0 %}
{% liquid
    assign chk_sidebar = true
    assign sett_equal = section.settings.use_eq_height
    assign image_ratio = section.settings.image_ratio
    if sett_equal 
    case image_ratio
      when 'ratio2_1'
          assign aspect_ratio = 2.0
      when 'ratio3_2'
          assign aspect_ratio = 1.5
      when 'ratio4_3'
          assign aspect_ratio = 1.333
      when 'ratio1_1'
          assign aspect_ratio = 1.0
      when 'ratio3_4'
          assign aspect_ratio = 0.75
      when 'ratio2_3'
          assign aspect_ratio = 0.66667
      when 'ratio1_2'
          assign aspect_ratio = 0.5
    endcase 
    endif
  %}
  <div id="laber_{{id}}" class="main-content shop-page main-content-blog  {% if layout == 2 or layout == 5 %}sidebar-left{% elsif layout == 3 or layout == 6 %}sidebar-right{% endif %}">
    <div class="container">
      {% if layout != 1 and layout !=4 %}
      	<a href="javascript:void(0)" class="js-mobile-sidebar mobile-sidebar-btn">
          <i class="icon-align-justify"></i> {{'blogs.article.sidebar' | t}}
        </a>
      {% endif %}
       
      <div class="grid-blog grid" style="--alo-width-sidebar:{{section.settings.w_sidebar }}px;--alo-col-gap:{{ section.settings.col_gap }}px;">
        {% paginate blog.articles by section.settings.pagination_limit_blog %}
        <div class="blog-content">
          <div class="row auto-clear blog-grid">
            <!-- /snippets/blog-simple -->	
            {% for article in blog.articles %}   
              {% # theme-check-disable %}{% include 'article-card' %}{% # theme-check-enable %}
            {% endfor %}                
          </div>
          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate, anchor: '#primary' %}
          {%- endif -%}
        </div>  
        {% endpaginate %} 
        {% if layout != 1 and layout != 4%} 
        	{% if chk_sidebar %}
        		{% render 'blog-sidebar',layout:layout, aspect_ratio:aspect_ratio %}  
        	{% endif %}
        {% endif %}
        
      </div>
    </div>
  </div>
 
{% style%}
	#laber_{{id}}{
        padding-bottom:{{section.settings.mg_bottom}}px;
		background: {{section.settings.cl_bg}};
	}
    @media (max-width: 767px) {
      #laber_{{id}}{
          padding-bottom:{{section.settings.mobile_mg_bottom}}px;
      }
    }
{% endstyle%}
