<style>
  .we-care-section {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
    background-color: {{ section.settings.bg_color }};
  }
  .we-care-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
  }
  .we-care-left {
    flex: 1 1 45%;
    max-width: 45%;
  }
  .we-care-image-wrapper {
    width: 100%;
    overflow: hidden;
    /* Arch shape: rounded top corners */
    border-radius: 120px 120px 0 0;
  }
  .we-care-image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  
  .we-care-right {
    flex: 1 1 50%;
    max-width: 50%;
  }
  .we-care-title {
    font-size: 36px;
    font-weight: 700;
    color: #111;
    margin-bottom: 20px;
    line-height: 1.2;
  }
  .we-care-content {
    font-size: 18px;
    color: #333;
    line-height: 1.6;
    margin-bottom: 40px;
  }
  
  .we-care-badges {
    display: flex;
    gap: 20px;
    justify-content: flex-start;
    flex-wrap: wrap;
  }
  .we-care-badge {
    text-align: center;
    width: 90px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .we-care-badge-icon {
    width: 60px;
    height: 60px;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .we-care-badge-icon svg {
    width: 100%;
    height: auto;
    fill: #2e7d32; /* Green wreath color */
  }
  .we-care-badge-icon img {
    max-width: 100%;
    height: auto;
  }
  .we-care-badge-text {
    font-size: 12px;
    font-weight: 700;
    color: #111;
    line-height: 1.2;
  }

  @media (max-width: 768px) {
    .we-care-container {
      flex-direction: column;
    }
    .we-care-left, .we-care-right {
      flex: 1 1 100%;
      max-width: 100%;
    }
    .we-care-image-wrapper {
      border-radius: 80px 80px 0 0;
    }
    .we-care-title {
      font-size: 28px;
      margin-top: 20px;
    }
    .we-care-content {
      font-size: 16px;
    }
    .we-care-badges {
      justify-content: center;
    }
  }
</style>

<div class="we-care-section">
  <div class="we-care-container">
    <div class="we-care-left">
      <div class="we-care-image-wrapper">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | img_url: 'master' }}" alt="{{ section.settings.title | escape }}" loading="lazy">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>
    
    <div class="we-care-right">
      <h2 class="we-care-title">{{ section.settings.title }}</h2>
      <div class="we-care-content">
        {{ section.settings.content }}
      </div>
      
      <div class="we-care-badges">
        {% for i in (1..4) %}
          {% capture badge_text_key %}badge_{{ i }}_text{% endcapture %}
          {% capture badge_image_key %}badge_{{ i }}_image{% endcapture %}
          {% assign b_text = section.settings[badge_text_key] %}
          {% assign b_image = section.settings[badge_image_key] %}
          
          {% if b_text != blank %}
            <div class="we-care-badge">
              <div class="we-care-badge-icon">
                {% if b_image != blank %}
                  <img src="{{ b_image | img_url: '200x' }}" alt="{{ b_text | escape }}">
                {% else %}
                  <!-- Fallback generic wreath SVG -->
                  <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 50 C20 20, 45 10, 50 10 C55 10, 80 20, 80 50 C80 80, 55 90, 50 90 C45 90, 20 80, 20 50" fill="none" stroke="#2e7d32" stroke-width="4" stroke-dasharray="8 4" stroke-linecap="round"/>
                    <circle cx="50" cy="50" r="30" fill="none" stroke="#2e7d32" stroke-width="2"/>
                  </svg>
                {% endif %}
              </div>
              <div class="we-care-badge-text">{{ b_text }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "We Care",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdfaf0"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "We Care For"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Other brands make raisins a commodity. We make them a promise...</p>"
    },
    {
      "type": "header",
      "content": "Badge 1"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Text",
      "default": "FSSAI Certified"
    },
    {
      "type": "image_picker",
      "id": "badge_1_image",
      "label": "Icon Image (Optional)"
    },
    {
      "type": "header",
      "content": "Badge 2"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Text",
      "default": "APEDA Certified"
    },
    {
      "type": "image_picker",
      "id": "badge_2_image",
      "label": "Icon Image (Optional)"
    },
    {
      "type": "header",
      "content": "Badge 3"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Text",
      "default": "ISO 9001:2015 Certified"
    },
    {
      "type": "image_picker",
      "id": "badge_3_image",
      "label": "Icon Image (Optional)"
    },
    {
      "type": "header",
      "content": "Badge 4"
    },
    {
      "type": "text",
      "id": "badge_4_text",
      "label": "Text",
      "default": "U.S. FDA Approved"
    },
    {
      "type": "image_picker",
      "id": "badge_4_image",
      "label": "Icon Image (Optional)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "We Care",
      "category": "Custom"
    }
  ]
}
{% endschema %}
