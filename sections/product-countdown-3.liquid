{% assign sid = section.id %}
{% assign layout = section.settings.layout %}

{% liquid
  assign show_stock_bar = section.settings.show_stock_bar
  assign space_between = section.settings['space-Between']
  assign navigation = section.settings.navigation
  assign pagination = section.settings.pagination
  if section.settings['use-slider']
    assign use_slider = true
  else
    assign use_slider = false
  endif
%}
{{ 'product_countdown.css' | asset_url | stylesheet_tag }}
{% if show_stock_bar %}{{ 'stock-bar.css' | asset_url | stylesheet_tag }}{% endif %}
  <section id="laber_{{sid}}" data-aos-duration="500" data-aos="fade-up">
     <div class="{% if layout %}full-width{% else %}container{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
        <div class="laber-section">
        <div class="content-section">
          <div class="products-arrivals products-list-countdown">
            {% # theme-check-disable %}
            {% include 'grid-slider', settings: section.settings %}
            <grid-slider
              class="grid-slider"
              {{ gridSlider }}
            >
              <div
                class="swiper iSwiper"
                {%- render 'skeleton', settings: section.settings -%}
                style="--perload-gap: {{ space_between}}px"
              >
                <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                  {%- if section.blocks.size > 0 -%}
                    {%- for block in section.blocks -%}
                      {% liquid
                        assign show_stock_bar = section.settings.show_stock_bar
                        assign total = block.settings.total
                        assign available = block.settings.available
                      -%}
                  {%- capture stock_bar -%}	
                  {%- if show_stock_bar -%}
                  	{%- assign sold = total | minus: available | times: 100 | divided_by: total | ceil -%}
                    <div class="loop-product-stock h_{{section.settings.h_position}} flex mb-30 sm:mb-15">
                      <div class="product-stock">
                        <div class="product-stock-status flex wrap mb-10 sm:mb-5">
                        <div class="sold">
                          <span>{{'products.grid_items.sold' | t  }} <b>{{total | minus: available}}</b></span> <span>{{'products.grid_items.available' | t  }} <b>{{available}}</b></span>
                        </div>
                      </div>
                      <div class="status-bar"  style="--bg-status:{{section.settings.status_bg}}; ">
                        <div class="sold-bar" style="--bg-sold:{{section.settings.sold_bg}};  width: {{sold}}%;"></div>
                      </div>	
                      </div>
                    </div>
                  {%- endif -%}	
                  {%- endcapture -%}
                      {%- case block.type -%}
                        {%- when 'product' -%}
                          {%- assign product = all_products[block.settings.product] %}
                          {%- assign img_product = block.settings.img_product %}
                          {% if product != blank %}
                            <div class="swiper-slide">
                              {% include 'product_countdown_3', product: product, stock_bar: stock_bar, img_product:img_product %}
                            </div>
                          {%- else -%}
                            <div class="pr_grid_item swiper-slide">
                              {% render 'product_countdown_2_demo' %}
                            </div>
                          {%- endif -%}
                      {%- endcase -%}
                    {%- endfor -%}

                  {%- else -%}
                    {%- for i in (1..3) -%}
                      <div class="pr_grid_item swiper-slide">
                        {% render 'product_countdown_2_demo' %}
                      </div>
                    {%- endfor -%}
                  {%- endif -%}
                </div>
                {% if use_slider == true %}
                  {% if navigation %}
                    <div class="swiper-button-next"></div>
                    <div class="swiper-button-prev"></div>
                  {% endif %}
                  {% if pagination %}
                    <div class="swiper-pagination"></div>
                  {% endif %}
                {% endif %}
              </div>
            </grid-slider>
            {% # theme-check-enable %}
          </div>
        </div>
      </div>
    </div>
  </section>
  {%- render 'section_style' -%}
{%- schema -%}
