{% assign sid = section.id %}
{% assign layout = section.settings.layout %}
{% liquid
  assign show_stock_bar = section.settings.show_stock_bar
  assign space_between = section.settings['space-Between']
  assign navigation = section.settings.navigation
  assign pagination = section.settings.pagination
  if section.settings['use-slider']
    assign use_slider = true
  else
    assign use_slider = false
  endif
%}
{{ 'product_countdown.css' | asset_url | stylesheet_tag }}
{% if show_stock_bar %}{{ 'stock-bar.css' | asset_url | stylesheet_tag }}{% endif %}
<section id="laber_{{sid}}" class="product-countdown-2" style="--cl-border-active:{{ section.settings.cl_border_active }};">
  <div
    class="{% if layout %}full-width{% else %}container{% endif %}"
    style="
      --alo-container-width:{{ section.settings.container }}px;
      --bg:{{ section.settings.cl_bg }};
      --cl-text-c:{{ section.settings.cl_text_c }};
      --bg-c:{{ section.settings.bg_countdown }};
      --cl-border-c:{{ section.settings.b_countdown }};
    "
  >
    <div class="laber-section">
      <div class="content-section">
        {% # theme-check-disable %}
          {% include 'grid-slider', settings: section.settings %}
          <slider-gallery
            class="slider-gallery"
          >
            <div class="row">
            <div class="col-lg-9 col-md-8 col-12 product-countdown-main">
            <div class="products-arrivals products-list-countdown">
            {% if section.settings.title != blank %}
              <div class="wrap_title {{ section.settings.text_size }} mb-30 sm:mb-20">
                <div class="h3 section-title text-transform" style="--text-transform:{{ section.settings.text_transform }}">
                  {{ section.settings.title }}
                </div>
              </div>
            {% endif %}
            <div
              class="swiper gallery"
              {%- render 'skeleton', settings: section.settings -%}
              style="--perload-gap: {{ space_between}}px"
            >
              <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                {%- if section.blocks.size > 0 -%}
                  {%- for block in section.blocks -%}
                    {% liquid
                      assign show_stock_bar = section.settings.show_stock_bar
                      assign total = block.settings.total
                      assign available = block.settings.available
                    -%}
                    {%- capture stock_bar -%}	
                  {%- if show_stock_bar -%}
                  	{%- assign sold = total | minus: available | times: 100 | divided_by: total | ceil -%}
                    <div class="loop-product-stock mb-20 sm:mb-10">
                      <div class="product-stock">
                      <div class="status-bar"  style="--bg-status:{{section.settings.status_bg}}; ">
                        <div class="sold-bar" style="--bg-sold:{{section.settings.sold_bg}};  width: {{sold}}%;"></div>
                      </div>	
                      <div class="product-stock-status flex wrap">
                        <div class="sold">
                          <span class="label">{{'products.grid_items.sold' | t  }} <span class="value">{{total | minus: available}}/{{total}}</span> {{'products.grid_items.products' | t  }}</span>  
                        </div>
                      </div>
                      </div>
                    </div>
                  {%- endif -%}	
                  {%- endcapture -%}
                    {%- case block.type -%}
                      {%- when 'product' -%}
                        {%- assign product = all_products[block.settings.product] %}
                        {%- assign img_product = block.settings.img_product %}
                        {% if product != blank %}
                          <div class="swiper-slide">
                            {% include 'product_countdown_2',
                              product: product,
                              stock_bar: stock_bar,
                              img_product: img_product
                            %}
                          </div>
                        {%- else -%}
                          <div class="pr_grid_item swiper-slide">
                            {% render 'product_countdown_2_demo' %}
                          </div>
                        {%- endif -%}
                    {%- endcase -%}
                  {%- endfor -%}

                {%- else -%}
                  {%- for i in (1..3) -%}
                    <div class="pr_grid_item swiper-slide">
                      {% render 'product_countdown_2_demo' %}
                    </div>
                  {%- endfor -%}
                {%- endif -%}
              </div>
              {% if use_slider == true %}
                {% if navigation %}
                  <div class="swiper-button">
                    <div class="swiper-button-prev">{{ 'swiper.swiper_button_prev' | t }}</div>
                    <div class="swiper-button-next">{{ 'swiper.swiper_button_next' | t }}</div>
                  </div>
                {% endif %}
                {% if pagination %}
                  <div class="swiper-pagination"></div>
                {% endif %}
              {% endif %}
            </div>
            </div>  
            </div>
            <div class="col-lg-3 col-md-4 col-12 product-countdown-thumbnail">
            <div
              class="swiper thumbnail "
              {{ gridSlider }}
              {%- render 'skeleton', settings: section.settings -%}
              style="--perload-gap: {{ space_between}}px"
            >
              <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                {%- if section.blocks.size > 0 -%}
                  {%- for block in section.blocks -%}
                    {%- case block.type -%}
                      {%- when 'product' -%}
                        {%- assign product = all_products[block.settings.product] %}
                        {%- assign img_product = block.settings.img_product %}
                        {% if product != blank %}
                          <div class="swiper-slide">
                            {% include 'product_thumbnail', product: product,
                            %}
                          </div>
                        {%- else -%}
                          <div class="pr_grid_item swiper-slide">
                            {% include 'product_thumbnail_demo' %}
                          </div>
                        {%- endif -%}
                    {%- endcase -%}
                  {%- endfor -%}

                {%- else -%}
                  {%- for i in (1..3) -%}
                    <div class="pr_grid_item swiper-slide">
                      {% include 'product_thumbnail_demo' %}
                    </div>
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </div>
            </div>
            </div>
          </slider-gallery>
        {% # theme-check-enable %}
      </div>
    </div>
  </div>
</section>
{%- render 'section_style' -%}
{%- schema -%}
 {
