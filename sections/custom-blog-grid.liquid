<style>
  .custom-blog-section {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
    background-color: {{ section.settings.bg_color }};
  }
  .cb-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .cb-header {
    text-align: center;
    margin-bottom: 50px;
  }
  .cb-subtitle {
    font-size: 16px;
    color: #8bc34a; /* Light green */
    font-weight: 600;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .cb-title {
    font-size: 36px;
    font-weight: 700;
    color: #1b5e20; /* Dark green */
    margin-bottom: 15px;
  }
  .cb-desc {
    font-size: 18px;
    color: #666;
  }
  
  .cb-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  
  .cb-card {
    display: flex;
    flex-direction: column;
  }
  .cb-image-wrapper {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 20px;
    aspect-ratio: 4/3;
  }
  .cb-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .cb-card:hover .cb-image-wrapper img {
    transform: scale(1.05);
  }
  
  .cb-article-title {
    font-size: 22px;
    font-weight: 700;
    color: #1b5e20;
    margin-bottom: 15px;
    line-height: 1.3;
    text-decoration: none;
  }
  .cb-article-title:hover {
    color: #2e7d32;
  }
  
  .cb-meta {
    display: flex;
    align-items: center;
    gap: 15px;
    font-size: 13px;
    color: #888;
    margin-bottom: 15px;
  }
  .cb-meta span {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .cb-meta svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
  
  .cb-excerpt {
    font-size: 15px;
    color: #555;
    line-height: 1.6;
    margin-bottom: 20px;
    flex-grow: 1;
  }
  
  .cb-read-more {
    font-size: 15px;
    font-weight: 700;
    color: #1b5e20;
    text-decoration: none;
    text-transform: uppercase;
  }
  .cb-read-more:hover {
    color: #2e7d32;
  }

  @media (max-width: 992px) {
    .cb-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .cb-grid {
      grid-template-columns: 1fr;
    }
    .cb-title {
      font-size: 28px;
    }
  }
</style>

<div class="custom-blog-section">
  <div class="cb-container">
    <div class="cb-header">
      {% if section.settings.subtitle != blank %}
        <div class="cb-subtitle">{{ section.settings.subtitle }}</div>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="cb-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="cb-desc">{{ section.settings.description }}</div>
      {% endif %}
    </div>
    
    <div class="cb-grid">
      {% assign blog = blogs[section.settings.blog] %}
      
      {% if blog != blank and blog.articles.size > 0 %}
        {% for article in blog.articles limit: section.settings.limit %}
          <div class="cb-card">
            <a href="{{ article.url }}" class="cb-image-wrapper">
              {% if article.image %}
                <img src="{{ article.image | img_url: '600x' }}" alt="{{ article.title | escape }}">
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </a>
            
            <a href="{{ article.url }}" class="cb-article-title">{{ article.title }}</a>
            
            <div class="cb-meta">
              <span>{{ article.published_at | date: "%d %b" }}</span>
              <span>
                <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                {{ article.author }}
              </span>
              <span>
                <svg viewBox="0 0 24 24"><path d="M21.99 4c0-1.1-.89-2-1.99-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4-.01-18zM18 14H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/></svg>
                {{ article.comments_count }} Comments
              </span>
            </div>
            
            <div class="cb-excerpt">
              {% if article.excerpt.size > 0 %}
                {{ article.excerpt | strip_html | truncatewords: 25 }}
              {% else %}
                {{ article.content | strip_html | truncatewords: 25 }}
              {% endif %}
            </div>
            
            <div>
              <a href="{{ article.url }}" class="cb-read-more">Read more</a>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Placeholders if no blog is selected -->
        {% for i in (1..3) %}
          <div class="cb-card">
            <div class="cb-image-wrapper">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="cb-article-title">Sample Blog Post Title</div>
            <div class="cb-meta">
              <span>15 Jul</span>
              <span>Author Name</span>
              <span>0 Comments</span>
            </div>
            <div class="cb-excerpt">
              This is a sample blog post excerpt. Please select a blog in the theme editor to show real posts.
            </div>
            <div>
              <a href="#" class="cb-read-more">Read more</a>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Blog Grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "From the Swarna Journal"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Insights From Our Farm & Beyond"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Your Guide to Smarter, Healthier Snacking."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 3,
      "max": 12,
      "step": 3,
      "label": "Number of articles to show",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Custom Blog Grid",
      "category": "Blog"
    }
  ]
}
{% endschema %}
