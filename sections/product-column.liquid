{% liquid
  assign sid = section.id 
  assign layout = section.settings.layout
  assign collection = section.settings.collection 
  assign visible = section.settings.visible
  assign widescreen = section.settings.widescreen
  assign desktop = section.settings.desktop
  assign laptop = section.settings.laptop
  assign notebook = section.settings.notebook
  assign tablet = section.settings.tablet
  assign landscape = section.settings.landscape
  assign portrait = section.settings.portrait
  assign mobile = section.settings.mobile
  assign space_between = section.settings['space-Between']
  assign navigation = section.settings.navigation
  assign pagination = section.settings.pagination
  if section.settings['use-slider']
    assign use_slider = true
  else
    assign use_slider = false
  endif
%}
<section id="laber_{{sid}}">
  <div class="laber_product_section_{{sid}}">
    <div class="container {%if layout%}full-width{%endif%}">
    {% if section.settings.title != blank %}
        <div class="wrap_title w_{{ section.settings.h_position }} {{ section.settings.text_size }} medium mb-30 sm:mb-20">
          <div
            class="h3 section-title alo-text-transform"
            style="--alo-text-transform:{{ section.settings.text_transform }}"
          >
            {{ section.settings.title }}
          </div>
          {% if section.settings.content != blank %}
            <div class="content">{{ section.settings.content }}</div>
          {% endif %}
        </div>
      {% endif %}
        <div class="products-arrivals ">
    <div class="section-content">
    {% # theme-check-disable %}
    {% include 'grid-slider', settings: section.settings %}
      <grid-slider class="grid-slider" {{ gridSlider }}>
        <div
          class="swiper iSwiper"
          data-mobile="{{ mobile }}"
          data-portrait="{{ portrait }}"
          data-landscape="{{ landscape }}"
          data-tablet="{{ tablet }}"
          data-notebook="{{ notebook }}"
          data-laptop="{{ laptop }}"
          data-desktop="{{ desktop }}"
          data-widescreen="{{ widescreen }}"
          data-visible="{{ visible }}"
          data-space-Between="{{ space_between}}"
          style="--perload-gap: {{ space_between}}px"
        >
          <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                {%- if collection  != blank -%} 
                {%- assign products = collections[collection].products -%}
                {%- for product in products limit: section.settings.max_count -%}
                  <div class="swiper-slide">
                  {% include 'product-column' %} 
                  </div>
                {%- endfor -%}  
                {%- else -%}
                {%- for i in (1..16) -%}
                <div class="pr_grid_item swiper-slide">
                  {% render 'product_demo_column' %} 
                </div>
                {%- endfor -%}
                {%- endif -%}
              </div>
            {% if use_slider == true %}
              {% if navigation %}
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
              {% endif %}
              {% if pagination %}
                <div class="swiper-pagination"></div>
              {% endif %}
            {% endif %}
            </div>
        </grid-slider>
      {% # theme-check-enable %}  
          </div>
        </div>
  </div>
  </div>
</section>

  {% if use_slider == false %}
    {% style %}#laber_{{sid}} .swiper-slide{padding-bottom:{{space_between}}px; }{% endstyle %}
  {% endif %}
{%- render 'section_style' -%} 

{%- schema -%}
