{%- liquid
  assign sid = section.id
  assign section_blocks = section.blocks
  assign layout = section.settings.layout
  assign arr_col = section_blocks | where: 'type', 'col'
  assign navigation = section.settings.navigation
  assign pagination = section.settings.pagination
  assign space_between = section.settings['space-Between']
  assign style_tab = section.settings.style_tab | plus : 0
  
  if section.settings['use-slider']
    assign use_slider = true
  else
    assign use_slider = false
  endif
  assign text_align = section.settings.text_align
-%}
{% case section.settings.col %}
    {% when '16%' %}
        {%- assign block_width_tab = 'col-lg-2 col-md-2 col-12' -%}
    {% when '25%' %}
        {%- assign block_width_tab = 'col-lg-3 col-md-3 col-12' -%}
    {% when '33%' %}
        {%- assign block_width_tab = 'col-lg-4 col-md-4 col-12' -%}
    {% when '42%' %}
        {%- assign block_width_tab = 'col-lg-5 col-md-5 col-12' -%}
    {% when '50%' %}
        {%- assign block_width_tab = 'col-lg-6 col-md-6 col-12' -%}
    {% when '58%' %}
        {%- assign block_width_tab = 'col-lg-7 col-md-7 col-12' -%}
    {% when '66%' %}
        {%- assign block_width_tab = 'col-lg-8 col-md-8 col-12' -%}
    {% when '75%' %}
        {%- assign block_width_tab = 'col-lg-9 col-md-9 col-12' -%}
    {% when '100%' %}
        {%- assign block_width_tab = 'col-12' -%}
{% endcase %}
{{ 'tab-products.css' | asset_url | stylesheet_tag }}
<section
  id="laber_{{sid}}"
  class="{% if section.settings.use_border_for_product %}alo-border-product{% endif%}"
  data-aos-duration="500" data-aos="fade-up"
>
  <product-tab>
    <div
      class="{% if layout %}full-width{% else %}container{% endif %}"
      style="--alo-container-width:{{ section.settings.container }}px;"
    >
      <div class="tab-product-content {% if section.settings.cl_bg_content != 'rgba(0,0,0,0)'  %}alo-background-color alo-border-radius pd-20 py-20 sm:pd-10 sm:py-10 {% endif %}" style="{% if section.settings.cl_bg_content != 'rgba(0,0,0,0)' %}--bg-color:{{ section.settings.cl_bg_content  }}; {% endif %}">
      <div class="row">
        {%- for block in section_blocks -%}
          {% case block.settings.col %}
              {% when '16%' %}
                  {%- assign block_width = 'col-lg-2 col-md-2 col-12' -%}
              {% when '25%' %}
                  {%- assign block_width = 'col-lg-3 col-md-3 col-12' -%}
              {% when '33%' %}
                  {%- assign block_width = 'col-lg-4 col-md-4 col-12' -%}
              {% when '42%' %}
                  {%- assign block_width = 'col-lg-5 col-md-5 col-12' -%}
              {% when '50%' %}
                  {%- assign block_width = 'col-lg-6 col-md-6 col-12' -%}
              {% when '58%' %}
                  {%- assign block_width = 'col-lg-7 col-md-7 col-12' -%}
              {% when '66%' %}
                  {%- assign block_width = 'col-lg-8 col-md-8 col-12' -%}
              {% when '75%' %}
                  {%- assign block_width = 'col-lg-9 col-md-9 col-12' -%}
              {% when '100%' %}
                  {%- assign block_width = 'col-12' -%}
          {% endcase %}
          {%- case block.type -%}
          {%- when 'banner' -%}
          {{ 'banner-image.css' | asset_url | stylesheet_tag }}
            {% # theme-check-disable %}
          {% include 'aspect-ratio', sett_equal: block.settings.use_eq_height, image_ratio: block.settings.image_ratio %}
          <banner-image id="b_{{block.id}}" class="{{ block_width }} d-block pos-{{ block.settings.b_position }} mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb-mobile }} {% if block.settings.hidden_mobile %}sm:d-none{% endif %}">
            <div class="block-banner overflow-hidden w-full h-full " >
              
              <div class="image_static image_card relative w-full" style="--rounded:{{ block.settings.b_image }}px;">
                {% assign image = block.settings.image %}
                {% assign url = block.settings.link %}
                {% if image != blank %}
                  {% render 'responsive-image', image: image, url: url, image_class: 'w-full h-full overflow-hidden' %}
                {% else %}
                  {% if aspect_ratio != blank %}
                       {%- assign ratio =  1 | divided_by: aspect_ratio | times: 100 -%}
                    {% else %}
                        {%- assign ratio = 100 -%}
                    {% endif %}
                  <div class="image-card__img overflow-hidden alo-border-radius ratio w-full h-full" style="--rounded:{{ block.settings.b_image }}px; --ratio-percent: {{ ratio }}%;">
                    {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                    {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                  </div>
                {% endif %}
                  <content-image class="flex events-none absolute inset-0 h_{{block.settings.h_position}} v_{{block.settings.v_position}} text_{{block.settings.txt_align}}">
                  <div class="content">
                    {% if block.settings.title != blank %}
                    <div class="wrap_title {{ block.settings.text_size }} mb-30 sm:mb-20">
                      <div class="block-title h3 text-transform" style="--cl-text:{{ block.settings.cl_text }};--text-transform:{{ block.settings.text_transform }}">
                            {{ block.settings.title }}
                      </div>
                    </div>
                    {% endif %}
                    {% assign image_cl = block.settings.image_cl %}
                      {% if image_cl != blank %}
                        {% render 'responsive-image', image: image_cl, aspect_ratio:aspect_ratio, url: url, image_class: 'w-full h-full bg_transparent overflow-hidden mb-30 sm:mb-15' %}
                      {% endif %}
                    {%- assign menu = block.settings.menu -%}
                    {%- if menu != blank -%}
                      <ul class="menu events-auto mb-40 sm:mb-20">
                        {%- for link in linklists[menu].links -%}
                         <li class="menu-item{% if link.active %}active{% endif %}">
                           <a href="{{ link.url }}">
                             <svg width="25" height="25" viewBox="0 0 32 32" fill="currentColor"><path d="M19.159 16.767l0.754-0.754-6.035-6.035-0.754 0.754 5.281 5.281-5.256 5.256 0.754 0.754 3.013-3.013z"></path></svg>
                             {{ link.title | split: '[' | first }}
                           {% if link.object.all_products_count %}
                               <span class="n_products">({{ link.object.all_products_count }})</span>
                           {%endif%}
                           </a>
                          </li>
                         {%- endfor -%}
                      </ul>
                        {%- endif -%}
                    {% if block.settings.n_btn_image %}
                      <div class="{{ block.settings.ct_color }}" style="--rounded-btn:{{ block.settings.b_btn }}px;">
                      <a
                        class="btn events-auto {{ block.settings.button_style }}"
                        href="{{ url }}"
                        title="{{ block.settings.n_btn_image }}"
                      >
                        {{ block.settings.n_btn_image }}
                      </a>
                      </div>
                    {% endif %}
                    </div>
                  </content-image>
              </div>
            </div>
          </banner-image>
            {% # theme-check-enable %}
        {% endcase %}
        {% endfor %}
      <div class="{{ block_width_tab }}">  
      {%- if arr_col.size > 0 -%}
        <div class="tabcontent">
          <div class="tab-products mb-{{ section.settings.mb-tab }} sm:mb-20 {% if section.settings.bg_header != 'rgba(0,0,0,0)' %}bg-header{% endif %} layout_{{text_align}}" {% if section.settings.bg_header != 'rgba(0,0,0,0)' %}style="--bg-header:{{ section.settings.bg_header }}" {% endif %} data-control="">
          {% if section.settings.title != blank %}
            <div class="wrap_title sm:mb-10 {{ section.settings.text_size }} ">
              {% if section.settings.subtitle != blank %}
                <div class="section-subtitle" style="--cl-text:{{ section.settings.cl_subtitle }};" bis_skin_checked="1">{{ section.settings.subtitle }}</div>
              {% endif %}
              <div class="h3 section-title " style="--cl-text:{{ section.settings.cl_title }};">{{section.settings.title}}</div>  
            </div>
          {% endif %}
            <ul class="h_{{text_align}} flex {% if style_tab == 1 %}tab_underline{% else %}tab_border{% endif %}" 
              style="
                --font-size:{{ section.settings.f-size }}px;
                --font-weight:{{ section.settings.f-weight }};
                --text-transform:{{ section.settings.text_transform }};
                --cl-text:{{ section.settings.cl_text }};
                --cl-text-h:{{ section.settings.cl_text_h }};
              "
              >
              {% assign index = 1 %}
              {%- for block in arr_col -%}
                {%- case block.type -%}
                {%- when 'col' -%}
                {%- assign coll_name = collections[block.settings.collection].title -%}
                  {%- assign show_icon = block.settings.show_icon -%}
                <li data-collection="{{ collections[block.settings.collection].handle }}" class="item h3 {%- if forloop.index == 1 %} active{% endif -%}" >
                  {% if show_icon and block.settings.code_svg != blank %}
                    <span class="icon-col">
                      {{ block.settings.code_svg }}
                    </span>   
                  {% endif %}
                  {% if block.settings.title != blank %}
                    <span>{{ block.settings.title }}</span>
                  {% else %}
                    <span>
                      {% if coll_name != blank %}{{ coll_name }}{% else %}Tab Title {{ index }}{% endif -%}
                    </span>
                  {% endif %}
                </li>
                {% assign index = index | plus: 1 %}
                {% endcase %}
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {% endif %}
      <div class="products-arrivals" data-ajaxloading>
        {%- if arr_col.size > 0 -%}
          {% # theme-check-disable %}
          {% include 'grid-slider', settings: section.settings %}
          {%- for block in arr_col limit: 1 -%}
            {%- case block.type -%}
                {%- when 'col' -%}
            <grid-slider
              class="grid-slider sorting-collections__products "
              data-limit="{{ section.settings.max_count }}"
              {{ gridSlider }}
            >
              <div
                class="swiper iSwiper"
                {%- render 'skeleton', settings: section.settings -%}
                style="--perload-gap: {{ space_between}}px"
              >
                <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                  {%- if block.settings.collection != blank -%}
                    {%- assign products = collections[block.settings.collection].products -%}
                    {%- capture url_cat -%}{%- if routes.root_url != '/' -%}{{routes.root_url}}{%- endif -%}{% if collection %}/collections/{{collection.handle}}{% endif %}{%- endcapture -%}
                    {% assign index = 1 %}
                    {%- for product in products limit: section.settings.max_count -%}
                      {%- if settings.productlazyload == true -%}
                        <div
                          class="swiper-slide lazyload scroll-trigger"
                          style="--animation-order:{{ index }};"
                          data-include="{{url_cat}}/products/{{product.handle}}/?view=pr_lazy_load"
                        ></div>
                      {% else %}
                        <div
                          class="swiper-slide scroll-trigger "
                          style="--animation-order:{{ index }};"
                        >
                          {% include 'product_style' %}
                        </div>
                      {%- endif -%}
                      {% assign index = index | plus: 1 %}
                    {%- endfor -%}
                  {% else %}
                    {%- for i in (1..section.settings.max_count) -%}
                      <div class="swiper-slide pr_grid_item">
                        {% include 'product_demo' %}
                      </div>
                    {%- endfor -%}
                  {%- endif -%}
                </div>
                {% if navigation and use-slider %}
                  <div class="swiper-button-next"></div>
                  <div class="swiper-button-prev"></div>
                {% endif %}
                {% if pagination and use-slider %}
                  <div class="swiper-pagination"></div>
                {% endif %}
              </div>
            </grid-slider>
              {% endcase %}
            {% if section.settings.show_view_all %}
              <div class="view_all pt-60">
              {{ 'collections.general.text' | t }} 
                <a href="/collections/all">{{ 'collections.general.view_all' | t }} {{- 'chevron.svg' | inline_asset_content -}}</a>
              </div>  
            {% endif %}
          {%- endfor -%}
          {% # theme-check-enable %}
        {%- else -%}
          {% render 'no-blocks' with message: 'homepage.onboarding.no_content' %}
        {%- endif -%}
      </div>
    </div>
      </div>
      </div>
    </div>
  </product-tab>
</section>
{%- render 'section_style' -%}
{%- schema -%}
 {
   "name": "Tab Products",
   "class": "cms_section type_carousel tab-product type_tab_collection laber_section product_section",
   "max_blocks": 10,
   "settings": [
     {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
     {
       "type": "color",
       "id": "bg_header",
       "label": "Background header",
       "default":"rgba(0,0,0,0)"
     },
     {
       "type": "color",
       "id": "cl_title",
       "label": "color Title",
       "default": "#333"
     },
    {
      "type": "select",
      "id": "text_size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "small"
       },
       {
          "value": "medium",
          "label": "Medium"
       },
       {
          "value": "large",
          "label": "Large"
        }
      ],
      "label": "Text size"
    },
     {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Sub Title"
    },
     {
       "type": "color",
       "id": "cl_subtitle",
       "label": "color Sub title",
       "default": "#333"
     },
     
       {
       "type": "header",
       "content": "== Settings Tab"
     },
     {
        "type": "select",
        "id": "col",
        "default": "100%",
        "options": [
        {
        "value": "16%",
        "label": "16%"
        },  
        {
        "value": "25%",
        "label": "25%"
        },
        {
        "value": "33%",
        "label": "33%"
        },
         {
        "value": "42%",
        "label": "42%"
        }, 
        {
        "value": "50%",
        "label": "50%"
        },
        {
        "value": "58%",
        "label": "58%"
        }, 
        {
        "value": "66%",
        "label": "66%"
        },
        {
        "value": "75%",
        "label": "75%"
        },
        {
        "value": "100%",
        "label": "100%"
        }
        ],
        "label": "Width tab:"
      },
     {
          "type": "range",  
          "id": "f-size",  
          "label": "Font size",
          "min": 12,
          "max": 50,
          "step": 0.5,
          "unit": "px",
          "default": 14 
      },
     {
          "type": "range",  
          "id": "f-weight",  
          "label": "Font Weight",
          "min": 300,
          "max": 900,
          "step": 100,
          "default": 400 
      },
      {
        "type": "select",
        "id": "text_transform",
        "default": "none",
        "options": [
         {
            "value": "none",
            "label": "None"
         },
         {
            "value": "capitalize",
            "label": "Capitalize"
         },
         {
            "value": "lowercase",
            "label": "Lowercase"
         },
         {
            "value": "uppercase",
            "label": "Uppercase"
          }
        ],
        "label": "Text transform:"
      },
       {
        "type": "select",
        "id": "text_align",
        "default": "left",
        "options": [ 
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
        ],
          "label": "Text align:"
      },
     {
        "type": "select",
        "id": "style_tab",
        "default": "1",
        "options": [ 
        {
          "value": "1",
          "label": "Underline"
        },
        {
          "value": "2",
          "label": "Border"
        }
        ],
          "label": "Style tab:"
      },
       {
       "type": "color",
       "id": "cl_text",
       "label": "color text tab",
       "default": "#cbcbcb"
     },
     {
       "type": "color",
       "id": "cl_text_h",
       "label": "color text tab (Hover)",
       "default": "#000000"
     },
     {
          "type": "range",  
          "id": "mb-tab",  
          "label": "Margin bottom (tab)",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "px",
          "default": 30 
      },
     {
       "type": "header",
       "content": "== General Settings"
     },
     {
       "type": "range",
       "id": "max_count",
       "min": 1,
       "max": 24,
       "step": 1,
       "unit": "pds",
       "label": "Limit products",
       "default": 8
     },
     {
        "type": "checkbox",
        "id": "show_view_all",
        "label":"Show View all button",
        "default": false
      },
{
       "type": "header",
       "content": "---- Slider Show Collection ----",
       "info": "Refer to the attribute values [here](httpss://kenwheeler.github.io/slick)"
   },
   {
       "type": "checkbox",
       "id": "use-slider",
       "label": "Use slider?",
       "default": true
   },
   {
       "type": "range",
       "id": "visible",
       "label": "Columns in Visible",
	"info": "Item(s) in screen ( Size >= 1920 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 5
   },
   {
       "type": "range",
       "id": "widescreen",
       "label": "Columns in Widescreen",
	"info": "Item(s) in screen ( 1366 <= Size < 1920 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 4
   },
   {
       "type": "range",
       "id": "desktop",
       "label": "Columns in Desktop",
	"info":  "Item(s) in screen ( 1200 <= Size < 1480 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 4
   },
   {
       "type": "range",
       "id": "laptop",
       "label": "Columns in Laptop",
	"info": "Item(s) in screen ( 992 <= Size < 1200 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 4
   },
   {
       "type": "range",
       "id": "notebook",
       "label": "Columns in Notebook",
	"info": "Item(s) in screen ( 768 <= Size < 992 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 3
   },
   {
       "type": "range",
       "id": "tablet",
       "label": "Columns in Tablet",
	"info": "Item(s) in screen ( 576 <= Size < 768 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "unit": "pds",
       "default": 3
   },
   {
       "type": "range",
       "id": "landscape",
       "label": "Columns in Landscape",
	"info": "Item(s) in screen ( 480 <= Size < 576 )",
       "min": 1,
       "max": 6,
       "step": 1,
       "default": 2
   },
   {
       "type": "range",
       "id": "portrait",
       "label": "Columns in Portrait",
	"info": "Item(s) in screen ( 360 < Size < 480 )",
       "min": 1,
       "max": 6,
       "step": 1,
       "default": 2
   },
   {
       "type": "range",
       "id": "mobile",
       "label": "Columns in Mobile",
	"info": "Item(s) in screen ( Size < = 360 )",
       "min": 1,
       "max": 4,
       "step": 1,
       "default": 1
   },
   {
       "type": "range",
       "id": "slides-Per-Group",
       "label": "Slide Per Group",
       "info": "The number of items slide to scroll",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 1
   },
   {
       "type": "range",
       "id": "rows",
       "label": "Rows Slider",
       "min": 1,
       "max": 3,
       "step": 1,
       "default": 1
   },
   {
       "type": "checkbox",
       "id": "autoplay",
       "label": "Autoplay",
       "default": true
   },
   {
       "type": "text",
       "id": "speed",
       "label": "Speed",
       "default": "300",
       "info": "Duration of transition between slides (in ms)"
   },
   {
       "type": "text",
       "id": "autoplay_delay",
       "label": "Auto Play delay",
       "default": "3000",
       "info": "Delay between transitions (in ms)"
   },
   {
       "type": "checkbox",
       "id": "navigation",
       "label": "Navigation",
       "info": "Arrows next,prev",
       "default": true
   },
   {
       "type": "select",
       "id": "effect",
       "label": "effect",
       "options": [
        {
           "value": "coverflow",
           "label": "Coverflow"
         },
        {
           "value": "creative",
           "label": "Creative"
         },
        {
           "value": "cube",
           "label": "Cube"
         },
        {
           "value": "fade",
           "label": "Fade"
         },
        {
           "value": "flip",
           "label": "Flip"
         },
        {
           "value": "slide",
           "label": "Slide"
        }
       ],
       "default": "slide"
   },
   {
       "type": "checkbox",
       "id": "centered-Slides",
       "label": "centered Slides",
       "default": false
   },
   {
       "type": "checkbox",
       "id": "auto-Height",
       "label": "Auto Height",
       "default": false
   },
   {
       "type": "checkbox",
       "id": "pagination",
       "label": "Pagination",
       "default": false
   },
   {
       "type": "checkbox",
       "id": "loop",
       "label": "Loop",
       "default": false
   },
   {
       "type": "range",
       "id": "space-Between",
       "label": "Space Between",
       "info": "Distance between slides in px.",
       "min": 0,
       "max": 30,
       "step": 1,
       "unit": "px",
       "default": 10
   },
   {
       "type": "select",
       "id": "direction",
       "label": "Direction",
       "options": [
        {
           "value": "horizontal",
           "label": "Horizontal"
         },
        {
           "value": "vertical",
           "label": "Vertical"
         }
       ],
       "default": "horizontal"
   },
     {
       "type": "header",
       "content": "== Design Options"
     },

     {
    "type": "checkbox",
    "id": "layout",
    "label": "Full width",
    "default": false
    },
    {
        "type": "range",
        "id": "container",
        "label": "Container width",
        "min": 1170,
        "max": 1920,
        "step": 10,
        "unit": "px",
        "default": 1410
    },
     {
       "type": "color",
       "id": "cl_bg",
       "label": "Background color",
       "default": "#fff"
     },
     {
        "type": "color",
        "id": "cl_bg_content",
        "label": "Background color (content)",
         "default":"rgba(0,0,0,0)",
        "info": "If not used you can leave blank"
      },  
     {
       "type": "text",
       "id": "mg",
       "label": "Margin",
       "info":"Margin top, margin right, margin bottom, margin left. If you not use to blank"
     },
     {
       "type": "text",
       "id": "pd",
       "label": "Padding",
       "info":"Padding top, padding right, padding bottom, padding left. If you not use to blank"
     },
    {
       "type": "header",
       "content": "== Design Mobile Options"
     },
