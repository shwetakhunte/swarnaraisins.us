{% assign id = section.id  %}
{% assign chk_sidebar = true %}
{% assign show_tags = section.settings.show_tags %}
{% assign show_social = section.settings.show_social %}
{% assign limit_tags = section.settings.limit_tags | plus:0 %}
{% assign layout = section.settings.layout_blog | plus:0 %}
  {% liquid
      assign sett_equal = section.settings.use_eq_height
      assign image_ratio = section.settings.image_ratio
      if sett_equal 
      case image_ratio
        when 'ratio2_1'
            assign aspect_ratio = 2.0
        when 'ratio3_2'
            assign aspect_ratio = 1.5
        when 'ratio4_3'
            assign aspect_ratio = 1.333
        when 'ratio1_1'
            assign aspect_ratio = 1.0
        when 'ratio3_4'
            assign aspect_ratio = 0.75
        when 'ratio2_3'
            assign aspect_ratio = 0.66667
        when 'ratio1_2'
            assign aspect_ratio = 0.5
      endcase 
      endif
%}
{{ 'blog.css' | asset_url | stylesheet_tag }}
<div id="laber_{{id}}" class=" main-content shop-page main-content-blog single-blog {% if layout == 2 %}sidebar-left{% elsif layout == 3 %}sidebar-right{% endif %}">
  <div class="container">   
    {% if layout != 1 and layout !=4 %}
      	<a href="javascript:void(0)" class="js-mobile-sidebar mobile-sidebar-btn">
          <i class="icon-align-justify"></i> {{'blogs.article.sidebar' | t}}
        </a>
      {% endif %}
    <div class="grid-blog grid" style="--alo-width-sidebar:{{section.settings.w_sidebar }}px;--alo-col-gap:{{ section.settings.col_gap }}px;">
      
      <div class="blog-content  {% if layout == 2 %}content-offset-left{% endif %}  {% if layout == 3  %}content-offset-right {% endif %}">
        <div class="banner-img-article" >
      {% assign image = article.image.src %}
      {% assign url = article.url %}
      {% if image != blank %}
        {% render 'responsive-image',
          image: image,
          aspect_ratio:aspect_ratio,
          url: url,
          image_class: 'w-full h-full alo-border-radius'
        %}
      {% endif %}                
    </div>
    <div class="content-blog">    	
    <div class="head head-article">
      <div class="cms-group-title">
        <h3 class="blog"><a href="{{blog.url}}">{{blog.title}}</a></h3>
        <h1><a class="h3" href="{{ article.url}}" title="{{ article.title }}" class="post-title">{{ article.title }}</a></h1>
      </div>
      <div class="meta-post">
        <div class="item-meta inner-date">
          {% render 'icon-data' %}
          <p>
          <span class="day">{{ article.created_at | date: "%d" }}</span>
          <span class="month">{{ article.created_at | date: "%b" }}</span>
          </p>
        </div>
        <div class="item-meta author">{% render 'icon-login' %} <p><span>{{article.author}}</span></p></div>
        <div class="item-meta comments">{% render 'icon-comment' %} <p><span>{{article.comments_count}} {{'blogs.article.comments' | t}} </span></p></div>
      </div>
    </div>
        <div class="post-item">          
          <div class="post-info">
            
            <div class="main-info-post">              
                {% if article.excerpt.size > 0 %}
                {% comment %}{{ article.excerpt | strip_html}} {% endcomment %}
                	<div class="des">{{ article.content }}</div>
                {% else %}
                	<div >{{ article.content }}</div>
                {% endif %}              
            </div>
          </div>
        </div>
		<div class="content-blog-bottom">
        {% if show_tags %}  	
        <div class="tags">
          {% if article.tags.size > 0 %}
          	{% render 'tags-article' ,limit:limit_tags%}                     
          {% endif %}
        </div>
        {%endif%}  
        {% if show_social %} {% render 'social-sharing', class:"top" %} {% endif%}  
      	</div>  
		<div class="paginate-post">
          {% if blog.next_article or blog.previous_article %} 
              {% if blog.previous_article %}
              <div class="left">
                <span class="icon-chevron-left"> </span>{{ 'blogs.article.older_post' | t | link_to: blog.previous_article }}
              </div>
              {% endif %}
              {% if blog.next_article %}
              <div class="right">
                {{ 'blogs.article.newer_post' | t | link_to: blog.next_article }} <span class="icon-chevron-right"> </span>
              </div>
              {% endif %}
          {% endif %}
        </div>
        {% if section.settings.comment_use_chk %}
        <div id="primary" class="list-comment content-form">  
          {% if article.comments_count > 0%}
          	<h4 class="main-title">{% if article.comments_count > 1 %}{{ 'blogs.comments.comments_with_count.other' | t : count : article.comments_count}} {% else %} {{ 'blogs.comments.comments_with_count.one' | t : count : article.comments_count}} {% endif %}</h4>
		  {% endif %}
          {% paginate article.comments by 3 %}
            {% if blog.comments_enabled? %}
              {% if comment and comment.created_at %}
                  <p class="note form-success">
                    {% if blog.moderated? %}
                    	{{ 'blogs.comments.success_moderated' | t }}
                    {% else %}
                    	{{ 'blogs.comments.success' | t }}
                    {% endif %}
                  </p>
              {% endif %}
              {% if article.comments_count > 0 %} 
                {% for comment in article.comments %}                
                	{% render 'comment' %}                
                {% endfor %}
              {% endif %}

              {% if paginate.pages > 1 %}
              	{% render 'pagination' %}
              {% endif %}
            {% endif %}
          {% endpaginate %}
          {% render 'blog-comment-form' %}
        </div>  
        {%endif%}
      </div>
      </div>    
      
    {% if layout != 1%} 
        	{% if chk_sidebar %}
        		{% render 'blog-sidebar',layout:layout%}  
        	{% endif %}
        {% endif %}
      
    </div>
  </div>
</div>
{%- render 'section_style' -%} 
{% style %}
  body{
      background-color:{{ section.settings.cl_bg }}
  }
{% endstyle %}
