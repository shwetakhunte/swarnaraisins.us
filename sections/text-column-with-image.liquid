{% liquid
  assign sid = section.id 
  assign layout =section.settings.layout
  assign visible = section.settings.visible
  assign widescreen = section.settings.widescreen
  assign desktop = section.settings.desktop
  assign laptop = section.settings.laptop
  assign notebook = section.settings.notebook
  assign tablet = section.settings.tablet
  assign landscape = section.settings.landscape
  assign portrait = section.settings.portrait
  assign mobile = section.settings.mobile
  assign space_between = section.settings.space-Between
  assign navigation = section.settings.navigation
  assign pagination = section.settings.pagination

  if section.settings['use-slider']
    assign use_slider = true
  else
    assign use_slider = false
  endif

  assign sett_equal = section.settings.use_eq_height
  assign image_ratio = section.settings.image_ratio
  if sett_equal 
     case image_ratio   
        when 'ratio2_1'
            assign aspect_ratio = 2.0
        when 'ratio3_2'
            assign aspect_ratio = 1.5
        when 'ratio4_3'
            assign aspect_ratio = 1.333
        when 'ratio1_1'
            assign aspect_ratio = 1.0
        when 'ratio3_4'
            assign aspect_ratio = 0.75
        when 'ratio2_3'
            assign aspect_ratio = 0.66667
        when 'ratio1_2'
            assign aspect_ratio = 0.5
     endcase 
  endif
  
%}
   
{%- for i in (1..1) -%}
{%- if section.settings.hidden %}{% break %}{% endif -%}	
{{ 'text-column-with-image.css' | asset_url | stylesheet_tag }}
<section id="laber_{{sid}}" class="text-column-with-image">
  <div class="container {% if layout %}full-width{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
      {% if section.settings.title != blank %}
        <div class="wrap_title w_{{ section.settings.h_position }} text_{{section.settings.txt_align}} {{ section.settings.text_size }} mb-30 sm:mb-20">
            <div
              class="h3 section-title text-transform"
                style="
                  --cl-text:{{ section.settings.cl_title |default:"#333333" }};
                  --text-transform:{{ section.settings.text_transform }}
                "
            >
            {{ section.settings.title }}
          </div>
        </div>
      {% endif %}
    <div class="content_section">
      {% # theme-check-disable %}

          {% include 'grid-slider', settings:section.settings %} 
          <grid-slider class="grid-slider show-tooltip blog-slider {%if sett_equal%}{{image_ratio}} {%endif%}" {{gridSlider}} >
            <div class="swiper iSwiper"
            data-mobile="{{ mobile }}"
            data-portrait="{{ portrait }}"
            data-landscape="{{ landscape }}"
            data-tablet="{{ tablet }}"
            data-notebook="{{ notebook }}"
            data-laptop="{{ laptop }}"
            data-desktop="{{ desktop }}"
            data-widescreen="{{ widescreen }}"
            data-visible="{{ visible }}"
            data-space-Between="{{ space_between}}"
            style="--perload-gap: {{ space_between}}px"
            >
              <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
      	{%- for block in section.blocks -%}
          {%- assign image = block.settings.image -%}
      	  {%- assign url = block.settings.url -%}
          <div class="swiper-slide">
            <div class="text_column_with_img">
              {%- if block.settings.enable_image -%}           
            	<div class="images mb-20">
                  {%- if image != blank -%}
                    {% render 'responsive-image', image: image, url:url, aspect_ratio:aspect_ratio, image_class: 'w-full h-full' %}
                  {%- else -%}
                    {% if aspect_ratio != blank %}
                         {%- assign ratio =  1 | divided_by: aspect_ratio | times: 100 -%}
                      {% else %}
                          {%- assign ratio = 100 -%}
                      {% endif %}
                      <div class="image-card__img overflow-hidden alo-border-radius ratio" style="--ratio-percent: {{ ratio }}%;">
                        {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                        {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                      </div>
                  {%- endif -%}
            	</div>
              {%- endif -%}
            <div class="text-content">	
              {% if block.settings.title != blank %}
                <h3 class="h3">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.sub_title != blank %}
                <h4 class="h4">{{ block.settings.sub_title | escape }}</h4>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="rte-setting">{{ block.settings.text }}</div>
              {% endif %}
            </div>	
            </div></div>
        {%- endfor -%}
    </div>
      {% if navigation and use-slider%}
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
      {% endif %}
      {% if pagination and use-slider%}
      <div class="swiper-pagination"></div>
      {% endif %}
    </div>
  </grid-slider>
      {% # theme-check-enable %}
    </div>
  </div>
</section>
{%- render 'section_style' -%} 
{%- endfor -%}

