{{ 'footer-top.css' | asset_url | stylesheet_tag }}
{%  assign sid = section.id  %}
{%- assign layout = section.settings.full_width -%}
<section id="laber_{{sid}}" class="wow animate--slide-in " style="--cl-border:{{ section.settings.cl_line }};">
    <div class="main-footer">
        <div class="container {% if layout %}full-width{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
        	<div class="row">
                {% render 'footer-top' %}
            </div>
        </div>
      </div>
</section>
{%- render 'section_style' -%} 
