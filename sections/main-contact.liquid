{% liquid
  assign sid = section.id 
  assign layout = section.settings.layout
%}  
<section id="laber_{{sid}}"> 

<div class="container {% if layout %}full-width{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
    <!-- Map Element -->
      {% if section.settings.use_contact_map %}
        <div class="map">              
          {{ section.settings.map_iframe }}              
        </div>
      {% endif %}
    <!-- End Map Element -->  
<div class="main-content shop-page">
  <div class="content-form">
    <div class="row pr_center ">

          {%- for block in section.blocks -%}
          {%- case block.type -%}
          {%- when 'Contact' -%} 
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-6">
              <div class="contact-info">
                {% if block.settings.title %}<h3 class="mb-15">{{ block.settings.title }}</h3>{% endif %}
                {% if block.settings.content %}<div class="content mb-25">{{ block.settings.content }}</div>{% endif %}
                {% if block.settings.show_address and block.settings.address %}
                    <div class="info-item">
                        <h2>{{ 'contact.information.location' | t }}</h2>
                        <div>{{ block.settings.address }}</div>
                    </div>
                    
                {% endif %}
                {% if block.settings.show_work_time and block.settings.work_time %}
                  <div class="info-item mb-20">
                    <h2>{{ 'contact.information.work_time' | t }}</h2>
                    <div>{{ block.settings.work_time }}</div>
                  </div>
                  {% endif %}
                {% if block.settings.show_phone %}
                  <div class="info-item mb-20">
                   <h2>{{ 'contact.information.phone' | t }}</h2>
                    <div>
                      <a class="phone" href="tel:{{shop.phone}}">{{shop.phone}}</a><br>
                      {% if block.settings.phone %}<a class="phone" href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a>{% endif %}
                    </div>
                  </div>
                {% endif %}
                {% if block.settings.show_email %}
                  <div class="info-item mb-20">
                     <h2>{{ 'contact.information.email' | t }}</h2>
                     <div>
                      <a href="mailto:{{shop.email}}">{{shop.email}}</a><br>
                      {% if block.settings.email %}<a href="mailto:{{block.settings.email}}">{{block.settings.email}}</a>{% endif %}
                     </div>
                  </div>
                {% endif %}
                  {% assign type_social = block.settings.type_social | plus: 0 %}
                  {%if block.settings.header_use_social%}
                  <div class="info-item mb-20">
                    <h2>{{ 'contact.information.social' | t }}</h2>
                    {%- if type_social == 1 -%}
                      {% render 'social_link', class: "top" %}
                    {%- else -%}
                        {% render 'social-sharing', class: "top" %}
                    {%- endif -%}
                   </div>
                  {% endif %}
              </div>
            </div>
            {%- when 'form_contact' -%}
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-6">
        <div class="information-form">
        <div class="contact-form">
          {% form 'contact', class:'form-contact', id:'contact-form' %}	
              {% if form.posted_successfully? %}
              <div class="successForm feedback">
                {{ 'contact.form.post_success' | t }}
              </div>
              {% endif %}
              {% if form.errors %}
              <div class="errorForm feedback">                
                <p>Your contact form has {{ form.errors | size | pluralize: "an error", "a few errors" }}. To submit your form, make the following changes and try again:</p>
                {% for field in form.errors %}
                <p>The {{ field | capitalize | replace: 'Body', 'Message' }} field {{ form.errors.messages[field] }}.</p>
                {% endfor %}
              </div>
              {% endif %}
              <h3 class="main-title mb-15">{{block.settings.right_title_block}}</h3>
              <div class="content mb-25">{{block.settings.content}}</div>
              <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
                    {% assign name_attr = 'contact.form.name' | t | handle %}
                    <input 
                      placeholder="{{'contact.form.name' | t}} *" 
                      class="input-info" 
                      id="name" 
                      required 
                      name="contact[{{ name_attr }}]"  
                      type="text" 
                      value="{% if form[name_attr] %}{{ form[name_attr] }}{% elsif customer %}{{ customer.first_name }}{% endif %}"/>  
                </div>
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
                  <input 
                    placeholder="{{ 'contact.form.email' | t }} *" 
                    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" 
                    required name="contact[email]" 
                    class="input-info" 
                    id="email" type="text"/>
                </div>
              </div>
              
                <input required
                  type="tel" 
                  id="ContactForm-phone" 
                  class="input-info" 
                  autocomplete="tel" 
                  name="contact[{{ 'contact.form.phone' | t }}]" 
                  pattern="[0-9\-]*" 
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" 
                  placeholder="{{ 'contact.form.phone' | t }} *">
                <div class="field">
                  
                </div>	
              <textarea placeholder="{{'contact.form.message' | t}} *" rows="8" class="input-info input-note" name="contact[body]" required id="message">{% if form.body %}{{ form.body }}{% endif %}</textarea>
              <div class="group-button">                
                <button class="btn button submit" type="submit">{{'contact.form.submit'|t}}</button>
              </div>
          {% endform %}
        </div>
          </div>
      </div>
          {%- endcase -%}
          {%- endfor -%}
    </div>
  </div>
</div>
  </div>
</section>
{%- render 'section_style' -%}
