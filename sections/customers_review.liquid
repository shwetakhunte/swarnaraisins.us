{{ 'customers-review.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign sid = section.id
  assign layout = section.settings.layout
  assign space_between = section.settings.space-Between
  assign navigation = section.settings.navigation
  assign pagination = section.settings.pagination

  if section.settings['use-slider']
    assign use_slider = true
  else
    assign use_slider = false
  endif
  
 %}
{%- for i in (1..1) -%}    
<section id="laber_{{sid}}">
  <div class=" {% if layout %}full-width{% else %}container{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
      {% if section.settings.title != blank %}
        <div class="wrap_title w_{{ section.settings.h_position }} text_{{section.settings.txt_align}} {{ section.settings.text_size }} mb-30 sm:mb-20 ">
          {% if section.settings.sub_title != blank %}
            <div class="section-subtitle"
              style="
                  --cl-text:{{ section.settings.cl_title_sub |default:"#888" }};
            "
              >{{ section.settings.sub_title }}</div>
          {% endif %}  
            <div
              class="h3 section-title text-transform"
                style="
                  --cl-text:{{ section.settings.cl_title |default:"#333333" }};
                  --text-transform:{{ section.settings.text_transform }}
                "
            >
            {{ section.settings.title }}
          </div>
          {% if section.settings.content != blank %}
            <div class="content">{{ section.settings.content }}</div>
          {% endif %}
        </div>
      {% endif %}
        <div  class="customers-review">
          {%- if section.blocks.size > 0 -%}         
            {% # theme-check-disable %}

          {% include 'grid-slider', settings:section.settings %} 
          <grid-slider class="grid-slider show-tooltip blog-slider {%if sett_equal%}{{image_ratio}} {%endif%}" {{gridSlider}} >
            <div class="swiper iSwiper"
            {%- render 'skeleton', settings: section.settings -%}
            style="--perload-gap: {{ space_between}}px"
            >
              <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                  {% assign index = 1 %} 
                  {%- for block in section.blocks -%}
                	{%- case block.type -%}
                	{%- when 'text' -%}	
                    <div class="swiper-slide scroll-trigger" style="--animation-order:{{ index }};">
                      <div class="review_content" style="--alo-background:{{ block.settings.cl_bg }};">
                          <div class="cms_content mb-20">
                          {{block.settings.content}}
                          </div>
                          <div class="name_time">{{block.settings.name_time}}</div>
                      </div>
                    </div>
                	{%endcase%}
                    {% assign index = index | plus: 1 %}
                  {%- endfor -%} 
                </div>
                {% if use_slider == true %}
                {% if navigation %}
                  <div class="swiper-button-next"></div>
                  <div class="swiper-button-prev"></div>
                {% endif %}
                {% if pagination %}
                  <div class="swiper-pagination"></div>
                {% endif %}
              {% endif %} 
            </div>
          	</grid-slider>
            {% # theme-check-enable %}
          {%- endif -%}
        </div>
       {% if section.settings.show_text_bottom %} <div class="text_bottom ">{{ section.settings.text_bottom }}</div>{% endif %}
      </div>
    </section>
{%- endfor -%}
{%style%}

	
{%endstyle%}
{%- render 'section_style' -%}
