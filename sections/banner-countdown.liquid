{% liquid
  assign sid = section.id
  assign url = section.settings.button_link
  assign layout = section.settings.layout
%}
{{ 'banner-countdown.css' | asset_url | stylesheet_tag }}
  <section id="laber_{{sid}}" data-aos-duration="500" data-aos="fade-up">
    <div class="{% if layout %}full-width{% else %}container{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
      <div  class="laber_countdown_banner">
        <div class=" wrap-infor">
          {%- assign url = section.settings.url -%}
          <div class="container">
            <div class="row h_{{section.settings.h_position}} v_{{section.settings.v_position}} text_{{section.settings.txt_align}}">
              <div class="product_count_down col-xs-12 col-sm-12 col-md-6" style="--cl-text:{{ section.settings.cl_text }};">
                <div class="content-countdown">
                  <div class="product-inner">
                    {% if section.settings.title != blank or section.settings.sub_title != blank %}
                      <div class="wrap_title mb-30 sm:mb-20">
                        {% if section.settings.title2 != blank %}
                          <div class="title2 mb-10 sm:mb-10">{{ section.settings.title2 }}</div>
                        {% endif %}
                        {% if section.settings.title != blank %}
                          <div class="mb-30 sm:mb-20 title1">{{ section.settings.title }}</div>
                        {% endif %}
                        {% if section.settings.sub_title != blank %}
                          <span class="subtitle">{{ section.settings.sub_title }}</span>
                        {% endif %}
                      </div>
                    {% endif %}
                    {%- if section.settings.year_count_down != blank
                      and section.settings.month_count_down != blank
                      and section.settings.day_count_down != blank
                    -%}
                      <count-down
                        style="
                        --cl-countdown:{{ section.settings.cl_countdown }};
                        "
                        class="cms-countdown mb-30 sm:mb-20"
                        data-y="{{section.settings.year_count_down}}"
                        data-m="{{section.settings.month_count_down}}"
                        data-d="{{section.settings.day_count_down}}"
                        data-h="00"
                        data-i="00"
                        data-s="00"
                      ></count-down>
                    {%- endif -%}

                    <div class="laber_button" style="
                      --cl-btn-text:{{section.settings.cl_btn}};
                      --bg-btn:{{section.settings.bg_cl}};
                      --cl-b-btn:{{section.settings.bg_cl}};
                      --cl-btn-text-h:{{section.settings.cl_btn_hover}};
                      --bg-btn-h:{{section.settings.bg_cl_hover}};
                      --cl-b-btn-h:{{section.settings.bg_cl_hover}};
                      --rounded-btn:{{ section.settings.b_border }}px;
                      ">
                      {% if section.settings.btn != blank %}
                        <a class="button btn" href="{{url | default:"#" }}">
                          {{- section.settings.btn -}}
                        </a>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
{%- render 'section_style' -%}
{%- schema -%}
  {
    "name": "Bannner countdown",
    "class": "cms_section type_product_countdown_banner",
    "settings": [
      {
          "type": "checkbox",
          "id": "layout",
          "label": "Full width",
          "default": false
        },
      {
        "type": "range",  
        "id": "container",  
        "label": "Container width",
        "min": 1170,
        "max": 1900,
        "step": 10,
        "unit": "px",
        "default": 1410 
    },
      {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
	  "info": "1920x700.jpg recommended"
      },
	  {
        "type": "color",
        "id": "cl_bg",
        "label": "Background color",
        "default": "#fff"
      },
      {
        "type": "header",
        "content": "== Countdown Settings"
      },
      {
      "type": "text",
      "id": "year_count_down",
      "label": "Year of countdown",
      "default": "yyyy"
      },
      {
      "type": "text",
      "id": "month_count_down",
      "label": "Month of countdown",
      "default": "mm"
      },
      {
      "type": "text",
      "id": "day_count_down",
      "label": "Day of countdown",
      "default": "dd"
      },
      {
        "type": "color",
        "id": "cl_countdown",
        "label": "Color Countdown",
        "default": "#333"
      },
	  {
        "type": "header",
        "content": "== Setting Button"
      },
      {
        "type": "text",
        "id": "btn",
        "label": "Button Text",
        "default": "Shop Now"
      },
	  {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      },
      {
        "type": "color",
        "id": "cl_btn",
        "label": "Button color text ",
        "default": "#fff"
      },
      {
        "type": "color",
        "id": "cl_btn_hover",
        "label": "Button color text (hover)",
        "default": "#fff"
      },
      {
        "type": "color",
        "id": "bg_cl",
        "label": "Button background color",
		"default":"#1a73e8"
      },
      {
          "type": "range",  
          "id": "b_border",  
          "label": "Button border",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px",
          "default": 0 
      },
      {
        "type": "color",
        "id": "bg_cl_hover",
        "label": "Button background color (hover)",
		"default":"#343e45"
      },
      {
        "type": "header",
        "content": "== General Settings"
      },
      {
        "type": "color",
        "id": "cl_text",
        "label": "Color text",
        "default": "#fff"
      },
      {
        "type": "textarea",
        "id": "title",
        "label": "Heading",
        "default": "Special Offers"
      },
      {
      "type": "inline_richtext",
      "id": "title2",
      "label": "Heading2",
      "default": "Hurry Up! 25% Off"
      },
      {
        "type": "richtext",
        "id": "sub_title",
        "label": "Sub Text",
		"default":"<p>Class aptent taciti sociosqu ad litora torquent per conubia</p>"
      },
	  {
        "type": "header",
        "content": "== Setting Sections"
      },
{
        "type": "select",
        "id": "h_position",
        "label": "Horizontal Position",
        "default": "left",
        "options": [
            {
            "value": "left",
            "label": "Left"
            },
            {
            "value": "center",
            "label": "Center"
            },
            {
            "value": "right",
            "label": "Right"
            }
          ]
        },
        {
        "type": "select",
        "id": "v_position",
        "label": "Vertical Position",
        "default": "top",
        "options": [
            {
            "value": "top",
            "label": "Top"
            },
            {
            "value": "middle",
            "label": "Middle"
            },
            {
            "value": "bottom",
            "label": "Bottom"
            }
          ]
        },
		{
            "type": "select",
            "id": "txt_align",
            "label": "Text Align",
            "default": "left",
            "options": [
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "center",
                "label": "Center"
              },
              {
                "value": "right",
                "label": "Right"
              }
            ]
          },
      {
        "type": "text",
        "id": "mg",
        "label": "Margin",
        "info":"Margin top, margin right, margin bottom, margin left. If you not use to blank"
      },
      {
        "type": "text",
        "id": "pd",
        "label": "Padding",
        "info":"Padding top, padding right, padding bottom, padding left. If you not use to blank"
      },
     {
        "type": "header",
        "content": "== Design Mobile Options"
      },
      {
        "type": "text",
        "id": "mg_mb",
        "label": "Margin"
      },
      {
        "type": "text",
        "id": "pd_mb",
        "label": "Padding"
      }
    ],
    "presets": [
      {
        "name": "Bannner countdown",
        "category": "Countdown"
      }
    ]
  }
{%- endschema -%}
