{% liquid
  assign sid = section.id
  assign layout = section.settings.layout
  assign blocks = section.blocks
%}
{{ 'section-about-us.css' | asset_url | stylesheet_tag }}
  <section id="laber_{{sid}}" class="">
    <div class="container {% if layout %}full-width{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
      {% if section.settings.title != blank %}
            <div class="wrap_title sm:mb-10 w_{{ section.settings.h_position }} text_{{section.settings.txt_align}} mb-30 {{ section.settings.text_size }} ">
              {% if section.settings.subtitle != blank %}
                <div class="section-subtitle" style="--cl-text:{{ section.settings.cl_subtitle }};" bis_skin_checked="1">{{ section.settings.subtitle }}</div>
              {% endif %}
              <div class="h3 section-title " style="--cl-text:{{ section.settings.cl_title }};">{{section.settings.title}}</div>  
              {% if section.settings.content != blank %}
                <div class="content">{{section.settings.content}}</div>
              {% endif %}
            </div>
          {% endif %}
      <div class="section_content ">
        <div class="part">
          <grid-wrap class="flex flex-wrap alo-gap content-grid"
            style="
                  --rounded:{{ section.settings.border }}px;
                  --col-desktop:{{ section.settings.columns_desktop }};
                  --col-laptop:{{ section.settings.columns_laptop }};
                  --col-tablet:{{ section.settings.columns_tablet }};
                  --col-landscape:{{ section.settings.columns_landscape }};
                  --col-mobile:{{ section.settings.columns_mobile }};
                  --alo-gap-m:{{section.settings.gap_mobile}}px;
                  --alo-gap:{{ section.settings.gap }}px;"
            >
            {% for block in blocks %}
              {%- case block.type -%}
                {% when 'text' %}
                  <grid-item id="bk_{{ block.id }}" class="item">
                      <div class="content-text" style="--bg-color:{{ block.settings.bg_color}}">
                        <div class="alo-icon mb-20 sm:mb-10" style="--cl-icon:{{ block.settings.cl_icon }}">
                          {% assign source = block.settings.source | plus : 0  %}
                          {% if source == 1 %}
                            {% if block.settings.icon != blank %}
                                <div class="iconfont" style=" width: 65px; height: 65px; --rounded: 100%;">
                                 <i class="{{ block.settings.icon }}"></i>
                                </div>
                              {% else %}
                                 {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                                 <div style=" width: 65px; height: 65px; --rounded: 100%;">
                                  {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                                 </div>
                              {% endif %}
                          {% elsif source == 2  %}
                            {% if block.settings.icon_img != blank %}
                                <div class="alo-icon-image" style="--rounded: 100%;">
                                  {% assign image = block.settings.icon_img %}
                                  {%- assign image_alt = image.alt | default: block.settings.title | escape -%}
                                  {%- assign image_height = block.settings.image_max_width | divided_by: block.settings.image.aspect_ratio -%}
                                  {% capture sizes %}(max-width: {{ block.settings.image_max_width | times: 2 }}px) 50vw, {{ block.settings.image_max_width }}px{% endcapture %}
                                  {% capture widths %}{{ block.settings.image_max_width }}, {{ block.settings.image_max_width | times: 1.5 | round }}, {{ block.settings.image_max_width | times: 2 }}{% endcapture %}
                                  {{ image | image_url: width: 600 | image_tag:
                                    class: 'i-image',
                                    widths: widths,
                                    height: image_height,
                                    width: block.settings.image_max_width,
                                    alt: image_alt,
                                    sizes: sizes,
                                    preload: true
                                  }}
                                </div>
                              {% else %}
                                 {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                                 <div style=" width: 65px; height: 65px; --rounded: 100%;">
                                  {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                                 </div>
                              {% endif %}
                          {% else %}
                            
                              <div class="icon-svg">
                               {% if block.settings.icon_svg != blank %}
                                 {{ block.settings.icon_svg }}
                              {% else %}
                                 {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                                 <div style=" width: 65px; height: 65px; --rounded: 100%;">
                                  {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                                 </div>
                              {% endif %}
                              </div>
                          {% endif %}
                          
                        </div>
                        {% if block.settings.title != blank %}
                          <h2 class="about-title mb-10 sm:mb-10" style="--cl-text:{{ block.settings.cl_title }}">{{ block.settings.title }}</h2>
                        {% endif %}
                        {% if block.settings.content != blank %}
                          <div class="content mb-10 sm:mb-10" style="--cl-text:{{ block.settings.cl_content }}">
                            {{ block.settings.content }}
                          </div>
                        {% endif %}
                        {% if block.settings.link_name != blank %}
                          <div class="link" style="--cl-link:{{ block.settings.cl_link }}">
                            <a href="{{ block.settings.link | default:"#" }}">{{ block.settings.link_name }}</a>
                          </div>
                        {% endif %}
                      </div>
                  </grid-item>
              {% endcase %}
            {% endfor %}
          </grid-wrap>
        </div>
        {% if section.settings.content_below %}
              <div class="view_all pt-40">
                {{ section.settings.content_below }} {{- 'chevron.svg' | inline_asset_content -}}
              </div>  
            {% endif %}                    
      </div>
    </div>
  </section>
{%- render 'section_style' -%}
