{{ 'menu-mobile-bottom.css' | asset_url | stylesheet_tag }}
<div class="apus-footer-mobile">
  <ul>
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'home' -%}
          <li>
            <a href="{{ routes.root_url | default: '#'}}" title="{{'homepage.title' | t}}" aria-label="link">
              {% render "icon-home" %}
              <span>{{ 'homepage.title' | t }}</span>
            </a>
          </li>
        {%- when 'collections' -%}
          <li>
            <a href="{{ block.settings.url | default: '#'}}" title="{{'homepage.shop' | t}}" aria-label="link">
              {% render "icon-shop" %}
              <span>{{ 'homepage.shop' | t }}</span>
            </a>
          </li>
        {%- when 'cart' -%}
          <li class="cart_mobile">
            <a
              title="{{'cart.general.title' | t}}"
              class="footer-mini-cart mini-cart push_side header-icon"
              href="{{ routes.cart_url }}"
              data-id="#js_cart_popup"
              aria-label="link"
            >
             
              {% render "icon-cart" %}
              <span class="header__counter js-cart-count cart-count" data-js-cart-count="{{ cart.item_count }}">
                {{- cart.item_count -}}
              </span>
              <span>{{ 'cart.general.title' | t }}</span>
            </a>
          </li>
        {%- when 'search' -%}
          <li>
            <trigger-click class="footer-search-btn" data-target="dialog-modal .header-search">
              {% render "icon-search" %}
              <span>{{ 'general.search.btn' | t }}</span>
            </trigger-click>
          </li>
        {%- when 'account' -%}
          <li>
            <a href="{{ routes.account_url }}" title="{{'customer.account.title' | t}}" aria-label="link">
              {% render "icon-login" %}
              <span>{{ 'customer.account.title' | t }}</span>
            </a>
          </li>
        {%- when 'wishlist' -%}
          {% if section.settings.header_use_wishlist_home %}
            <li>
              {% render 'mini-wishlist' %}
            </li>
          {% endif %}
      {%- endcase -%}
    {%- endfor -%}
  </ul>
</div>
{%- render 'section_style' -%}
{%- schema -%}
{
  "name": "Menu bottom",
  "class": "menu-bottom",
  "max_blocks": 10,
  "settings": [
  {
  "type": "checkbox",
  "id": "header_use_wishlist_home",
  "label": "Show Count Wishlist",
  "default": true
  }
  ],
  "blocks": [
    {
      "type": "home",
      "name": "Home",
      "limit":1
    },
    {
      "type": "collections",
      "name": "Collections",
      "limit":1,
      "settings": [
      {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    },
    {
      "type": "cart",
      "name": "Cart",
      "limit":1
    },
    {
      "type": "search",
      "name": "Search",
      "limit":1
    },
    {
      "type": "account",
      "name": "Account",
      "limit":1
    },
    {
      "type": "wishlist",
      "name": "Wishlist",
      "limit":1
    }

  ]
}
{%- endschema -%}
