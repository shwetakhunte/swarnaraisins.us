{% if section.settings.home_page_only == false or template.name == 'index' %}
  {{ 'top-bar.css' | asset_url | stylesheet_tag }}  
  <top-bar
    class="topbar {% if section.settings.hide_top_header_mobile %}hide-mobile{% endif %} {% if section.settings.show_close_btn %} show-close-button parent-close{% endif %}"
    style="
      {% if section.settings.bg_img != blank %}
        background-image: url('{{ section.settings.bg_img | image_url: width: 1920 }}');
        background-size: cover;
        background-repeat: no-repeat;
        background-position: top center;
      {% endif %}
    "
  >
    {% if section.settings.show_close_btn %}
      <span class="announcement-close btn-close close-x">
        <i class="icon-btn-close icon-x"></i>
      </span>
    {% endif %}
    <div
      class="container {% if section.settings.layout %}full-width{% endif %}"
      style="--alo-container-width:{{ section.settings.container }}px;"
    >
      <div class="row">
          {%- for block in section.blocks -%}
            {% assign text_align = block.settings.text_align %}
            {% case block.settings.col %}
                {% when '16%' %}
                    {%- assign block_width = 'col-lg-2 col-md-2 col-12' -%}
                {% when '25%' %}
                    {%- assign block_width = 'col-lg-3 col-md-3 col-12' -%}
                {% when '33%' %}
                    {%- assign block_width = 'col-lg-4 col-md-4 col-12' -%}
                {% when '42%' %}
                    {%- assign block_width = 'col-lg-5 col-md-5 col-12' -%}
                {% when '50%' %}
                    {%- assign block_width = 'col-lg-6 col-md-6 col-12' -%}
                {% when '58%' %}
                    {%- assign block_width = 'col-lg-7 col-md-7 col-12' -%}
                {% when '66%' %}
                    {%- assign block_width = 'col-lg-8 col-md-8 col-12' -%}
                {% when '75%' %}
                    {%- assign block_width = 'col-lg-9 col-md-9 col-12' -%}
                {% when '100%' %}
                    {%- assign block_width = 'col-12' -%}
            {% endcase %}
            {%- case block.type -%}
              {%- when 'message' -%}
              <div id="b_{{ block.id }}" class="{{ block_width }}">
                <div class="wrapper-bar-message h_{{text_align}} flex">
                  <div class="announcement-bar__message"
                      style="
                          --cl-text:{{block.settings.color_link}}; 
                          --cl-text-h:{{block.settings.color_link_hover}};
                          --font-size:{{ block.settings.f-size }}px;
                          --font-weight:{{ block.settings.f-weight }};
                          --text-transform:{{ block.settings.text_transform }};
                        "
                    >
                    {{ block.settings.message_text }}
                  </div>
                </div>
              </div>
              {%- when 'text_running' -%}
                {% assign limit = block.settings.limit %}
                <div id="b_{{ block.id }}" class="{{ block_width }}">
                <div class="text-horizontal-running {{ block.settings.slider_direction }}">
                  {%- if section.blocks.size > 0 -%}
                    <div class="wrap-text" style=" --cl-text:{{ block.settings.cl_text }};--alo-healing-speed:{{ block.settings.healing_speed }}s;">
                      {%- for i in (1..limit) -%}
                          {% if block.settings.text != blank -%}
                            <div class="flex">{{ block.settings.text }}</div>
                          {%- endif %}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
                </div>
              {%- when 'text_slider' -%}
              {% liquid
                  assign space_between = block.settings.space-Between
                  assign navigation = block.settings.navigation
                  if block.settings['use-slider']
                    assign use_slider = true
                  else
                    assign use_slider = false
                  endif
                %}
              <div id="b_{{ block.id }}" class="{{ block_width }}">
                <div class="text-slider" style="--cl-text:{{section.settings.cl_text}};--w-slide:{{ block.settings.w_slide }}px;">
                  {%- if section.blocks.size > 0 -%}
                    {% # theme-check-disable %}
                     {% include 'grid-slider', settings: block.settings %}
                      <grid-slider class="grid-slider" {{ gridSlider }}>
                      <div class="swiper iSwiper" {%- render 'skeleton', settings: block.settings -%} style="--perload-gap: {{space_between}}px">
                      <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                          {% if block.settings.text_1 != blank %}<div class="swiper-slide"><div class="text h_{{text_align}} flex">{{ block.settings.text_1 }}</div></div>{% endif %}
                          {% if block.settings.text_2 != blank %}<div class="swiper-slide"><div class="text h_{{text_align}} flex">{{ block.settings.text_2 }}</div></div>{% endif %}
                          {% if block.settings.text_3 != blank %}<div class="swiper-slide"><div class="text h_{{text_align}} flex">{{ block.settings.text_3 }}</div></div>{% endif %}
                          {% if block.settings.text_4 != blank %}<div class="swiper-slide"><div class="text h_{{text_align}} flex">{{ block.settings.text_4 }}</div></div>{% endif %}
                          {% if block.settings.text_5 != blank %}<div class="swiper-slide"><div class="text h_{{text_align}} flex">{{ block.settings.text_5 }}</div></div>{% endif %}
                      </div>
                      {% if use_slider == true %}
                        {% if navigation %}
                          <div class="swiper-button-next"></div>
                          <div class="swiper-button-prev"></div>
                        {% endif %}
                      {% endif %}
                      </div>
                      </grid-slider>
                    {% # theme-check-enable %}
                  {%- endif -%}
                </div>
              </div>
            {%- endcase -%}
          {%- endfor -%}
      </div>
    </div>
  </top-bar>
{% style %}
  :root {
    --h-top-bar:{{ section.settings.h_topbar }}px;
    --bg-top-bar:{{section.settings.bg_top_header}};
    --cl-bd-top-bar:{{section.settings.cl_bd_top_bar}};
    --cl-text-top-bar:{{section.settings.cl_text}};
  }
{% endstyle %}
{% endif %}
