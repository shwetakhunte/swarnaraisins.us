{% schema %}
{
  "name": "SupplySix Featured Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "SupplySix Featured Grid",
      "category": "Collection"
    }
  ]
}
{% endschema %}

{{ 'supplysix-style.css' | asset_url | stylesheet_tag }}

<div class="supplysix-collection-section">
  <div class="supplysix-container">
    {% if section.settings.title != blank %}
      <h2 class="supplysix-section-title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="supplysix-product-grid">
      {% assign collection = collections[section.settings.collection] %}
      
      {% for product in collection.products limit: section.settings.products_to_show %}
        <div class="supplysix-product-card">
          {% if product.variants.first.image != blank %}
            {% assign initial_image = product.variants.first.image %}
          {% else %}
            {% assign initial_image = product.featured_image %}
          {% endif %}
          <div class="ss-product-image">
            <a href="{{ product.url }}">
              <img src="{{ initial_image | img_url: '600x600', crop: 'center' }}" alt="{{ product.title }}">
            </a>
          </div>
          
          <div class="ss-product-info">
            <a href="{{ product.url }}" class="ss-product-title">{{ product.title }}</a>
            
            <div class="ss-product-price-wrapper">
              {% if product.compare_at_price > product.price %}
                <span class="ss-sale-price">{{ product.price | money }}</span>
                <span class="ss-regular-price struck">{{ product.compare_at_price | money }}</span>
              {% else %}
                <span class="ss-regular-price">{{ product.price | money }}</span>
              {% endif %}
            </div>

            <div class="ss-product-reviews">
               <!-- Placeholder for Judge.me or other review app -->
               <span class="ss-stars">★★★★★</span>
            </div>

            {% if product.variants.size > 1 and product.has_only_default_variant == false %}
              <div class="ss-product-swatches">
                <span class="ss-swatch-label">{{ product.options.first }}:</span>
                <div class="ss-swatch-list">
                  {% for variant in product.variants %}
                    {% assign variant_days = variant.title | split: ' ' | first %}
                    {% if variant.image != blank %}
                      {% assign variant_image = variant.image %}
                    {% else %}
                      {% assign variant_image = product.featured_image %}
                    {% endif %}
                    <div class="ss-swatch-item {% if forloop.first %}selected{% endif %}"
                         onclick="ssSelectCardVariant(this, '{{ product.id }}', '{{ variant.id }}', '{{ variant.price | money | escape }}', '{{ variant.compare_at_price | money | escape }}', {{ variant.available }}, '{{ variant_image | img_url: '600x600', crop: 'center' }}')">
                      {{ variant_days }}
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            <div class="ss-product-action">
              <form method="post" action="/cart/add">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                {% if product.available %}
                  <button type="submit" class="ss-add-to-cart-btn">Add to cart</button>
                {% else %}
                  <button type="button" class="ss-add-to-cart-btn disabled" disabled>Sold out</button>
                {% endif %}
              </form>
            </div>
          </div>
        </div>
      {% else %}
        <p style="text-align: center; width: 100%;">Please select a collection with products.</p>
      {% endfor %}
    </div>
  </div>
</div>

<script>
if (typeof ssSelectCardVariant !== 'function') {
  window.ssSelectCardVariant = function(el, productId, variantId, price, comparePrice, available, imageUrl) {
    const card = el.closest('.supplysix-product-card');
    if (!card) return;

    // 1. Toggle selected class
    card.querySelectorAll('.ss-swatch-item').forEach(item => item.classList.remove('selected'));
    el.classList.add('selected');

    // 2. Update variant ID input
    const input = card.querySelector('form[action="/cart/add"] input[name="id"]');
    if (input) {
      input.value = variantId;
    }

    // 3. Update Price
    const priceWrapper = card.querySelector('.ss-product-price-wrapper');
    if (priceWrapper) {
      let priceHtml = '';
      if (comparePrice && comparePrice !== '' && comparePrice !== price) {
        priceHtml = `<span class="ss-sale-price">${price}</span> <span class="ss-regular-price struck">${comparePrice}</span>`;
      } else {
        priceHtml = `<span class="ss-regular-price">${price}</span>`;
      }
      priceWrapper.innerHTML = priceHtml;
    }

    // 4. Update Button State
    const btn = card.querySelector('.ss-add-to-cart-btn');
    if (btn) {
      if (available) {
        btn.innerText = 'Add to cart';
        btn.disabled = false;
        btn.classList.remove('disabled');
      } else {
        btn.innerText = 'Sold out';
        btn.disabled = true;
        btn.classList.add('disabled');
      }
    }

    // 5. Update Image
    if (imageUrl) {
      const img = card.querySelector('.ss-product-image img');
      if (img) {
        img.src = imageUrl;
      }
    }
  };
}
</script>
