{% schema %}
{
  "name": "SupplySix Main Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    }
  ],
  "presets": [
    {
      "name": "SupplySix Main Collection",
      "category": "Collection"
    }
  ]
}
{% endschema %}

{{ 'supplysix-style.css' | asset_url | stylesheet_tag }}

<div class="supplysix-collection-section">
  <div class="supplysix-container">
    <div class="collection-header" style="text-align: center; margin-bottom: 40px;">
      
      {% if collection.description != blank %}
        <div class="collection-description" style="max-width: 800px; margin: 0 auto; color: #555;">
          {{ collection.description }}
        </div>
      {% endif %}
    </div>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size == 0 -%}
        <p style="text-align: center; width: 100%;">No products found in this collection.</p>
      {%- else -%}
        <div class="supplysix-product-grid">
          {%- for product in collection.products -%}
            <div class="supplysix-product-card">
              {% if product.variants.size > 1 %}
                {% assign default_variant = product.variants[1] %}
              {% else %}
                {% assign default_variant = product.variants.first %}
              {% endif %}

              {% if default_variant.image != blank %}
                {% assign initial_image = default_variant.image %}
              {% else %}
                {% assign initial_image = product.featured_image %}
              {% endif %}
              <div class="ss-product-image">
                <a href="{{ product.url }}">
                  <img src="{{ initial_image | img_url: '600x600', crop: 'center' }}" alt="{{ product.title }}">
                </a>
              </div>
              
              <div class="ss-product-info">
                <a href="{{ product.url }}" class="ss-product-title">{{ product.title }}</a>
                
                <div class="ss-product-price-wrapper">
                  {% if default_variant.compare_at_price > default_variant.price %}
                    <span class="ss-sale-price">{{ default_variant.price | money }}</span>
                    <span class="ss-regular-price struck">{{ default_variant.compare_at_price | money }}</span>
                  {% else %}
                    <span class="ss-regular-price">{{ default_variant.price | money }}</span>
                  {% endif %}
                </div>

                <div class="ss-product-reviews">
                   <!-- Placeholder for Judge.me or other review app -->
                   <span class="ss-stars">★★★★★</span>
                </div>

                {% if product.variants.size > 1 and product.has_only_default_variant == false %}
                  <div class="ss-product-swatches">
                    <span class="ss-swatch-label">{{ product.options.first }}:</span>
                    <div class="ss-swatch-list">
                      {% for variant in product.variants %}
                        {% assign variant_days = variant.title | split: ' ' | first %}
                        {% if variant.image != blank %}
                          {% assign variant_image = variant.image %}
                        {% else %}
                          {% assign variant_image = product.featured_image %}
                        {% endif %}
                        <div class="ss-swatch-item {% if variant.id == default_variant.id %}selected{% endif %}"
                             onclick="ssSelectCardVariant(this, '{{ product.id }}', '{{ variant.id }}', '{{ variant.price | money | escape }}', '{{ variant.compare_at_price | money | escape }}', {{ variant.available }}, '{{ variant_image | img_url: '600x600', crop: 'center' }}')">
                          {{ variant_days }}
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                {% endif %}

                <div class="ss-product-action">
                  <form method="post" action="/cart/add">
                    <input type="hidden" name="id" value="{{ default_variant.id }}" />
                    {% if default_variant.available %}
                      <button type="submit" class="ss-add-to-cart-btn">Add to cart</button>
                    {% else %}
                      <button type="button" class="ss-add-to-cart-btn disabled" disabled>Sold out</button>
                    {% endif %}
                  </form>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="pagination-wrapper" style="margin-top: 40px; text-align: center;">
            {{ paginate | default_pagination: next: 'Next »', previous: '« Prev' }}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

<style>
/* Basic pagination styling for SupplySix theme */
.pagination-wrapper .page {
  display: inline-block;
  margin: 0 4px;
}
.pagination-wrapper .page a, .pagination-wrapper .next a, .pagination-wrapper .prev a {
  padding: 8px 16px;
  border: 1px solid var(--brand-border);
  border-radius: 4px;
  color: var(--brand-text);
  text-decoration: none;
  font-weight: 500;
  transition: all 0.2s ease;
}
.pagination-wrapper .page a:hover, .pagination-wrapper .next a:hover, .pagination-wrapper .prev a:hover {
  background: var(--brand-green);
  color: var(--brand-white);
  border-color: var(--brand-green);
}
.pagination-wrapper .page.current {
  padding: 8px 16px;
  border: 1px solid var(--brand-green);
  border-radius: 4px;
  background: var(--brand-green);
  color: var(--brand-white);
  font-weight: 500;
}
</style>

<script>
function ssSelectCardVariant(el, productId, variantId, price, comparePrice, available, imageUrl) {
  const card = el.closest('.supplysix-product-card');
  if (!card) return;

  // 1. Toggle selected class
  card.querySelectorAll('.ss-swatch-item').forEach(item => item.classList.remove('selected'));
  el.classList.add('selected');

  // 2. Update variant ID input
  const input = card.querySelector('form[action="/cart/add"] input[name="id"]');
  if (input) {
    input.value = variantId;
  }

  // 3. Update Price
  const priceWrapper = card.querySelector('.ss-product-price-wrapper');
  if (priceWrapper) {
    let priceHtml = '';
    // If comparePrice exists and is different from price (or has value)
    if (comparePrice && comparePrice !== '' && comparePrice !== price) {
      priceHtml = `<span class="ss-sale-price">${price}</span> <span class="ss-regular-price struck">${comparePrice}</span>`;
    } else {
      priceHtml = `<span class="ss-regular-price">${price}</span>`;
    }
    priceWrapper.innerHTML = priceHtml;
  }

  // 4. Update Button State
  const btn = card.querySelector('.ss-add-to-cart-btn');
  if (btn) {
    if (available) {
      btn.innerText = 'Add to cart';
      btn.disabled = false;
      btn.classList.remove('disabled');
    } else {
      btn.innerText = 'Sold out';
      btn.disabled = true;
      btn.classList.add('disabled');
    }
  }

  // 5. Update Image
  if (imageUrl) {
    const img = card.querySelector('.ss-product-image img');
    if (img) {
      img.src = imageUrl;
    }
  }
}
</script>
