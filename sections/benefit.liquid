{%- liquid
  assign sid = section.id
  assign layout =section.settings.layout 
  assign col = section.settings.col_pr
  assign col_tb = section.settings.col_pr_tb
  assign source = section.settings.source
  assign cl_mb = section.settings.col_pr_mb

 %}
 {{ 'benefit.css' | asset_url | stylesheet_tag }}
  <section id="laber_{{sid}}" class="wow animate--slide-in {{ section.settings.style }}">
     
          <div class="{% if layout %}full-width{% else %}container{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
          <div class="wrap-benefit {% if section.settings.cl_bg_content != 'rgba(0,0,0,0)' %}alo-background-color alo-border-radius pd-20 py-20 sm:pd-10 sm:py-10 {% endif %}" style="{% if section.settings.cl_bg_content != 'rgba(0,0,0,0)' %}--bg-color:{{ section.settings.cl_bg_content  }}; {% endif %}">  
          {% if section.settings.title != blank %}
          <div class="wrap_title w_center text_center {{ section.settings.text_size }} mb-30 sm:mb-20" >
            {% if section.settings.sub_title != blank %}
              <div class="section-subtitle">{{section.settings.sub_title}}</div>  
            {% endif %}
            <div class="h3 section-title text-transform" style="--text-transform:{{ section.settings.text_transform }}">
              {{section.settings.title}}
            </div>  
          </div>
          {% endif %}
          {%- if section.blocks.size > 0 -%}
            <div class="row">
            {% assign index = 0 %}  
            {%- for block in section.blocks -%}
                {%- case block.type -%} 
                {% when 'shipping' %}
                <div class="item item_{{index}} col-sm-{{cl_mb}} col-md-{{col_tb}} col-lg-{{col}} bl_{{block.id}}">
                  <div class="alo-shipping flex pt-{{ block.settings.pt }} sm:mb-20">                
                    {%- if source == '1' -%}
                    <div class="icon" style="--color-icon:{{ section.settings.cl_icon }}">
                      <i class="{{block.settings.icon}}"></i>
                    </div>
                    {%- elsif source == '2' -%}
                    {% assign image = block.settings.icon_img %} 
                    <div class="icon icon_img">
                      {% if image != blank %}
                        {% render 'responsive-image', image: image, image_class: 'w-full h-full' %}
                      {% else %}
                      {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                            {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                       {% endif %} 
                    </div>
                    {%- else -%}
                      {% assign icon_svg = block.settings.icon_svg %} 
                      <div class="icon icon_svg " style="--color-icon:{{ section.settings.cl_icon }}">
                      {% if icon_svg != blank %}
                          {{icon_svg}}
                       {% else %}
                      {% capture current %}{% cycle 1, 2, 3, 4 %}{% endcapture %}
                            {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                       {% endif %}  
                      </div>
                    {%- endif -%}
                    <div class="content">
                      <h3 class="title" style="--cl-text:{{ section.settings.cl_heading }};">{{block.settings.title}}</h3>
                      <p style="--cl-text:{{ section.settings.cl_text }};">{{block.settings.text}}</p>
                    </div>
                  </div>
                </div>
                {% assign index = index | plus: 1 %}
              {%endcase%}	
            {%endfor%} 
             </div>
          {%- endif -%}
      </div>
    </div>
    </section>

{%- render 'section_style' -%} 
{%- schema -%}
