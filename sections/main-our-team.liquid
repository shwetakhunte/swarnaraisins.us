{% liquid
  assign sid = section.id 
  assign layout = section.settings.layout
  assign border = section.settings.border
  assign sett_equal = section.settings.use_eq_height
  assign image_ratio = section.settings.image_ratio
  if sett_equal
    case image_ratio
      when 'ratio2_1'
        assign aspect_ratio = 2.0
      when 'ratio3_2'
        assign aspect_ratio = 1.5
      when 'ratio4_3'
        assign aspect_ratio = 1.333
      when 'ratio1_1'
        assign aspect_ratio = 1.0
      when 'ratio3_4'
        assign aspect_ratio = 0.75
      when 'ratio2_3'
        assign aspect_ratio = 0.66667
      when 'ratio1_2'
        assign aspect_ratio = 0.5
      when 'custom'
        assign custom_ratio = section.settings.custom_ratio | split: '/'
        assign width = custom_ratio[0]
        assign height = custom_ratio[1] | times: 1.0
        assign aspect_ratio = width | divided_by: height
    endcase
  endif
  
  assign column = section.settings.column
  case column 
    when '2'
            assign alo_column = 'col-lg-6 col-md-6 col-12'
        when '3'
            assign alo_column = 'col-lg-4 col-md-6 col-12'
        when '4'
            assign alo_column = 'col-lg-3 col-md-6 col-12'
        when '5'
            assign alo_column = 'col-lg-15 col-md-6 col-12'
  endcase
%}
{%- if section.settings.hidden %}{% break %}{% endif -%}	
{{ 'our-stores.css' | asset_url | stylesheet_tag }}
<section id="laber_{{sid}}">
  <div class="container {% if layout %}full-width{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
    <div class="row">
      	{%- for block in section.blocks -%}
          {%- assign image = block.settings.image -%}
      	  {%- assign url = block.settings.url -%}
            <div class="{{ alo_column }}" style="padding-bottom:calc(var(--alo-gap) + var(--alo-gap));">
            <div class="wrap-our-stores">
         
            	<div class="our-stores-image">
                  {%- if image != blank -%}
                    {% render 'responsive-image', image: image, url:url, aspect_ratio:aspect_ratio,border:border, image_class: 'w-full h-full' %}
                  {%- else -%}
                    {% if aspect_ratio != blank %}
                         {%- assign ratio =  1 | divided_by: aspect_ratio | times: 100 -%}
                      {% else %}
                          {%- assign ratio = 100 -%}
                      {% endif %}
                      <div class="image-card__img overflow-hidden alo-border-radius ratio" style="--alo-border-radius:{{ border }}px;--ratio-percent: {{ ratio }}%;">
                        {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                        {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                      </div>
                  {%- endif -%}
            	</div>
              
            <div class="our-stores-content">	
              {% if block.settings.title != blank %}
                <h3 class="title">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="content">{{ block.settings.text }}</div>
              {% endif %}
              {% if block.settings.button_label != blank %}
              <div class="our-stores-btn">
                <a
                  class="btn {{ block.settings.button_style }} {{ block.settings.button_size }}"
                  href="{{ block.settings.btn_link | default:'#' }}"
                  title="{{ block.settings.button_label }}"
                  target="{{block.settings.open_link}}"
                >
                  {{ block.settings.button_label }}
                </a>
              </div>
            {% endif %}
            </div>	
            </div>
            </div>
        {%- endfor -%}
    </div>
  </div>
</section>
{%- render 'section_style' -%} 
