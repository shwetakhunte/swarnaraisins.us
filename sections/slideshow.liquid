{{ 'slideshow.css' | asset_url | stylesheet_tag }}
{% assign sid = section.id %}
{% assign position_dots = section.settings.position_dots %}
{%- assign sizes = '100vw' -%}
{% liquid 
        assign section_blocks = section.blocks  
    	assign index = 1 
        assign arr_blocks_img = section_blocks | where: "type", 'img'
        assign h_des = section.settings.h_des
        assign h_tb = section.settings.h_tb
        assign h_mb = section.settings.h_mb
        
%}
<section id="laber_{{sid}}" class="laber_slidershow_{{sid}} ">
<div data-wrapper-slidershow class="{% if section.settings.layout %}full-width{% else %}container{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
  <div class="alo-slidershow wrapper-slidershow"> 
  {% # theme-check-disable %}
  {% include 'grid-slider', settings:section.settings %}
  <grid-slider class="grid-slider vertical-center {% if section.settings.fade_zoom %}fade_zoom{%endif%}"
     {{gridSlider}}
  	>
       {% if arr_blocks_img.size > 0 %}  
    <div class="swiper iSwiper" {%- render 'skeleton', settings: section.settings -%} style="--perload-gap: {{ section.settings.space-Between}}px">
      <div class="swiper-wrapper">
    	{%- for block in arr_blocks_img -%}
    		{% if block.type == 'img' %} 
    			{% assign image = block.settings.image_sl %}
    			
    			{% assign url = block.settings.link_img |default:"#" %}
    			{% assign open_link = block.settings.open_link %} 
                <div id="laber_bock_{{block.id}}" class="swiper-slide wrap_slide js_image_slide" style="--rounded:{{ section.settings.border }}px;">
                  <div  class="content-item overflow-hidden {% if section.settings.full-screen %}full-screen{% endif %}" style="--alo-height-pc:{{ h_des }}px ; --alo-height-tb:{{ h_tb }}px; --alo-height-mb:{{ h_mb }}px;" {{ block.shopify_attributes }}>                  
                  {%- if block.settings.video != null -%}
                    <div class="alo-video">
                    {% render 'video', video: block.settings.video %}
                    <div class="video-play pause">
                      <a class="btn-play" href="#">
                        <svg class="play" xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 512 512"><!--! Font Awesome Free 6.4.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2023 Fonticons, Inc. --><path d="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm115.7 272l-176 101c-15.8 8.8-35.7-2.5-35.7-21V152c0-18.4 19.8-29.8 35.7-21l176 107c16.4 9.2 16.4 32.9 0 42z"/></svg>
                        <svg class="pause" xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 512 512"><!--! Font Awesome Free 6.4.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2023 Fonticons, Inc. --><path d="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm0 448c-110.5 0-200-89.5-200-200S145.5 56 256 56s200 89.5 200 200-89.5 200-200 200zm96-280v160c0 8.8-7.2 16-16 16h-48c-8.8 0-16-7.2-16-16V176c0-8.8 7.2-16 16-16h48c8.8 0 16 7.2 16 16zm-112 0v160c0 8.8-7.2 16-16 16h-48c-8.8 0-16-7.2-16-16V176c0-8.8 7.2-16 16-16h48c8.8 0 16 7.2 16 16z"/></svg>
                      </a>
                    </div>
                    </div>
                    {% else %}
                    {% assign ratio = image.aspect_ratio |default:1.0 %}
                    {% if image != blank %}
                   <a class="image-slideshow " href="{{url}}" target="{{open_link}}" style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;" aria-label="link" {{ block.shopify_attributes }}>
                      <div class="w-full h-full sm:d-none">
                          {% render 'image', image: image, width: 1920  %}
                       </div>
                       {% assign image_mobile = block.settings.image_sl_mobile | default: block.settings.image_sl %}
                       <div class="w-full h-full md:hidden ">  
                          {% render 'image', image:image_mobile, width: 767 %}
                       </div>
                   </a>
                    {%else%}
                    <div class="image-card__img h-full">  
                    {% capture current %}{% cycle 1, 2, 3 %}{% endcapture %}  
                    {{ 'hero-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                    </div>  
                    {%endif%}
                    {% endif %}
                    {% assign h_position = block.settings.h_position %}
                    {% assign v_position = block.settings.v_position %}
                    {% assign txt_align = block.settings.txt_align %}
                    <div class="container wrap_text flex h_{{h_position}} v_{{v_position}} text_{{txt_align}}">
                      <div class="wrapper_caption alo-custom-width " style="--alo-custom-width:{{ block.settings.cusotm-width }}%;">
                        <div class="caption">
                          <div class="outner-caption">
                            <div class="inner-caption animation-effect_{{block.settings.class_animate}}">                            	
                              {% for block in section_blocks offset:index %}
                              {% assign index = index|plus:1 %}                            		
                              {%- case block.type -%}   
                              {% when 'logo' %}
                                <div id="b_{{block.id}}"  class="slide_item_logo line_{{ block.settings.text_line }} mb-{{ block.settings.mb }} sm:mb-{{ block.settings.sm_mb }}" {{ block.shopify_attributes }}>
                                  {% assign b_logo = block.settings.logo | default:settings.logo  %}
                                  {% if b_logo != blank %}
                                    {%- assign logo_alt = b_logo.alt | default: shop.name | escape -%}
                                    {%- assign logo_height = block.settings.logo_max_width | divided_by: settings.logo.aspect_ratio -%}
                                    {% capture sizes %}(max-width: {{ block.settings.logo_max_width | times: 2 }}px) 50vw, {{ block.settings.logo_max_width }}px{% endcapture %}
                                    {% capture logo_widths %}{{ block.settings.logo_max_width }}, {{ block.settings.logo_max_width | times: 1.5 | round }}, {{ block.settings.logo_max_width | times: 2 }}{% endcapture %}
                                    {{ b_logo | image_url: width: 600 | image_tag:
                                      class: 'header__heading-logo motion-reduce',
                                      widths: logo_widths,
                                      height: logo_height,
                                      width: block.settings.logo_max_width,
                                      alt: logo_alt,
                                      sizes: sizes,
                                      preload: true
                                    }}
                                  {% endif %}
                                </div>
                              {% when 'subhd' %}
                                <div id="b_{{block.id}}"  class="slide_item_h4 line_{{ block.settings.text_line }} mb-{{ block.settings.mb }} sm:mb-{{ block.settings.sm_mb }}" {{ block.shopify_attributes }}
                                    >
                                  {% assign somearray = block.settings.title | split: ' ' %}                             
                                  {% assign pos = block.settings.custom_mark %}
                                  {% assign index_mark  = 0 %}
                                  {% for item in somearray %}
                                  {% assign index_mark  = index_mark | plus: 1 %} 
                                  <span  class="{% if block.settings.first_mark and forloop.first %}first {% endif %}{% if pos contains index_mark %}marked{% endif %}{% if block.settings.last_mark and forloop.last %}last {% endif %}" > {{item}} </span>
                                  {% endfor %}   
                                </div>
                              {% when 'hd' %}
                              <div id="b_{{block.id}}"  class="slide_item_h3 mb-{{ block.settings.mb }} sm:mb-{{ block.settings.sm_mb }}" {{ block.shopify_attributes }}>                             
                                {% assign somearray = block.settings.title | split: ' ' %} 
                                {% assign pos = block.settings.custom_mark %}
                                {% assign index_mark  = 0 %}
                                {% for item in somearray %}
                                {% assign index_mark  = index_mark | plus: 1 %} 
                                	<span  class="{% if block.settings.first_mark and forloop.first %}first {% endif %}{% if pos contains index_mark %}marked{% endif %}{% if block.settings.last_mark and forloop.last %}last {% endif %}" > {{item}} </span>
                                {% endfor %}                             
                              </div>
                              {% when 'txt' %}
                              <div id="b_{{block.id}}"  class="slide_item_p mb-{{ block.settings.mb }} sm:mb-{{ block.settings.sm_mb }} {% if block.settings.hide_mobile %} hide_mobile{% endif %}" {{ block.shopify_attributes }}>{{block.settings.title}}</div> 
                              {% when 'btn' %}
                              {%- if  block.settings.title != blank -%}
                              	<a id="b_{{block.id}}" 
                                   class="buttons mb-{{ block.settings.mb }} sm:mb-{{ block.settings.sm_mb }}" href="{{block.settings.btn_link | default:"#"}}" 
                                   target="{{open_link}}" 
                                  aria-label="link"
                                   {{ block.shopify_attributes }}>{{block.settings.title}}</a>	
                              {%- endif -%}
                              {% when 'box' %}
                              <div id="b_{{block.id}}"  class="slide_item_box flex h_{{h_position}} v_{{v_position}}" {{ block.shopify_attributes }}>    
                                <div class="inner-box">
                                  <div class="outside-box alo-border-radius alo-opacity" style="--width-box:{{ block.settings.w_box }}px;--alo-background-color:{{ block.settings.bg_color }};--rounded:{{ block.settings.border }}px;--alo-opacity:{{ block.settings.opacity | divided_by: 100.0 }}">
                                    <div class="inside-box text_{{txt_align}}">
                                      {% if block.settings.sub_title != blank %}<h4 class="text-transform mb-10" style="--text-transform:{{ block.settings.sub_title_transform }}">{{block.settings.sub_title}}</h4>{% endif %}
                                      {% if block.settings.title != blank %}<h2 class="text-transform mb-20" style="--text-transform:{{ block.settings.title_transform }}">{{block.settings.title}}</h2>{% endif %}
                                      {% if block.settings.content != blank %}<div class="content text-transform {% if block.settings.button_text != blank %}mb-20{% endif %}" style="--ls-content:{{ block.settings.ls_content }};--text-transform:{{ block.settings.content_transform }}">{{block.settings.content}}</div>{% endif %}
                                      {%- if block.settings.button_text != blank -%}
                                      	<a class="btn btn-link text-transform" style="--text-transform:{{ block.settings.btn_transform }}" href="{{block.settings.btn_link}}">{{block.settings.button_text}}</a>
                                      {% endif %}
                                    </div>
                                  </div>
                                </div>
                              </div>
                              {% else %}                            				
                              {%- break -%}
                              {%- endcase -%}
                              {%- endfor -%}
                            </div> 
                          </div>
                        </div>   
                      </div>
                    </div>
                  </div> 
                </div>
    		{% endif %}
    	{% endfor %}
      </div>
      {% if section.settings.navigation %}
          <div class="swiper-button-next"></div>
          <div class="swiper-button-prev"></div>
      {% endif %}
      {% if section.settings.pagination %}
        <div class="alo-pagination" style="--bg-dot:{{ section.settings.cl_dots }};--bg-dot-h:{{ section.settings.cl_dots_h }};">
          <div class="swiper-pagination {{ position_dots }}"></div>
        </div>
      {% endif %}
    </div>
      {% endif %}
</grid-slider>   
{% # theme-check-enable %}
</div>
</div>
</section>
{%- render 'section_style' -%}
{%- render 'setting_slideshow' -%}
{% schema %}
  {
    "name": "Slideshow",   
	"max_blocks": 50,
	"class":"slideshow",
    "settings": [
    
        {
      "type": "checkbox",
      "id": "full-screen",
      "label": "Full screen",
      "default": false
      },
      {
       "type": "range",
       "id": "h_des",
       "label": "Desktop Large",
       "min": 400,
       "max": 900,
       "step": 5,
       "unit": "px",
       "default": 650
       },
       {
       "type": "range",
       "id": "h_tb",
       "label": "Tablet (<= 1024px)",
       "min": 300,
       "max": 700,
       "step": 5,
       "unit": "px",
       "default": 500
       }, 
      {
       "type": "range",
       "id": "h_mb",
       "label": "Mobile (<= 767px)",
       "min": 300,
       "max": 500,
       "step": 5,
       "unit": "px",
       "default": 400
       }, 
    {
      "type": "range",
      "id": "border",
      "min": 0,
      "max": 50,
      "step": 1,
      "label": "Border radius",
      "unit": "px",
      "default": 0
    },  
    {
        "type": "header",
        "content": "---- Banner Slider ----",
        "info": "Refer to the attribute values [here](https://swiperjs.com/swiper-api)"
    },  
    {
        "type": "checkbox",
        "id": "use-slider",
        "label": "Use slider?",
        "default": true
    },
    {
       "type": "range",
       "id": "visible",
       "label": "Columns in Visible",
    "info": "Item(s) in screen ( Size >= 1920 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 5
    },
    {
       "type": "range",
       "id": "widescreen",
       "label": "Columns in Widescreen",
    "info": "Item(s) in screen ( 1366 <= Size < 1920 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 4
    },
    {
       "type": "range",
       "id": "desktop",
       "label": "Columns in Desktop",
    "info":  "Item(s) in screen ( 1200 <= Size < 1480 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 4
    },
    {
       "type": "range",
       "id": "laptop",
       "label": "Columns in Laptop",
    "info": "Item(s) in screen ( 992 <= Size < 1200 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 4
    },
    {
       "type": "range",
       "id": "notebook",
       "label": "Columns in Notebook",
    "info": "Item(s) in screen ( 768 <= Size < 992 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 3
    },
    {
       "type": "range",
       "id": "tablet",
       "label": "Columns in Tablet",
    "info": "Item(s) in screen ( 576 <= Size < 768 )",
       "min": 1,
       "max": 8,
       "step": 1,
       "unit": "pds",
       "default": 3
    },
    {
       "type": "range",
       "id": "landscape",
       "label": "Columns in Landscape",
    "info": "Item(s) in screen ( 480 <= Size < 576 )",
       "min": 1,
       "max": 6,
       "step": 1,
       "default": 2
    },
    {
       "type": "range",
       "id": "portrait",
       "label": "Columns in Portrait",
    "info": "Item(s) in screen ( 360 < Size < 480 )",
       "min": 1,
       "max": 6,
       "step": 1,
       "default": 2
    },
    {
       "type": "range",
       "id": "mobile",
       "label": "Columns in Mobile",
    "info": "Item(s) in screen ( Size < = 360 )",
       "min": 1,
       "max": 4,
       "step": 1,
       "default": 1
    },
    {
       "type": "range",
       "id": "slides-Per-Group",
       "label": "Slide Per Group",
       "info": "The number of items slide to scroll",
       "min": 1,
       "max": 8,
       "step": 1,
       "default": 1
    },
    {
       "type": "range",
       "id": "rows",
       "label": "Rows Slider",
       "min": 1,
       "max": 3,
       "step": 1,
       "default": 1
    },
    {
       "type": "checkbox",
       "id": "autoplay",
       "label": "Autoplay",
       "default": true
    },
    {
       "type": "text",
       "id": "speed",
       "label": "Speed",
       "default": "300",
       "info": "Duration of transition between slides (in ms)"
    },
    {
       "type": "text",
       "id": "autoplay_delay",
       "label": "Auto Play delay",
       "default": "3000",
       "info": "Delay between transitions (in ms)"
    },
    {
       "type": "checkbox",
       "id": "navigation",
       "label": "Navigation",
       "info": "Arrows next,prev",
       "default": true
    },
    {
       "type": "select",
       "id": "effect",
       "label": "effect",
       "options": [
        {
           "value": "coverflow",
           "label": "Coverflow"
         },
        {
           "value": "creative",
           "label": "Creative"
         },
        {
           "value": "cube",
           "label": "Cube"
         },
        {
           "value": "fade",
           "label": "Fade"
         },
        {
           "value": "flip",
           "label": "Flip"
         },
        {
           "value": "slide",
           "label": "Slide"
        }
       ],
       "default": "slide"
    },
    {  
        "type": "checkbox",
        "id": "fade_zoom",
        "label": "Fade zoom",
        "default": false
    },
    {
       "type": "checkbox",
       "id": "centered-Slides",
       "label": "centered Slides",
       "default": false
    },
    {
       "type": "checkbox",
       "id": "auto-Height",
       "label": "Auto Height",
       "default": false
    },
    {
       "type": "checkbox",
       "id": "pagination",
       "label": "Pagination",
       "default": false
    },
    {
       "type": "checkbox",
       "id": "loop",
       "label": "Loop",
       "default": false
    },
    {
       "type": "range",
       "id": "space-Between",
       "label": "Space Between",
       "info": "Distance between slides in px.",
       "min": 0,
       "max": 60,
       "step": 1,
       "unit": "px",
       "default": 10
    },
    {
       "type": "select",
       "id": "direction",
       "label": "Direction",
       "options": [
        {
           "value": "horizontal",
           "label": "Horizontal"
         },
        {
           "value": "vertical",
           "label": "Vertical"
         }
       ],
       "default": "horizontal"
    },
        {
        "type": "select",
        "id": "position_dots",
        "default": "left",
        "options": [
        {
        "value": "left",
        "label": "Left"
        },
        {
        "value": "center",
        "label": "Center"
        },  
        {
        "value": "right",
        "label": "Right"
        }

        ],
        "label": "Dots position"
        },
		{
          "type": "header",
          "content": "== Design Options"
        },
      {
          "type": "color",
          "id": "cl_dots",
          "label": "Color Dots",
          "default": "#f5f5f5"
        },
        {
          "type": "color",
          "id": "cl_dots_h",
          "label": "Color Dots (Hover)",
          "default": "#222"
        },
        {
        "type": "checkbox",
        "id": "layout",
        "label": "Full width",
        "default": false
        },
        {
            "type": "range",  
            "id": "container",  
            "label": "Container width",
            "min": 1170,
            "max": 1920,
            "step": 10,
            "unit": "px",
            "default": 1410 
        },
        {
          "type": "color",
          "id": "cl_bg",
          "label": "Background Color",
          "default": "#f5f5f5",
          "info": "only active when you use layout 'Container'"
        },
       
      {
        
      "type": "paragraph",
      "content": "—————————————————"
      }, 
      
      {
        "type": "text",
        "id": "mg",
        "label": "Margin",
        "info":"Margin top, margin right, margin bottom, margin left. If you not use to blank"
      },
      {
        "type": "text",
        "id": "pd",
        "label": "Padding",
        "info":"Padding top, padding right, padding bottom, padding left. If you not use to blank"
      },
     {
        "type": "header",
        "content": "== Design Mobile Options"
      },
      {
        "type": "text",
        "id": "mg_mb",
        "label": "Margin"
      },
      {
        "type": "text",
        "id": "pd_mb",
        "label": "Padding"
      }
	],
	"blocks": [
      {
        "type": "img",
        "name": "Image slide (Parent)",
        "settings": [	
          {
            "type": "video",
            "id": "video",
            "label": "Video"
          },
          {
            "type": "image_picker",
            "id": "image_sl",
            "label": "Image"
          },
		  {
            "type": "image_picker",
            "id": "image_sl_mobile",
            "label": "Image mobile"
          },	
          {
            "type": "url",
            "id": "link_img",
            "label": "Link image",
            "info": "The image becomes clickable."
          },
          {
            "type": "select",
            "id": "open_link",
            "options": [
              {
                "value": "_self",
                "label": "Current window (_self)"
              },
             {
                "value": "_blank",
                "label": "New window (_blank)"
              }
            ],
            "label": "Open link in",
            "default": "_blank"
          },          
          {
             "type": "header",
             "content": "== Caption settings"
           },
           {
          "type": "select",
          "id": "class_animate",
          "default": "fadeinleft",
          "options": [
          {
          "value": "zoomin",
          "label": "Zoom In"
          },
          {
          "value": "zoomout",
          "label": "Zoom Out"
          },
          {
          "value": "fadein",
          "label": "Fadein"
          },
          {
          "value": "fadeindown",
          "label": "fadein Down"
          }, 		
          {
          "value": "fadeinup",
          "label": "Fadein Up"
          },
          {
          "value": "fadeinleft",
          "label": "Fadein Left"
          },
          {
          "value": "fadeinright",
          "label": "Fadein Right"
          }
          ],
          "label": "Animate content"
          }, 
          {
              "type": "range",
              "id": "cusotm-width",
              "min": 10,
              "max": 100,
              "step": 5,
              "label": "cusotm-width",
              "unit": "%",
              "default": 50
            }, 
                   
          {
            "type": "select",
            "id": "h_position",
            "label": "Horizontal Position",
            "default": "center",
            "options": [
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "center",
                "label": "Center"
              },
              {
                "value": "right",
                "label": "Right"
              }
            ]
          },
			{
            "type": "select",
            "id": "v_position",
            "label": "Vertical Position",
            "default": "middle",
            "options": [
              {
              "value": "top",
              "label": "Top"
              },
              {
              "value": "middle",
              "label": "Middle"
              },
              {
              "value": "bottom",
              "label": "Bottom"
              }
            ]
          },
          {
            "type": "select",
            "id": "txt_align",
            "label": "Text alignment",
            "default": "center",
            "options": [
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "center",
                "label": "Center"
              },
              {
                "value": "right",
                "label": "Right"
              }
            ]
          }
          
          
        ]
      },
         
      {
      "type": "logo",
      "name": "Logo",
      "settings": [	
          {
            "type": "image_picker",
            "id": "logo",
            "label": "Logo image"
            },
            {
            "type": "range",
            "id": "logo_max_width",
            "label":"Custom logo width",
            "min": 50,
            "max": 250,
            "step": 5,
            "unit": "px",
            "default": 115
            },
            {
            "type": "header",
            "content": "== Space between"
            },
            {
              "type": "range",
              "id": "mb",
              "label": "Margin bottom",
              "min": 0,
              "max": 60,
              "step": 5,
              "unit": "px",
              "default": 0
          },
           {
              "type": "range",
