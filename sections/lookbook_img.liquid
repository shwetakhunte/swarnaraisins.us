{%- liquid
  assign sid = section.id
  assign layout = section.settings.layout
  assign image = section.settings.image
-%}

<lookbook-pin id="laber_{{sid}}"  class="wow animate--slide-in {% if section.settings.hidden_mobile %}sm:d-none{% endif %}" style="display: block;">
  <div
    class="{% if layout %}full-width{% else %}container{% endif %}"
    style="--alo-container-width:{{ section.settings.container }}px;"
  >
    <div class="pin__maker pr">
      {%- if image != blank -%}
        {% render 'image', image:image, width:1920, class:'pin__image w-full h-full' %}
      {%- else -%}
        <div
          class="pin__image  alo-border-radius">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
        </div>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'pr' -%}
            {%- if block.settings.product == blank -%}{%- continue -%}{%- endif -%}
            <div
              {{ block.shopify_attributes }}
              class="pin__type pin__type_{{block.id}} pa pe_none pin__type_pr pin__size--{{block.settings.pos_size}} pin_ic_{{block.settings.type}}"
               style="--cl-text:{{ block.settings.cl_text }};--cl-border:{{ block.settings.cl_border }};"
            >
              <span class="zoompin"></span>
              
                <span class="pin_tt pin_tt_js dn db_mb">
                  {%- if block.settings.type != '2' -%}<i class="icon-plus"></i>{%- else -%}<span class="truncate">{{ block.settings.shorttxt }}</span>{%- endif -%}
                </span>
                <span data-opennt="#pin_mfp_{{block.id}}" data-ani="none" data-class="mfp__pin" class="pin_tt mfp_js dn_md">
                  {%- if block.settings.type != '2' -%}<i class="icon-plus"></i>{%- else -%}<span class="truncate">{{ block.settings.shorttxt }}</span>{%- endif -%}
                </span>
              
              <div id="pin_mfp_{{block.id}}">
                {% # theme-check-disable %}
                <div class="pin_lazy_js pin__popup--{{block.settings.pos_pin}} pin__popup--{{block.settings.effect}} lazyload" data-include="/products/{{block.settings.product}}/?view=lookbook"></div>
                {% # theme-check-enable %}
              </div>
            </div>
          {%- when 'txt' -%}
            <div
              {{ block.shopify_attributes }}
              class="pin__type pin__type_{{block.id}} pa pe_none pin__type_txt pin__size--{{block.settings.pos_size}} pin_ic_{{block.settings.type}}"
               style="--cl-text:{{ block.settings.cl_text }};--cl-border:{{ block.settings.cl_border }};"
            >
              <span class="zoompin"></span>
  
                <span class="pin_tt pin_tt_js dn db_mb">
                  {%- if block.settings.type != '2' -%}<i class="icon-plus"></i>{%- else -%}<span class="truncate">{{ block.settings.shorttxt }}</span>{%- endif -%}
                </span>

                <span
                  data-opennt="#pin_mfp_{{block.id}}"
                  data-ani="none"
                  data-class="mfp__pin"
                  class="pin_tt mfp_js dn_md"
                  ><span class="truncate">{{ block.settings.shorttxt }}</span></span
                >

              <div id="pin_mfp_{{block.id}}">
                <div class="pin__popup pin__popup--{{block.settings.pos_pin}} pin__popup--{{block.settings.effect}} op__0 pa">
                  <div class="popup__title">{{ block.settings.heading }}</div>
                  <div class="popup__content">{{ block.settings.text }}</div>
                </div>
              </div>
            </div>
          {%- else -%}
            <div
              {{ block.shopify_attributes }}
              class="pin__type pin__type_{{block.id}} pa pe_none pin__type_url pin__size--{{block.settings.pos_size}} pin_ic_{{block.settings.type}}"
               style="--cl-text:{{ block.settings.cl_text }};--cl-border:{{ block.settings.cl_border }};"
            >
              <span class="zoompin"></span>
                <a href="{{block.settings.url}}" target="{{block.settings.open_link}}" class="pin_tt cw">
                  {%- if block.settings.type != '2' -%}<i class="icon-plus"></i>{%- else -%}<span class="truncate">{{ block.settings.shorttxt }}</span>{%- endif -%}
                </a>
            </div>
        {%- endcase -%}

        {%- style -%}
            .pin__type_{{block.id}} {
          transform: translate(-{{block.settings.pos_l}}%, -{{block.settings.pos_t}}%);
          top:{{block.settings.pos_t}}%;
          left:{{block.settings.pos_l}}%
          }
          .pin__type_{{block.id}} .pin_tt{
          	background-color: {{block.settings.bg_cl}}
          }
          .pin__type_{{block.id}} .zoompin{
          	background-color: {{block.settings.bg_cl_br}};
          	opacity:{{block.settings.bg_cl_br_opacity}};
          }
        {%- endstyle -%}
      {%- endfor -%}
    </div>
  </div>
</lookbook-pin>
{%- liquid
  assign mg = section.settings.mg
  assign pd = section.settings.pd
  assign mg_mb = section.settings.mg_mb
  assign pd_mb = section.settings.pd_mb
  assign sid = section.id
-%}

{%- capture style -%}
{%- if section.settings.cl_bg != blank -%}#shopify-section-{{sid}} {background-color: {{section.settings.cl_bg}} !important;}{%- endif -%}
{%- if mg != blank or pd != blank -%} 
.laber_se_{{sid}} {
max-width:100%;
{%- if mg != blank %}{% assign arr_mg = mg | remove:' ' | split:',' -%}
margin-top: {{arr_mg[0]}} !important;margin-right: {{arr_mg[1]}} !important;margin-bottom: {{arr_mg[2]}} !important;margin-left: {{arr_mg[3]}} !important;
{%- if arr_mg[3] != blank and section.settings.layout == 'full-width' -%}width: calc(100% - {{arr_mg[3]}} - {{arr_mg[1]}});width: -webkit-calc(100% - {{arr_mg[3]}} - {{arr_mg[1]}});{%- endif -%}
{%- endif -%}
{%- if pd != blank %}{% assign arr_pd = pd | remove:' ' | split:',' -%}
padding-top: {{arr_pd[0]}} !important;padding-right: {{arr_pd[1]}} !important;padding-bottom: {{arr_pd[2]}} !important;padding-left: {{arr_pd[3]}} !important;
{%- endif -%}
}
{%- endif -%}
{%- if mg_mb != blank or pd_mb != blank -%} 
@media only screen and (max-width: 767px) {
.laber_se_{{sid}} {
{%- if mg_mb != blank %}{% assign arr_mg = mg_mb | remove:' ' | split:',' -%}
margin-top: {{arr_mg[0]}} !important;margin-right: {{arr_mg[1]}} !important;margin-bottom: {{arr_mg[2]}} !important;margin-left: {{arr_mg[3]}} !important;
{%- if arr_mg[3] != blank and section.settings.layout == 'full-width' -%}width: calc(100% - {{arr_mg[3]}} - {{arr_mg[1]}});width: -webkit-calc(100% - {{arr_mg[3]}} - {{arr_mg[1]}});{%- endif -%}
{%- endif -%}
{%- if pd_mb != blank %}{% assign arr_pd = pd_mb | remove:' ' | split:',' -%}
padding-top: {{arr_pd[0]}} !important;padding-right: {{arr_pd[1]}} !important;padding-bottom: {{arr_pd[2]}} !important;padding-left: {{arr_pd[3]}} !important;
{%- endif -%}
}
}
{%- endif -%}
{%- endcapture -%}

{%- style -%}{{ style | strip_newlines | remove:"  "}}{%- endstyle -%}
