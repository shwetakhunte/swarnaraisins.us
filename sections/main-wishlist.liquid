{% assign sid = section.id %}
{% assign settings = section.settings %}
{% assign layout = section.settings.layout %}
{% liquid
  assign visible = section.settings.visible
  assign widescreen = section.settings.widescreen
  assign desktop = section.settings.desktop
  assign laptop = section.settings.laptop
  assign notebook = section.settings.notebook
  assign tablet = section.settings.tablet
  assign landscape = section.settings.landscape
  assign portrait = section.settings.portrait
  assign mobile = section.settings.mobile
  assign space_between = section.settings['space-Between']
  assign navigation = section.settings.navigation
  assign pagination = section.settings.pagination

  if section.settings['use-slider']
    assign use_slider = true
  else
    assign use_slider = false
  endif
%}
<section id="laber_{{sid}}">
  <div class="{%if layout%}full-width{% else %}container{%endif%}">
    {% if section.settings.title != blank %}
      <div
        class="wrap_title mb-30 {{ section.settings.text_size }} w_{{ section.settings.d_position }}"
      >
        <h3
          class="section-title alo-text-transform"
          style="
            --cl-text:{{ section.settings.cl_title |default:"#333333" }};
            --alo-text-transform:{{ section.settings.text_transform }}
          "
        >
          {{ section.settings.title }}
        </h3>
      </div>
    {% endif %}
    {% # theme-check-disable %}
    {% include 'grid-slider', settings: settings %}
    <collection-wishlist class="content_section collection-wishlist">
      <grid-slider
        class="grid-slider ajax"
        {{ gridSlider }}
      >
        <div
          class="swiper"
          data-mobile="{{ mobile }}"
          data-portrait="{{ portrait }}"
          data-landscape="{{ landscape }}"
          data-tablet="{{ tablet }}"
          data-notebook="{{ notebook }}"
          data-laptop="{{ laptop }}"
          data-desktop="{{ desktop }}"
          data-widescreen="{{ widescreen }}"
          data-visible="{{ visible }}"
          data-space-Between="{{ space_between}}"
          style="--perload-gap: {{ space_between}}px"
        >
          <div
            class="swiper-wrapper js-collection-wishlist grid-slider-ajax {% if use_slider == false %}flex-wrap{% endif %}"
            data-view="pr_lazy_load"
          ></div>
          {% if use_slider == true %}
            {% if navigation %}
              <div class="swiper-button-next"></div>
              <div class="swiper-button-prev"></div>
            {% endif %}
            {% if pagination %}
              <div class="swiper-pagination"></div>
            {% endif %}
          {% endif %}
        </div>
      </grid-slider>
      <div class="collection-empty collection-wishlist-empty" style="display:none">
        <p>{{ 'general.wishlist.empty' | t }}</p>
        <a class="wishlist-no-product-url btn no-underline inline-block" href="/collections/all">
          {{- 'general.wishlist.back_to_shopping' | t -}}
        </a>
      </div>
    </collection-wishlist>
    {% # theme-check-enable %}
  </div>
</section>
{%- render 'section_style' -%}
{% if use_slider == false %}
  {% style %}#laber_{{sid}} .swiper-slide{padding-bottom:{{space_between}}px; }{% endstyle %}
{% endif %}
