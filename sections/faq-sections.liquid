{% liquid
  assign sid = section.id
  assign layout = section.settings.layout
%}
{{ 'faq-section.css' | asset_url | stylesheet_tag }}
<section id="laber_{{sid}}">
    <div
      class="{% if layout %}full-width{% else %}container{% endif %}"
      style="--alo-container-width:{{ section.settings.container }}px;"
    >
    <div class="row">
      <div class="faq-wrap col-xs-12 col-sm-12 col-md-8 col-lg-8">
    {% if section.settings.title != blank %}
      <div class="wrap_title {{ section.settings.text_size }} mb-30 sm:mb-20 ">
        <div
          class="h3 section-title alo-text-transform"
          style="
            --cl-text:{{ section.settings.cl_title |default:"#333333" }};
            --alo-text-transform:{{ section.settings.text_transform }}
          "
        >
          {{ section.settings.title }}
        </div>
        {% if section.settings.content != blank %}
          <div class="content">{{ section.settings.content }}</div>
        {% endif %}
      </div>
    {% endif %}
    <div class="content_section">
      <accordion-tab data-scroll-into-view="false" data-siblings-close="true">
          {%- for block in section.blocks -%}
              <div id="id_b_{{ block.id }}" class="item-faq">
                <div class="tab-panel js-item-faq item mb-10 {% if forloop.first %} active {% endif %}">
                  {% if block.settings.title != blank %}
                    <h3 class="tab-title heading-title">
                      <span class="faqs-icon">
                        <i class="icon-plus"></i>
                      </span>
                        {{- block.settings.title | escape -}}
                    </h3>
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <div class="tab-content content-faq">{{ block.settings.text }}</div>
                  {% endif %}
                </div>
              </div>
          {%- endfor -%}

      </accordion-tab>
    </div>
      </div>
{% if section.settings.show_contact %}
  <div class="working-time-wrap col-xs-12 col-sm-12 col-md-4 col-lg-4">
    {% if section.settings.title_working_time != blank %}
      <div class="wrap_title {{ section.settings.text_size }} mb-30 sm:mb-20">
        <div
          class="h3 section-title alo-text-transform"
          style="--cl-text:{{ section.settings.cl_title |default:"#333333" }}; --alo-text-transform:{{ section.settings.text_transform }}">
          {{ section.settings.title_working_time }}
        </div>
      </div>
     {% endif %}       
      {% if section.settings.text_contact != blank %}
        <div class="working_time mb-25 sm:mb-15">{{ section.settings.working_time }}</div>
      {% endif %}
    {% if section.settings.title_text_contact != blank %}
      <div class="wrap_title {{ section.settings.text_size }} mb-30 sm:mb-20">
        <div
          class="h3 section-title alo-text-transform"
          style="--cl-text:{{ section.settings.cl_title |default:"#333333" }}; --alo-text-transform:{{ section.settings.text_transform }}">
          {{ section.settings.title_text_contact }}
        </div>
      </div>
     {% endif %}  
            {% if section.settings.text_contact != blank %}
              <div class="text_contact">{{ section.settings.text_contact }}</div>
            {% endif %}
        </div>
  {% endif %}
  </div>
      
    </div>
</section>
{%- render 'section_style' -%}
{%- schema -%}
 {
   "name": "FAQ - section",
   "class": "cms_section faq-section",
"max_blocks": 10,
   "settings": [
     {
       "type": "header",
       "content": "== Settings FAQ"
     },
     {
       "type": "text",
       "id": "title",
       "label": "Frequently Asked Questions",
       "default": "Text column with image"
     },
      {
      "type": "color",
      "id": "cl_title",
      "label": "Color title",
      "default": "#fff"
      },
     {
     "type": "select",
     "id": "text_size",
     "default": "medium",
     "options": [
       {
         "value": "small",
         "label": "small"
      },
      {
         "value": "medium",
         "label": "Medium"
      },
      {
         "value": "large",
         "label": "Large"
       }
     ],
     "label": "Text size"
   },
   {
       "type": "select",
       "id": "text_transform",
       "default": "none",
       "options": [
        {
           "value": "none",
           "label": "None"
        },
        {
           "value": "capitalize",
           "label": "Capitalize"
        },
        {
           "value": "lowercase",
           "label": "Lowercase"
        },
        {
           "value": "uppercase",
           "label": "Uppercase"
         }
       ],
       "label": "Text transform:"
     },
     {
       "type": "header",
       "content": "== Settings Contact"
     },
     {
     "type": "checkbox",
     "id": "show_contact",
     "label": "Show Contact?",
     "default": true
     },
     {
       "type": "text",
       "id": "title_working_time",
       "label": "Title",
       "default": "Hour of Operation"
     },
     {
         "type": "html",
         "id": "working_time",
         "label": "Corking time"
       },
     {
       "type": "text",
       "id": "title_text_contact",
       "label": "Title",
       "default": "Careers"
     },
     {
         "type": "richtext",
         "id": "text_contact",
         "label": "Content"
       },
     {
       "type": "header",
       "content": "== Design Options"
     },
	{
    "type": "checkbox",
    "id": "layout",
    "label": "Full width",
    "default": false
    },
    {
        "type": "range",
        "id": "container",
        "label": "Container width",
        "min": 1170,
        "max": 1920,
        "step": 10,
        "unit": "px",
        "default": 1410
    },
     {
     "type": "color",
     "id": "cl_bg",
     "label": "Background color",
     "default": "#fff"
     },
     {
     "type": "text",
     "id": "mg",
     "label": "Margin",
     "info":"Margin top, margin right, margin bottom, margin left. If you not use to blank"
     },
     {
     "type": "text",
     "id": "pd",
     "label": "Padding",
     "info":"Padding top, padding right, padding bottom, padding left. If you not use to blank"
     },
     {
     "type": "header",
     "content": "== Design Mobile Options"
     },
     {
     "type": "text",
     "id": "mg_mb",
     "label": "Margin"
     },
     {
     "type": "text",
     "id": "pd_mb",
     "label": "Padding"
     }
   ],
"blocks": [{
   "type": "faq",
   "name": "Faq",
   "settings": [
       {
         "type": "text",
         "id": "title",
         "label": "Heading",
         "default": "Problems sending or receiving messages?"
       },
       {
         "type": "richtext",
         "id": "text",
         "label": "Text",
         "default": "<p>Curabitur lacinia purus vitae lorem porttitor fermentum. In in mattis erat mattis libero. Donec volutpat faucibus elit cursus interdum. Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos.</p>"
       }
     ]
   }],
   "presets": [
     {
       "name": "FAQ - section",
       "category": "Images",
	"blocks": [
         { "type": "faq" },
         { "type": "faq" },
         { "type": "faq" },
         { "type": "faq" },
         { "type": "faq" },
         { "type": "faq" },
         { "type": "faq" },
         { "type": "faq" }
       ]
     }
   ]
 }
{%- endschema -%}
