{{ 'sidebar.css' | asset_url | stylesheet_tag }}
{% liquid
  assign sid = section.id
  assign blocks = section.blocks
%}
<section id="laber_{{sid}}" class="sidebar" style="--rounded:{{ section.settings.border }}px;">
  <div class="sticky-sidebar">
    <div class="title_sidebar">
      <h3>{{ 'sections.sidebar.sidebar' | t}}</h3>
    </div>
    {%- if blocks.size > 0 -%}
      {%- for block in blocks -%}
        {% liquid
          assign sett_equal = block.settings.use_eq_height
          assign image_ratio = block.settings.image_ratio
          if sett_equal 
          case image_ratio
            when 'ratio2_1'
                assign aspect_ratio = 2.0
            when 'ratio3_2'
                assign aspect_ratio = 1.5
            when 'ratio4_3'
                assign aspect_ratio = 1.333
            when 'ratio1_1'
                assign aspect_ratio = 1.0
            when 'ratio3_4'
                assign aspect_ratio = 0.75
            when 'ratio2_3'
                assign aspect_ratio = 0.66667
            when 'ratio1_2'
                assign aspect_ratio = 0.5
          endcase 
          endif
        %}
        {%- case block.type -%}
          {% when 'vertical_menu' %}
            
            {% if settings.use_vertical_menu and settings.vertical_menu_position == '4' or settings.vertical_menu_position == '5' %}
              <div class="sidebar_vertical_menu mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb_mobile }} " style="--font-size:{{ block.settings.font-size }}px;--font-weight:{{ block.settings.font-weight }};">
                {% if settings.vertical_menu_position != '5' %}
                <div class="title_vertical_menu {% if settings.vertical_menu_position == '3'  %}back-to-top{% endif %} {% if settings.vertical_menu_position == '1' or request.page_type !='index'%}click{% endif %} flex">
                  <span class="icon-left">
                    <svg fill="none" height="25" viewBox="0 0 24 24" width="25" xmlns="http://www.w3.org/2000/svg">
                      <g fill="rgb(0,0,0)"><path d="m20 7h-16c-.6 0-1-.4-1-1s.4-1 1-1h16c.6 0 1 .4 1 1s-.4 1-1 1z"/><path d="m14 13h-10c-.6 0-1-.4-1-1s.4-1 1-1h10c.6 0 1 .4 1 1s-.4 1-1 1z"/><path d="m18 19h-14c-.6 0-1-.4-1-1s.4-1 1-1h14c.6 0 1 .4 1 1s-.4 1-1 1z"/></g>
                    </svg>
                  </span>
                  <span class="title">{{ settings.title_vertical }}</span>
                </div>
                {% endif %}        
                {%- render 'list-vertical-menu' -%}
              </div>
            {% endif %}
            <div class="menu_categories menu-mobile mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb_mobile }}" style="--font-size:{{ block.settings.font-size }}px;--font-weight:{{ block.settings.font-weight }};">
              {% if block.settings.title_categories != blank %}
                <h3 class="b-title mb-10 sm:mb-10">
                  {{ block.settings.title_categories }}
                </h3>
              {% endif %}
              {% if block.settings.menu %}
                {% render 'magic-accordion', menu: block.settings.menu, use_thumb: block.settings.use_thumb %}
              {% endif %}
            </div>
          {% when 'menu' %}
            <div class="menu_categories mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb_mobile }}" style="--font-size:{{ block.settings.font-size }}px;--font-weight:{{ block.settings.font-weight }};">
              {% if block.settings.title_categories != blank %}
                <h3 class="b-title mb-10 sm:mb-10">
                  {{ block.settings.title_categories }}
                </h3>
              {% endif %}
              {% if block.settings.menu %}
                {% render 'magic-accordion', menu: block.settings.menu, use_thumb: block.settings.use_thumb %}
              {% endif %}
            </div>
          {%- when 'brands' -%}
            <div class="menu_brands mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb_mobile }}" style="--font-size:{{ block.settings.font-size }}px;--font-weight:{{ block.settings.font-weight }};">
              {% if block.settings.title_categories != blank %}
                <h3 class="b-title mb-20 sm:mb-20">
                  {{ block.settings.title_categories }}
                </h3>
              {% endif %}
              <ul class="brands-list">
                {% for product_vendor in shop.vendors limit: block.settings.limit %}
                  <li class="brand">{{ product_vendor | link_to_vendor }}</li>
                {% endfor %}
              </ul>
            </div>
          {%- when 'promobox' -%}
            <div class="laber_promobox mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb_mobile }}">
              <div class="promobox">
                {% assign image = block.settings.image_promobox %}
                {% assign open_link = block.settings.open_link %}
                {% assign url = block.settings.url %}
                <div class="images-card overflow-hidden w-full h-full alo-border-radius" {{ block.shopify_attributes }}>
                  {% if image != blank %}
                    {% render 'responsive-image',
                      image: image,
                      aspect_ratio: aspect_ratio,
                      open_link: open_link,
                      image_class: 'w-full h-full',
                      url: url
                    %}
                  {% else %}
                    {% if aspect_ratio != blank %}
                      {%- assign ratio = 1 | divided_by: aspect_ratio | times: 100 -%}
                    {% else %}
                      {%- assign ratio = 100 -%}
                    {% endif %}
                    <div class="image-card__img overflow-hidden ratio" style="--ratio-percent: {{ ratio }}%;">
                      {% capture current %}{% cycle 1, 2, 3, 4 %}{% endcapture %}
                      {{ 'product-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                    </div>
                  {% endif %}
                </div>
                {% if block.settings.content != blank and block.settings.show_content %}
                <div class="banner_content events-none">
                  <div class="flex relative w-full h-full h_{{block.settings.h_position}} v_{{block.settings.v_position}} text_{{block.settings.txt_align}}">
                    <div class="content_banner">
                        {{ block.settings.content }}
                        {% if block.settings.button_text %}
                        <div class="button_text">
                          <a class="btn events-auto" href="{{ url }}" target="{{open_link}}" >{{ block.settings.button_text }}</a>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
                {% endif %}
              </div>
            </div>
                      
          {%- when 'product_slider' -%} 
           {%- assign products = block.settings.product_list -%}   
            {%-assign limit = block.settings.max_count-%}   
            {%-assign space_between = block.settings.space-Between-%}   
            {%-assign navigation = block.settings.navigation-%}   
            {%-assign pagination = block.settings.pagination-%}   
            {%-assign use_slider = block.settings.use-slider   -%}          
            <div id="bl_{{block.id}}" class="alo-product-slider mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb_mobile }}" style="--font-size:{{ block.settings.font-size }}px;--font-weight:{{ block.settings.font-weight }};">
              {% if block.settings.title != blank %}
                <h3 class="b-title mb-20 sm:mb-20">{{ block.settings.title }}</h3>
              {% endif %}
              <div class="products-slider">
                {% # theme-check-disable %}

                  {% include 'grid-slider', settings: block.settings %}
                  <grid-slider class="grid-slider" {{ gridSlider }}>
                    <div
                      class="swiper iSwiper"
                      {%- render 'skeleton', settings: block.settings -%}
                      style="--perload-gap: {{ space_between}}px"
                    >
                      <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                        {% if products != blank %}
                          {%- for product in products limit: limit -%}
                            {% if block.settings.s_product == 'vertical' %}
                            <div
                                class="swiper-slide lazyload scroll-trigger"
                                data-include="/products/{{product.handle}}/?view=pr_lazy_load"
                              >{% include 'product_style' %} </div>
                              {% else %}
                                <div class="swiper-slide">
                                  {% include 'product-column' %} 
                                </div>
                              {% endif %}
                          {%- endfor -%}
                        {% else %}
              
                          {%- for i in (1..limit) -%}
                            {% if block.settings.s_product == 'vertical' %}
                            <div class="swiper-slide pr_grid_item">
                              {% render 'product_demo' %}
                            </div>
                              {% else %}
                                 <div class="pr_grid_item swiper-slide">
                                  {% render 'product_demo_column' %} 
                                </div>
                              {% endif %}
                          {%- endfor -%}
                        {% endif %}
                      </div>
                      {% if use_slider == true %}
                        {% if navigation %}
                          <div class="swiper-button">
                            <div class="swiper-button-next"></div>
                            <div class="swiper-button-prev"></div>
                          </div>
                        {% endif %}
                        {% if pagination %}
                          <div class="swiper-pagination"></div>
                        {% endif %}
                      {% endif %}
                    </div>
                  </grid-slider>
                {% # theme-check-enable %}
              </div>
            </div>          
          {%- when 'product' -%}
            <div id="bl_{{block.id}}" class="alo-product mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb_mobile }}" style="--font-size:{{ block.settings.font-size }}px;--font-weight:{{ block.settings.font-weight }};">
              {% if block.settings.title != blank %}
                <h3 class="b-title mb-20 sm:mb-20">{{ block.settings.title }}</h3>
              {% endif %}
              <div class="products-column" style="--perload-gap:20px;">
                <div class="list-product">
                  {%- assign products = block.settings.product_list -%}
                  {% if products %}
                    {%- for product in products -%}
                      {% # theme-check-disable %}
                      {% include 'product-column', product: product %}
                      {% # theme-check-enable %}
                    {%- endfor -%}
                  {% else %}
                    {%- for i in (1..4) -%}
                      <div class="product-item">
                        {% render 'product_demo_column' %}
                      </div>
                    {%- endfor -%}
                  {% endif %}
                </div>
              </div>
            </div>
          {%- when 'benefit' -%}
            <div id="bl_{{block.id}}" class="mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb_mobile }}">
              <div class="alo-benefit">
                {% if block.settings.show_benefit_1 %}
                  <div class="item-benefit">
                    {%- if block.settings.source == '1' -%}
                      <div class="icon">
                        <i class="{{block.settings.icon}}"></i>
                      </div>
                    {%- elsif block.settings.source == '2' -%}
                      <div class=" icon img">
                        {% assign image = block.settings.icon_img %}
                        {% if image != blank %}
                          {% render 'responsive-image', image: image, image_class: 'w-full h-full' %}
                        {% else %}
                          {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                          {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                        {% endif %}
                      </div>
                    {%- else -%}
                      <div class="icon">
                        {{ block.settings.text_svg }}
                      </div>
                    {%- endif -%}
                    <div class="content">
                      <p class="title">{{ block.settings.title }}</p>
                      <p>{{ block.settings.content2 }}</p>
                    </div>
                  </div>
                {% endif %}
                {% if block.settings.show_benefit_2 %}
                  <div class="item-benefit">
                    {%- if block.settings.source == '1' -%}
                      <div class="icon">
                        <i class="{{block.settings.icon2}}"></i>
                      </div>
                    {%- elsif block.settings.source == '2' -%}
                      <div class=" icon img">
                        {% assign image = block.settings.icon_img2 %}
                        {% if image != blank %}
                          {% render 'responsive-image', image: image, image_class: 'w-full h-full' %}
                        {% else %}
                          {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                          {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                        {% endif %}
                      </div>
                    {%- else -%}
                      <div class="icon">
                        {{ block.settings.text_svg2 }}
                      </div>
                    {%- endif -%}
                    <div class="content">
                      <p class="title">{{ block.settings.title2 }}</p>
                      <p>{{ block.settings.content2 }}</p>
                    </div>
                  </div>
                {% endif %}
                {% if block.settings.show_benefit_3 %}
                  <div class="item-benefit">
                    {%- if block.settings.source == '1' -%}
                      <div class="icon">
                        <i class="{{block.settings.icon3}}"></i>
                      </div>
                    {%- elsif block.settings.source == '2' -%}
                      <div class=" icon img">
                        {% assign image = block.settings.icon_img3 %}
                        {% if image != blank %}
                          {% render 'responsive-image', image: image, image_class: 'w-full h-full' %}
                        {% else %}
                          {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                          {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                        {% endif %}
                      </div>
                    {%- else -%}
                      <div class="icon">
                        {{ block.settings.text_svg3 }}
                      </div>
                    {%- endif -%}
                    <div class="content">
                      <p class="title">{{ block.settings.title3 }}</p>
                      <p>{{ block.settings.content3 }}</p>
                    </div>
                  </div>
                {% endif %}
                {% if block.settings.show_benefit_4 %}
                  <div class="item-benefit">
                    {%- if block.settings.source == '1' -%}
                      <div class="icon">
                        <i class="{{block.settings.icon4}}"></i>
                      </div>
                    {%- elsif block.settings.source == '2' -%}
                      <div class=" icon img">
                        {% assign image = block.settings.icon_img4 %}
                        {% if image != blank %}
                          {% render 'responsive-image', image: image, image_class: 'w-full h-full' %}
                        {% else %}
                          {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                          {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                        {% endif %}
                      </div>
                    {%- else -%}
                      <div class="icon">
                        {{ block.settings.text_svg4 }}
                      </div>
                    {%- endif -%}
                    <div class="content">
                      <p class="title">{{ block.settings.title4 }}</p>
                      <p>{{ block.settings.content4 }}</p>
                    </div>
                  </div>
                {% endif %}
              </div>
            </div>
          {%- when 'blog' -%}
            {% liquid
              assign blog = blogs[block.settings.blog]
              assign space_between = block.settings['space-Between']
              assign navigation = block.settings.navigation
              assign pagination = block.settings.pagination
              if block.settings['use-slider']
                assign use_slider = true
              else
                assign use_slider = false
              endif
            %}
            <div id="bl_{{block.id}}" class="alo-blog mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb_mobile }}" style="--font-size:{{ block.settings.font-size }}px;--font-weight:{{ block.settings.font-weight }};">
              {% if block.settings.title != blank %}
                <h3 class="b-title mb-20 sm:mb-20">{{ block.settings.title }}</h3>
              {% endif %}
              <div class="list-blog">
                {% # theme-check-disable %}

                {% include 'grid-slider', settings: block.settings %}
                <grid-slider class="grid-slider blog-slider" {{ gridSlider }}>
                  <div
                    class="swiper iSwiper"
                    {%- render 'skeleton', settings: block.settings -%}
                    style="--perload-gap: {{ space_between}}px"
                  >
                    <div class="swiper-wrapper {% if use_slider == false %}flex-wrap{% endif %}">
                      {%- if blog != blank -%}
                        {%- for article in blog.articles -%}
                          {% assign image = article.image %}
                          {% assign url = article.url %}
                          <article class="swiper-slide post-item post_laber_loop">
                            <div class="item">
                              {% if image != blank %}
                                <div class="images-card w-full h-full overflow-hidden">
                                  {% render 'responsive-image',
                                    image: image,
                                    aspect_ratio: aspect_ratio,
                                    image_class: 'w-full h-full',
                                    url: url
                                  %}
   
                                </div>
                              {% endif %}
                              <div class="post-info">
                                  <div class="blog mb-5">
                                    <a href="{{blog.url}}">{{ blog.title }}</a>
                                  </div>
                                  <div class="head head-article mb-10">
                                    <div class="title_blog">
                                      <h3>
                                        <a href="{{article.url }}" class="post-title">{{ article.title }}</a>
                                      </h3>
                                    </div>
                                  </div>
                                  <div class="meta-post">
                                    <div class="item-meta inner-date">
                                    {% render 'icon-data' %}
                                    <p>
                                    <span class="day">{{ article.created_at | date: "%d" }}</span>
                                    <span class="month">{{ article.created_at | date: "%b" }}</span>
                                    </p>
                                  </div>
                                   <div class="item-meta read_more">
                                    <a href="{{ article.url }}" title="{{ article.title }}">
                                      <svg width="16" height="19" viewBox="0 0 16 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                                      <path d="M4.39117 3.22266V10.2202H1.39258C1.39258 10.2202 1.39258 13.3088 1.39258 14.3067C1.39258 15.3047 2.32211 15.7177 3.0107 15.7177C3.6993 15.7177 10.6326 15.7177 12.3885 15.7177C13.146 15.7177 13.888 14.9808 13.888 14.2181C13.888 13.6673 13.888 3.22266 13.888 3.22266H4.39117ZM3.0107 15.218C2.69945 15.218 1.89273 15.0544 1.89273 14.3067V10.7198H4.39164V14.0911C4.39164 14.4258 3.9543 15.218 3.26477 15.218H3.0107ZM13.3879 14.2181C13.3879 14.7038 12.8741 15.218 12.388 15.218H4.36633C4.70289 14.8673 4.89086 14.4066 4.89086 14.0911V3.72234H13.3874L13.3879 14.2181Z" fill="#AAAAAA"/>
                                      <path d="M5.89062 4.72168H12.388V5.22137H5.89062V4.72168Z" fill="#AAAAAA"/>
                                      <path d="M5.89062 11.4688H12.388V11.9684H5.89062V11.4688Z" fill="#AAAAAA"/>
                                      <path d="M5.89062 13.2188H12.388V13.7184H5.89062V13.2188Z" fill="#AAAAAA"/>
                                      <path d="M12.388 6.4707H5.89062V10.2193H12.388V6.4707ZM11.8883 9.71961H6.39031V6.97086H11.8883V9.71961Z" fill="#AAAAAA"/>
                                      </svg>
                                      {{ 'blogs.article.read_more' | t }}
                                    </a>
                                  </div>
                                  </div>
                              </div>
                            </div>
                          </article>
                        {%- endfor -%}
                      {%- else -%}
                        {%- for i in (1..5) -%}
                          <article class="swiper-slide post-item post_laber_loop">
                            <div class="item">
                              {% if aspect_ratio != blank %}
                                {%- assign ratio = 1 | divided_by: aspect_ratio | times: 100 -%}
                              {% else %}
                                {%- assign ratio = 100 -%}
                              {% endif %}
                              <div
                                class="image-card__img image-blog img-demo overflow-hidden ratio"
                                style="--ratio-percent: {{ ratio }}%;"
                              >
                                {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                                {{
                                  'collection-'
                                  | append: current
                                  | placeholder_svg_tag: 'placeholder-svg w-full h-full'
                                }}
                                
                              </div>
                              <div class="post-info head head-article">
                                  <div class="blog"><a href="#">Blog category </a></div>
                                  <div class="title_blog">
                                    <h3>
                                      <a href="{{ routes.root_url }}" class="post-title"
                                        >Avocado Grilled Salmon, Rich In Nutrients For The Body</a
                                      >
                                    </h3>
                                  </div>
                                  <div class="meta-post">
                                    <div class="item-meta inner-date">
                                      <span class="day">05</span>
                                      <span class="year">Feb</span>
                                    </div>
                                    <div class="read_more">
                                      <a href="#" title="read more"> read more </a>
                                    </div>
                                  </div>
                              </div>
                            </div>
                          </article>
                        {%- endfor -%}
                      {%- endif -%}
                    </div>
                    {% if use_slider == true %}
                      {% if navigation %}
                        <div class="swiper-button">
                          <div class="swiper-button-prev"></div>
                          <div class="swiper-button-next"></div>
                        </div>
                      {% endif %}
                      {% if pagination %}
                        <div class="swiper-pagination"></div>
                      {% endif %}
                    {% endif %}
                  </div>
                </grid-slider>
              {% # theme-check-enable %}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
{% style %}
  .wrap-sidebar {
    --alo-width-sidebar:{{section.settings.width}}px;
    --alo-width-sidebar-tablet:{{section.settings.width_tablet}}px;
    --alo-gap-sidebar:{{section.settings.gap}}px;
  }
{% endstyle %}
{%- render 'section_style' -%}
{% schema %}
 {
   "name": "Sidebar",
"class":"alo-index-sidebar",
	"settings": [
		 {
           "type": "header",
           "content": "== Setting"
           },
           {
           "type": "color",
           "id": "cl_bg",
           "label": "Background color",
           "default": "#fff"
           },
           {
              "type": "range",
              "id": "width",
              "label": "width sidebar",
              "min": 200,
              "max": 400,
              "step": 10,
              "unit": "px",
              "default": 250
           },
           {
              "type": "range",
              "id": "width_tablet",
              "label": "width sidebar (tablet)",
              "min": 200,
              "max": 400,
              "step": 10,
              "unit": "px",
              "default": 250
           },
           {
              "type": "range",
              "id": "gap",
              "label": "Gap",
              "min": 0,
              "max": 60,
              "step": 1,
              "unit": "px",
              "default": 30
           },
           {
              "type": "range",
              "id": "border",
              "label": "Border",
              "min": 0,
              "max": 50,
              "step": 1,
              "unit": "px",
              "default": 0
           },
           {
           "type": "header",
           "content": "== Setting PC",
           "info":"Margin"
           },
           {
           "type": "text",
           "id": "mg",
           "label": "Margin",
           "info":"Margin top, margin right, margin bottom, margin left. If you not use to blank"
           },
           {
           "type": "text",
           "id": "pd",
           "label": "Padding",
           "info":"Padding top, padding right, padding bottom, padding left. If you not use to blank"
           },
           {
           "type": "text",
           "id": "bd",
           "label": "Border",
           "info":"border top  border right border bottom  border left. If you not use to blank"
           },
           {
           "type": "header",
           "content": "== Design Mobile Options"
           },
           {
           "type": "text",
           "id": "mg_mb",
           "label": "Margin"
           },
           {
           "type": "text",
           "id": "pd_mb",
           "label": "Padding"
           }
	],
     "blocks": [

       {
       "type": "vertical_menu",
       "name": "Vertical Menu",
       "settings": [
         {
             "type": "range",
             "id": "font-size",
             "label": "Font size (title)",
             "min": 20,
             "max": 60,
             "step": 5,
             "default": 25
           },
         {
               "type": "range",
               "id": "font-weight",
               "label": "Font weight (title)",
               "min": 400,
               "max": 900,
               "step": 100,
               "default": 500
             },
         {
           "type": "paragraph",
           "content": "Display menu in mobile instead of Vertical Menu."
         },
         {
           "type": "text",
           "id": "title_categories",
           "label": "Title",
           "default": "Product Categories"
         },
         {
           "type": "link_list",
           "id": "menu",
           "label": "Add menu"
         },
         {
           "type": "checkbox",
           "id": "use_thumb",
           "label": "Use Thumbnail",
           "default": true
           },
           {
             "type": "range",
             "id": "mb",
             "label": "Margin bottom",
             "min": 0,
             "max": 100,
             "step": 5,
             "default": 30
