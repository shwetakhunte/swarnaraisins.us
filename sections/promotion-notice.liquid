{% liquid
  assign sid = section.id 
  assign layout = section.settings.layout
  assign section_blocks = section.blocks
  assign arr_blocks_img = section_blocks | where: "type", 'banner_img'
  assign img_size = arr_blocks_img.size | plus:0
  assign index = 1

%}
{%- if section.settings.hidden %}{% break %}{% endif -%}
<section id="laber_{{sid}}" class="wow animate--slide-in">
  <div class="container {% if layout %}full-width{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
    	{% if img_size > 0 %} 
            {%- for block in arr_blocks_img -%}
                {% if block.type == 'banner_img' %}
                    {% assign image = block.settings.image_sl %}
                    {% assign image_mobile = block.settings.image_sl_mobile | default: block.settings.image_sl %}
                    {% assign url = block.settings.link_img %}
                    {% assign open_link = block.settings.open_link %} 
                    <div id="laber_{{block.id}}" class="banner-card overflow-hidden" style="--alo-background:{{ block.settings.cl_bg }};--color-border:{{ block.settings.cl_border }};--alo-border-radius:{{ block.settings.border }}px;">
                        <div class="content-item">
                          <div  class="images-card w-full h-full" style="--alo-height-pc:{{ section.settings.h_des }}; --alo-height-tb:{{ section.settings.h_tb }};--alo-height-mb:{{ section.settings.h_mb }}" {{ block.shopify_attributes }}>
                          
                          {% if image != blank %} 
                            {% render 'banner-image', image: image, image_class: 'w-full h-full sm:d-none',url: url,open_link:open_link %}
                            {% if image_mobile != blank %}
                              {% render 'banner-image', image: image_mobile, image_class: 'w-full h-full d-none sm:d-block',url: url,open_link:open_link %}
                            {% endif %}  
                          {% endif %}
                          
                            <div class="w-full h-full banner_content events-none">
                            <div class="w-full h-full flex relative banner_text h_center v_middle text_center"> 
                            <div class="content_banner {{ block.settings.display }}" style="--alo-gap:{{ block.settings.gap }}px;">
                                  {% for block in section_blocks offset:index %}
                                  {% assign index = index|plus:1 %}                          		
                                  {%- case block.type -%}
                                      {% when 'hd' %}
                                        <h3 id="b_{{block.id}}" class="banner_title_h3 {% if block.settings.hide %} d-none{% endif %}" {{ block.shopify_attributes }}>                             
                                          {% assign somearray = block.settings.title | split: ' ' %} 
                                          {% assign pos = block.settings.custom_mark %}
                                          {% assign index_mark  = 0 %}
                                          {% for item in somearray %}
                                          {% assign index_mark  = index_mark | plus: 1 %} 
                                          <span  class="{% if block.settings.first_mark and forloop.first %}first {% endif %}{% if pos contains index_mark %}marked{% endif %}{% if block.settings.last_mark and forloop.last %}last {% endif %}" > 
                                            {{item}}
                                            </span>
                                          {% endfor %}                             
                                        </h3>
                                    {% when 'btn' %}
                                      {% if block.settings.button_label != blank %}
                                          <div id="b_{{block.id}}" class="alo-btn mb-{{ block.settings.mg_bottom }} sm:mb-{{ block.settings.mobile_mg_bottom }}">
                                            <a class="btn events-auto alo-letter-spacing alo-text-transform {{ block.settings.button_style }} {{ block.settings.button_size }}" href="{{ url | default:'#' }}" title="{{ block.settings.button_label }}" style="--alo-letter-spacing{{ block.settings.ls_text }};--alo-text-transform:{{ block.settings.text_transform }}">
                                              {{- block.settings.button_label -}} <i class="icon-arrow-right"></i>
                                            </a>
                                          </div>
                                        {% endif %}
                              
                                  {% else %} 
                                  {%- break -%}
                                  {%- endcase -%}
                                  {%- endfor -%}
                            </div>
                            </div>
                          </div>
                          </div>
                      </div>
                    </div>

                {%endif%}
            {%endfor%}
    	{%endif%}
  </div>
</section>
{%- render 'section_style' -%}
{%- capture banner_style -%}
	{%- if section_blocks.size > 0 %}
      {%- for block in section_blocks -%}
        {%- assign id = block.id -%}
        {%- assign type = block.type -%}
        {%- case type -%} 
			{% when 'hd' %}
			.type_promotion_notice .banner_text h3#b_{{id}} {
                text-transform:{{block.settings.text_transform}}; 
                letter-spacing:{{block.settings.ls_text}}; 
                {% if block.settings.lh_text >0 %}line-height:{{block.settings.lh_text}}px; {% endif %} 
                font-size:{{block.settings.fs_text}}px; 
                color:{{block.settings.color}}; 
                font-weight:{{block.settings.fw_text}};
				
			}
            .type_promotion_notice .banner_text h3#b_{{id}} span.first ,
            .type_promotion_notice .banner_text h3#b_{{id}} span.marked,
            .type_promotion_notice .banner_text h3#b_{{id}} span.last {
              color:{{block.settings.color_mark}}; 
            }
            @media (max-width: 1024px) {
				.type_promotion_notice .banner_text h3#b_{{id}}{
					font-size:{{block.settings.mobile_font_text}}px;
				}
          	}
            {% when 'btn' %}
            .type_promotion_notice .banner_text #b_{{block.id}} a {
					font-size:{{block.settings.font_text}}px;
				}
            font_text
        {%endcase%}
      {%- endfor -%}
	{%- endif -%}
{%- endcapture -%}

{% style%}
{{ banner_style | strip_newlines | remove:"  "}}
{% endstyle%}
{{ 'promotion-notice.css' | asset_url | stylesheet_tag }}
