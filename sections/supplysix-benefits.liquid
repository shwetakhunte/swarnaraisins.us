{% comment %} Swarna Raisins — Why Choose Swarna? Benefits Section {% endcomment %}

<style>
.sr-benefits-section {
  padding: 72px 24px;
  background: #fdfaf6;
  font-family: 'Poppins', sans-serif;
}
.sr-benefits-inner {
  max-width: 1200px;
  margin: 0 auto;
}
.sr-benefits-eyebrow {
  display: block;
  text-align: center;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #2e7d32;
  margin-bottom: 12px;
}
.sr-benefits-heading {
  text-align: center;
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 800;
  color: #1b1b1b;
  margin: 0 0 12px 0;
  line-height: 1.2;
}
.sr-benefits-sub {
  text-align: center;
  font-size: 16px;
  color: #555;
  max-width: 580px;
  margin: 0 auto 52px;
  line-height: 1.7;
}
.sr-benefits-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 28px;
}
.sr-benefit-card {
  background: #ffffff;
  border: 1px solid #eaeaea;
  border-radius: 16px;
  padding: 36px 28px;
  text-align: center;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  position: relative;
  overflow: hidden;
}
.sr-benefit-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: linear-gradient(90deg, #2e7d32, #66bb6a);
  border-radius: 16px 16px 0 0;
}
.sr-benefit-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 50px rgba(46, 125, 50, 0.1);
}
.sr-benefit-icon-wrap {
  width: 72px;
  height: 72px;
  margin: 0 auto 20px;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sr-benefit-icon-wrap svg {
  width: 32px;
  height: 32px;
  color: #2e7d32;
  stroke: #2e7d32;
}
.sr-benefit-icon-wrap img {
  width: 38px;
  height: 38px;
  object-fit: contain;
}
.sr-benefit-title {
  font-size: 18px;
  font-weight: 700;
  color: #1b1b1b;
  margin: 0 0 10px;
}
.sr-benefit-desc {
  font-size: 14px;
  color: #666;
  line-height: 1.65;
  margin: 0;
}
/* Promise strip */
.sr-promise-strip {
  margin-top: 56px;
  background: linear-gradient(135deg, #2e7d32 0%, #1b5e20 100%);
  border-radius: 16px;
  padding: 36px 32px;
  display: flex;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
  justify-content: center;
  text-align: center;
}
.sr-promise-icon {
  font-size: 48px;
  flex-shrink: 0;
}
.sr-promise-text h3 {
  font-size: 22px;
  font-weight: 700;
  color: #ffffff !important;
  margin: 0 0 8px;
}
.sr-promise-text p {
  font-size: 15px;
  color: rgba(255,255,255,0.88);
  margin: 0;
  max-width: 640px;
  line-height: 1.6;
}
@media (max-width: 600px) {
  .sr-benefits-section { padding: 48px 16px; }
  .sr-benefit-card { padding: 28px 20px; }
  .sr-promise-strip { padding: 28px 20px; }
}
</style>

<section class="sr-benefits-section">
  <div class="sr-benefits-inner">
    <span class="sr-benefits-eyebrow">
      {{ section.settings.eyebrow | default: '— Nature\'s Best —' }}
    </span>
    <h2 class="sr-benefits-heading">
      {{ section.settings.heading | default: 'Why Choose Swarna Raisins?' }}
    </h2>
    <p class="sr-benefits-sub">
      {{ section.settings.subheading | default: 'A handful of Swarna Raisins daily supports a calmer gut, steady energy, glowing skin & balanced hormones — rooted in Ayurveda, backed by modern nutrition.' }}
    </p>

    <div class="sr-benefits-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="sr-benefit-card" {{ block.shopify_attributes }}>
            <div class="sr-benefit-icon-wrap">
              {% if block.settings.icon %}
                <img src="{{ block.settings.icon | image_url: width: 80 }}" alt="{{ block.settings.title }}">
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  {% when 2 %}
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  {% when 3 %}
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                  {% when 4 %}
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                {% endcase %}
              {% endif %}
            </div>
            <h3 class="sr-benefit-title">{{ block.settings.title | default: 'Benefit' }}</h3>
            <p class="sr-benefit-desc">{{ block.settings.description | default: 'Naturally packed with goodness.' }}</p>
          </div>
        {% endfor %}
      {% else %}
        {%- assign default_benefits = "100% Natural & Chemical-Free|Zero sulphur, zero additives. Our raisins are sun-dried the natural way — pure as nature intended.|Naturally Dried & Nutrient-Rich|Packed with Iron, Fibre & Antioxidants that boost energy, support gut health and nourish your skin from within.|Ayurvedic Wisdom|Rooted in centuries of Ayurvedic tradition — raisins soaked overnight or eaten raw are a daily ritual for natural wellness.|FSSAI & NABL Certified|Every batch is lab-tested and certified. What you see on the label is exactly what's in the pack — no surprises.|Supports 200+ Farmers|Every purchase directly supports smallholder farmers across Maharashtra & Karnataka with fair pricing and guaranteed offtake.|Perfectly Portioned|Available in 40g snack packs, 100g–1kg family packs — fresh-sealed for every lifestyle, on the go or at home." | split: "|" -%}
        {%- assign default_icons = "shield|heart|leaf|badge|users|package" | split: "|" -%}
        {% for i in (0..5) %}
          {%- assign t = default_benefits[forloop.index0 | times: 2] -%}
          {%- assign d = default_benefits[forloop.index0 | times: 2 | plus: 1] -%}
          <div class="sr-benefit-card">
            <div class="sr-benefit-icon-wrap">
              {% case forloop.index %}
                {% when 1 %}<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {% when 2 %}<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                {% when 3 %}<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8C8 10 5.9 16.17 3.82 19.99l1.86.01L7 16h10l2 4h2l-4-12z"/></svg>
                {% when 4 %}<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                {% when 5 %}<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                {% else %}<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              {% endcase %}
            </div>
            <h3 class="sr-benefit-title">{{ t }}</h3>
            <p class="sr-benefit-desc">{{ d }}</p>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <div class="sr-promise-strip">
      <div class="sr-promise-icon">🍇</div>
      <div class="sr-promise-text">
        <h3>{{ section.settings.promise_title | default: 'Let Go of Empty Sweets. Choose Sweetness That Gives Back.' }}</h3>
        <p>{{ section.settings.promise_text | default: 'Fibre, Iron & Antioxidants in every bite. Swarna Raisins — the only snack that loves you back.' }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Swarna Benefits",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Label", "default": "— Nature's Best —" },
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "Why Choose Swarna Raisins?" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A handful of Swarna Raisins daily supports a calmer gut, steady energy, glowing skin & balanced hormones — rooted in Ayurveda, backed by modern nutrition." },
    { "type": "text", "id": "promise_title", "label": "Promise Strip Title", "default": "Let Go of Empty Sweets. Choose Sweetness That Gives Back." },
    { "type": "textarea", "id": "promise_text", "label": "Promise Strip Text", "default": "Fibre, Iron & Antioxidants in every bite. Swarna Raisins — the only snack that loves you back." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Card",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon Image (optional)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit Title" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Describe this benefit here." }
      ]
    }
  ],
  "presets": [
    { "name": "Swarna Benefits" }
  ]
}
{% endschema %}
