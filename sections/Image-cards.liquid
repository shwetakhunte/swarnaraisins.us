{% liquid
  assign sid = section.id 
  assign section_blocks = section.blocks
  assign arr_blocks_img = section_blocks | where: "type", 'banner_img'
  assign img_size = arr_blocks_img.size | plus:0
  assign index = 1
  assign layout = section.settings.layout
%}
{{ 'media-grid.css' | asset_url | stylesheet_tag }}
<section id="laber_{{sid}}" data-aos-duration="500" data-aos="fade-up">
  <div class="{% if layout %}full-width {% else %}container{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;"> 
    <div class="wrap-Image-cards {% if section.settings.cl_bg_content != 'rgba(0,0,0,0)' %}alo-background-color alo-border-radius pd-20 py-20 sm:pd-10 sm:py-10 {% endif %}" style="{% if section.settings.cl_bg_content != 'rgba(0,0,0,0)' %}--bg-color:{{ section.settings.cl_bg_content  }}; {% endif %}">
      {% if section.settings.title != blank %}
          <div class="wrap_title w_{{ section.settings.h_position }} {{ section.settings.text_size }} mb-30 sm:mb-20">
          <div
             class="h3 section-title text-transform {% if section.settings.cl_underline != 'rgba(0,0,0,0)' %}title-hr{% endif %}"
                style="
                  --cl-text:{{ section.settings.cl_title |default:"#333333" }};
                  --text-transform:{{ section.settings.text_transform }};
                --cl-underline:{{ section.settings.cl_underline }};
                "
            >
              <span>{{ section.settings.title }}</span>
            </div>
            {% if section.settings.content %}
              <div class="content">{{ section.settings.content }}</div>
            {% endif %}
          </div>
        {% endif %}
    	{% if img_size > 0 %} 
    	<media-grid class="media-grid" style="--media-grid-column:{{ section.settings.column }};--alo-gap:{{ section.settings.gap }}px;">
            {%- for block in arr_blocks_img -%}
                {%- case block.type -%}
                    {% when 'banner_img' %}
                    {% assign hide_image = block.settings.hide_image %}
                    {% assign image = block.settings.image_sl %}
                    {% assign url = block.settings.link_img %}
                    {% assign open_link = block.settings.open_link %} 
          			{% assign hidden_content = block.settings.hidden_content %}
          			<article id="media-grid-{{ block.id }}" class="media-item w-full h-full" style="--media-grid-column-span: {{ block.settings.media-grid-column-span }}; --media-grid-row-span: {{ block.settings.media-grid-row-span }};" > 
                 
                          <div  class="images-card relative overflow-hidden w-full h-full alo-border-radius" style="--rounded:{{ section.settings.border }}px;" {{ block.shopify_attributes }}>
                          {% if image != blank %} 
                            {% render 'banner-image', image: image, image_class: 'w-full h-full',url: url,open_link:open_link %}
                          {% else %}
                            <div class="image-card__img absolute inset-0 w-full h-full {% if hide_image %}d-none-important{% endif %}" style="--aspect-ratio: 3;">
                                 
                                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg w-full h-full object-cover' }}
                            </div>
                          {% endif %}
                          
                            <div class="banner_content banner_text_{{block.id}} events-none w-full h-full" {%if hidden_content %}style="display:none;"{%endif%}>
                            <div class="{% if img_size == 1%} container{%endif%} w-full h-full flex relative banner_text {% if hide_image %}p-0{% endif %} h_{{block.settings.h_position}} v_{{block.settings.v_position}} text_{{block.settings.txt_align}}" style="--pad:{{ block.settings.pd_content }}%;">
                            <div class="content_banner {% if block.settings.bg_color != 'rgba(0,0,0,0)' %}bg_color{% endif %}" style="--alo-width-content:{{ block.settings.w_content }}%;--bg-color:{{ block.settings.bg_color }};">
                                  {% for block in section_blocks offset:index %}
                                  {% assign index = index|plus:1 %}                          		
                                  {%- case block.type -%}
                                      {% when 'hd' %}
                                        <h3 id="b_{{block.id}}" class="banner_title_h3 {% if block.settings.cl_underline != 'rgba(0,0,0,0)' %}title-hr{% endif %} {% if block.settings.hide %} d-none{% endif %}" {{ block.shopify_attributes }}
                                          style="--cl-underline:{{ block.settings.cl_underline }};"
                                          >
                                          {% assign somearray = block.settings.title | split: ' ' %} 
                                          {% assign pos = block.settings.custom_mark %}
                                          {% assign index_mark  = 0 %}
                                          {% for item in somearray %}
                                          {% assign index_mark  = index_mark | plus: 1 %} 
                                          <span  class="{% if block.settings.first_mark and forloop.first %}first {% endif %}{% if pos contains index_mark %}marked{% endif %}{% if block.settings.last_mark and forloop.last %}last {% endif %}" > 
                                            {{item}}
                                            </span>
                                          {% endfor %}                             
                                        </h3>
                                      {% when 'subhd' %}
                                        <h5 id="b_{{block.id}}" class="banner_title_h5 {% if block.settings.hide %} d-none{% endif %}" {{ block.shopify_attributes }}>
                                          {% assign somearray = block.settings.title | split: ' ' %}                             
                                          {% assign pos = block.settings.custom_mark %}
                                          {% assign index_mark  = 0 %}
                                          {% for item in somearray %}
                                          {% assign index_mark  = index_mark | plus: 1 %} 
                                          <span  class="{% if block.settings.first_mark and forloop.first %}first {% endif %}{% if pos contains index_mark %}marked{% endif %}{% if block.settings.last_mark and forloop.last %}last {% endif %}" > 
                                              {{item}} 
                                          </span>
                                          {% endfor %}   
                                        </h5>
                                      {% when 'txt' %}
                                          <div id="b_{{block.id}}" class="slide_item_p {% if block.settings.hide %} d-none{% endif %}">
                                              <div  {{ block.shopify_attributes }}>{{block.settings.content}}</div> 
                                          </div>
                                       {% when 'btn' %}
                                      {% if block.settings.button_label != blank %}
                                          <div id="b_{{block.id}}" class="alo-btn mb-{{ block.settings.mg_bottom }} sm:mb-{{ block.settings.mobile_mg_bottom }}">
                                            <a class="btn events-auto alo-letter-spacing text-transform {{ block.settings.button_style }}" href="{{ url | default:'#' }}" title="{{ block.settings.button_label }}" style="
                                              --rounded-btn:{{ block.settings.border }}px;
                                              --alo-letter-spacing:{{ block.settings.ls_text }};
                                              --text-transform:{{ block.settings.text_transform }};
                                              --font-size:{{ block.settings.f-size }}px;
                                              --cl-btn-text:{{ block.settings.cl_txt }};
                                              --cl-link:{{ block.settings.cl_txt }};
                                              --cl-btn-text-h:{{ block.settings.cl_txt_h }};
                                              --bg-btn:{{block.settings.cl_bg }};
                                              --bg-btn-h:{{ block.settings.cl_bg_h}};
                                              --cl-b-btn:{{block.settings.cl_bg}};
                                              --cl-b-btn-h:{{block.settings.cl_bg_h}};
                                              ">
                                              {{- block.settings.button_label -}}
                                            </a>
                                          </div>
                                        {% endif %}
                              
                                      {% when 'label' %}
                                      {%- if  block.settings.title != blank -%}
                                      <div id="b_{{block.id}}" class="label" {{ block.shopify_attributes }}>
                                        <span><span>{{block.settings.title}}</span></span>
                                      </div>	
                                      {%- endif -%}
                              
                                  {% else %} 
                                  {%- break -%}
                                  {%- endcase -%}
                                  {%- endfor -%}
                            </div>
                            </div>
                              </div>
                          </div>
                
                    </article>
                  {% endcase %}
                
            {%endfor%}
    	</media-grid>
    	{%endif%}
    </div>
  </div>
</section>
{%- render 'section_style' -%}
{%- capture banner_style -%}
	{%- if section_blocks.size > 0 %}
      {%- for block in section_blocks -%}
        {%- assign id = block.id -%}
        {%- assign type = block.type -%}
        {%- case type -%} 
			{% when 'hd' %}
			.image-cards .content_banner h3#b_{{id}}{
				margin-bottom:{{block.settings.mg_bottom}}px;
                text-transform:{{block.settings.text_transform}}; 
                letter-spacing:{{block.settings.ls_text}}; 
                {% if block.settings.lh_text >0 %}line-height:{{block.settings.lh_text}}px; {% endif %} 
                font-size:{{block.settings.fs_text}}px; 
                color:{{block.settings.color}}; 
                font-weight:{{block.settings.fw_text}};
			}
            .image-cards .content_banner h3.title-hr#b_{{id}} {
                  position: relative;
                  padding-bottom: 15px;
            }
            .image-cards .content_banner h3.title-hr#b_{{id}}:before {
                content: '';
                background-color: var(--cl-underline);
                height: 5px;
                display: block;
                width: 50px;
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                margin: 0 auto;
            }
            .image-cards .text_left .content_banner h3.title-hr#b_{{id}}:before { 
                  right: inherit;
            }
            .image-cards .text_right .content_banner h3.title-hr#b_{{id}}:before { 
                  left: inherit;
            }
            .image-cards .content_banner h3#b_{{id}} span.first ,
            .image-cards .content_banner h3#b_{{id}} span.marked,
            .image-cards .content_banner h3#b_{{id}} span.last {
              color:{{block.settings.color_mark}}; 
              font-size:{{block.settings.mark_fs_text}}px;
              font-weight:{{block.settings.mark_fw_text}};
            }
            @media (max-width: 1024px) {
                .image-cards .content_banner h3#b_{{id}} span.first ,
                .image-cards .content_banner h3#b_{{id}} span.marked,
                .image-cards .content_banner h3#b_{{id}} span.last {font-size:{{block.settings.mobile_font_text}}px;}
				.image-cards .content_banner h3#b_{{id}} {
					font-size:{{block.settings.mobile_font_text}}px;
                    {% if block.settings.lh_text >0 %}line-height:{{block.settings.mobile_lh_text}}px; {% endif %} 
					margin-bottom:{{block.settings.mobile_mg_bottom}}px;
				}
          	}
			{% when 'subhd' %}
			.image-cards .content_banner h5#b_{{id}}{
				margin-bottom:{{block.settings.mg_bottom}}px;
				text-transform:{{block.settings.text_transform}}; 
				letter-spacing:{{block.settings.ls_text}};
				{% if block.settings.lh_text >0 %}line-height:{{block.settings.lh_text}}px; {% endif %} 
				font-size:{{block.settings.fs_text}}px; 
				color:{{block.settings.color}}; 
				font-weight:{{block.settings.fw_text}};
			}
            .image-cards .content_banner h5#b_{{id}} span.first ,
            .image-cards .content_banner h5#b_{{id}} span.marked,
            .image-cards .content_banner h5#b_{{id}} span.last {
              color:{{block.settings.color_mark}}; 
              font-size:{{block.settings.mark_fs_text}}px;
              font-weight:{{block.settings.mark_fw_text}};
            }
			@media (max-width: 1024px) {
                .image-cards .content_banner h5#b_{{id}} span.first ,
                .image-cards .content_banner h5#b_{{id}} span.marked,
                .image-cards .content_banner h5#b_{{id}} span.las{font-size:{{block.settings.mobile_font_text}}px;}
				.image-cards .content_banner h5#b_{{id}}{
					font-size:{{block.settings.mobile_font_text}}px;
                    {% if block.settings.lh_text >0 %}line-height:{{block.settings.mobile_lh_text}}px; {% endif %} 
					margin-bottom:{{block.settings.mobile_mg_bottom}}px;
                    
				}
          	}
            {% when 'txt' %}
              .image-cards .content_banner div#b_{{id}}{
                  margin-bottom:{{block.settings.mg_bottom}}px; 
                  letter-spacing:{{block.settings.ls_text}}; 
				  text-transform:{{block.settings.text_transform}}; 
                  {% if block.settings.lh_text >0 %}line-height:{{block.settings.lh_text}}px; {% endif %} 
                  font-size:{{block.settings.fs_text}}px; 
                  color:{{block.settings.color}}; 
                  font-weight:{{block.settings.fw_text}};
              }
              @media (max-width: 1024px) {
                  .image-cards .content_banner div#b_{{id}} {
                      font-size:{{block.settings.mobile_font_text}}px;
                      margin-bottom:{{block.settings.mobile_mg_bottom}}px;
                  }
              }
              {% when 'label' %}
			  .image-cards .content_banner div#b_{{id}}.label{
					margin-bottom:{{block.settings.mg_bottom}}px;
				}
              .image-cards .content_banner div#b_{{id}}.label > span{
                background-color: {{block.settings.cl_bg}}; 
                color:{{block.settings.cl_txt}}; 
                font-size:{{block.settings.fs_text}}px; 
                font-weight:{{block.settings.fw_text}};
                text-transform:{{block.settings.button_transform}};
                moz-transition: all .4s ease-in-out;
                -o-transition: all .4s ease-in-out;
                -webkit-transition: all .4s ease-in-out;
                transition: all .4s ease-in-out;
                display: inline-block;
                padding:0 15px;
                min-height: 30px;
                line-height: 30px;
                position: relative;
              } 
              .image-cards .content_banner div#b_{{id}}.label > span:before {
                    content: '';
                    border: 14px solid;
                    border-color: {{block.settings.cl_bg}} transparent {{block.settings.cl_bg}} {{block.settings.cl_bg}};
                    position: absolute;
                    bottom: 0;
                    top: 0;
                    right: -20px;
              }
            @media (max-width: 1024px) {
              .image-cards .content_banner div#b_{{id}}.label{
              	margin-bottom:{{block.settings.mobile_mg_bottom}}px;
              }
            }
        {%endcase%}
      {%- endfor -%}
	{%- endif -%}
  
    #laber_{{ sid}} {
    --media-grid-row-height: {{ section.settings.mobile_row_height }}px;
    }
    @media screen and (min-width: 1200px) {
      #laber_{{ sid }} {
        --media-grid-row-height: {{ section.settings.desktop_row_height }}px;
      }
    }
    @media only screen and (min-width: 768px) and (max-width: 1199px) {
      #laber_{{ sid }} {
        --media-grid-row-height: {{ section.settings.tablet_row_height }}px;
      }
    }
{%- endcapture -%}

{% style%}
{{ banner_style | strip_newlines | remove:"  "}}
{% endstyle%}
{%- schema -%}
  {
    "name": "Image cards",
    "class": "image-cards type_banner laber_section",	
    "settings": [
      {
      "type": "header",
      "content": "== Title Settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
     {
     "type": "color",
     "id": "cl_title",
     "label": "Color title",
     "default": "#fff"
     },
     {
      "type": "color",
      "id": "cl_underline",
      "label": "Color underline",
      "default": "#c60f14",
      "info":"If you do not want to use it, you can leave it blank."
    },  
    {
      "type": "select",
      "id": "text_size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "small"
       },
       {
          "value": "medium",
          "label": "Medium"
       },
       {
          "value": "large",
          "label": "Large"
        }
      ],
      "label": "Text size"
    },
    {
            "type": "select",
            "id": "text_transform",
            "default": "none",
            "options": [
             {
                "value": "none",
                "label": "None"
             },
             {
                "value": "capitalize",
                "label": "Capitalize"
             },
             {
                "value": "lowercase",
                "label": "Lowercase"
             },
             {
                "value": "uppercase",
                "label": "Uppercase"
              }
            ],
            "label": "Text transform:"
          },
            {
        "type": "select",
        "id": "h_position",
        "label": "Position",
        "default": "left",
        "options": [
            {
            "value": "left",
            "label": "Left"
            },
            {
            "value": "center",
            "label": "Center"
            },
            {
            "value": "right",
            "label": "Right"
            }
          ]
        },
      {
      "type": "header",
      "content": "Row height",
      "info": "Define the height of a single row, from which the grid is dynamically created."
    },
    {
      "type": "range",
      "id": "desktop_row_height",
      "label": "Desktop row height",
      "min": 150,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 290
    },
    {
      "type": "range",
      "id": "tablet_row_height",
      "label": "Tablet row height",
      "min": 150,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 290
    },  
    {
      "type": "range",
      "id": "mobile_row_height",
      "label": "Mobile row height",
      "min": 120,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 150
    },
      {
        "type": "header",
        "content": "== Setting"
      },
      {	
        "type": "range",
        "id": "column",
        "label": "Column",
        "min": 1,
        "max": 12,
        "step": 1,
        "unit": "col",
        "default": 4
        },
      {	
        "type": "range",
        "id": "gap",
        "label": "Gap",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "default": 5
        },
      {	
        "type": "range",
        "id": "border",
        "label": "Border radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "default": 5
        },
      {
    "type": "checkbox",
    "id": "layout",
    "label": "Full width",
    "default": false
    },
    {
        "type": "range",  
        "id": "container",  
        "label": "Container width",
        "min": 1170,
        "max": 1920,
        "step": 10,
        "unit": "px",
        "default": 1410 
    },
      
      {
      "type": "color",
      "id": "cl_bg",
      "label": "Background color",
      "default": "#fff"
      },
      {
        "type": "color",
        "id": "cl_bg_content",
        "default":"rgba(0,0,0,0)",
        "label": "Background color (content)",
        "info": "If not used you can leave blank"
      },  
      {
        "type": "text",
        "id": "mg",
        "label": "Margin",
        "info":"Margin top, margin right, margin bottom, margin left. If you not use to blank"
      },
      {
        "type": "text",
        "id": "pd",
        "label": "Padding",
        "info":"Padding top, padding right, padding bottom, padding left. If you not use to blank"
      },
     {
        "type": "header",
        "content": "== Design Mobile Options"
      },
      {
        "type": "text",
        "id": "mg_mb",
        "label": "Margin"
      },
      {
        "type": "text",
        "id": "pd_mb",
        "label": "Padding"
      }
    ],
	"blocks": [
	{
    "type": "banner_img",
    "name": "Banner images",
    "settings": [
        {
        "type": "checkbox",
        "id": "hide_image",
        "label": "Hide image (Default)",
        "default": false
        },
        {
        "type": "image_picker",
        "id": "image_sl",
        "label": "Image"
        },
        {
          "type": "header",
          "content": "Desktop",
          "info": "When using a 1x1 tile, we recommend not using text on top of media."
        },
        {
          "type": "range",
          "id": "media-grid-column-span",
          "label": "Column",
          "min": 1,
          "max": 6,
          "default": 2
        },
        {
          "type": "range",
          "id": "media-grid-row-span",
          "label": "Row",
          "min": 1,
          "max": 3,
          "default": 2
        },
        {
        "type": "url",
        "id": "link_img",
        "label": "Link image",
        "info": "The image becomes clickable."
        },
        {
        "type": "select",
        "id": "open_link",
        "options": [
        {
        "value": "_self",
        "label": "Current window (_self)"
        },
        {
        "value": "_blank",
        "label": "New window (_blank)"
        }
        ],
        "label": "Open link in",
        "default": "_blank"
        },
        {
        "type": "checkbox",
        "id": "hidden_content",
        "label": "Hidden Content ?",
        "default": false
        },
        {
          "type": "range",
          "id": "w_content",
          "label": "Width content",
          "min": 20,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",  
          "id": "pd_content",  
          "label": "Padding content",
          "min": 0,
          "max": 10,
          "step": 0.5,
          "unit": "%",
          "default": 5 
        },  
        {
         "type": "color",
         "id": "bg_color",
         "label": "Background color",
         "default": "rgba(0,0,0,0)"
       },
        {
        "type": "select",
        "id": "h_position",
        "label": "Horizontal Position",
        "default": "left",
        "options": [
            {
            "value": "left",
            "label": "Left"
            },
            {
            "value": "center",
            "label": "Center"
            },
            {
            "value": "right",
            "label": "Right"
            }
          ]
        },
        {
        "type": "select",
        "id": "v_position",
        "label": "Vertical Position",
        "default": "top",
        "options": [
            {
            "value": "top",
            "label": "Top"
            },
            {
            "value": "middle",
            "label": "Middle"
            },
            {
            "value": "bottom",
            "label": "Bottom"
            }
          ]
        },
		{
            "type": "select",
            "id": "txt_align",
            "label": "Text Align",
            "default": "left",
            "options": [
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "center",
                "label": "Center"
              },
              {
                "value": "right",
                "label": "Right"
              }
            ]
          }
      ]
    },
	{
      "type": "hd",
      "name": "Heading",
      "settings": [
          {
          "type": "checkbox",
          "id": "hide",
          "label": "Hidden ?",
          "default": false
          },
          {
            "type": "textarea",
            "id": "title",
            "label": "Heading",
            "default": "Your main title",
			"info":"Insert <br> to line break"
          },         
          {
            "type": "color",
            "id": "color",
            "label": "Color Text",
            "default": "#111"
          },
          {
            "type": "color",
            "id": "cl_underline",
            "label": "Color underline",
            "default": "rgba(0,0,0,0)",
            "info":"If you do not want to use it, you can leave it blank."
          },  
          {
            "type": "range",
            "id": "fw_text",
            "min": 400,
            "max": 800,
            "step": 100,
            "label": "Font weight",
            "default": 600
          },
          {
            "type": "range",
            "id": "fs_text",
            "min": 14,
            "max": 100,
            "step": 1,
            "label": "Font size",
            "unit": "px",
            "default": 15
          },
          {
            "type": "range",
            "id": "lh_text",
            "min": 0,
            "max": 100,
            "step": 1,
            "label": "Line Height",
            "info": "set is '0' use to default",
            "unit": "px",
            "default": 0
          },
		  {
              "type": "text",
