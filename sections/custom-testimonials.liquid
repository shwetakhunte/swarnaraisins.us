<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />
<style>
  .custom-testimonials-section {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
    background-color: {{ section.settings.bg_color }};
  }
  .ct-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .ct-header {
    text-align: center;
    margin-bottom: 50px;
  }
  .ct-title {
    font-size: 36px;
    font-weight: 700;
    color: #1b5e20; /* Dark green */
    margin: 0;
  }
  
  .ct-card {
    background: #fff;
    padding: 30px 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
  }
  
  .ct-avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    border: 5px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    overflow: hidden;
  }
  .ct-avatar.theme-purple {
    border-color: #6a0dad;
  }
  .ct-avatar.theme-green {
    border-color: #00b300;
  }
  .ct-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ct-avatar svg {
    width: 60%;
    height: 60%;
  }
  .ct-avatar.theme-purple svg { fill: #6a0dad; }
  .ct-avatar.theme-green svg { fill: #00b300; }
  
  .ct-content {
    font-size: 15px;
    color: #555;
    line-height: 1.6;
    margin-bottom: 20px;
    flex-grow: 1;
  }
  
  .ct-stars {
    color: #ffb300; /* Gold */
    font-size: 18px;
    margin-bottom: 15px;
  }
  
  .ct-author {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 5px;
  }
  .theme-purple .ct-author { color: #8bc34a; /* Light green name */ }
  .theme-green .ct-author { color: #8bc34a; }
  
  .ct-location {
    font-size: 14px;
    color: #888;
  }

  .custom-testimonial-swiper {
    padding-bottom: 50px !important;
  }
  .swiper-pagination-bullet {
    background: #ccc;
    opacity: 1;
  }
  .swiper-pagination-bullet-active {
    background: #00b300;
  }

  @media (max-width: 768px) {
    .ct-title {
      font-size: 28px;
    }
  }
</style>

<div class="custom-testimonials-section">
  <div class="ct-container">
    <div class="ct-header">
      <h2 class="ct-title">{{ section.settings.title }}</h2>
    </div>
    
    <div class="swiper custom-testimonial-swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="ct-card theme-{{ block.settings.theme }}">
              <div class="ct-avatar theme-{{ block.settings.theme }}">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | img_url: '150x' }}" alt="{{ block.settings.author | escape }}">
                {% else %}
                  <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                {% endif %}
              </div>
              
              <div class="ct-content">
                {{ block.settings.content }}
              </div>
              
              <div class="ct-stars">
                {% for i in (1..block.settings.rating) %}★{% endfor %}
              </div>
              
              <div class="ct-author">{{ block.settings.author }}</div>
              <div class="ct-location">{{ block.settings.location }}</div>
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination"></div>
    </div>
  </div>
</div>

<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    new Swiper('.custom-testimonial-swiper', {
      slidesPerView: 1,
      spaceBetween: 30,
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      breakpoints: {
        640: {
          slidesPerView: 1,
        },
        768: {
          slidesPerView: 2,
        },
        1024: {
          slidesPerView: 3,
        },
      }
    });
  });
</script>

{% schema %}
{
  "name": "Custom Testimonials",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Real people, real stories"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "select",
          "id": "theme",
          "label": "Color Theme",
          "options": [
            { "value": "purple", "label": "Purple" },
            { "value": "green", "label": "Green" }
          ],
          "default": "purple"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Avatar Image (Optional)"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Review Text",
          "default": "Excellent Product and Packaging Quality. The quality is exceptional!"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating (Stars)",
          "default": 5
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Prajakta Mangave"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Pune, India"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Testimonials",
      "category": "Custom",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
