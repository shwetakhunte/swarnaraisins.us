{%- if section.settings.hide_tabs %}{% break %}{% endif -%}
{% assign sid = section.id %}
{% assign index = 0 %}

<style>
/* Custom styling for the product page tabs and accordion */
#laber_{{sid}} {
  margin-top: 40px;
  margin-bottom: 60px;
  background-color: #ffffff;
  border-radius: 12px;
  border: 1px solid #e8ede9;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
}

/* Nav bar styles (desktop) */
#laber_{{sid}} .tab-nav {
  display: flex;
  justify-content: center;
  gap: 0;
  border-bottom: 1px solid #e8ede9;
  padding: 0;
  margin: 0;
  background: #fcfdfc;
  list-style: none;
}

#laber_{{sid}} .tab-nav li {
  margin: 0;
  padding: 0;
  position: relative;
  flex: 1;
  text-align: center;
}

#laber_{{sid}} .tab-nav li a {
  display: block;
  font-family: 'Montserrat', sans-serif;
  font-weight: 700;
  font-size: 15px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #555555;
  padding: 18px 15px;
  text-decoration: none;
  border-bottom: 3px solid transparent;
  transition: all 0.3s ease;
  opacity: 0.65;
}

#laber_{{sid}} .tab-nav li.active a {
  color: #2e7d32;
  border-bottom-color: #2e7d32;
  opacity: 1;
  background-color: #ffffff;
}

#laber_{{sid}} .tab-nav li a:hover {
  color: #2e7d32;
  opacity: 1;
}

#laber_{{sid}} .tab-panel h3.heading-title {
  display: none !important; /* Always hide accordion titles on desktop */
}

/* Content Area */
#laber_{{sid}} .tab-content {
  padding: 40px;
  background-color: #ffffff;
}

#laber_{{sid}} .tab-panel {
  display: none;
}

#laber_{{sid}} .tab-panel.active {
  display: block;
}

#laber_{{sid}} .tab-content.description {
  font-size: 15px;
  line-height: 1.6;
  color: #333333;
}

#laber_{{sid}} .tab-content.description p {
  margin-bottom: 15px;
}

#laber_{{sid}} .tab-content.description ul,
#laber_{{sid}} .tab-content.description ol {
  padding-left: 20px;
  margin-bottom: 15px;
}

/* Mobile Accordion Styles */
@media (max-width: 767px) {
  #laber_{{sid}} {
    border: none;
    box-shadow: none;
    background: transparent;
    margin-top: 20px;
    margin-bottom: 30px;
  }
  
  #laber_{{sid}} .tab-nav {
    display: none !important; /* Hide horizontal nav on mobile */
  }
  
  #laber_{{sid}} .tab-content {
    padding: 0;
    background: transparent;
  }
  
  #laber_{{sid}} .tab-panel {
    display: block !important;
    background: #ffffff;
    border: 1px solid #e8ede9;
    border-radius: 8px;
    margin-bottom: 10px;
    overflow: hidden;
    transition: all 0.3s ease;
  }
  
  #laber_{{sid}} .tab-panel.active {
    border-color: #c8e6c9;
    box-shadow: 0 2px 10px rgba(46, 125, 50, 0.04);
  }

  /* Accordion Headers on Mobile */
  #laber_{{sid}} .tab-panel h3.heading-title {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #1b1b1b;
    padding: 15px 20px;
    margin: 0;
    background: #fafafa;
    cursor: pointer;
    border-bottom: 1px solid transparent;
    transition: all 0.3s ease;
  }

  #laber_{{sid}} .tab-panel.active h3.heading-title {
    color: #2e7d32;
    background: #f4f9f4;
    border-bottom: 1px solid #e8ede9;
  }

  /* Custom Plus/Minus Toggle Icon */
  #laber_{{sid}} .tab-panel h3.heading-title i {
    position: relative;
    display: inline-block;
    width: 14px;
    height: 14px;
    font-size: 0 !important; /* Hide font icon content */
    color: inherit;
  }

  #laber_{{sid}} .tab-panel h3.heading-title i::before,
  #laber_{{sid}} .tab-panel h3.heading-title i::after {
    content: '';
    position: absolute;
    background-color: currentColor;
    transition: all 0.25s ease;
  }

  /* Horizontal line */
  #laber_{{sid}} .tab-panel h3.heading-title i::before {
    width: 12px;
    height: 2px;
    left: 1px;
    top: 6px;
  }

  /* Vertical line */
  #laber_{{sid}} .tab-panel h3.heading-title i::after {
    width: 2px;
    height: 12px;
    left: 6px;
    top: 1px;
  }

  #laber_{{sid}} .tab-panel.active h3.heading-title i::after {
    transform: scaleY(0); /* Make it a minus sign when active */
  }

  #laber_{{sid}} .tab-panel .description {
    display: none;
    padding: 20px;
    background: #ffffff;
  }

  #laber_{{sid}} .tab-panel.active .description {
    display: block !important;
  }
}
</style>

<section
  id="laber_{{sid}}"
  class="{% if section.settings.accordion_tabs %}accordion-tabs{% else %}tabs-product{% endif %}"
>
  <product-information id="tab_product" class="cms-tab">
    <ul class="tab-nav nav list-nav mb-30 sm:mb-20" style="--cl-text:{{ section.settings.cl_tab }};">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'tab_description' -%}
            {%- assign title_description = block.settings.title_description -%}
            <li class="tab {%if forloop.first %}active{% endif %}">
              <a class="tab-title h3" data-animated="fadeIn" data-toggle="pill" href="#tab_des">
                {{- title_description -}}
              </a>
            </li>
          {%- when 'tab_custom_html' -%}
            {% assign index = index | plus: 1 %}
            <li class="tab {%if forloop.first %}active{% endif %}">
              <a class="tab-title h3" data-animated="fadeIn" data-toggle="pill" href="#tab{{index}}">
                {{- block.settings.title -}}
              </a>
            </li>
          {%- when 'tab_custom_text' -%}
            {% assign index = index | plus: 1 %}
            <li class="tab {%if forloop.first %}active{% endif %}">
              <a class="tab-title h3" data-animated="fadeIn" data-toggle="pill" href="#tab{{index}}">
                {{- block.settings.title -}}
              </a>
            </li>
          {%- when 'tab_reviews' -%}
            {%- assign title_reviews = block.settings.title_reviews %}
            <li class="tab {%if forloop.first %}active{% endif %}">
              <a class="tab-title h3" data-animated="rotateInDownLeft" data-toggle="pill" href="#tab_review">
                {{- title_reviews -}}
              </a>
            </li>
          {%- when 'show_variants' -%}
            {% if product.has_only_default_variant %}{% continue %}{% endif -%}
            <li class="tab {%if forloop.first %}active{% endif %}">
              <a class="tab-title h3" data-animated="rotateInDownLeft" data-toggle="pill" href="#tab_variants">
                {{- block.settings.title -}}
              </a>
            </li>
          {%- when 'tab_metafields' -%}
            <li class="tab {%if forloop.first %}active{% endif %}">
              <a class="tab-title h3" data-animated="rotateInDownLeft" data-toggle="pill" href="#tab_metafields">
                {{- block.settings.title -}}
              </a>
            </li>
        {%- endcase -%}
      {%- endfor -%}
    </ul>

    <accordion-tab data-scroll-into-view="true" data-siblings-close="false" class="tab-content">
      {%- assign custom_tab_index = 1 -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'tab_description' -%}
            <div id="tab_des" class="tab-panel {%if forloop.first %}active{% endif %} ">
              <h3 class="tab-title heading-title d-none sm:d-block">
                <span>{{ block.settings.title_description }}</span> <i class="icon-plus"></i>
              </h3>
              <div class="tab-content description">
                {{ product.description }}
              </div>
            </div>
          {%- when 'tab_custom_html' -%}
            <div id="tab{{custom_tab_index}}" class="tab-panel {%if forloop.first %}active{% endif %}">
              <h3 class="tab-title heading-title d-none sm:d-block">
                <span>{{ block.settings.title }}</span> <i class="icon-plus"></i>
              </h3>
              <div class="tab-content description">
                {%- if block.type == 'tab_custom_html' %}
                  {%- if block.settings.page_content != blank -%}
                    {%- assign get_content = pages[block.settings.page_content].content -%}
                    {{ get_content }}
                  {% endif %}
                {% else %}
                  {{ block.settings.content }}
                {% endif %}
              </div>
            </div>
            {%- assign custom_tab_index = custom_tab_index | plus: 1 -%}

          {%- when 'tab_custom_text' -%}
            <div id="tab{{custom_tab_index}}" class="tab-panel {%if forloop.first %}active{% endif %}">
              <h3 class="tab-title heading-title d-none sm:d-block">
                <span>{{ block.settings.title }}</span> <i class="icon-plus"></i>
              </h3>
              <div class="tab-content description">
                {%- if block.type == 'tab_custom_html' %}
                  {%- if block.settings.page_content != blank -%}
                    {%- assign get_content = pages[block.settings.page_content].content -%}
                    {{ get_content }}
                  {% endif %}
                {% else %}
                  {{ block.settings.content }}
                {% endif %}
              </div>
            </div>
            {%- assign custom_tab_index = custom_tab_index | plus: 1 -%}

          {%- when 'tab_reviews' -%}
            {%- assign title_reviews = block.settings.title_reviews %}
            <div id="tab_review" class="tab-panel {%if forloop.first %}active{% endif %}">
              <h3 class="tab-title heading-title d-none sm:d-block">
                <span>{{ title_reviews }}</span> <i class="icon-plus"></i>
              </h3>
              <div class="tab-content custom-review description">
                <div class="row">
                  <!-- Start of Judge.me code -->
                  <div style="clear:both"></div>
                  <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">
                    {{- product.metafields.judgeme.widget -}}
                  </div>
                  <!-- End of Judge.me code -->
                </div>
              </div>
            </div>
          {%- when 'show_variants' -%}
            {% if product.has_only_default_variant %}{% continue %}{% endif -%}
            <div id="tab_variants" class="tab-panel {%if forloop.first %}active{% endif %}">
              <h3 class="tab-title heading-title d-none sm:d-block">
                <span>{{ block.settings.title }}</span> <i class="icon-plus"></i>
              </h3>
              <div class="tab-content sp-tab-content description">
                <table class="pr_attrs">
                  <tbody>
                    {%- for product_option in product.options_with_values -%}
                      <tr class="attr_pa_{{product_option.name | handle }}">
                        <th class="attr__label">{{ product_option.name }}</th>
                        <td class="attr__value">
                          {% for value in product_option.values -%}
                            {{- value -}}
                            {%- unless forloop.last == true %}, {% endunless -%}
                          {%- endfor %}
                        </td>
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
            </div>
          {%- when 'tab_metafields' -%}
            <div id="tab_metafields" class="tab-panel {%if forloop.first %}active{% endif %}">
              <h3 class="tab-title heading-title d-none sm:d-block">
                <span>{{ block.settings.title }}</span> <i class="icon-plus"></i>
              </h3>
              <div class="tab-content description">
                {{ block.settings.custom_liquid }}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </accordion-tab>
  </product-information>
  {% if section.settings.show_border %}
    <div class="sm:d-none pt-60">
      <div class="line alo-background-color" style="--bg-color:{{ section.settings.cl_line }};"></div>
    </div>
  {% endif %}
</section>
{%- render 'section_style' -%}
{% schema %}
 {
   "name": "Tab Product page",
"class": "tab_product_page",
   "settings": [
       {
         "type": "checkbox",
         "id": "hide_tabs",
         "label": "Hide tabs",
         "default": false
       },
	{
       "type": "checkbox",
       "id": "accordion_tabs",
       "label": "accordion tabs",
       "default": false
     },
	{
       "type": "header",
       "content": "== Design Options"
     },
     {
       "type": "color",
       "id": "cl_bg",
       "label": "Background color",
       "default": "#fff"
     },
     {
       "type": "color",
       "id": "cl_tab",
       "label": "Color tab",
       "default": "#000"
     },
     {
       "type": "checkbox",
       "id": "show_border",
       "label": "Show Border",
       "default": false
     },
    {
       "type": "color",
       "id": "cl_line",
       "label": "Color line",
       "default": "#fff"
     },
  {
       "type": "header",
       "content": "== Margin",
	"info":"Margin top, margin bottom. If you not use to blank"
     },
     {
       "type": "text",
       "id": "mg",
       "label": "Margin",
       "info":"Margin top, margin right, margin bottom, margin left. If you not use to blank"
     },
     {
       "type": "text",
       "id": "pd",
       "label": "Padding",
       "info":"Padding top, padding right, padding bottom, padding left. If you not use to blank"
     },

    {
       "type": "header",
       "content": "== Design Mobile Options"
     },
     {
       "type": "text",
       "id": "mg_mb",
       "label": "Margin"
     },
     {
       "type": "text",
       "id": "pd_mb",
       "label": "Padding"
     }

     ],
     "blocks": [
	{
         "type": "tab_description",
         "name": "Description",
	  "limit": 1,
         "settings": [
           {
             "type": "text",
             "id": "title_description",
             "label": "Title",
             "default": "Description"
           }
         ]
       },
	{
         "type": "show_variants",
         "name": "Additional Information",
	  "limit": 1,
         "settings": [
           {
             "type": "text",
             "id": "title",
             "label": "Title",
             "default": "Additional Information"
           }
         ]
       },
       {
         "type": "tab_custom_html",
         "name": "Custom HTML tab",
         "settings": [
           {
             "type": "text",
             "id": "title",
             "label": "Title",
             "default": "Custom HTML"
           },
           {
             "type": "page",
             "id": "page_content",
             "label": "Page content",
             "info": "Default page: 'Include Product Tab Custom HTML'"
           }
         ]
       },
       {
         "type": "tab_custom_text",
         "name": "Custom text tab",
         "settings": [
           {
             "type": "text",
             "id": "title",
             "label": "Title",
             "default": "Custom text"
           },
           {
             "type": "richtext",
             "id": "content",
             "label": "HTML content",
             "default": "<p>Text content of Tab goes here!</p><p>You can make&nbsp;text <strong>bold</strong>, <em>italic</em> or add <a href=\"\/blogs\/news\" title=\"News\">link</a> using rich text editor.</p><p></p>"
           }
         ]
       },
	{
         "type": "tab_reviews",
         "name": "Reviews",
	  "limit": 1,
         "settings": [
           {
             "type": "paragraph",
             "content": "You have to install Judge.me Product Reviews app. At our demo, we use a free [Product Reviews](https:\\/\\/apps.shopify.com\/judgeme) app"
           },
           {
             "type": "text",
             "id": "title_reviews",
             "label": "Title",
             "default": "Reviews"
           }
         ]
       },
	{
         "type": "tab_metafields",
         "name": "Metafields tabs",
	  "limit": 1,
         "settings": [
           {
             "type": "text",
             "id": "title",
             "label": "Title",
             "default": "Additional Information"
           },
           {
             "type": "liquid",
             "id": "custom_liquid",
             "label": "t:sections.main-product.blocks.custom_liquid.settings.custom_liquid.label",
             "info": "t:sections.main-product.blocks.custom_liquid.settings.custom_liquid.info",
             "default":"{{product.metafields.custom.additional_information}}"
           }
         ]
       }

     ],
  "default": {
       "blocks": [
           { "type": "tab_description" },
           { "type": "tab_custom_html" },
           { "type": "tab_custom_text" },
           { "type": "tab_reviews" }
       ]
     }

 }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
