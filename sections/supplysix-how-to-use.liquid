{% comment %} Swarna Raisins — How to Enjoy / Daily Ritual Section {% endcomment %}

<style>
.sr-htu-section {
  padding: 72px 24px;
  background: linear-gradient(135deg, #1b5e20 0%, #2e7d32 50%, #388e3c 100%);
  font-family: 'Poppins', sans-serif;
  position: relative;
  overflow: hidden;
}
.sr-htu-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.05) 0%, transparent 50%),
                    radial-gradient(circle at 80% 20%, rgba(255,255,255,0.04) 0%, transparent 40%);
  pointer-events: none;
}
.sr-htu-inner {
  max-width: 1100px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}
.sr-htu-eyebrow {
  display: block;
  text-align: center;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.7);
  margin-bottom: 10px;
}
.sr-htu-heading {
  text-align: center;
  font-size: clamp(26px, 4vw, 40px);
  font-weight: 800;
  color: #ffffff;
  margin: 0 0 12px;
  line-height: 1.2;
}
.sr-htu-sub {
  text-align: center;
  font-size: 15px;
  color: rgba(255,255,255,0.8);
  max-width: 540px;
  margin: 0 auto 56px;
  line-height: 1.7;
}
/* Steps grid */
.sr-htu-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 32px;
  position: relative;
}
/* Connector line between steps */
@media (min-width: 768px) {
  .sr-htu-grid::before {
    content: '';
    position: absolute;
    top: 52px;
    left: calc(50% / 3);
    right: calc(50% / 3);
    height: 2px;
    background: rgba(255,255,255,0.2);
    z-index: 0;
    border-radius: 2px;
  }
}
.sr-htu-step {
  text-align: center;
  position: relative;
  z-index: 1;
}
.sr-htu-number-wrap {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  margin: 0 auto 24px;
  background: rgba(255,255,255,0.12);
  border: 2px solid rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s ease, background 0.3s ease;
  backdrop-filter: blur(4px);
}
.sr-htu-step:hover .sr-htu-number-wrap {
  transform: scale(1.08);
  background: rgba(255,255,255,0.2);
}
.sr-htu-number-wrap img {
  width: 56px;
  height: 56px;
  object-fit: contain;
}
.sr-htu-step-num {
  font-size: 36px;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
}
.sr-htu-step-icon {
  font-size: 36px;
  line-height: 1;
}
.sr-htu-title {
  font-size: 18px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 10px;
}
.sr-htu-desc {
  font-size: 14px;
  color: rgba(255,255,255,0.8);
  line-height: 1.65;
  margin: 0;
  max-width: 220px;
  margin-left: auto;
  margin-right: auto;
}
/* Bottom tip */
.sr-htu-tip {
  margin-top: 52px;
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 12px;
  padding: 20px 28px;
  display: flex;
  align-items: center;
  gap: 16px;
  max-width: 700px;
  margin-left: auto;
  margin-right: auto;
  flex-wrap: wrap;
  justify-content: center;
}
.sr-htu-tip-icon {
  font-size: 32px;
  flex-shrink: 0;
}
.sr-htu-tip-text {
  font-size: 14px;
  color: rgba(255,255,255,0.9);
  line-height: 1.6;
  text-align: left;
}
.sr-htu-tip-text strong {
  color: #ffffff;
  font-weight: 700;
}
@media (max-width: 600px) {
  .sr-htu-section { padding: 48px 16px; }
  .sr-htu-tip { text-align: center; }
  .sr-htu-tip-text { text-align: center; }
}
</style>

<section class="sr-htu-section">
  <div class="sr-htu-inner">
    <span class="sr-htu-eyebrow">{{ section.settings.eyebrow | default: '— Daily Ritual —' }}</span>
    <h2 class="sr-htu-heading">{{ section.settings.heading | default: 'How to Enjoy Swarna Raisins' }}</h2>
    <p class="sr-htu-sub">{{ section.settings.subheading | default: 'Simple, delicious ways to make Swarna Raisins a part of your daily wellness routine.' }}</p>

    <div class="sr-htu-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="sr-htu-step" {{ block.shopify_attributes }}>
            <div class="sr-htu-number-wrap">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | image_url: width: 120 }}" alt="{{ block.settings.title }}">
              {% else %}
                <span class="sr-htu-step-num">{{ forloop.index }}</span>
              {% endif %}
            </div>
            <h3 class="sr-htu-title">{{ block.settings.title }}</h3>
            <p class="sr-htu-desc">{{ block.settings.description }}</p>
          </div>
        {% endfor %}
      {% else %}
        {%- assign steps = "Soak Overnight|Soak a handful (20–30g) of Swarna Raisins in water before bedtime. Drink the water and eat the raisins first thing in the morning.|Snack On the Go|Toss a 40g snack pack into your bag, office desk or gym kit. A natural energy boost, no prep needed.|Add to Your Meals|Sprinkle Swarna Raisins on oatmeal, salads, rice dishes or desserts. Delicious and nutritious — every time." | split: "|" -%}
        {%- assign icons = "🌙|⚡|🍽️" | split: "|" -%}
        {% for i in (0..2) %}
          {%- assign t = steps[forloop.index0 | times: 2] -%}
          {%- assign d = steps[forloop.index0 | times: 2 | plus: 1] -%}
          {%- assign em = icons[forloop.index0] -%}
          <div class="sr-htu-step">
            <div class="sr-htu-number-wrap">
              <span class="sr-htu-step-icon">{{ em }}</span>
            </div>
            <h3 class="sr-htu-title">{{ t }}</h3>
            <p class="sr-htu-desc">{{ d }}</p>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <div class="sr-htu-tip">
      <span class="sr-htu-tip-icon">💡</span>
      <p class="sr-htu-tip-text">
        <strong>Ayurvedic Tip:</strong>
        {{ section.settings.tip | default: 'Soaking raisins overnight in copper vessel water and consuming them on an empty stomach is an ancient Ayurvedic practice known to improve digestion, boost haemoglobin and enhance skin glow.' }}
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Swarna How To Enjoy",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Label", "default": "— Daily Ritual —" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to Enjoy Swarna Raisins" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Simple, delicious ways to make Swarna Raisins a part of your daily wellness routine." },
    { "type": "textarea", "id": "tip", "label": "Ayurvedic Tip Text", "default": "Soaking raisins overnight in copper vessel water and consuming them on an empty stomach is an ancient Ayurvedic practice known to improve digestion, boost haemoglobin and enhance skin glow." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Usage Step",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Step Image / Icon" },
        { "type": "text", "id": "title", "label": "Step Title", "default": "Step Title" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Step description goes here." }
      ]
    }
  ],
  "presets": [
    { "name": "Swarna How To Enjoy" }
  ]
}
{% endschema %}
