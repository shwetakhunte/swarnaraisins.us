{% style %}
  :root {
  --bg-title-vmenu:{{ settings.cl_bg_vmenu }};
  --cl-title:{{settings.cl_h_vertical}};
  --w-vertical:{{section.settings.w_vertical}}px;
  --w-vertical-tab:{{section.settings.w_vertical_tab}}px;  
  --bg-vertical:{{section.settings.bg_vertical}};
  --cl-b-vertical:{{section.settings.cl_border}};  
  --cl-vertical:{{section.settings.cl_vertical}};  
  --cl-vertical-h:{{section.settings.cl_vertical_hover}};    
  }
{% endstyle %}
{% assign show_thumb_collection = section.settings.show_thumb_collection %}
{%- assign se_blocks = section.blocks -%} 
{%- assign admin_sp = request.design_mode -%}
{%- if template.suffix == "item_vegamenu" and template.name == 'search' -%}
	{%- render 'menu_import',section:section -%}	
{%- endif -%}
{% if show_thumb_collection != true %} {% assign show_thumb = 'hide-thub-col' %} {% endif %}
{%- if template.suffix == "vertical_menu" and template.name == 'search' -%}
	[v_menu]
	{%- for block in se_blocks -%}
		{%- case block.type -%}
			{%- when 'mega' -%}
				{%- assign cl_bg = block.settings.cl_bg -%}
				{%- assign img_bg = block.settings.img_bg -%}
				<li id="item_{{block.id}}" class="type_{{block.type}} {{ show_thumb }} menu_has_offsets verticalmenu-item verticalmenu-item-has-children {% if block.settings.pos_rel %}pos_rel{%endif%} {% if forloop.first == true %}first{%endif%}" {{ block.shopify_attributes }}>
                  <a class="cms-item-title " href="{{block.settings.url}}" target="{{block.settings.open_link}}"{% if block.settings.cus_cl %} style="color:{{block.settings.cl}}"{% endif %}>
                    {%- render 'title_menu',block:block, enable_icon:section.settings.enable_icon_menu -%}
                    <i class="icon_right icon-chevron-right"></i>
                  </a>
                  <div class="subverticalmenu vertical-menu vertical-menu1" 
                       style="{% if  block.settings.wid == 'cus' %} width:{{block.settings.cus_wid}}px;{% endif %}
                              {%if cl_bg!=blank %}background-color:{{cl_bg}};{%endif%}
                              {%if img_bg!=blank %}
                              	{%- assign img_url = img_bg | image_url: width: 550 -%}
                              	background-image:url({{ img_url }});
                              {%endif%} "
                       >
                    <div class="{{block.settings.wid}}">
                      <div id="bk_{{block.id}}" class="row lazy_menu_mega" >
                         {% render 'menu-mega' ,section_blocks:section.blocks ,block_id:block.id  %}
                       </div>
                    </div>
                  </div>
				</li>
            {%- when 'dropdown' -%}
              <li id="item_{{block.id}}" class="type_{{block.type}} {{ show_thumb }} menu_has_offsets verticalmenu-item {% if linklists[block.settings.menu].links.size > 0 %}  verticalmenu-item-has-children {% endif %} {% if forloop.first == true %}first{%endif%}"  {{ block.shopify_attributes }}>
                <a class="cms-item-title " href="{{block.settings.url}}" target="{{block.settings.open_link}}"{% if block.settings.cus_cl %} style="color:{{block.settings.cl}}"{% endif %}>
                  {% render 'title_menu',block:block, enable_icon:section.settings.enable_icon_menu %}
                  {% if linklists[block.settings.menu].links.size > 0 %}  <i class="icon_right icon-chevron-right"></i> {% endif %}
                </a>
                {%- if linklists[block.settings.menu].links.size > 0 %}                      
                <div class="subverticalmenu" >
                  <div id="bk_{{block.id}}" class="dropdown type_link">
                      {% render 'menu-dropdown' ,linklists:linklists[block.settings.menu].links  %}
                  </div> 
                </div>
                {% endif %}
              </li>                
            {%- when 'simple' -%}
              {% if block.settings.url != blank %}
                <li id="item_{{block.id}}" class="verticalmenu-item {{ show_thumb }} type_simple {% if forloop.first == true %}first{%endif%}" {{ block.shopify_attributes }} >
                  <a class="cms-item-title" href="{{block.settings.url}}" target="{{block.settings.open_link}}"{% if block.settings.cus_cl %} style="color:{{block.settings.cl}}"{% endif %}>
                    {%- render 'title_menu',block:block, enable_icon:section.settings.enable_icon_menu -%}
                  </a>
                </li>
              {% endif %}	
		{% endcase%}
	{%- endfor -%}

	{% if section.settings.show_title %}
    {% assign show_style= section.settings.show_style | plus: 0 %}
		<li class="js-all-cat" data-numb ="{{ section.settings.item_numb }}" data-style="{% if show_style == 1%}nextcats{%else%}allcat{%endif%}"><a href="javascript:void(0)">
          	<span class="show-all"><i class="las la-plus"></i> {{ section.settings.item_title }}</span>
          	<span class="show-less"><i class="las la-minus"></i> {{ section.settings.close_title }}</span>
          </a></li>	
    {%endif%}
	[v_menu]
{%- endif -%}
{%- if admin_sp -%}
  {% # theme-check-disable %}
      {%- assign arr_sub = 'link,link2,banner,html,pr,cat' -%}
      {%- for block in se_blocks %}
      	<div {% if arr_sub contains block.type %}{% assign id_data = block.id %} {{ block.shopify_attributes }}{% else %}{% assign id_data2 = block.id %}{% endif %}id="bkjs_{{id_data}}" data-id='{{id_data2}}'></div>{% endfor -%}
  {% # theme-check-enable %}
{%- endif -%}

