/* 1. Slideshow background image overrides & Full-Width Breakout */
section.slideshow {
  width: 100vw !important;
  max-width: 100vw !important;
  position: relative !important;
  left: 50% !important;
  right: 50% !important;
  margin-left: -50vw !important;
  margin-right: -50vw !important;
  padding: 0 !important;
}

section.slideshow [data-wrapper-slidershow] {
  width: 100vw !important;
  max-width: 100vw !important;
  padding: 0 !important;
  margin: 0 !important;
}

section.slideshow .wrapper-slidershow,
section.slideshow grid-slider,
section.slideshow .swiper,
section.slideshow .swiper-wrapper,
section.slideshow .swiper-slide {
  width: 100% !important;
  max-width: 100% !important;
}

.swiper-slide .image-slideshow img,
.swiper-slide .image-card__img svg {
  display: none !important;
  opacity: 0 !important;
}

.swiper-slide .image-slideshow,
.swiper-slide .image-card__img {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  min-height: 620px !important;
  /* Increased desktop height to prevent cropping of the square image banners */
  background-size: cover !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
}

