                          <div class="sub-email mb-10">
                            {{block.settings.sub_title}}
                          </div>
                          {% endif %}
                          
                          <div class="textwidget" style="--alo-border-radius:{{ block.settings.border }}px;--color-btn:{{ block.settings.cl_btn }};--alo-border-color:{{ block.settings.cl_border }};">
