                              	{% render 'newsletter-form'  %} 						
                            </div>
                          </div>
                          {% if block.settings.sub_title2 %}
                          <div class="sub-email2 pt-10">
                            {{block.settings.sub_title2}}
                          </div>
                          {% endif %}
                          {%if block.settings.use_social%}
                            {% render 'social_link' class:'top' %}
                          {% endif %}
                        </div>
                    </aside>
                  </div>
                    {% style %}
