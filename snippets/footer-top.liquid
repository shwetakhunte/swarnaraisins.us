                              <img loading="lazy"  width="45px"   height="30px" class="img_tr_svg" 
                                src="{{ img | payment_type_img_url }}" 
                                data-src="{{ img | payment_type_img_url }}" 
                                alt="{{img | replace:'_',' '}}" />
                          {% # theme-check-enable %}
                        {%- endfor -%}
                        </div>
                      <style>
                           .payment_type_svg{display: flex;flex-wrap: wrap;gap: 5px;} 
                          .payment_type_svg img {border-radius: 3px;}
                      </style>
                      {%- endif -%}
                    </div>
                    </aside>  
                    </div>
                   {%- when 'payment_img_middle' -%}
                    <div class="footer-iteam {{ block_width }} sm:mb-{{ block.settings.sm_mg_b }} mb-{{ block.settings.mg_b }}" style="--alo-position:{{ block.settings.pos_block }};" {{ block.shopify_attributes }}>
                    <aside id="block_{{block.id}}" class="location-{{ block.settings.location }} mb-{{ block.settings.mb }}">
                      {{ heading | strip_newlines | remove:"  "}} 
                      <div class="payment_img_middle">
                            {% if block.settings.img_payment %}  
                              {% render 'responsive-image', image: block.settings.img_payment, image_class: 'w-auto h-full' %}
                            {%- endif -%}
                      </div> 
                    </aside>
                    </div>
                    {%- when 'Secured_by_middle' -%}
                    <div class="footer-iteam {{ block_width }} sm:mb-{{ block.settings.sm_mg_b }} mb-{{ block.settings.mg_b }}" style="--alo-position:{{ block.settings.pos_block }};" {{ block.shopify_attributes }}>
                    <aside id="block_{{block.id}}" class="location-{{ block.settings.location }} mb-{{ block.settings.mb }}">
                      {{ heading | strip_newlines | remove:"  "}} 
                      <div class="secured_by_middle">
                            {% if block.settings.img_secured_by %}  
                              <a target="_blank" href="{{ block.settings.url | default:'#' }}" >
                                {{ block.settings.img_secured_by | image_url: width: 85 | image_tag: width: nil }}
                              </a>  
                            {%- endif -%}
                            {% if block.settings.img_secured_by2 %}  
                              <a target="_blank" href="{{ block.settings.url2 | default:'#' }}" >
                                {{ block.settings.img_secured_by2 | image_url: width: 85 | image_tag: width: nil }}
                              </a>  
                            {%- endif -%}
                      </div> 
                    </aside>
