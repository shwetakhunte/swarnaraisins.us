                                         <p>
                                             {%- if block.settings.text1 -%}<span class="text" style="color:{{ block.settings.cl_text }}">{{ block.settings.text1 }} </span>{%endif%}
                                     		 <a class="phone" href="tel:{{shop.phone}}" style="color:{{ block.settings.cl_phone }}">{{shop.phone}}</a>
                                         </p>
                                     </div>
                                   {%endif%}
                                  
                                   
                                   {%- if block.settings.show_email -%}
                                 		<a href="mailto:{{shop.email}}" style="color:{{ block.settings.cl_text }}" target="_blank">{{shop.email}}</a>
                                   {%endif%}
                               </div>	
                          	 </div>
                          </aside>
						</div>
                   {%- when 'logo-footer' -%}
                      <div class="footer-iteam footer-iteam-logo {{ block_width }} sm:mb-{{ block.settings.sm_mg_b }} mb-{{ block.settings.mg_b }}" {{ block.shopify_attributes }}>
                      <aside id="block_{{block.id}}" class="widget widget_text alo-logo-footer location-{{ block.settings.location }}" style="--cl-text:{{block.settings.text_color}};">
                      
                    {% if block.settings.use_logo_footer %}
                      <div class="logo-footer mb-30 sm:mb-15">
                            {% assign logo_footer = block.settings.logo_footer | default: settings.logo %}
                            {%- assign logo_alt = logo_footer.alt | default: shop.name | escape -%}
                            {% if logo_footer != blank %}
                              <a href="{{ routes.root_url }}" class="site-header__logo-image" aria-label="{{ logo_alt }}">
                                  {%- assign logo_height = block.settings.logo_max_width | divided_by: block.settings.logo.aspect_ratio -%}
                                  {% capture sizes %}(max-width: {{ block.settings.logo_max_width | times: 2 }}px) 50vw, {{ block.settings.logo_max_width }}px{% endcapture %}
                                  {% capture widths %}{{ block.settings.logo_max_width }}, {{ block.settings.logo_max_width | times: 1.5 | round }}, {{ block.settings.logo_max_width | times: 2 }}{% endcapture %}
                                        {{ logo_footer | image_url: width: 600 | image_tag:
                                          class: 'header__heading-logo motion-reduce',
                                          widths: widths,
                                          height: logo_height,
                                          width: block.settings.logo_max_width,
                                          alt: logo_alt,
                                          sizes: sizes,
                                          preload: true
                                        }}
                                </a>
                        {% else %}
                          <a class="site-title" href="{{ routes.root_url }}" itemprop="url"><span class="logo-default">{{ settings.logo_text  }}</span></a>
                        {% endif %}
                     </div>
                    {% endif %}  
                    {%- if block.settings.d_phone -%}
                      <div class="phone-footer mb-25 sm:mb-15">
                       {% if block.settings.html_svg !=blank %} 
                         <div class="icon-svg">
                           {{ block.settings.html_svg }} 
                        </div>
                       {% endif %}
                       <div class="phone">
                         {% if block.settings.title_phone !=blank %} <p style="--cl-text:{{ block.settings.cl_title_phone }};">{{ block.settings.title_phone }}</p>{% endif %}
                         <a style="--cl-text:{{ block.settings.text_color }};" href="tel:{{ shop.phone }}" title="tel:{{ shop.phone }}" bis_skin_checked="1">{{ shop.phone }}</a>
                       </div> 
                      </div>
                        
                    {% endif %}
                    {%- if block.settings.content -%}
                          <div class="content" style="--cl-text:{{ block.settings.text_color }};">{{block.settings.content}}</div>
                     {%endif%}    
                    {%if block.settings.use_social%}
                      {% render 'social_link' class:'top' %}
                    {% endif %}
                    </aside>
                    </div>
                  {%- when 'html' -%}
                    
                          <div class="footer-iteam {{ block_width }} sm:mb-{{ block.settings.sm_mg_b }} mb-{{ block.settings.mg_b }}" {{ block.shopify_attributes }}>
                            <aside id="block_{{block.id}}" class="widget widget_text location-{{ block.settings.location }}">
                             {{ heading | strip_newlines | remove:"  "}}
                             <div class="textwidget widget_footer">
                               {%- if block.settings.content != blank-%}
                               <div class="contentHtml mb-20 alo-color" style="--alo-color:{{ block.settings.cl_content }};">
                               		{{block.settings.content}}
                               </div>
                               {%endif%}
                               <div class="ao-img mb-30" style="--alo-width:{{ block.settings.width_img }}px;"> 
                                {% if block.settings.img %}  
                                  {% render 'responsive-image', image: block.settings.img, image_class: 'w-auto h-full' %}
                                {%- endif -%}
                              </div>
                               {%if block.settings.use_social%}
                                  {% render 'social_link' %}
                               {% endif %}
                              </div>
                          </aside>
						</div>
                    {%- when 'social_network' -%}
                          <div class="footer-iteam {{ block_width }} sm:mb-{{ block.settings.sm_mg_b }} mb-{{ block.settings.mg_b }}" {{ block.shopify_attributes }}>
                            <aside id="block_{{block.id}}" class="widget widget_text location-{{ block.settings.location }}">
                             {{ heading | strip_newlines | remove:"  "}}
                             <div class="textwidget widget_footer">
                               {%- if block.settings.content != blank-%}
                               <div class="contentHtml mb-20 alo-color" style="--alo-color:{{ block.settings.cl_content }};">
                               		{{block.settings.content}}
                               </div>
                               {%endif%}
                               {%if block.settings.use_social%}
                                  {% render 'social_link' %}
                               {% endif %}
                              </div>
                          </aside>
						</div>
                       {%- when 'image' -%}
                          <div class="footer-iteam {{ block_width }} sm:mb-{{ block.settings.sm_mg_b }} mb-{{ block.settings.mg_b }}" {{ block.shopify_attributes }}>
                            <aside id="block_{{block.id}}" class="widget widget_text location-{{ block.settings.location }}">
                             {{ heading | strip_newlines | remove:"  "}}
                             <div class="textwidget widget_footer">
                                    <div class="image-footer">
                                    {%- assign image = block.settings.image %}
                                    {% assign url = block.settings.url -%}
                                    {%- if image != blank -%}
                                        {% render 'responsive-image', image: image, aspect_ratio:aspect_ratio, image_class: 'w-full h-full' url:url %}
                                    {%- else -%}
                                          {% if aspect_ratio != blank %}
                                             {%- assign ratio =  1 | divided_by: aspect_ratio | times: 100 -%}
                                          {% else %}
                                              {%- assign ratio = 100 -%}
                                          {% endif %}
                                          <div class="image-card__img overflow-hidden alo-border-radius ratio" style="--alo-border-radius:{{ border }}px;--ratio-percent: {{ ratio }}%;">
                                            {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                                            {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                                          </div>
                                    {%- endif -%}
                                    </div>
                              </div>
                          </aside>
						</div>
                      {%- when 'instagram' -%}
                          <div class="footer-iteam {{ block_width }} sm:mb-{{ block.settings.sm_mg_b }} mb-{{ block.settings.mg_b }}" {{ block.shopify_attributes }}>
                            <aside id="block_{{block.id}}" class="widget widget_text location-{{ block.settings.location }}">
                             {{ heading | strip_newlines | remove:"  "}}
                             <div class="textwidget widget_footer">
                                    <div class="instagram-footer row">
                                      {% render 'instagram_footer', block: block.settings%}
                                    </div>
                              </div>
                          </aside>
						</div>
                    {%- when 'menu' -%}
                          <div class="footer-iteam {{ block_width }} sm:mb-{{ block.settings.sm_mg_b }} mb-{{ block.settings.mg_b }}" {{ block.shopify_attributes }}>
                            <aside id="block_{{block.id}}" class="widget widget_nav_menu location-{{ block.settings.location }}">
                             {{ heading | strip_newlines | remove:"  "}}
                             <div class="menu_footer widget_footer">
                              {%- assign menu = block.settings.menu -%}
                              {%- if menu != blank -%}
                                <ul class="menu" style="--cl-link:{{ block.settings.cl_link }};--cl-link-h:{{ block.settings.cl_link_hover }};">
                                  {%- for link in linklists[menu].links -%}
                                    {% assign image_col = link.object.image | default: link.object.products[0].featured_image  %}
                                   <li class="menu-item{% if link.active %}active{% endif %}">
                                     <a href="{{ link.url }}">
                                       {% if image_col != blank %}
                                          {% render 'image-category', image: image_col %}
                                        {% endif %}
                                       {{ link.title | split: '[' | first }}
                                     </a>
                                  	</li>
                                   {%- endfor -%}
                                </ul>
                                {%- else -%}
                                  <p>You have not selected the footer menu</p>
                                {%- endif -%}
                             </div>
                          </aside>
                            </div>
                  {%- when 'menu_middle' -%} 
                    <div class="footer-iteam {{ block_width }} sm:mb-{{ block.settings.sm_mg_b }} mb-{{ block.settings.mg_b }}" {{ block.shopify_attributes }}>
                        <aside id="block_{{block.id}}" class="widget_nav_menu location-{{ block.settings.location }} mb-{{ block.settings.mb }}">
                         {{ heading | strip_newlines | remove:"  "}}
                         <div class="menu_middle">
                          {%- assign menu = block.settings.menu -%}
                          {%- if menu != blank -%}
                            <ul class="menu">
                              {%- for link in linklists[menu].links -%}
                               <li class="menu-item{% if link.active %}active{% endif %}" style="--alo-color:{{ block.settings.cl_link }};--alo-color-hover:{{ block.settings.cl_link_hover }};">
                                 <a class="alo-color alo-color-hover" href="{{ link.url }}">{{ link.title | split: '[' | first }}
                                 </a>
                                </li>
                               {%- endfor -%}
                            </ul>
                            {%- else -%}
                              You have not selected the footer menu
                            {%- endif -%}
                         </div>
                        </aside>
                        </div>
                    {%- when 'payment_svg_middle' -%}
                    <div class="footer-iteam {{ block_width }} sm:mb-{{ block.settings.sm_mg_b }} mb-{{ block.settings.mg_b }}" style="--alo-position:{{ block.settings.pos_block }};" {{ block.shopify_attributes }}>
                    <aside id="block_{{block.id}}" class="location-{{ block.settings.location }} mb-{{ block.settings.mb }}">
                         {{ heading | strip_newlines | remove:"  "}} 
                    <div class="payment_middle">
                      {% if block.settings.svg_custom %}
                        <div class="payment_type_svg">
                        {%- assign svg_custom = block.settings.svg_custom | remove: ' ' | split:"," -%}
