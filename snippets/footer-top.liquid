                          --cl-btn-text:{{ block.settings.cl_btn_n }};
                          --cl-btn-text-h:{{ block.settings.cl_btn_n_h }};
                          --bg-b-btn:{{ block.settings.bg_btn_n }};
                          --bg-btn:{{ block.settings.bg_btn_n }};
                          --bg-btn-h:{{ block.settings.bg_btn_n_h }};
                          --cl-b-btn-h:{{ block.settings.bg_btn_n_h }};
                        }
                        
                      {% endstyle %}  
				  {%- when 'text' -%}
                          <div class="footer-iteam {{ block_width }} sm:mb-{{ block.settings.sm_mg_b }} mb-{{ block.settings.mg_b }}" {{ block.shopify_attributes }}>
                        <aside id="block_{{block.id}}" class="widget widget_text location-{{ block.settings.location }}">
                             {{ heading | strip_newlines | remove:"  "}}
                             <div class="textwidget widget_footer alo-color" style="--alo-color:{{ block.settings.cl_content }};">{{block.settings.content}}</div>
                            {% assign image = block.settings.image %}
                            {%- assign image_alt = image.alt | default: shop.name | escape -%}
                            {% if image != blank %}
                              <div class="img_text pt-10">
                                  {%- assign logo_height = block.settings.image_max_width | divided_by: block.settings.logo.aspect_ratio -%}
