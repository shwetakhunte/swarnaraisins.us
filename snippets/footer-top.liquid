                                          widths: widths,
                                          height: image_height,
                                          width: block.settings.img_max_width,
                                          alt: image_alt,
                                          sizes: sizes,
                                          preload: true
                                        }}
                              </div>
                          {% endif %}
                          </aside>
						</div>
