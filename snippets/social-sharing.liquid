{%comment%} /snippets/social-sharing.liquid {%endcomment%}
{% # theme-check-disable %}
{% assign _share_permalink = product.url |default:article.url | default:page.url %}
{% assign _share_permalink2 = shop.url | append:_share_permalink %}
{% assign permalink_url = share_permalink |default:_share_permalink2 %}
{% assign share_title = share_title |default:product.title |default:article.title |default:page.title |default:shop.name %}
{% assign perma_title = share_title | url_param_escape %}
{% assign share_image = share_image |default:product.featured_image |default:article.image |default:settings.share_image | default: page_image | default: settings.logo %}
{% assign perma_image = share_image | image_url: width: 1024 %}
{% # theme-check-enable %}
<div class="laber-social-sharing socials clearfix">
  <label>{{ 'general.social.title' | t }}</label>
  <ul>
    {% if settings.share_linkedin %}
    <li class="linkedin">
      <a data-no-instant rel="noopener noreferrer nofollow " title="{{ 'general.social.share_on_linkedin' | t }}" href="//linkedin.com/sharing/share-offsite/?url={{ permalink_url }}" target="_blank" class="linkedin alo_tooltip {{ class }}">
        <span class="alo_tooltip-content">{{ 'general.social.share_on_linkedin' | t }}</span>
        {%- render 'icon-linkedin-in' -%}
      </a>
    </li>
    {% endif %}
    {% if settings.share_facebook %}
    <li class="facebook">
      <a data-no-instant rel="noopener noreferrer nofollow" title="{{ 'general.social.share_on_facebook' | t }}" href="https://www.facebook.com/sharer/sharer.php?u={{ permalink_url }}" target="_blank" class="facebook alo_tooltip {{ class }}">
        <span class="alo_tooltip-content">{{ 'general.social.share_on_facebook' | t }}</span>
        {%- render 'icon-facebook' -%}
      </a>
    </li>
    {% endif %}
    {% if settings.share_twitter %}
    <li class="twitter">
      <a data-no-instant rel="noopener noreferrer nofollow" title="{{ 'general.social.share_on_twitter' | t }}" href="http://twitter.com/share?text={{ perma_title }}&amp;url={{ permalink_url }}" target="_blank" class="twitter alo_tooltip {{ class }}">
        <span class="alo_tooltip-content">{{ 'general.social.share_on_twitter' | t }}</span>
        {%- render 'icon-twitter' -%}
      </a>
    </li>
    {% endif %}
    {% if settings.share_email %}
    <li class="email">
      <a data-no-instant rel="noopener noreferrer nofollow" title="{{ 'general.social.share_on_email' | t }}" href="mailto:?subject=Check this {{ permalink_url }}" target="_blank" class="email alo_tooltip {{ class }}">
        <span class="alo_tooltip-content">{{ 'general.social.share_on_email' | t }}</span>
        {%- render 'icon-envelope' -%}
      </a>
    </li>
	{% endif %}
    {%- if perma_image != blank -%}
    	{% if settings.share_pinterest %}
          <li class="pinterest">
            <a data-no-instant rel="noopener noreferrer nofollow" title="{{ 'general.social.share_on_pinterest' | t }}" href="http://pinterest.com/pin/create/button/?url={{ permalink_url }}&amp;media=http:{{perma_image}}&amp;description={{ perma_title }}" target="_blank" class="pinterest alo_tooltip {{ class }}">
              <span class="alo_tooltip-content">{{ 'general.social.share_on_pinterest' | t }}</span>
              {%- render 'icon-pinterest' -%}
            </a>
          </li>
    	{% endif %}
    	{% if settings.share_tumblr %}
          <li class="tumblr">
            <a data-no-instant rel="noopener noreferrer nofollow" title="{{ 'general.social.share_on_tumblr' | t }}" data-content="http:{{perma_image}}" href="//tumblr.com/widgets/share/tool?canonicalUrl={{ permalink_url }}" target="_blank" class="tumblr alo_tooltip {{ class }}">
              <span class="alo_tooltip-content">{{ 'general.social.share_on_tumblr' | t }}</span>
              {%- render 'icon-tumblr' -%}
            </a>
          </li>
    	{% endif %}
    {%- endif -%}
    {% if settings.share_telegram %}
    <li class="telegram">
      <a data-no-instant rel="nofollow" title="{{ 'general.social.share_on_telegram' | t }}" target="_blank" class="telegram alo_tooltip {{ class }}" href="https://telegram.me/share/url?url={{ permalink_url }}"> 
        <span class="alo_tooltip-content">{{ 'general.social.share_on_telegram' | t }}</span>
        {%- render 'icon-telegram' -%}
      </a>
    </li>
    {% endif %}
    {% if settings.share_whatsapp %}
    <li class="whatsapp">
      <a data-no-instant rel="nofollow" title="{{ 'general.social.share_on_whatsapp' | t }}" target="_blank" class="whatsapp alo_tooltip {{ class }}" href="https://wa.me/?text={{ perma_title }}&#x20;{{ permalink_url }}"> 
        <span class="alo_tooltip-content">{{ 'general.social.share_on_whatsapp' | t }}</span>
        {%- render 'icon-whatsapp' -%}
      </a>
    </li>
    {% endif %}
  </ul>


</div>

