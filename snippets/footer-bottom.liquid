<!--Footer-->
{%  assign sid = section.id  %}
{%- assign layout = section.settings.full_width -%}
<section id="laber_{{sid}}" style="--cl-text:{{ section.settings.cl_text }};--cl-border:{{ section.settings.cl_border }};">
        <div class="{% if layout %}full-width{% else %}container{% endif %}" style="--alo-container-width:{{ section.settings.container }}px;">
        	<div class="row">
          {%- for block in section.blocks -%}
                  {% case block.settings.col %}
                        {% when '16%' %}
                            {%- assign block_width = 'col-lg-2 col-md-2 col-12' -%}
                        {% when '25%' %}
                            {%- assign block_width = 'col-lg-3 col-md-3 col-12' -%}
                        {% when '33%' %}
                            {%- assign block_width = 'col-lg-4 col-md-4 col-12' -%}
                        {% when '42%' %}
                            {%- assign block_width = 'col-lg-5 col-md-5 col-12' -%}
                        {% when '50%' %}
                            {%- assign block_width = 'col-lg-6 col-md-6 col-12' -%}
                        {% when '58%' %}
                            {%- assign block_width = 'col-lg-7 col-md-7 col-12' -%}
                        {% when '66%' %}
                            {%- assign block_width = 'col-lg-8 col-md-8 col-12' -%}
                        {% when '75%' %}
                            {%- assign block_width = 'col-lg-9 col-md-9 col-12' -%}
                        {% when '100%' %}
                            {%- assign block_width = 'col-12' -%}
                    {% endcase %}
                  {%- case block.type -%}
                  {%- when 'lang_curr' -%} 
                  <div class="footer-iteam {{ block_width }} mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb-mobile }}" style="--alo-position:{{ block.settings.pos_block }};" {{ block.shopify_attributes }}> 
                    <div class="language-currency">
                      {%if block.settings.header_use_language or block.settings.header_use_currency %}
                     {% assign show_flag = block.settings.show_flag %}
                      <ul>
                        {%if block.settings.header_use_language%}
                          {% render 'language', show_flag:show_flag %} 
                        {% endif %}
                        {%if block.settings.header_use_currency %}
                          {% render 'currency' %}
                        {% endif %}  
                      </ul> 
                    {% endif %}
                    </div>
                  </div>  
                  {%- when 'policy' -%} 
                  <div class="footer-iteam {{ block_width }} mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb-mobile }}" style="--alo-position:{{ block.settings.pos_block }};" {{ block.shopify_attributes }}> 
                   <div class="policies"> 
                    <ul class="list-unstyled" style="--cl-link:{{ block.settings.cl_link }};--cl-link-h:{{ block.settings.cl_link_hover }};">
                      {%- for policy in shop.policies -%}
                        {%- if policy != blank -%}
                          <li>
                            <small class="policies_content"
                              ><a href="{{ policy.url }}">{{ policy.title }}</a></small
                            >
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                   </div>
                  </div>
                  {%- when 'copyright' -%} 
                  <div class="footer-iteam {{ block_width }} mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb-mobile }}" style="--alo-position:{{ block.settings.pos_block }};" {{ block.shopify_attributes }}> 
                      {% if block.settings.copyright != blank %}
                      <div class="copyright alo-color" style="--alo-color:{{ block.settings.cl_text }};--cl-link-footer:{{ block.settings.cl_link }};"> {{ block.settings.copyright }}</div>
                    {% endif %}
                  </div>
                  {%- when 'text' -%} 
                  <div class="footer-iteam {{ block_width }} mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb-mobile }}" style="--alo-position:{{ block.settings.pos_block }};" {{ block.shopify_attributes }}> 
                      {% if block.settings.text != blank %}
                        <div class ="wrap-text">
                          <div class="footer-text text_{{ block.settings.text_align }} alo-color" style="--alo-color:{{ block.settings.cl_text }};"> {{ block.settings.text }}</div>
                        </div>
                    {% endif %}
                  </div>
                  {%- when 'logo' -%}   
                  <div class="footer-iteam {{ block_width }} mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb-mobile }}" style="--alo-position:{{ block.settings.pos_block }};" {{ block.shopify_attributes }}>   
                  <div class="logo-footer">
                    {% assign logo_footer = block.settings.logo_footer | default: settings.logo %}
                    {% if logo_footer != blank %}
                      {%- assign logo_alt = logo_footer.alt | default: shop.name | escape -%}
                      <a href="{{ routes.root_url }}" class="site-footer__logo-image" aria-label="{{ logo_alt | default: shop.name }}">
                        {%- assign logo_height = block.settings.logo_max_width | divided_by: logo_footer.aspect_ratio -%}
                        {% capture sizes %}(max-width: {{ block.settings.logo_max_width | times: 2 }}px) 50vw, {{ block.settings.logo_max_width }}px{% endcapture %}
                        {% capture widths %}{{ block.settings.logo_max_width }}, {{ block.settings.logo_max_width | times: 1.5 | round }}, {{ block.settings.logo_max_width | times: 2 }}{% endcapture %}
                        {{ logo_footer | image_url: width: 600 | image_tag:
                          class: 'footer__heading-logo',
                          widths: widths,
                          height: logo_height,
                          width: block.settings.logo_max_width,
                          alt: logo_alt,
                          sizes: sizes,
                          preload: true
                        }}
                      </a>
                      {% else %}
                        <a class="site-title" href="{{ routes.root_url }}" itemprop="url"><span class="logo-default">{{ settings.logo_text  }}</span>
                      </a>
                    {% endif %}
                  </div>  
                  </div>
				  {%- when 'payment_svg' -%}
                    <div class="footer-iteam {{ block_width }} mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb-mobile }}" style="--alo-position:{{ block.settings.pos_block }};" {{ block.shopify_attributes }}>
                    <div class="payment">
                      {% if block.settings.title != blank %}<span class="alo-color" style="--alo-color:{{ block.settings.cl_text }};">{{ block.settings.title }}</span>{% endif %} 
                      {% if block.settings.svg_custom %}
                        <div class="payment_type_svg">
                        {%- assign svg_custom = block.settings.svg_custom | remove: ' ' | split:"," -%}
                        {%- for img in svg_custom -%}
                          {% # theme-check-disable %}
                              <img loading="lazy"  width="45px"   height="30px" class="img_tr_svg" 
                                src="{{ img | payment_type_img_url }}" 
                                data-src="{{ img | payment_type_img_url }}" 
                                alt="{{img | replace:'_',' '}}" />
                          {% # theme-check-enable %}
                        {%- endfor -%}
                        </div>
                      <style>
                           .payment_type_svg{display: flex;flex-wrap: wrap;gap: 5px;} 
                          .payment_type_svg img {border-radius: 3px;}
                      </style>
                      {%- endif -%}
                    </div>
                    
                    </div>
                   {%- when 'payment_img' -%}
                        <div class="footer-iteam  {{ block_width }} mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb-mobile }}" {{ block.shopify_attributes }}>
                              <div class="payment" style="--alo-width:{{ block.settings.width_img }}px;--alo-position:{{ block.settings.pos_block }}"> 
                                {% if block.settings.title != blank %}<span class="alo-color" style="--alo-color:{{ block.settings.cl_text }};">{{ block.settings.title }}</span>{% endif %} 
                                {% if block.settings.img_payment %}  
                                  {% render 'responsive-image', image: block.settings.img_payment, image_class: 'w-auto h-full' %}
                                {%- endif -%}
                              </div>
						</div>
                   {%- when 'socia' -%}
                      <div class="footer-iteam {{ block_width }} mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb-mobile }}" {{ block.shopify_attributes }} style="--alo-position:{{ block.settings.pos_block }}">
                        {%if block.settings.f_social == "2"%}
                          {% render 'social_link' class:'top' %}
                        {% else %}
                           {% render 'social-sharing' class:'top' %} 
                        {% endif %}
                      </div>
                  {%- when 'menu' -%}
                    <div class="footer-iteam {{ block_width }} mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb-mobile }}" {{ block.shopify_attributes }} style="--alo-position:{{ block.settings.pos_block }}">
                       <div class="menu_footer">
                        {%- assign menu = block.settings.menu -%}
                        {%- if menu != blank -%}
                          <ul class="menu">
                            {%- for link in linklists[menu].links -%}
                             <li class="menu-item{% if link.active %}active{% endif %}">
                               <a class="alo-color alo-color-hover" style="--cl-color:{{ block.settings.cl_link }};--cl-color-h:{{ block.settings.cl_link_hover }};" href="{{ link.url }}">{{ link.title | split: '[' | first }}
                               </a>
                              </li>
                             {%- endfor -%}
                          </ul>
                          {%- else -%}
                            You have not selected the footer menu
                          {%- endif -%}
                       </div>
                      </div>
                    {%- when 'app-footer' -%}
                    <div class="footer-iteam {{ block_width }} mb-{{ block.settings.mb }} sm:mb-{{ block.settings.mb-mobile }}" {{ block.shopify_attributes }} style="--alo-position:{{ block.settings.pos_block }}">
                      <div class="app-footer">
                            {% if block.settings.app_store %}  
                              <a target="_blank" href="{{ block.settings.url_app_store  | default:'#' }}" >
                                {{ block.settings.app_store | image_url: width: 130 | image_tag: width: nil }}
                              </a>  
                            {%- endif -%}
                            {% if block.settings.app_android %}  
                              <a target="_blank" href="{{ block.settings.url_app_android | default:'#' }}" >
                                {{ block.settings.app_android | image_url: width: 130 | image_tag: width: nil }}
                              </a>  
                            {%- endif -%}
                      </div> 
                    </div>
                  {%- endcase -%}
                  
              {%- endfor -%}
        </div>
        </div>
</section>
<!--/Footer-->
