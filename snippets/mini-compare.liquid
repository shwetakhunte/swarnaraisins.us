<mini-compare data-modal class="laber-compare">
  <a
    href="#"
    class="header-icon"
    title="{{'general.compare.title' | t}}"
    aria-label="link"
  >
    <span class="icon">
    {% render "icon-compare" %}
    <span class="header__counter" data-js-compare-count="0">0</span>
    </span>
    {% if settings.show_text_header_right %}
      <span class="b">{{ 'general.compare.title' | t }}</span>
    {% endif %}
  </a>
