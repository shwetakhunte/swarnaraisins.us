{%- case block.type -%}
  {%- when 'image' -%}
    {%- liquid
      assign image = block.settings.image
      assign url =  block.settings.btn_link |default:"#"
      assign open_link =  block.settings.open_link
       
    -%}
    <div class="image-media-grid-item relative h-full">
        {%- if image != blank -%}
          {% render 'responsive-image', image: image, url:url, aspect_ratio:aspect_ratio, open_link:open_link, border:section.settings.border, image_class: 'w-full h-full' %}
        {%- else -%}
          {% if aspect_ratio != blank %}
               {%- assign ratio =  1 | divided_by: aspect_ratio | times: 100 -%}
            {% else %}
                {%- assign ratio = 100 -%}
            {% endif %}
            <div class="image-card__img overflow-hidden ratio alo-border-radius" style="--rounded:{{ section.settings.border }}px;--ratio-percent: {{ ratio }}%;">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg w-full h-full object-cover' }}
            </div>
        {%- endif -%}
        
        <div class="content-image events-none absolute inset-0 flex h_{{block.settings.h_position}} v_{{block.settings.v_position}} text_{{block.settings.txt_align}} {% if block.settings.hide_content %}hide{% endif %}">
          <div class="content">
            {% if block.settings.sub_title != blank %}<div class="sub_title mb-10 sm:mb-10 md:mb-10" style="--color-text:{{ block.settings.cl_sub_title }};--font-size:{{ block.settings.font_size_sub_title }}px;"><span>{{ block.settings.sub_title }}</span></div>{% endif %}
            {% if block.settings.title != blank %}<h3 class="title mb-20 sm:mb-10 md:mb-10"  style="--color-text:{{ block.settings.cl_title }};--font-size:{{ block.settings.font_size_title }}px;">{{ block.settings.title }}</h3> {% endif %}
            {% if block.settings.content != blank %}<div class="cnt mb-20 sm:mb-10 md:mb-10" style="--color-text:{{ block.settings.cl_content }};">{{ block.settings.content }}</div> {% endif %}
            {% if block.settings.link != blank %}
                <div id="b_{{block.id}}" class="{{ block.settings.ct_color }}">
                <a  class="btn events-auto alo-letter-spacing alo-text-transform {{ block.settings.button_style }} {{ block.settings.button_size }}" href="{{url}}" target="{{open_link}}"
                style="--color-link:{{ block.settings.cl_link }};--color-link-hover:{{ block.settings.cl_link_hover }};"  
                {{ block.shopify_attributes }}>
                {{block.settings.link}}
                </a> 
                </div>
              {% endif %}
          </div>   
        </div>
    </div>
  {%- when 'video' -%}
      {%- if block.settings.video -%}
        {%- render 'video-pm4', block:block -%}
      {%- else -%}
        {%- render 'video-link', block:block -%}
      {%- endif -%}
  {%- when 'text' -%}
    <div class="wrap-text relative w-full h-full" style="--pd-content:{{ block.settings.pd_content }}%;--alo-bg:{{ block.settings.bg_content }};--rounded:{{ block.settings.border_radius }}px;--cl-border:{{ block.settings.cl_border }};">
        <div class="content-image events-none absolute inset-0 flex h_{{block.settings.h_position}} v_{{block.settings.v_position}} text_{{block.settings.txt_align}}">
          <div class="content">
            {% if block.settings.sub_title != blank %}<div class="sub_title mb-10 sm:mb-10 md:mb-10" style="--cl-text:{{ block.settings.cl_sub_title }};--font-size:{{ block.settings.font_size_sub_title }}px;"><span>{{ block.settings.sub_title }}</span></div>{% endif %}
            {% if block.settings.title != blank %}<h3 class="title mb-20 sm:mb-20 md:mb-10"  style="--cl-text:{{ block.settings.cl_title }};--font-size:{{ block.settings.font_size_title }}px;">{{ block.settings.title }}</h3> {% endif %}
            {% if block.settings.content != blank %}<div class="cnt mb-20 sm:mb-20 md:mb-10 sm:d-none" style="--cl-text:{{ block.settings.cl_content }};">{{ block.settings.content }}</div> {% endif %}
            <div class="store-spotlight pt-20" style="--cl-text-heading:{{ block.settings.cl_heading }};--cl-text:{{ block.settings.cl_text }};">
                <div class="iteam">
                    <div class="icon icon_img">
                      {% if block.settings.icon_img_1 != blank %}
                        {% render 'responsive-image', image: block.settings.icon_img_1, image_class: 'w-full h-full' %}
                      {% else %}
                      {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                            {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                       {% endif %} 
                    </div>
                    <div class="text">
                      <h3 class="title">{{block.settings.title_1}}</h3>
                      <div>{{block.settings.text_1}}</div>
                    </div>
                </div>
                <div class="iteam">
                    <div class="icon icon_img">
                      {% if block.settings.icon_img_2 != blank %}
                        {% render 'responsive-image', image: block.settings.icon_img_2, image_class: 'w-full h-full' %}
                      {% else %}
                      {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                            {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                       {% endif %} 
                    </div>
                    <div class="text">
                      <h3 class="title">{{block.settings.title_2}}</h3>
                      <div>{{block.settings.text_2}}</div>
                    </div>
                </div>
                <div class="iteam">
                    <div class="icon icon_img">
                      {% if block.settings.icon_img_3 != blank %}
                        {% render 'responsive-image', image: block.settings.icon_img_3, image_class: 'w-full h-full' %}
                      {% else %}
                      {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                            {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                       {% endif %} 
                    </div>
                    <div class="text">
                      <h3 class="title">{{block.settings.title_3}}</h3>
                      <div>{{block.settings.text_3}}</div>
                    </div>
                </div>
                <div class="iteam">
                    <div class="icon icon_img">
                      {% if block.settings.icon_img_4 != blank %}
                        {% render 'responsive-image', image: block.settings.icon_img_4, image_class: 'w-full h-full' %}
                      {% else %}
                      {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                            {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                       {% endif %} 
                    </div>
                    <div class="text">
                      <h3 class="title">{{block.settings.title_4}}</h3>
                      <div>{{block.settings.text_4}}</div>
                    </div>
                </div>
              <div class="iteam">
                    <div class="icon icon_img">
                      {% if block.settings.icon_img_5 != blank %}
                        {% render 'responsive-image', image: block.settings.icon_img_5, image_class: 'w-full h-full' %}
                      {% else %}
                      {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                            {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                       {% endif %} 
                    </div>
                    <div class="text">
                      <h3 class="title">{{block.settings.title_5}}</h3>
                      <div>{{block.settings.text_5}}</div>
                    </div>
                </div>
              <div class="iteam">
                    <div class="icon icon_img">
                      {% if block.settings.icon_img_6 != blank %}
                        {% render 'responsive-image', image: block.settings.icon_img_6, image_class: 'w-full h-full' %}
                      {% else %}
                      {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                            {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                       {% endif %} 
                    </div>
                    <div class="text">
                      <h3 class="title">{{block.settings.title_6}}</h3>
                      <div>{{block.settings.text_6}}</div>
                    </div>
                </div>
            </div>
          </div> 
        </div>
    </div>
{%- endcase -%} 



