{%- liquid
  assign collection = collections[block.settings.collection]
  assign image = block.settings.image | default:collection.image |default:collection.products[0].featured_image
  assign home_t = 'homepage.onboarding.collection_title' | t
  assign url =  collection.url | default:'/admin/collections' 
-%}
  <div id="bk_{{block.id}}" class="collection-content relative h-full" {{ block.shopify_attributes }} >
    <div class="collection-image h-full">
        {%- if image != blank -%}
          {% render 'responsive-image', image: image, url:url, border:border, image_class: 'w-full h-full' %}
        {%- else -%}
          {% if aspect_ratio != blank %}
               {%- assign ratio =  1 | divided_by: aspect_ratio | times: 100 -%}
            {% else %}
                {%- assign ratio = 100 -%}
            {% endif %}
            <div class="image-card__img overflow-hidden alo-border-radius ratio" style="--ratio-percent: {{ ratio }}%; --rounded:{{ border }}px;">
              {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
              {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
            </div>
        {%- endif -%}
    </div>
        {% if block.settings.title %}
          <div class="collection-name" >
            <a class="name" href="{{ url }}" title="{{ block.settings.title | default:collection.title | default:home_t }}" aria-label="link">
                {{ block.settings.title | default:collection.title | default:home_t }}
            </a>
            <a class="btn events-auto alo-letter-spacing alo-text-transform alo_btn-link " href="{{ url }}" target="_blank">
            Shop now &nbsp; <i class="icon-arrow-right"></i>
            </a>
          </div>
        {%endif%}
  </div>




