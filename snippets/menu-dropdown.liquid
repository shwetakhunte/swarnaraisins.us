{%- assign llists = linklists -%} 
<ul class="sub-column">
{%- for link in llists -%}
  {%- if link.links != blank -%}
                          {% assign sub_image = link.object.image | default: link.object.products[0].featured_image  %}
                           <li class="menu-item menu-item-has-children {% if link.active %} current{% endif %}">
                             <a href="{{ link.url }}">
                                 {% if sub_image != blank %}
                                  <span class="icon">
                                    {%- capture img_html -%}{{ sub_image | image_url: width: 30 | image_tag: width: nil  }}{%- endcapture -%}
                                    {{ img_html | replace: 'src="', 'class="lazyload" src="' }}
                                  </span>
                                {% endif %}
                                <span>{{ link.title }}</span>
                             </a>
                             <ul class="submenu sub-menu-2">
        			            	{%- for child_link in link.links -%}
        				            	{%- if child_link.links != blank -%}
                                          {% assign sub_image_child_2 = child_link.object.image | default: child_link.object.products[0].featured_image  %}
        					               <li class="menu-item menu-item-has-children{% if child_link.active %} current{% endif %}">
        					                  <a href="{{ child_link.url }}">
                                                {% if sub_image_child_2 != blank %}
                                                  <span class="icon">
                                                    {%- capture img_html -%}{{ sub_image_child_2 | image_url: width: 30 | image_tag: width: nil  }}{%- endcapture -%}
                                                    {{ img_html | replace: 'src="', 'class="lazyload" src="' }}
                                                  </span>
                                                {% endif %}
                                                <span>{{ child_link.title }}</span>  
                                              </a>
        					                  <ul class="submenu sub-menu-3">
        					                  	{%- for grandchild_link in child_link.links -%}
                                                    {% assign sub_image_child_3 = grandchild_link.object.image | default: grandchild_link.object.products[0].featured_image  %}
        					                        <li class="menu-item{% if menu.active %} current{% endif %}">
                                                      <a href="{{ grandchild_link.url }}">
                                                        {% if sub_image_child_3 != blank %}
                                                          <span class="icon">
                                                            {%- capture img_html -%}{{ sub_image_child_3 | image_url: width: 30 | image_tag: width: nil  }}{%- endcapture -%}
                                                            {{ img_html | replace: 'src="', 'class="lazyload" src="' }}
                                                          </span>
                                                        {% endif %}
                                                        <span>{{ grandchild_link.title }}</span>  
                                                      </a>
                                                	</li>
        					                     {%- endfor -%}
        					                  </ul>
        					               </li>
        				               {%- else -%}
                                            {% assign sub_image_child_2 = child_link.object.image | default: child_link.object.products[0].featured_image  %}
                                  			<li class="menu-item{% if child_link.active %} current{% endif %}">
                                              <a href="{{ child_link.url }}">
                                                {% if sub_image_child_2 != blank %}
                                                  <span class="icon">
                                                    {%- capture img_html -%}{{ sub_image_child_2 | image_url: width: 30 | image_tag: width: nil  }}{%- endcapture -%}
                                                    {{ img_html | replace: 'src="', 'class="lazyload" src="' }}
                                                  </span>
                                                {% endif %}
                                                <span>{{ child_link.title }}</span> 
                                              </a>
                                  			</li>
        				               {%- endif -%}
        			               {%- endfor -%}
        			            </ul>
                           </li>
                      {% else %}  
                      {% assign sub_image = link.object.image | default: link.object.products[0].featured_image  %}
                       <li class="menu-item{% if link.active %} current{% endif %}">
                         <a href="{{ link.url }}">
                             {% if sub_image != blank %}
                              <span class="icon">
                                {%- capture img_html -%}{{ sub_image | image_url: width: 30 | image_tag: width: nil  }}{%- endcapture -%}
                                {{ img_html | replace: 'src="', 'class="lazyload" src="' }}
                              </span>
                            {% endif %}
                            <span>{{ link.title }}</span>
                         </a>
                       </li>
                      {% endif %}
{%- endfor -%}
</ul>