<div class="header-logo hide-desktop flex-1">
    {% assign logo_mobile = settings.logo_page_mobile | default: settings.logo %}
    {%- assign logo_alt = logo_mobile.alt | default: shop.name | escape -%}
    {% if logo_mobile != blank %}
        <a href="{{ routes.root_url }}" class="site-header__logo-image" title="{{ logo_alt }}">
            {%- assign logo_height = settings.logo_max_width | divided_by: logo_mobile.aspect_ratio -%}
            {% capture sizes %}(max-width: {{ settings.logo_max_width | times: 2 }}px) 50vw, {{ settings.logo_max_width }}px{% endcapture %}
            {% capture widths %}{{ settings.logo_max_width }}, {{ settings.logo_max_width | times: 1.5 | round }}, {{ settings.logo_max_width | times: 2 }}{% endcapture %}
            {{ logo_mobile | image_url: width: 600 | image_tag:
            class: 'logo_mobile',
            widths: widths,
            height: logo_height,
            width: settings.logo_max_width,
            alt: logo_alt,
            sizes: sizes,
            preload: true
            }}
        </a>
      {% else %}
      <a class="site-title" href="{{ routes.root_url }}" itemprop="url"><span class="logo-default">{{ settings.logo_text  }}</span></a>
      {% endif %}
</div>