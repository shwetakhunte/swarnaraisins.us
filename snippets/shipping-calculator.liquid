<!-- /snippets/shipping-calculator -->

{% unless settings.shipping_calculator == 'Disabled' %}
  <shipping-calculator id="shipping-calculator" class="info-checkout">
    <h5 class="title mb-15">
      <span>{{ 'cart.shipping_rates.title' | t }}</span>
    </h5>
    <div class="shopping-cart-element-content">
      <p class="field form-row form-row-wide select">
        <select
          id="address_country"
          style="width: 100%;"
          name="address[country]"
          data-default="{% if shop.customer_accounts_enabled and customer %}{{ customer.default_address.country }}{% elsif settings.shipping_calculator_default_country != '' %}{{ settings.shipping_calculator_default_country }}{% endif %}"
        >
          {{ country_option_tags }}
        </select>
      </p>
      <p class="field form-row form-row-wide select" id="address_province_container" style="display:none;">
        <select
          id="address_province"
          style="width: 100%;"
          name="address[province]"
          data-default="{% if shop.customer_accounts_enabled and customer and customer.default_address.province != '' %}{{ customer.default_address.province }}{% endif %}"
        ></select>
      </p>
      <p class="field form-row form-row-wide" id="address_zip_container">
        <input
          placeholder="{{ 'cart.shipping_rates.zip_Code' | t }}"
          type="text"
          style="width: 100%;"
          id="address_zip"
          name="address[zip]"
          {% if shop.customer_accounts_enabled and customer %}
            value="{{ customer.default_address.zip }}"
          {% endif %}
        >
      </p>
      <span id="wrapper-response"></span>
      <p class="field last">
        <button type="button" class="get-rates btn button button-duck">
          {{ settings.shipping_calculator_submit_button_label | default: 'Update' }}
        </button>
      </p>
    </div>
    <script id="shipping-calculator-response-template" type="text/template">
      <!-- <script id="shipping-calculator-response-template" type="text/javascript"> -->
      <p id="shipping-rates-feedback" style="margin:0" class="${(success) ? 'success' : 'error'}">
        ${(function () { if (success) { if (rates.length > 1) { return `
        {{ 'cart.shipping_rates.note_rates.note_rates1' | t }} ${rates.length}
        {{ 'cart.shipping_rates.note_rates.note_rates2' | t }} ${address},
        {{ 'cart.shipping_rates.note_rates.note_rates3' | t }} ${rates[0].price} `; } else if (rates.length == 1) {
        return `{{ 'cart.shipping_rates.note' | t }} ${address}.`; } else { return `
        {{- 'cart.shipping_rates.note_no' | t -}}
        `; } }else{ return errorFeedback; } })()}
      </p>
      <ul id="shipping-rates" style="list-style: none;">
        ${ rates.map(function (rate) { return `
        <li style="font-size: 16px;">${rate.price}</li>
        `; }).join('') }
      </ul>
    </script>
  </shipping-calculator>
  <style>
    #wrapper-response{
      display:block!important;
      clear: both;
    }
  </style>
  {% # theme-check-disable %}
  {{ '/services/javascripts/countries.js' | script_tag }}
  {{ 'shopify_common.js' | shopify_asset_url | script_tag }}
  {% # theme-check-enable %}
  <script src="{{ 'shipping-calculator.js' | asset_url }}" defer="defer"></script>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      Shopify.Cart.ShippingCalculator.show( {
        submitButton: {{ settings.shipping_calculator_submit_button_label | default: 'Calculate shipping' | json }},
        submitButtonDisabled: {{ settings.shipping_calculator_submit_button_label_disabled | default: 'Calculating...' | json }}{% if customer %},
        customerIsLoggedIn: true{% endif %},
        moneyFormat: {{ shop.money_format | json }}
      } );
    });
  </script>
{% endunless %}
