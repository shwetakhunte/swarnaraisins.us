<div class="laber-social-link socials clearfix">
<ul class="list-socials ">
  {% if settings.footer_social_twitter_enable %}
  <li class="twitter">
    <a class="alo_tooltip {{ class }}" target="_blank" href="{{settings.footer_social_twitter_link | default:"#"}}" title="{{settings.footer_social_twitter_text}}">
      {%- render 'icon-twitter' -%}
      <span class="alo_tooltip-content">Twitter</span>
    </a>
  </li>
  {% endif %}
  {% if settings.footer_social_facebook_enable %}
  <li class="facebook">
    <a class="alo_tooltip {{ class }}" target="_blank" href="{{settings.footer_social_facebook_link | default:"#"}}" title="{{settings.footer_social_facebook_text}}">
