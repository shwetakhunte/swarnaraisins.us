<div class="title">
  <div class="tag-area">
    <span>{{ 'blogs.article.tags' | t }}: </span>
    {% for tag in article.tags limit: limit %}
    <a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>{% comment %}{% unless forloop.last %},{% endunless %}{% endcomment %}
    {% endfor %}  
  </div>
</div>
