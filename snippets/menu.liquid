<!--  Check and get sticky menu-->
{% assign show_thumb_collection = section.settings.show_thumb_collection %}
{% if show_thumb_collection != true %} {% assign show_thumb = 'hide-thub-col' %} {% endif %}
<!--/End check --> 
  <div class="header-nav-inner">
    <div class="box-header-nav">
      <div class="container-wapper">        
        <ul id="menu-main-menu" class="main-menu clone-main-menu" >
          {%- for type in tp_blocks -%}
     
              {%- assign arr_ty_curent = blocktp |remove:'t4,' | split:',' | where:type -%}
              {%- assign arrblock = se_blocks | where: "type", type -%}
              {%- assign block = arrblock[arr_ty_curent.size] -%}
              {%- assign blocktp = blocktp | append:',' | append:type -%}
              
              {%- case block.type -%}
          		 {%- when 'logo' -%}	
                    {% if settings.header_design =='both-center' %}
          			 <li class="header-logo" style="width:{{ block.settings.logo_max_width }}px;">
                        {%- render 'logo' -%}
                    </li>	
                  {% endif %}
                 {%- when 'dropdown' -%}
                    <li id="item_{{block.id}}" class="type_{{block.type}} {{ show_thumb }} menu-item {% if linklists[block.settings.menu].links.size > 0 %}  has-children {% endif %}"  {{ block.shopify_attributes }}>
                       <a class="cms-item-title " href="{{block.settings.url}}" target="{{block.settings.open_link}}"{% if block.settings.cus_cl %} style="color:{{block.settings.cl}}"{% endif %}>
                         {% render 'title_menu',block:block, enable_icon:section.settings.enable_icon_menu %}
                         {% if linklists[block.settings.menu].links.size > 0 %}  <i class="icon-chevron-down"></i> {% endif %}
                      </a>
                       {%- if linklists[block.settings.menu].links.size > 0 %}                      
                         <div class="submenu" style="{%if block.settings.bg != blank%}--bg-color:{{block.settings.bg}};{%endif%}" >
                           	<div id="bk_{{block.id}}" class="dropdown type_link">
                           		{% render 'menu-dropdown' ,linklists:linklists[block.settings.menu].links  %}
                         	</div> 
                      	</div>
                      {% endif %}
                    </li>                
                 {%- when 'simple' -%}
                    {% if block.settings.url != blank %}
                        <li id="item_{{block.id}}" class="menu-item type_simple" {{ block.shopify_attributes }}>
                          <a class="cms-item-title" href="{{block.settings.url}}" target="{{block.settings.open_link}}"{% if block.settings.cus_cl %} style="color:{{block.settings.cl}}"{% endif %}>
                            {%- render 'title_menu',block:block, enable_icon:section.settings.enable_icon_menu -%}
                          </a>
                        </li>
                    {% endif %}
                 {%- else -%}


                    <li id="item_{{block.id}}" class="type_{{block.type}} {{ show_thumb }} menu-item has-children {% if block.settings.pos_rel %}pos_rel{%endif%}" {{ block.shopify_attributes }}>
                       <a class="cms-item-title " href="{{block.settings.url}}" target="{{block.settings.open_link}}"{% if block.settings.cus_cl %} style="color:{{block.settings.cl}}"{% endif %}>
                         {%- render 'title_menu',block:block, enable_icon:section.settings.enable_icon_menu -%}
                         <i class="icon-chevron-down"></i>
                      </a>
                       <div class="submenu mega-menu mega-menu1" 
                            style="
                                   {% if  block.settings.wid == 'cus' %} width:{{block.settings.cus_wid}}px;{% endif %}
                                   {%if block.settings.bg != blank%}background-color:{{block.settings.bg}};{%endif%}
                                   {%if block.settings.image != blank%}
                                   	 background-image:url('{{block.settings.image | image_url: width: 450 }}'); 
                                     background-position: right bottom;
                                     background-repeat: no-repeat;
                                   {%endif%}
                                   "
                            >
                         <div class="{{block.settings.wid}}">
                          
                          <div id="bk_{{block.id}}" class="row lazy_menu_mega" >
                             {% render 'menu-mega' ,section_blocks:section.blocks ,block_id:block.id  %}
                           </div>
                         </div>
                      </div>
                    </li>
              {%- endcase -%}
           {%- endfor -%}          
        </ul>
        {% if section.settings.text != blank and section.settings.enable_text_right %}
        <ul class="menu_right" style="--cl-text:{{ section.settings.cl_text }}">
          <li>
            {% render 'icon-phone' %}
            <div>
            {{ section.settings.text }}
            </div>
          </li>  
        </ul>
        {% endif %}
      </div>
    </div>
  </div>