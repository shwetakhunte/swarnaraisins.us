{%- liquid
  assign collection = collections[block.settings.collection]
  assign image = block.settings.image | default:collection.image |default:collection.products[0].featured_image
  assign home_t = 'homepage.onboarding.collection_title' | t
  assign url =  collection.url | default:'/admin/collections' 
-%}
<div id="bk_{{block.id}}" class="alo-collection-item" {{ block.shopify_attributes }} >
  <div class="collection_item__content">
    <div class="collection-image" style="--rounded:100%;">
        {%- if image != blank -%}
          {% render 'responsive-image', image: image, url:url, aspect_ratio:aspect_ratio, image_class: 'w-full h-full alo-border-radius' %}
        {%- else -%}
          {% if aspect_ratio != blank %}
               {%- assign ratio =  1 | divided_by: aspect_ratio | times: 100 -%}
            {% else %}
                {%- assign ratio = 100 -%}
            {% endif %}
            <div class="image-card__img overflow-hidden alo-border-radius ratio" style="--ratio-percent: {{ ratio }}%;">
              {% capture current %}{% cycle 1, 2, 3, 4 %}{% endcapture %}
              {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full ' }}
            </div>
        {%- endif -%}
    </div>
      <div class="collection_item__title">
        {% if block.settings.title %}
          <a href="{{ url }}" title="{{ block.settings.title | default:collection.title | default:home_t }}" aria-label="link">
              <span>{{ block.settings.title | default:collection.title | default:home_t }}</span>
              {% if num_p_qty and collection != blank %}
                <span class="cat_grid_item__count ">
                  {{collection.all_products_count}} 
                  <span>
                    {% if collection.all_products_count > 1 %} 
                        {{'homepage.section.items' | t}} 
                    {% else %}
                        {{'homepage.section.item' | t}} 
                    {% endif %}
                  </span>
                </span>
              {% endif %}
         </a>
        {%endif%}
      </div>
  </div>
</div>



