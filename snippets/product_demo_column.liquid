{%- assign design_product = settings.design_product -%}
{%- assign show_reviews = settings.product_collection_show_reviews -%}
{%- assign image_border_product = settings.image_border_product -%}
{%- liquid
  assign sett_equal = settings.use_eq_height_product
  assign image_ratio = settings.image_ratio_product
  if sett_equal
    case image_ratio
      when 'ratio2_1'
        assign aspect_ratio = 2.0
      when 'ratio3_2'
        assign aspect_ratio = 1.5
      when 'ratio4_3'
        assign aspect_ratio = 1.333
      when 'ratio5_6'
        assign aspect_ratio = 0.8333
      when 'ratio1_1'
        assign aspect_ratio = 1.0
      when 'ratio6_5'
        assign aspect_ratio = 1.2
      when 'ratio3_4'
        assign aspect_ratio = 0.75
      when 'ratio2_3'
        assign aspect_ratio = 0.66667
      when 'ratio1_2'
        assign aspect_ratio = 0.5
      when 'custom'
        assign custom_ratio = settings.custom_ratio | split: '/'
        assign width = custom_ratio[0]
        assign height = custom_ratio[1] | times: 1.0
        assign aspect_ratio = width | divided_by: height
    endcase
  endif
-%}
{%- capture style -%}
  {% assign ratio = aspect_ratio | default:product.featured_media.aspect_ratio %}
  --ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;
{%- endcapture -%}
<div class="product-item product-column-style laber-product-item-{{design_product}}">
  <div class="product-collection alo-border-radius" style="--alo-border-radius:{{ image_border_product }}px;">
    <div class="product-inner">
      <div class="thumb">
        <div class="product-image">
          <a class="db" href="{{ routes.root_url }}admin/products" aria-label="Product Image">
            <div
              class="image-card__img overflow-hidden alo-border-radius ratio"
              style="--alo-border-radius:{{ image_border_product }}px; {{ style }}"
            >
              {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
              {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
            </div>
          </a>
        </div>
      </div>
      <div class="info">
        <div class="product-collection__content ">
          <div class="product-collection__title">
            <h2 class="name_product">
              <a class="cd" href="{{ routes.root_url }}admin/products">
                {{ 'homepage.onboarding.product_title' | t }}
              </a>
            </h2>
          </div>
          {%- if show_reviews -%}
            <!-- Start of Judge.me code -->
            <div style="{{ jm_style }}" class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
              {{- product.metafields.judgeme.badge -}}
            </div>
            <!-- End of Judge.me code -->
          {%- endif -%}
          <div class="frm-price-color">
            <div class="product-collection__price ">
              <span class="price price--sale" data-js-product-price="">
                <span class="current">$56.00</span> <span class="compare">$19.00 </span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
